{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git worktree remove *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down *)",
      "Bash(pnpm --filter ./apps/api prisma:migrate:deploy *)",
      "Bash(pnpm --filter @kabso/api prisma:migrate:deploy *)",
      "Bash(npx prisma migrate *)",
      "Bash(pnpm prisma migrate *)",
      "Bash(prisma migrate *)",
      "Bash(dropdb *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)"
    ]
  }
}
