# Kabso Live — media node settings (D350). Copy to /etc/kabso-media/media.env on the SERVER (mode 600, root) and fill
# it there over SSH. Never commit the filled file, never paste it into chat.
#   install -m 600 -o root -g root /opt/kabso/infra/media/.env.example /etc/kabso-media/media.env
#   nano /etc/kabso-media/media.env
#   bash /opt/kabso/infra/media/render-config.sh          # validates and renders livekit.yaml / caddy.yaml
# Values are plain KEY=value lines (no spaces around =, no quotes needed, printable ASCII only).

# ---- Names and addresses -------------------------------------------------------------------------------------------
# Signalling host the apps connect to (wss://MEDIA_DOMAIN). DNS A record → NODE_IP.
MEDIA_DOMAIN=media1.example.com
# TURN host (own name and certificate; TURN/TLS is always advertised on 443). DNS A record → NODE_IP.
TURN_DOMAIN=turn1.example.com
# E-mail for Let's Encrypt (expiry notices).
ACME_EMAIL=ops@example.com
# The server's public IPv4 (Hetzner Robot → Server → IPs). Advertised to clients as the ICE candidate.
NODE_IP=203.0.113.10
# Optional private (vSwitch) IPv4 of this node, Phase 2. When set, LiveKit (7880 + metrics 6789) and node_exporter
# (9100) also listen there, and ufw allows them from MONITORING_IPS only. Empty in Phase 1 (they stay on 127.0.0.1).
PRIVATE_IP=
# Region tag reported by the node.
LIVEKIT_REGION=eu-central-fsn1

# ---- Ports (defaults are the recommended layout; see docs/infrastructure/TURN_NETWORK_DESIGN.md) ---------------------
# ICE/TCP fallback.
RTC_TCP_PORT=7881
# ICE/UDP mux range: at least one port per vCPU (EX44: 20 threads). A single port ("7882") also works.
RTC_UDP_PORT=7882-7901
# TURN/UDP: 443 (passes QUIC-only networks) or 3478 (the TURN default).
TURN_UDP_PORT=443

# ---- Firewall ------------------------------------------------------------------------------------------------------
# SSH sources (space-separated IPv4/IPv6 CIDRs), e.g. the owner's and the operator's static IPs. EMPTY = SSH open to
# everyone, rate-limited by ufw and watched by fail2ban (key-only login either way). Set it as soon as the IPs are known.
SSH_ALLOW_CIDRS=
# Prometheus / node_exporter scrapers (space-separated CIDRs). Empty = no remote scraping (read them over SSH).
MONITORING_IPS=

# ---- LiveKit -------------------------------------------------------------------------------------------------------
# API key NAME (not secret; starts with "API"). The same pair goes into the API's kabso.env at cut-over.
LIVEKIT_API_KEY=
# API secret (>= 32 random characters). Leave EMPTY and run `render-config.sh --generate-keys`: a new pair is
# generated ON the server and written into this file (never printed). To hand it to the API server, copy it over SSH
# (LIVEKIT_SINGLE_NODE_DEPLOYMENT.md §7), never through chat.
LIVEKIT_API_SECRET=
# Webhook target. Empty = no webhook (validation before cut-over). At cut-over the API's public signed route:
#   https://api.<domain>/livekit/webhook   (needs LIVEKIT_PUBLIC_WEBHOOK_ENABLED=true on the API; D350)
LIVEKIT_WEBHOOK_URL=
# debug | info | warn | error
LIVEKIT_LOG_LEVEL=info
# Per-room participant cap (viewers included); 0 = unlimited.
ROOM_MAX_PARTICIPANTS=1000
# Node limits; when reached, LiveKit refuses NEW participants, even into existing rooms. -1 / 0 = off (Phase 1 load
# test). Set from SINGLE_NODE_CAPACITY_RESULTS.md before production (e.g. bytes_per_sec ≈ 80 % of the port, in+out).
LIMIT_NUM_TRACKS=-1
LIMIT_BYTES_PER_SEC=0

# ---- Update policy -------------------------------------------------------------------------------------------------
# update-media.sh: how long a drain may take before the node is stopped anyway (seconds). 10800 = 3 h.
DRAIN_TIMEOUT_SECONDS=10800
