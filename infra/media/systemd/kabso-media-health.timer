# Kabso Live — run the media node health probe every minute. (There is deliberately NO update timer on media nodes:
# updates are manual and drain-safe, update-media.sh.)
[Unit]
Description=Kabso Live media node health probe every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
