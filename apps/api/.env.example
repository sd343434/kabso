# Kabso Live API — example environment. Copy to `.env` (gitignored) for local development.
# Never commit real secrets. All values are validated at boot (src/config/env.schema.ts).

NODE_ENV=development
PORT=3000

# PostgreSQL 16 (Prisma 7 + @prisma/adapter-pg). Two roles (SEC-011, docs/DEPLOYMENT.md §5.1),
# created by infra/postgres/bootstrap-roles.sql (docker compose runs it on first start):
# - DATABASE_URL: the DML-only runtime login the API uses (member of kabso_runtime_<database>
#   only; one login per database). In production the API refuses to boot if this role (or any
#   role it can reach) is a superuser, owns the schema/tables or can run DDL / TRUNCATE.
# - MIGRATION_DATABASE_URL: the migration/owner role, used only by the Prisma CLI
#   (`prisma migrate deploy|dev`, see prisma.config.ts). Never give it to the API.
DATABASE_URL=postgresql://kabso_app:kabso_app_dev_password@localhost:5432/kabso_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://kabso_migrator:kabso_migrator_dev_password@localhost:5432/kabso_dev?schema=public
# Redis 7 (rate limiting)
REDIS_URL=redis://localhost:6379/0

# Access JWT (HS256). ≥ 32 bytes. Generate: openssl rand -base64 48
# In production the value must be base64/base64url that decodes to ≥ 32 bytes and look random
# (placeholders, typed passphrases, repeated or sequential characters are refused at boot).
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
# Refresh token: 30 days sliding, 180 days absolute
REFRESH_TTL_SECONDS=2592000
REFRESH_ABSOLUTE_TTL_SECONDS=15552000

# Base URL used to build links in emails (verification / password reset)
APP_PUBLIC_URL=http://localhost:3000
# Only `log` is implemented (BLOCKED B2: SMTP provider credentials not yet provided)
MAIL_TRANSPORT=log

# HMAC key for rate-limit Redis keys (no raw or plainly hashed emails/IPs in Redis).
# Required in production (same strength rules as JWT_ACCESS_SECRET, and must differ from it).
# Optional elsewhere: when unset a random key is generated per process (limits reset on restart).
# Generate: openssl rand -base64 48
# It also derives (HKDF) the key for registration-code HMACs: outside production, set it if
# pending registrations must survive an API restart.
# RATE_LIMIT_KEY_SECRET=

# Comma-separated list of allowed CORS origins (empty = CORS disabled for browsers)
CORS_ORIGINS=
# How the client IP is derived (Express `trust proxy`). Used by every per-IP rate limit.
#   false            no proxy in front: use the socket address (default, safe)
#   <hop count>      exactly N proxies in front that APPEND to X-Forwarded-For, e.g. 1 behind one
#                    load balancer. Do NOT set a hop count if clients can reach the API directly.
#   <IPs/CIDRs>      comma-separated proxy addresses/subnets, e.g. 10.0.0.0/8 (also: loopback,
#                    linklocal, uniquelocal) — preferred when the proxy subnet is known
#   true             trust every hop = the client controls its own IP. REFUSED in production.
# Production also refuses /0 ranges (0.0.0.0/0, ::/0), hop counts greater than 3, IPv4 ranges
# broader than /8, IPv6 broader than /32 and ::ffff:0:0/96 (SEC-003a, v1.2.3).
TRUST_PROXY=false

# Concurrent Argon2 operations per process (default: CPU count) and how many may wait for a
# slot (default: 4 × CPU count). Beyond that, login/register/reset answer 503 + Retry-After.
# Also size libuv's pool to at least the cap: UV_THREADPOOL_SIZE (must be set in the process
# environment before start, e.g. in the container spec; default 4).
# ARGON2_MAX_CONCURRENCY=
# ARGON2_MAX_QUEUE=

LOG_LEVEL=info

# Rate-limit overrides (format: <max>/<windowSeconds>). Defaults follow CONVENTIONS §7.
# Login: per IP+account, per account across all IPs (email and username share it), per IP
# RATE_LIMIT_LOGIN_IP_ACCOUNT=10/900
# RATE_LIMIT_LOGIN_ACCOUNT=20/900
# RATE_LIMIT_LOGIN_IP=50/900
# RATE_LIMIT_REGISTER_IP=5/3600
# RATE_LIMIT_FORGOT_EMAIL=3/3600
# RATE_LIMIT_FORGOT_IP=10/3600
# RATE_LIMIT_REFRESH_SESSION=60/900
# RATE_LIMIT_AUTHENTICATED_USER=600/900
# RATE_LIMIT_EMAIL_RESEND_USER=5/3600
# Unauthenticated endpoints without a dedicated rule (verify, reset, username availability)
# RATE_LIMIT_PUBLIC_IP=300/900
# v1.2: verify-first registration and PATCH /me
# RATE_LIMIT_REGISTER_EMAIL=3/3600
# RATE_LIMIT_REGISTER_VERIFY_IP=10/900
# RATE_LIMIT_REGISTER_VERIFY_EMAIL=15/86400
# RATE_LIMIT_REGISTER_RESEND_EMAIL=3/3600
# RATE_LIMIT_REGISTER_RESEND_IP=10/3600
# RATE_LIMIT_UPDATE_ME_USER=30/3600

# Verify-first registration (contract v1.2 §6)
# REGISTRATION_TTL_SECONDS=1800
# Absolute lifetime from creation; resend never extends past it (SEC-026)
# REGISTRATION_MAX_LIFETIME_SECONDS=7200
# Optional dedicated key for registration-code HMACs (>= 32 bytes; SEC-029). Unset: derived from
# RATE_LIMIT_KEY_SECRET. Changing it invalidates live pending codes (users resend).
# REGISTRATION_CODE_KEY=
# REGISTRATION_NOTICE_INTERVAL_SECONDS=3600
# Periodic deletion of expired pending registrations (seconds; 0 disables; lazy cleanup remains)
# REGISTRATION_CLEANUP_INTERVAL_SECONDS=600
# SEC-023: a source with a successful login within this window bypasses the account bucket
# LOGIN_RECENT_SUCCESS_TTL_SECONDS=2592000
# Reserved display-name terms (comma-separated; default = CONVENTIONS §6 list)
# Brand terms additionally matched anywhere inside any single word (v1.2.3)
# RESERVED_DISPLAY_NAME_BRAND_TERMS=kabso,كابسو
# RESERVED_DISPLAY_NAME_TERMS=kabso,admin,administrator,support,official,moderator,كابسو,الدعم,الإدارة

# Live discovery, contract v1.3 (CONVENTIONS §10). Going live and heartbeats answer 503
# LIVE_HOSTING_UNAVAILABLE unless LIVE_HOSTING_ENABLED is exactly "true" (default false: no media
# provider yet, B1; turning it on in staging/production needs owner approval).
# LIVE_HOSTING_ENABLED=false
# Heartbeat cadence sent to clients (5–60 s) and stale window (>= 2 x interval)
# LIVE_HEARTBEAT_INTERVAL_SECONDS=15
# LIVE_HEARTBEAT_STALE_SECONDS=45
# Stale-room sweeper period per API instance (0 disables; refused in production). A run starts
# only after the previous one finished and ends stale rooms in batches of LIVE_SWEEP_BATCH_SIZE
# (1-5000), each batch its own transaction, within a per-run budget (SEC-035).
# LIVE_SWEEP_INTERVAL_SECONDS=15
# CP-016 A: the popularity boards' time zone (day from midnight, week from Monday). Default UTC.
# LIVE_RANKINGS_TIME_ZONE=UTC
# v1.23-live (CP-020): the quantities a live gift send may use (1-12 ascending whole numbers
# 1-9999), and the gift-send bucket (per user, replaces the default).
# LIVE_GIFT_QUANTITIES=1,10,66,99,188,520,1314
# RATE_LIMIT_LIVE_GIFT_USER=120/60
# D145c: lucky gifts (MAX X streaks) — every gift send counts against the per-minute ceiling; a lucky
# send against the burst bucket instead of RATE_LIMIT_LIVE_GIFT_USER.
# D145d: 100 lucky sends a second per user (6000 a minute).
# RATE_LIMIT_LIVE_LUCKY_GIFT_USER=6000/60
# RATE_LIMIT_LIVE_LUCKY_GIFT_BURST_USER=100/1
# v1.27-live (D132, CONVENTIONS §10.27): lucky gifts. Off by default; the table below is checked at
# start-up even while off (an invalid one refuses to start). RTP + host share must not pass 100 %.
# LUCKY_GIFTS_ENABLED=false
# LUCKY_GIFT_RTP_PERCENT=85
# LUCKY_GIFT_HOST_SHARE_PERCENT=10
# D148: eight tiers, their chances per million, and the per-sender guarantee (×5 after 15 losses).
# LUCKY_GIFT_RTP_SHARES (D132) is gone: set, the API refuses to start.
# LUCKY_GIFT_MULTIPLIERS=5,10,25,50,100,250,500,1000
# LUCKY_GIFT_CHANCES_PER_MILLION=48918,15451,3903,1464,569,130,40,12
# LUCKY_PITY_AFTER=15
# LUCKY_PITY_MULTIPLIER=5
# LUCKY_GIFT_BIG_WIN_MULTIPLIER=100
# LUCKY_GIFT_DAY_TIME_ZONE=UTC
# Countries (ISO alpha-2) where lucky gifts are off; needs the header the edge sets (e.g. cf-ipcountry).
# LUCKY_GIFTS_DISABLED_COUNTRIES=
# LUCKY_GIFTS_COUNTRY_HEADER=
# v1.24-live (CP-021): the CP space (CP day, CP week and the couples ranking) uses
# LIVE_RANKINGS_TIME_ZONE above. CP space writes and new confessions, per user (replace the default).
# RATE_LIMIT_CP_SPACE_WRITE_USER=60/60
# RATE_LIMIT_CP_CONFESSION_USER=10/3600
# v1.25-live (CP-022): family chat messages, per user (replaces the default).
# RATE_LIMIT_FAMILY_CHAT_USER=30/60
# v1.40-social (D155): direct message sends, message requests (to strangers) and the other DM writes.
# RATE_LIMIT_DM_SEND_USER=30/60
# RATE_LIMIT_DM_REQUEST_USER=20/3600
# RATE_LIMIT_DM_WRITE_USER=300/3600
# LIVE_SWEEP_BATCH_SIZE=500
# Optional dedicated source of the list-cursor HMAC key (HKDF info `live-cursor/v1`). Unset:
# derived from RATE_LIMIT_KEY_SECRET. Production: generator output (openssl rand -base64 48),
# distinct from the other secrets. Rotating it only invalidates outstanding cursors.
# LIVE_CURSOR_KEY=
# v1.3 rate limits (per user; each replaces the default authenticated bucket for its endpoint)
# RATE_LIMIT_LIVE_LIST_USER=300/900
# RATE_LIMIT_PROFILE_USER=300/900
# RATE_LIMIT_LIVE_START_HOUR_USER=10/3600
# RATE_LIMIT_LIVE_START_DAY_USER=30/86400
# Production requires at least 2x the heartbeat cadence (12/60 at 15 s = 3x)
# RATE_LIMIT_LIVE_HEARTBEAT_USER=12/60
# RATE_LIMIT_LIVE_END_USER=30/3600
# Follow and unfollow share these two buckets
# RATE_LIMIT_FOLLOW_HOUR_USER=60/3600
# RATE_LIMIT_FOLLOW_DAY_USER=300/86400
