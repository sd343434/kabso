# Kabso Live API — example environment. Copy to `.env` (gitignored) for local development.
# Never commit real secrets. All values are validated at boot (src/config/env.schema.ts).

NODE_ENV=development
PORT=3000

# PostgreSQL 16 (Prisma 7 + @prisma/adapter-pg)
DATABASE_URL=postgresql://kabso:kabso_dev@localhost:5432/kabso_dev?schema=public
# Redis 7 (rate limiting)
REDIS_URL=redis://localhost:6379/0

# Access JWT (HS256). ≥ 32 bytes. Generate: openssl rand -base64 48
# In production the value must be base64/base64url that decodes to ≥ 32 bytes and look random
# (placeholders, typed passphrases, repeated or sequential characters are refused at boot).
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
# Refresh token: 30 days sliding, 180 days absolute
REFRESH_TTL_SECONDS=2592000
REFRESH_ABSOLUTE_TTL_SECONDS=15552000

# Base URL used to build links in emails (verification / password reset)
APP_PUBLIC_URL=http://localhost:3000
# Only `log` is implemented (BLOCKED B2: SMTP provider credentials not yet provided)
MAIL_TRANSPORT=log

# HMAC key for rate-limit Redis keys (no raw or plainly hashed emails/IPs in Redis).
# Required in production (same strength rules as JWT_ACCESS_SECRET, and must differ from it).
# Optional elsewhere: when unset a random key is generated per process (limits reset on restart).
# Generate: openssl rand -base64 48
# It also derives (HKDF) the key for registration-code HMACs: outside production, set it if
# pending registrations must survive an API restart.
# RATE_LIMIT_KEY_SECRET=

# Comma-separated list of allowed CORS origins (empty = CORS disabled for browsers)
CORS_ORIGINS=
# How the client IP is derived (Express `trust proxy`). Used by every per-IP rate limit.
#   false            no proxy in front: use the socket address (default, safe)
#   <hop count>      exactly N proxies in front that APPEND to X-Forwarded-For, e.g. 1 behind one
#                    load balancer. Do NOT set a hop count if clients can reach the API directly.
#   <IPs/CIDRs>      comma-separated proxy addresses/subnets, e.g. 10.0.0.0/8 (also: loopback,
#                    linklocal, uniquelocal) — preferred when the proxy subnet is known
#   true             trust every hop = the client controls its own IP. REFUSED in production.
# Production also refuses /0 ranges (0.0.0.0/0, ::/0), hop counts greater than 3, IPv4 ranges
# broader than /8, IPv6 broader than /32 and ::ffff:0:0/96 (SEC-003a, v1.2.3).
TRUST_PROXY=false

# Concurrent Argon2 operations per process (default: CPU count) and how many may wait for a
# slot (default: 4 × CPU count). Beyond that, login/register/reset answer 503 + Retry-After.
# Also size libuv's pool to at least the cap: UV_THREADPOOL_SIZE (must be set in the process
# environment before start, e.g. in the container spec; default 4).
# ARGON2_MAX_CONCURRENCY=
# ARGON2_MAX_QUEUE=

LOG_LEVEL=info

# Rate-limit overrides (format: <max>/<windowSeconds>). Defaults follow CONVENTIONS §7.
# Login: per IP+account, per account across all IPs (email and username share it), per IP
# RATE_LIMIT_LOGIN_IP_ACCOUNT=10/900
# RATE_LIMIT_LOGIN_ACCOUNT=20/900
# RATE_LIMIT_LOGIN_IP=50/900
# RATE_LIMIT_REGISTER_IP=5/3600
# RATE_LIMIT_FORGOT_EMAIL=3/3600
# RATE_LIMIT_FORGOT_IP=10/3600
# RATE_LIMIT_REFRESH_SESSION=60/900
# RATE_LIMIT_AUTHENTICATED_USER=600/900
# RATE_LIMIT_EMAIL_RESEND_USER=5/3600
# Unauthenticated endpoints without a dedicated rule (verify, reset, username availability)
# RATE_LIMIT_PUBLIC_IP=300/900
# v1.2: verify-first registration and PATCH /me
# RATE_LIMIT_REGISTER_EMAIL=3/3600
# RATE_LIMIT_REGISTER_VERIFY_IP=10/900
# RATE_LIMIT_REGISTER_VERIFY_EMAIL=15/86400
# RATE_LIMIT_REGISTER_RESEND_EMAIL=3/3600
# RATE_LIMIT_REGISTER_RESEND_IP=10/3600
# RATE_LIMIT_UPDATE_ME_USER=30/3600

# Verify-first registration (contract v1.2 §6)
# REGISTRATION_TTL_SECONDS=1800
# Absolute lifetime from creation; resend never extends past it (SEC-026)
# REGISTRATION_MAX_LIFETIME_SECONDS=7200
# Optional dedicated key for registration-code HMACs (>= 32 bytes; SEC-029). Unset: derived from
# RATE_LIMIT_KEY_SECRET. Changing it invalidates live pending codes (users resend).
# REGISTRATION_CODE_KEY=
# REGISTRATION_NOTICE_INTERVAL_SECONDS=3600
# Periodic deletion of expired pending registrations (seconds; 0 disables; lazy cleanup remains)
# REGISTRATION_CLEANUP_INTERVAL_SECONDS=600
# SEC-023: a source with a successful login within this window bypasses the account bucket
# LOGIN_RECENT_SUCCESS_TTL_SECONDS=2592000
# Reserved display-name terms (comma-separated; default = CONVENTIONS §6 list)
# Brand terms additionally matched anywhere inside any single word (v1.2.3)
# RESERVED_DISPLAY_NAME_BRAND_TERMS=kabso,كابسو
# RESERVED_DISPLAY_NAME_TERMS=kabso,admin,administrator,support,official,moderator,كابسو,الدعم,الإدارة
