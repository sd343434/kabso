{
  "name": "@kabso/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kabso Live backend API (NestJS + Prisma + PostgreSQL + Redis)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke:admin-server": "vitest run --config vitest.smoke.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "levels:admin": "tsx src/cli/levels-admin.ts",
    "wallet:admin": "tsx src/cli/wallet-admin.ts",
    "medals:admin": "tsx src/cli/medals-admin.ts",
    "bag:admin": "tsx src/cli/bag-admin.ts",
    "gift:admin": "tsx src/cli/gift-admin.ts",
    "banner:admin": "tsx src/cli/banner-admin.ts",
    "feature:admin": "tsx src/cli/feature-admin.ts",
    "premium:admin": "tsx src/cli/premium-admin.ts",
    "search:admin": "tsx src/cli/search-admin.ts",
    "boost:admin": "tsx src/cli/boost-admin.ts",
    "event:admin": "tsx src/cli/event-admin.ts",
    "task:admin": "tsx src/cli/task-admin.ts",
    "profile:admin": "tsx src/cli/profile-admin.ts",
    "economy:admin": "tsx src/cli/economy-admin.ts",
    "recharge:admin": "tsx src/cli/recharge-admin.ts",
    "username:admin": "tsx src/cli/username-admin.ts",
    "admin:admin": "tsx src/cli/admin-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "blurhash": "2.0.5",
    "dotenv": "^18.0.8",
    "firebase-admin": "14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "2.19.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@livekit/rtc-node": "1.1.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
