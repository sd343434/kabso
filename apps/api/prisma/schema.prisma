/// A report (§11.7). Exactly one target column is set (CHECK `reports_one_target`); one OPEN
/// report per reporter and target (partial unique indexes in the migration).
model Report {
  id                        String           @id @default(uuid(7)) @db.Uuid
  reporterId                String           @map("reporter_id") @db.Uuid
  targetType                ReportTargetType @map("target_type")
  targetPostId              String?          @map("target_post_id") @db.Uuid
  targetCommentId           String?          @map("target_comment_id") @db.Uuid
  targetUserId              String?          @map("target_user_id") @db.Uuid
  targetStoryId             String?          @map("target_story_id") @db.Uuid
  targetLiveRoomId          String?          @map("target_live_room_id") @db.Uuid
  /// CP-013: a live chat message.
  targetLiveChatMessageId   String?          @map("target_live_chat_message_id") @db.Uuid
  /// CP-021: a CP confession.
  targetCpConfessionId      String?          @map("target_cp_confession_id") @db.Uuid
  /// CP-022: a family chat message.
  targetFamilyChatMessageId String?          @map("target_family_chat_message_id") @db.Uuid
  /// v1.40-social (D155): a direct message — no foreign key: the message is deleted after 24 h and
  /// the report keeps `dm_snapshot` (cleared 30 days after the report is resolved).
  targetDmMessageId         String?          @map("target_dm_message_id") @db.Uuid
  dmSnapshot                Json?            @map("dm_snapshot")
  /// v1.104-social (D339): a group conversation — no foreign key (like a direct message); `dm_snapshot` keeps the
  /// group as it was when reported (name, members, its newest messages), cleared 30 days after resolution.
  targetDmGroupId           String?          @map("target_dm_group_id") @db.Uuid
  /// v1.47-social (D175): a profile link — no foreign key (the owner may edit it away); the report
  /// keeps `link_snapshot` ({userId, url, label}).
  targetProfileLinkId       String?          @map("target_profile_link_id") @db.Uuid
  linkSnapshot              Json?            @map("link_snapshot")
  reason                    ReportReason
  note                      String?          @db.VarChar(500)
  status                    ReportStatus     @default(OPEN)
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt                DateTime?        @map("resolved_at") @db.Timestamptz(3)
  resolvedById              String?          @map("resolved_by_id") @db.Uuid
  resolutionNote            String?          @map("resolution_note") @db.VarChar(500)
  /// v1.93-social (D296, CONVENTIONS §10.109): the staff action that resolved the report automatically (WARN, RESTRICT,
  /// SUSPEND, BAN, REMOVE_CONTENT, DELETE_CONTENT, DELETE_ACCOUNT, DISMISS); null for «تم حله» without an action (and while OPEN).
  resolutionAction          String?          @map("resolution_action") @db.VarChar(20)
  /// D193: the content was deleted with its author's account and is kept under this legal hold (the target id of a
  /// deleted row is then null; the hold carries it). Deleted with the hold (REPORT_LEGAL_HOLD_DAYS).
  legalHoldId               String?          @map("legal_hold_id") @db.Uuid
  /// v1.68-live (D273, §10.96.6): a USER report made inside a live (the context, not the target): the live's staff
  /// see it with the live's reports and are alerted.
  contextLiveRoomId         String?          @map("context_live_room_id") @db.Uuid

  reporter                User               @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetPost              Post?              @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  targetComment           Comment?           @relation(fields: [targetCommentId], references: [id], onDelete: Cascade)
  targetUser              User?              @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetStory             Story?             @relation(fields: [targetStoryId], references: [id], onDelete: Cascade)
  targetLiveRoom          LiveRoom?          @relation("ReportTargetLive", fields: [targetLiveRoomId], references: [id], onDelete: Cascade)
  contextLiveRoom         LiveRoom?          @relation("ReportContextLive", fields: [contextLiveRoomId], references: [id], onDelete: SetNull)
  targetLiveChatMessage   LiveChatMessage?   @relation(fields: [targetLiveChatMessageId], references: [id], onDelete: Cascade)
  targetCpConfession      CpConfession?      @relation(fields: [targetCpConfessionId], references: [id], onDelete: Cascade)
  targetFamilyChatMessage FamilyChatMessage? @relation(fields: [targetFamilyChatMessageId], references: [id], onDelete: Cascade)
  resolvedBy              User?              @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  legalHold               LegalHold?         @relation(fields: [legalHoldId], references: [id], onDelete: Cascade)
  /// v1.78-live (D288): the staff's STAFF_REPORT_NEW notifications pointing at this report.
  staffNotifications      Notification[]

  @@unique([reporterId, targetPostId], map: "reports_open_post_once", where: raw("status = 'OPEN'::report_status AND target_post_id IS NOT NULL"))
  @@unique([reporterId, targetCommentId], map: "reports_open_comment_once", where: raw("status = 'OPEN'::report_status AND target_comment_id IS NOT NULL"))
  @@unique([reporterId, targetUserId], map: "reports_open_user_once", where: raw("status = 'OPEN'::report_status AND target_user_id IS NOT NULL"))
  @@unique([reporterId, targetStoryId], map: "reports_open_story_once", where: raw("status = 'OPEN'::report_status AND target_story_id IS NOT NULL"))
  @@unique([reporterId, targetLiveRoomId], map: "reports_open_live_room_once", where: raw("status = 'OPEN'::report_status AND target_live_room_id IS NOT NULL"))
  @@unique([reporterId, targetLiveChatMessageId], map: "reports_open_live_chat_message_once", where: raw("status = 'OPEN'::report_status AND target_live_chat_message_id IS NOT NULL"))
  @@unique([reporterId, targetCpConfessionId], map: "reports_open_cp_confession_once", where: raw("status = 'OPEN'::report_status AND target_cp_confession_id IS NOT NULL"))
  @@unique([reporterId, targetFamilyChatMessageId], map: "reports_open_family_chat_message_once", where: raw("status = 'OPEN'::report_status AND target_family_chat_message_id IS NOT NULL"))
  @@unique([reporterId, targetDmMessageId], map: "reports_open_dm_message_once", where: raw("status = 'OPEN'::report_status AND target_dm_message_id IS NOT NULL"))
  @@unique([reporterId, targetProfileLinkId], map: "reports_open_profile_link_once", where: raw("status = 'OPEN'::report_status AND target_profile_link_id IS NOT NULL"))
  @@unique([reporterId, targetDmGroupId], map: "reports_open_dm_group_once", where: raw("status = 'OPEN'::report_status AND target_dm_group_id IS NOT NULL"))
  @@index([status, createdAt, id], map: "reports_status_created_idx")
  @@index([targetPostId], map: "reports_target_post_idx")
  @@index([targetCommentId], map: "reports_target_comment_idx")
  @@index([targetUserId], map: "reports_target_user_idx")
  @@index([targetStoryId], map: "reports_target_story_idx")
  @@index([targetLiveRoomId], map: "reports_target_live_room_idx")
  @@index([targetLiveChatMessageId], map: "reports_target_live_chat_message_idx")
  @@index([targetCpConfessionId], map: "reports_target_cp_confession_idx")
  @@index([targetFamilyChatMessageId], map: "reports_target_family_chat_message_idx")
  @@index([targetDmMessageId], map: "reports_target_dm_message_idx")
  @@index([targetDmGroupId], map: "reports_target_dm_group_idx")
  @@index([targetProfileLinkId], map: "reports_target_profile_link_idx")
  @@index([legalHoldId], map: "reports_legal_hold_idx")
  @@index([contextLiveRoomId], map: "reports_context_live_room_idx", where: raw("context_live_room_id IS NOT NULL"))
  @@index([resolvedAt(sort: Desc), id(sort: Desc)], map: "reports_resolved_idx", where: raw("status <> 'OPEN'::report_status"))
  @@map("reports")
}

model PrivacySettings {
  userId               String        @id @map("user_id") @db.Uuid
  whoCanMention        WhoCanMention @default(EVERYONE) @map("who_can_mention")
  defaultWhoCanComment WhoCanComment @default(EVERYONE) @map("default_who_can_comment")
  /// v1.25-live (CP-022, D116): others may see when this user was last active (§10.25).
  showActivityStatus   Boolean       @default(true) @map("show_activity_status")
  /// v1.40-social (D155): who may send this user direct messages (§11.13).
  whoCanMessage        WhoCanMessage @default(EVERYONE) @map("who_can_message")
  /// v1.77-social (D220, §10.74): the person card and profile leave out the lifetime cherries received for
  /// everyone but the user (and the admin panel); default shown.
  hideCherriesReceived Boolean       @default(false) @map("hide_cherries_received")
  /// v1.77-social (D220, §10.74): the same for the lifetime coins sent on gifts.
  hideCoinsSent        Boolean       @default(false) @map("hide_coins_sent")
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

/// A photo story (CP-008, CONVENTIONS §11.9): active until `expires_at` (+24 h); the author keeps
/// it in the archive until they delete it. `removed_at` is set by moderation (REMOVE_TARGET).
model Story {
  id             String    @id @default(uuid(7)) @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  mediaAssetId   String    @unique @map("media_asset_id") @db.Uuid
  text           String    @default("") @db.VarChar(200)
  viewCount      Int       @default(0) @map("view_count")
  /// `Idempotency-Key` of createStory and the SHA-256 of its body (kept 24 h, as posts).
  idempotencyKey String?   @map("idempotency_key") @db.Uuid
  requestHash    String?   @map("request_hash") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  views         StoryView[]
  mentions      StoryMention[]
  reports       Report[]
  notifications Notification[]

  @@unique([authorId, idempotencyKey], map: "stories_author_idempotency_key")
  @@index([authorId, expiresAt], map: "stories_author_active_idx", where: raw("deleted_at IS NULL AND removed_at IS NULL"))
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], map: "stories_author_created_idx")
  @@map("stories")
}

/// One row per viewer and story (never the author); `view_count` counts them.
model StoryView {
  storyId  String   @map("story_id") @db.Uuid
  viewerId String   @map("viewer_id") @db.Uuid
  seenAt   DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId], map: "story_views_pkey")
  @@index([storyId, seenAt(sort: Desc), viewerId(sort: Desc)], map: "story_views_story_seen_idx")
  @@index([viewerId], map: "story_views_viewer_id_idx")
  @@map("story_views")
}

/// A linked mention in a story's text (§11.6 rules, at most 10).
model StoryMention {
  storyId String @map("story_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId], map: "story_mentions_pkey")
  @@index([userId], map: "story_mentions_user_id_idx")
  @@map("story_mentions")
}

enum NotificationType {
  LIKE_POST
  LIKE_COMMENT
  COMMENT
  REPLY
  MENTION
  FOLLOW
  REPOST
  POST_PUBLISHED
  CONTENT_REMOVED
  LIVE_SCHEDULED_SOON
  /// v1.21-live (CP-018, D106).
  CP_REQUEST
  CP_ACCEPTED
  FAMILY_JOIN_ACCEPTED
  FAMILY_JOIN_DECLINED
  MEDAL_AWARDED
  /// v1.28-live (D146, system): the premium username ends soon / ended.
  PREMIUM_USERNAME_EXPIRING
  PREMIUM_USERNAME_EXPIRED
  /// v1.47-social (D175): someone asked to follow your private account / your request was accepted.
  FOLLOW_REQUEST
  FOLLOW_REQUEST_ACCEPTED
  /// v1.47-social (D175, system): a moderator removed your profile photo.
  AVATAR_REMOVED
  /// v1.48-social (D171): someone sent you a bag item (actor the sender).
  BAG_ITEM_RECEIVED
  /// v1.54-social (D185): a recharge agent (or employee) sold you coins (actor the seller; target the sale).
  RECHARGE_COINS_RECEIVED
  /// v1.54-social (D185): a host or agent asked you to confirm a cherry sale (actor the creator).
  RECHARGE_CHERRY_REQUEST
  /// v1.60-social (D191, system): a moderator warned you about content that breaks the rules.
  MODERATION_WARNING
  /// v1.66-social (D198, system): the personal-data export «تنزيل بياناتي» is ready (no target).
  DATA_EXPORT_READY
  /// v1.69-social (D204, system): something happened on a recharge order you take part in (target the order).
  RECHARGE_ORDER_UPDATE
  /// v1.70-social (D206, system; target the agency): the agency the person opened «افتح وكالة» is open (also an
  /// admin's reopening).
  AGENCY_OPENED
  /// v1.70-social (D206, system): 24 h before the probation's end, still fewer activated hosts than needed.
  AGENCY_PROBATION_REMINDER
  /// v1.70-social (D206, system): the probation passed (enough activated hosts).
  AGENCY_PROBATION_PASSED
  /// v1.70-social (D206, system): the agency was closed (the probation failed, or the team closed it).
  AGENCY_CLOSED
  /// v1.70-social (D206, system): the host's agency was closed; the host is free (released).
  AGENCY_HOST_RELEASED
  /// v1.72-social (D208): the team locked or restricted the account (target ACCOUNT_RESTRICTION), lifted it early,
  /// adjusted a balance (target BALANCE_ADJUSTMENT) or edited the profile (no target).
  ACCOUNT_RESTRICTED
  ACCOUNT_RESTRICTION_LIFTED
  BALANCE_ADJUSTED
  PROFILE_EDITED_BY_TEAM
  /// v1.73-social (D209, system): the caller's application «كن مضيفاً مع الإدارة» was approved (they may go live).
  HOST_APPLICATION_APPROVED
  /// v1.73-social (D209, system): the application was rejected (the reason is in `getMyHostingApplication`).
  HOST_APPLICATION_REJECTED
  /// v1.74-social (D217): the team voided a referral and took back its credited cherries (system, no target).
  REFERRAL_REWARD_REVERSED
  /// v1.76-social (D218): a moderator removed the profile cover (system).
  COVER_REMOVED
  /// v1.80-kyc (D227, system, no target): the identity check «تأكيد الهوية» was approved / declined / sent to a
  /// manual review by Didit (or the team in Didit's console).
  KYC_APPROVED
  KYC_DECLINED
  KYC_IN_REVIEW
  /// v1.60-live (D250, system; target LIVE_MODERATION): the team acted on the person's live from the panel — ended
  /// it, possibly with a ban from going live / a suspension / a device ban — with the reason «السبب».
  LIVE_MODERATED
  /// v1.68-live (D273): a report on a live the staff member is responsible for (or, nobody on it, the actors / OWNERs).
  LIVE_STAFF_REPORT
  /// v1.78-live (D288, §10.101): a new report in the shared queue — to every MODERATION / SUPPORT account (one unread
  /// row per staff member, moved to the newest report).
  STAFF_REPORT_NEW
  /// v1.89-social (D290, system; target LEVEL_RAISE): the OWNER approved / rejected a level-raise request — to the
  /// staff member who made it; LEVEL_RAISED to the supporter (approval only).
  LEVEL_RAISE_APPROVED
  LEVEL_RAISE_REJECTED
  LEVEL_RAISED
  /// v1.95-social (D301, §10.112.5, system; target OWNER_FEEDBACK): a new item in «صندوق المؤسس» — to the owners only.
  OWNER_FEEDBACK_NEW
  /// v1.95-social (D301 follow-up, §10.112.7, system; target POST): the app owner published an official announcement —
  /// to every ACTIVE account (staff too), written by a background fan-out, once per announcement.
  OWNER_ANNOUNCEMENT
  /// v1.97-social (D303, system; target EVENT): the person won a prize of an event board (paid automatically).
  EVENT_PRIZE_WON
  /// v1.101-social (D325, system; target EVENT): an event for the person's audience started (once per person and event).
  EVENT_STARTED

  @@map("notification_type")
}

/// An in-app notification (CP-009, CONVENTIONS §11.10). At most one of post / comment / story is
/// the target (a FOLLOW targets its actor); a COMMENT target also sets `post_id`. `group_key` is
/// set on unread likes and reposts so new actors join the same row; `updated_at` is the latest
/// activity (the list order and the 30-day retention).
model Notification {
  id                 String           @id @default(uuid(7)) @db.Uuid
  recipientId        String           @map("recipient_id") @db.Uuid
  type               NotificationType
  postId             String?          @map("post_id") @db.Uuid
  commentId          String?          @map("comment_id") @db.Uuid
  storyId            String?          @map("story_id") @db.Uuid
  /// CP-016 C: the scheduled live a `LIVE_SCHEDULED_SOON` reminds of (deleted with it).
  liveScheduleId     String?          @map("live_schedule_id") @db.Uuid
  /// CP-018: the family of FAMILY_JOIN_ACCEPTED / FAMILY_JOIN_DECLINED.
  familyId           String?          @map("family_id") @db.Uuid
  /// CP-018: the medal of MEDAL_AWARDED.
  medalCode          String?          @map("medal_code") @db.VarChar(40)
  /// v1.81-live (D291): the level MEDAL_AWARDED announces (1 = earned; more = a level-up); null on older rows.
  medalLevel         Int?             @map("medal_level") @db.SmallInt
  /// D146: the premium username lease of PREMIUM_USERNAME_EXPIRING / _EXPIRED.
  premiumLeaseId     String?          @map("premium_lease_id") @db.Uuid
  /// v1.48-social (D171): the bag item of BAG_ITEM_RECEIVED.
  bagItemCode        String?          @map("bag_item_code") @db.VarChar(40)
  /// v1.54-social (D185): the sale of RECHARGE_COINS_RECEIVED.
  rechargeSaleId     String?          @map("recharge_sale_id") @db.Uuid
  /// v1.69-social (D204): the order of RECHARGE_ORDER_UPDATE and the latest event on it.
  rechargeOrderId    String?          @map("recharge_order_id") @db.Uuid
  rechargeOrderEvent String?          @map("recharge_order_event") @db.VarChar(24)
  /// v1.70-social (D206): the agency of AGENCY_* notifications, with the activated hosts reached and the hosts
  /// needed at the time (the probation's numbers; NULL for the other types).
  agencyId           String?          @map("agency_id") @db.Uuid
  agencyActivated    Int?             @map("agency_activated")
  agencyRequired     Int?             @map("agency_required")
  groupKey           String?          @map("group_key") @db.VarChar(80)
  readAt             DateTime?        @map("read_at") @db.Timestamptz(3)
  /// v1.30-live (D152): the `updated_at` the push dispatcher last handled (pushed or skipped);
  /// NULL or older than `updated_at` = waiting (an outbox, `notifications_push_pending_idx`).
  pushedAt           DateTime?        @map("pushed_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  /// v1.72-social (D208): ACCOUNT_RESTRICTED / ACCOUNT_RESTRICTION_LIFTED and BALANCE_ADJUSTED.
  accountRestrictionId String?                 @map("account_restriction_id") @db.Uuid
  balanceAdjustmentId  String?                 @map("balance_adjustment_id") @db.Uuid
  accountRestriction   AccountRestriction?     @relation(fields: [accountRestrictionId], references: [id], onDelete: Cascade)
  balanceAdjustment    AdminBalanceAdjustment? @relation(fields: [balanceAdjustmentId], references: [id], onDelete: Cascade)
  /// v1.60-live (D250): LIVE_MODERATED.
  liveModerationId     String?                 @map("live_moderation_id") @db.Uuid
  liveModeration       LiveModerationAction?   @relation(fields: [liveModerationId], references: [id], onDelete: Cascade)
  /// v1.68-live (D273): LIVE_STAFF_REPORT — the live a staff member is alerted about (one unread row per live).
  liveRoomId           String?                 @map("live_room_id") @db.Uuid
  liveRoom             LiveRoom?               @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  /// v1.78-live (D288, §10.101): STAFF_REPORT_NEW — the newest report the row stands for (deleted with it).
  reportId             String?                 @map("report_id") @db.Uuid
  report               Report?                 @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// v1.89-social (D290): LEVEL_RAISE_APPROVED / LEVEL_RAISE_REJECTED / LEVEL_RAISED.
  levelRaiseRequestId  String?                 @map("level_raise_request_id") @db.Uuid
  levelRaiseRequest    LevelRaiseRequest?      @relation(fields: [levelRaiseRequestId], references: [id], onDelete: Cascade)
  /// v1.95-social (D301): OWNER_FEEDBACK_NEW — the new inbox item.
  ownerFeedbackId      String?                 @map("owner_feedback_id") @db.Uuid
  ownerFeedback        OwnerFeedback?          @relation(fields: [ownerFeedbackId], references: [id], onDelete: Cascade)
  /// v1.97-social (D303): EVENT_PRIZE_WON — the event (deleted with it).
  eventId              String?                 @map("event_id") @db.Uuid
  event                Event?                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  recipient     User                  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  post          Post?                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment       Comment?              @relation(fields: [commentId], references: [id], onDelete: Cascade)
  story         Story?                @relation(fields: [storyId], references: [id], onDelete: Cascade)
  liveSchedule  LiveScheduleSlot?     @relation(fields: [liveScheduleId], references: [id], onDelete: Cascade)
  family        Family?               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  medal         Medal?                @relation(fields: [medalCode], references: [code], onDelete: Cascade)
  premiumLease  PremiumUsernameLease? @relation(fields: [premiumLeaseId], references: [id], onDelete: Cascade)
  bagItem       BagItem?              @relation(fields: [bagItemCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  rechargeSale  RechargeSale?         @relation(fields: [rechargeSaleId], references: [id], onDelete: Cascade)
  rechargeOrder RechargeOrder?        @relation(fields: [rechargeOrderId], references: [id], onDelete: Cascade)
  agency        Agency?               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actors        NotificationActor[]

  /// D301 follow-up: one OWNER_ANNOUNCEMENT per person and announcement (the fan-out is idempotent).
  @@unique([recipientId, postId], map: "notifications_owner_announcement_once", where: raw("type = 'OWNER_ANNOUNCEMENT'::notification_type"))
  @@unique([recipientId, eventId], map: "notifications_event_started_once", where: raw("type = 'EVENT_STARTED'::notification_type"))
  @@index([recipientId, updatedAt(sort: Desc), id(sort: Desc)], map: "notifications_recipient_updated_idx")
  @@index([agencyId], map: "notifications_agency_idx", where: raw("agency_id IS NOT NULL"))
  @@index([liveModerationId], map: "notifications_live_moderation_idx", where: raw("live_moderation_id IS NOT NULL"))
  @@index([liveRoomId], map: "notifications_live_room_idx", where: raw("live_room_id IS NOT NULL"))
  @@index([reportId], map: "notifications_report_idx", where: raw("report_id IS NOT NULL"))
  @@index([levelRaiseRequestId], map: "notifications_level_raise_idx", where: raw("level_raise_request_id IS NOT NULL"))
  @@index([ownerFeedbackId], map: "notifications_owner_feedback_idx", where: raw("owner_feedback_id IS NOT NULL"))
  @@index([eventId], map: "notifications_event_idx", where: raw("event_id IS NOT NULL"))
  @@index([recipientId, groupKey], map: "notifications_unread_group_idx", where: raw("read_at IS NULL AND group_key IS NOT NULL"))
  @@index([recipientId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@index([premiumLeaseId], map: "notifications_premium_lease_idx", where: raw("premium_lease_id IS NOT NULL"))
  @@index([updatedAt], map: "notifications_updated_idx")
  @@index([updatedAt], map: "notifications_push_pending_idx", where: raw("pushed_at IS NULL OR pushed_at < updated_at"))
  @@index([postId], map: "notifications_post_id_idx")
  @@index([commentId], map: "notifications_comment_id_idx")
  @@index([storyId], map: "notifications_story_id_idx")
  @@index([liveScheduleId], map: "notifications_live_schedule_id_idx")
  @@index([familyId], map: "notifications_family_id_idx")
  @@index([medalCode], map: "notifications_medal_code_idx")
  @@index([rechargeSaleId], map: "notifications_recharge_sale_idx", where: raw("recharge_sale_id IS NOT NULL"))
  @@index([recipientId, rechargeOrderId], map: "notifications_recharge_order_idx", where: raw("recharge_order_id IS NOT NULL"))
  @@map("notifications")
}

/// Who caused a notification (one row per actor; grouped likes and reposts have several).
model NotificationActor {
  notificationId String   @map("notification_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([notificationId, actorId], map: "notification_actors_pkey")
  @@index([actorId], map: "notification_actors_actor_id_idx")
  @@map("notification_actors")
}

/// Per-type in-app notification switches (CP-009); no row = all on.
model NotificationSettings {
  userId     String   @id @map("user_id") @db.Uuid
  likes      Boolean  @default(true)
  comments   Boolean  @default(true)
  mentions   Boolean  @default(true)
  follows    Boolean  @default(true)
  reposts    Boolean  @default(true)
  /// CP-016 C: reminders of lives scheduled by hosts you follow.
  lives      Boolean  @default(true)
  /// v1.30-live (D152): pushes of new family chat messages.
  messages   Boolean  @default(true)
  /// v1.85-live (D305): the gifts strip «شريط الهدايا» shows in the lives this person watches or hosts.
  giftStrip  Boolean  @default(true) @map("gift_strip")
  /// v1.85-live (D305): the games strip «شريط الألعاب» shows in the lives this person watches or hosts.
  gameStrip  Boolean  @default(true) @map("game_strip")
  /// v1.111-live (D347): the global lucky banner «شريط المردود» (another live's ×250 / ×500 / ×1000 win) shows in the
  /// lives this person watches or hosts; false = «إخفاء أشرطة الفوز».
  luckyStrip Boolean  @default(true) @map("lucky_strip")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// v1.30-live (D152, CONVENTIONS §11.12).
enum PushPlatform {
  ANDROID
  IOS

  @@map("push_platform")
}

/// v1.30-live (D152): a session's Firebase Cloud Messaging token (one per session; a token is
/// unique). Deleted with the session, on logout or revocation, when Firebase reports it invalid,
/// and by the notifications sweeper after the session ended or 60 days unseen. Never logged.
model DeviceToken {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  sessionId  String       @map("session_id") @db.Uuid
  token      String       @db.VarChar(1024)
  platform   PushPlatform
  appVersion String       @map("app_version") @db.VarChar(32)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([token], map: "device_tokens_token_key")
  @@unique([sessionId], map: "device_tokens_session_id_key")
  @@index([userId], map: "device_tokens_user_id_idx")
  @@index([lastSeenAt], map: "device_tokens_last_seen_at_idx")
  @@map("device_tokens")
}

// ---- v1.21-live (DRAFT, CP-018, D106): families, CP couples and medals ------------------------

enum FamilyRole {
  LEADER
  DEPUTY
  MEMBER

  @@map("family_role")
}

/// A family join request or a CP request. PENDING until accepted, declined, cancelled or expired.
enum BondRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("bond_request_status")
}

/// CP-018 (D106): a family (العائلة). `number` is its public 8-digit number; `name_key` the
/// case-folded name, unique among families that are not disbanded; `points` the coins its members
/// spent while in it (`family_points_ledger`) and `level` the ladder level for them. A disbanded
/// family keeps its row (`disbanded_at`) so a create retry is never charged twice. CHECKs in
/// migration 20261110100000_families_cp_medals.
model Family {
  id             String    @id @default(uuid(7)) @db.Uuid
  number         Int       @default(dbgenerated("(10000000 + floor((random() * (90000000)::double precision)))::integer"))
  name           String    @db.VarChar(40)
  nameKey        String    @map("name_key") @db.VarChar(80)
  emblemMediaId  String?   @unique @map("emblem_media_id") @db.Uuid
  emblemUrl      String?   @map("emblem_url") @db.VarChar(512)
  /// v1.25-live (CP-022, D116): the cover picture (a `FAMILY_COVER` upload) and a short tagline.
  coverMediaId   String?   @unique @map("cover_media_id") @db.Uuid
  coverUrl       String?   @map("cover_url") @db.VarChar(512)
  tagline        String?   @db.VarChar(60)
  points         BigInt    @default(0)
  level          Int       @default(1)
  memberCount    Int       @default(0) @map("member_count")
  createdById    String?   @map("created_by_id") @db.Uuid
  createClientId String    @map("create_client_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  disbandedAt    DateTime? @map("disbanded_at") @db.Timestamptz(3)

  createdBy     User?               @relation("FamilyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  emblem        MediaAsset?         @relation(fields: [emblemMediaId], references: [id], onDelete: SetNull)
  cover         MediaAsset?         @relation("FamilyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  members       FamilyMember[]
  joinRequests  FamilyJoinRequest[]
  pointsEntries FamilyPointsEntry[]
  notifications Notification[]
  chatMessages  FamilyChatMessage[]
  chatMutes     FamilyChatMute[]

  @@unique([number], map: "families_number_key")
  @@unique([createdById, createClientId], map: "families_create_once")
  @@unique([nameKey], map: "families_name_key_active", where: raw("disbanded_at IS NULL"))
  @@index([points(sort: Desc), id(sort: Desc)], map: "families_points_idx", where: raw("disbanded_at IS NULL"))
  @@map("families")
}

/// A user's family (at most one: the primary key) and role; one LEADER per family.
model FamilyMember {
  userId   String     @id @map("user_id") @db.Uuid
  familyId String     @map("family_id") @db.Uuid
  role     FamilyRole @default(MEMBER)
  /// Family points this member gave while in the family.
  points   BigInt     @default(0)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId], map: "family_members_one_leader", where: raw("role = 'LEADER'::family_role"))
  @@index([familyId, joinedAt], map: "family_members_family_idx")
  @@map("family_members")
}

/// A request to join a family; at most one PENDING per user; expires 7 days after it was made.
model FamilyJoinRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  familyId    String            @map("family_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      BondRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  handledAt   DateTime?         @map("handled_at") @db.Timestamptz(3)
  handledById String?           @map("handled_by_id") @db.Uuid

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User   @relation("FamilyJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User?  @relation("FamilyJoinHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([userId], map: "family_join_requests_one_pending", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([familyId, createdAt], map: "family_join_requests_family_idx")
  @@index([userId], map: "family_join_requests_user_idx")
  @@index([expiresAt], map: "family_join_requests_expiry_idx", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([handledById], map: "family_join_requests_handled_by_idx")
  @@map("family_join_requests")
}

/// Family points: one row per wallet debit of a member that counted for the family (unique
/// `wallet_ledger_id`, so a spend never counts twice). Append-only for the runtime role.
model FamilyPointsEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  walletLedgerId String   @unique @map("wallet_ledger_id") @db.Uuid
  points         BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntry WalletLedgerEntry @relation(fields: [walletLedgerId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt], map: "family_points_ledger_family_idx")
  @@index([userId], map: "family_points_ledger_user_idx")
  /// v1.25-live: the monthly family ranking sums a window across families.
  @@index([createdAt, familyId], map: "family_points_ledger_created_idx")
  @@map("family_points_ledger")
}

/// v1.25-live (CP-022, D116): a message in a family's chat (members only). `client_id` is unique
/// per author (an idempotent retry). Soft-deleted by its author, the leader, a deputy or moderation.
model FamilyChatMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  text        String    @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    User     @relation("FamilyChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User?    @relation("FamilyChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([authorId, clientId], map: "family_chat_messages_client_once")
  @@index([familyId, createdAt, id], map: "family_chat_messages_family_idx")
  @@index([deletedById], map: "family_chat_messages_deleted_by_idx")
  @@map("family_chat_messages")
}

/// v1.25-live (CP-022, D116): a member the leader or a deputy muted in the family chat.
model FamilyChatMute {
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mutedById String?  @map("muted_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user    User   @relation("FamilyChatMuted", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User?  @relation("FamilyChatMutedBy", fields: [mutedById], references: [id], onDelete: SetNull)

  @@id([familyId, userId])
  @@index([userId], map: "family_chat_mutes_user_idx")
  @@index([mutedById], map: "family_chat_mutes_muted_by_idx")
  @@map("family_chat_mutes")
}

/// A CP request (العلاقة): `cost` coins taken at send (ledger CP_REQUEST, reference = id) and
/// given back when it is declined, cancelled or expires (CP_REFUND, same reference). One PENDING
/// outgoing request per sender; `client_id` is unique per sender (an idempotent retry).
model CpRequest {
  id         String            @id @default(uuid(7)) @db.Uuid
  senderId   String            @map("sender_id") @db.Uuid
  receiverId String            @map("receiver_id") @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  cost       Int
  status     BondRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  handledAt  DateTime?         @map("handled_at") @db.Timestamptz(3)

  sender   User      @relation("CpRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("CpRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  couple   CpCouple?

  @@unique([senderId, clientId], map: "cp_requests_client_once")
  @@unique([senderId], map: "cp_requests_one_outgoing", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([receiverId, createdAt], map: "cp_requests_receiver_idx")
  @@index([expiresAt], map: "cp_requests_expiry_idx", where: raw("status = 'PENDING'::bond_request_status"))
  @@map("cp_requests")
}

/// A CP couple. `user_a_id` < `user_b_id`; `points` the CP gifts' coins; `level` the CP tier.
/// Ended couples keep their row (`ended_at`); the partners are in `cp_partners` while it lasts.
model CpCouple {
  id        String    @id @default(uuid(7)) @db.Uuid
  userAId   String    @map("user_a_id") @db.Uuid
  userBId   String    @map("user_b_id") @db.Uuid
  requestId String?   @unique @map("request_id") @db.Uuid
  since     DateTime  @default(now()) @db.Timestamptz(3)
  points    BigInt    @default(0)
  level     Int       @default(1)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById String?   @map("ended_by_id") @db.Uuid

  userA        User            @relation("CpCoupleA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User            @relation("CpCoupleB", fields: [userBId], references: [id], onDelete: Cascade)
  endedBy      User?           @relation("CpCoupleEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  request      CpRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  partners     CpPartner[]
  gifts        CpGift[]
  pointsLedger CpPointsEntry[]
  checkIns     CpCheckIn[]
  taskClaims   CpTaskClaim[]
  confessions  CpConfession[]

  @@index([userAId], map: "cp_couples_user_a_idx")
  @@index([userBId], map: "cp_couples_user_b_idx")
  @@index([endedById], map: "cp_couples_ended_by_idx")
  @@map("cp_couples")
}

/// A user's current CP partner (one row per partner while the couple lasts; the primary key keeps
/// one partner per user).
model CpPartner {
  userId    String @id @map("user_id") @db.Uuid
  coupleId  String @map("couple_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid

  user    User     @relation("CpPartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  partner User     @relation("CpPartnerOther", fields: [partnerId], references: [id], onDelete: Cascade)
  couple  CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId], map: "cp_partners_couple_idx")
  @@index([partnerId], map: "cp_partners_partner_idx")
  @@map("cp_partners")
}

/// A CP gift: coins spent on one's partner (ledger CP_GIFT, reference = id); adds `amount` CP
/// points to the couple. `client_id` is unique per sender.
model CpGift {
  id         String   @id @default(uuid(7)) @db.Uuid
  coupleId   String   @map("couple_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  amount     Int
  clientId   String   @map("client_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple   CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  sender   User     @relation("CpGiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("CpGiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId], map: "cp_gifts_client_once")
  @@index([coupleId, createdAt], map: "cp_gifts_couple_idx")
  @@index([receiverId], map: "cp_gifts_receiver_idx")
  @@map("cp_gifts")
}

/// CP-021 (D112): why a couple's CP points grew.
enum CpPointsSource {
  /// A CP gift (reference = `cp_gifts.id`).
  GIFT
  /// A claimed daily CP task (reference = `cp_task_claims.id`).
  TASK

  @@map("cp_points_source")
}

/// CP-021 (D112): every CP points gain of a couple, written in the same transaction as the gain
/// (append-only for the runtime role). The couples ranking sums it per window; `cp_couples.points`
/// stays the running total. One row per source and reference.
model CpPointsEntry {
  id          String         @id @default(uuid(7)) @db.Uuid
  coupleId    String         @map("couple_id") @db.Uuid
  source      CpPointsSource
  referenceId String         @map("reference_id") @db.Uuid
  points      Int
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  couple CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([source, referenceId], map: "cp_points_ledger_reference_once")
  @@index([createdAt, coupleId], map: "cp_points_ledger_created_idx")
  @@index([coupleId, createdAt], map: "cp_points_ledger_couple_idx")
  @@map("cp_points_ledger")
}

/// CP-021 (D112): a partner checked in on the CP space that day (the CP day, §10.24).
model CpCheckIn {
  coupleId  String   @map("couple_id") @db.Uuid
  day       DateTime @db.Date
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([coupleId, day, userId], map: "cp_check_ins_pkey")
  @@index([userId], map: "cp_check_ins_user_idx")
  @@map("cp_check_ins")
}

/// CP-021 (D112): a daily CP task's reward, claimed once per couple, day and task.
model CpTaskClaim {
  id          String   @id @default(uuid(7)) @db.Uuid
  coupleId    String   @map("couple_id") @db.Uuid
  day         DateTime @db.Date
  taskCode    String   @map("task_code") @db.VarChar(40)
  points      Int
  claimedById String   @map("claimed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple    CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  claimedBy User     @relation(fields: [claimedById], references: [id], onDelete: Cascade)

  @@unique([coupleId, day, taskCode], map: "cp_task_claims_once")
  @@index([claimedById], map: "cp_task_claims_claimed_by_idx")
  @@map("cp_task_claims")
}

/// CP-021 (D112): a confession one partner leaves for the other on the couple's page. `text` is
/// 1–200 code points after the chat text rules (both partners' blocked words masked);
/// `client_id` is unique per author (an idempotent retry). Soft-deleted by either partner or an
/// admin report action.
model CpConfession {
  id          String    @id @default(uuid(7)) @db.Uuid
  coupleId    String    @map("couple_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  text        String    @db.VarChar(200)
  clientId    String    @map("client_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  couple    CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author    User     @relation("CpConfessionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User     @relation("CpConfessionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  deletedBy User?    @relation("CpConfessionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([authorId, clientId], map: "cp_confessions_client_once")
  @@index([coupleId, createdAt], map: "cp_confessions_couple_idx")
  @@index([recipientId], map: "cp_confessions_recipient_idx")
  @@index([deletedById], map: "cp_confessions_deleted_by_idx")
  @@map("cp_confessions")
}

/// v1.81-live (D291, CONVENTIONS §10.104): the medals page's tabs «الإنجازات» / «النشاط».
enum MedalCategory {
  ACHIEVEMENT
  ACTIVITY
}

/// v1.81-live (D291, §10.104): what a medal's levels count — the number the thresholds of `medal_levels` compare with.
enum MedalMetric {
  /// Ended lives hosted.
  LIVES_HOSTED
  /// Hours of all ended lives hosted (`ended_at − started_at`).
  LIVE_HOURS
  /// The charm (CP-005 `ATTRACTIVENESS`) level reached.
  CHARM_LEVEL
  /// 1 once the user created or joined a family (one level only).
  FAMILY_JOINED
  /// 1 once the user formed a couple (one level only).
  CP_FORMED
  /// Bullet messages sent.
  BULLETS_SENT
  /// D291 (owner «ملوك الثروة»): the coin value of every gift sent to anyone — live (host, seat guests), direct
  /// conversation, CP — lucky gifts excluded (kept in `medal_metric_totals`, added in each send's transaction).
  GIFTS_SENT_COINS
  /// D291 (owner «سيد الحظ»: «يتم احتساب من مجموع هدايا الحظ التي قام بإرسالها»): the coin value of the LUCKY gifts sent
  /// (any path, any recipient; never the winnings), in `medal_metric_totals`, added in each send's transaction.
  LUCKY_GIFTS_SENT_COINS
  /// D300 (§10.111): a multi-requirement medal («مدرسة المحتوى») — its value is the highest level whose every
  /// `medal_level_requirements` row is met; each level's `threshold` is the level number.
  ALL_REQUIREMENTS
  /// D300: a content creator's (`creator_members`) followers now — ACTIVE accounts, as the profile counts them.
  CREATOR_FOLLOWERS
  /// D300: likes from other ACTIVE accounts on the creator's posts and reels, all-time — deleted or removed ones too
  /// (owner); never self.
  CREATOR_LIKES
  /// D300: §11.4 views from other ACTIVE accounts of the creator's posts and reels, all-time — deleted or removed ones
  /// too (owner); `post_views.counted_views`.
  CREATOR_VIEWS
  /// D300 («لاعب الأحكام», owner: «PK أحكام» only): a host's PK points from DARES matches now
  /// (`pk_host_records.dares_points`; may fall, levels never do). Renamed from PK_POINTS (20270401090300).
  PK_DARES_POINTS
}

/// D291: a running total of a medal metric that is not cheap to recount on every event (GIFTS_SENT_COINS), added to in
/// the event's own transaction (once per send) and recomputed from history by `medals-admin backfill`.
model MedalMetricTotal {
  userId    String      @map("user_id") @db.Uuid
  metric    MedalMetric
  value     BigInt      @default(0)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, metric], map: "medal_metric_totals_pkey")
  @@map("medal_metric_totals")
}

/// The medal catalogue (الميداليات), seeded by migration 20261110100000_families_cp_medals.
model Medal {
  code          String        @id @db.VarChar(40)
  nameAr        String        @map("name_ar") @db.VarChar(60)
  nameEn        String        @map("name_en") @db.VarChar(60)
  descriptionAr String        @map("description_ar") @db.VarChar(200)
  descriptionEn String        @map("description_en") @db.VarChar(200)
  iconKey       String        @map("icon_key") @db.VarChar(60)
  sortOrder     Int           @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// v1.81-live (D291): the medals page's tab.
  category      MedalCategory @default(ACHIEVEMENT)
  /// v1.81-live (D291): what the levels count; null = a medal without levels (awarded by code at level 1 only).
  metric        MedalMetric?
  /// D291 (owner: «هذه بالأصل ليست ميدالية يمكن ارتداؤها، فقط تكون أيقونة بجانب الاسم»): not a wearable medal any
  /// more — left out of the medals page, the showcase, the lists and the chat line, never awarded again; the rows of
  /// `user_medals` are kept as history.
  retired       Boolean       @default(false)

  awards        UserMedal[]
  notifications Notification[]
  levels        MedalLevel[]

  @@map("medals")
}

/// v1.81-live (D291, §10.104): a medal's level — reached when the medal's metric is at least `threshold`. Level 1 is
/// the medal's original award rule; the panel edits the list (thresholds strictly rising).
model MedalLevel {
  medalCode String   @map("medal_code") @db.VarChar(40)
  level     Int      @db.SmallInt
  threshold BigInt
  /// Optional names for this level (null = the medal's name; the app adds the numeral).
  nameAr    String?  @map("name_ar") @db.VarChar(60)
  nameEn    String?  @map("name_en") @db.VarChar(60)
  /// Optional hosted art for this level (https); null = the medal's art.
  iconUrl   String?  @map("icon_url") @db.VarChar(500)
  /// D291: optional art bundled in the app for this level (its asset key, e.g. `medal_wealth_l1`); the app falls
  /// back to the medal's art for a key it does not have. `iconUrl` wins when both are set.
  iconAsset String?  @map("icon_asset") @db.VarChar(60)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  medal        Medal                   @relation(fields: [medalCode], references: [code], onDelete: Cascade)
  /// D300 (§10.111): the several thresholds of this level (a medal on `ALL_REQUIREMENTS`); none for the others.
  requirements MedalLevelRequirement[]

  @@id([medalCode, level], map: "medal_levels_pkey")
  @@map("medal_levels")
}

/// D300 (owner 2026-11-07 «مدرسة المحتوى», CONVENTIONS §10.111): one of the thresholds a level of a multi-requirement
/// medal (metric `ALL_REQUIREMENTS`) needs — the level is reached when EVERY row of it is met. CHECKs: threshold
/// 1 … 10^12, `metric` never `ALL_REQUIREMENTS`.
model MedalLevelRequirement {
  medalCode String      @map("medal_code") @db.VarChar(40)
  level     Int         @db.SmallInt
  metric    MedalMetric
  threshold BigInt
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  medalLevel MedalLevel @relation(fields: [medalCode, level], references: [medalCode, level], onDelete: Cascade, onUpdate: Cascade, map: "medal_level_requirements_level_fkey")

  @@id([medalCode, level, metric], map: "medal_level_requirements_pkey")
  @@map("medal_level_requirements")
}

/// A medal a user earned (once per user and medal).
model UserMedal {
  userId           String   @map("user_id") @db.Uuid
  medalCode        String   @map("medal_code") @db.VarChar(40)
  awardedAt        DateTime @default(now()) @map("awarded_at") @db.Timestamptz(3)
  /// Owner D106 amendment: 1 … 6 when shown on the profile (in this order), else null.
  showcasePosition Int?     @map("showcase_position") @db.SmallInt
  /// v1.81-live (D291): the level reached (1 = the original award); never goes down.
  level            Int      @default(1) @db.SmallInt
  /// v1.81-live (D291): when `level` was reached (the award time for level 1).
  levelReachedAt   DateTime @default(now()) @map("level_reached_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal Medal @relation(fields: [medalCode], references: [code], onDelete: Cascade)

  @@id([userId, medalCode], map: "user_medals_pkey")
  @@unique([userId, showcasePosition], map: "user_medals_showcase_position_key", where: raw("showcase_position IS NOT NULL"))
  @@index([userId, awardedAt(sort: Desc)], map: "user_medals_user_awarded_idx")
  @@index([medalCode], map: "user_medals_medal_idx")
  @@map("user_medals")
}

// ---- v1.22-live (CP-019, D107): the bag (الحقيبة) ---------------------------------------------

/// A bag category. PROFILE_CARD: the decoration on the profile card's header. AVATAR_FRAME
/// (v1.46-levels, D169): the frame around the user's photo. More come later.
enum BagCategory {
  PROFILE_CARD
  AVATAR_FRAME
  /// D270 (§10.98): kinds the store sells that were VIP-only (D264); MIC_WAVE stays VIP-only (not stored).
  CHAT_BUBBLE
  ENTRY_BANNER
  ENTRY_EFFECT

  @@map("bag_category")
}

/// How a user got a bag item.
enum BagItemSource {
  /// Free item given when the account was created.
  FREE_SIGNUP
  /// Free item given to accounts that existed before the feature (migration 20261111090000_bag).
  BACKFILL
  /// Granted by an admin (`bag-admin grant`).
  ADMIN
  /// Given by the server when a level is reached (v1.46-levels, D169: the support tier frames).
  LEVEL_REWARD
  /// v1.48-social (D171): sent by another user (`gifted_by_user_id`).
  GIFT
  /// v1.55-social (D186): the active-host frame, kept while the user is an active agency host (never sent).
  HOST_ACTIVE
  /// D270 (§10.98): bought in the store for oneself (a store gift is a GIFT with its giver).
  STORE
  /// v1.97-social (D303, §10.114): an event prize (reference: the `event_prize_payouts` row).
  EVENT

  @@map("bag_item_source")
}

/// The bag catalogue, seeded by migration 20261111090000_bag (bag.catalogue.ts keeps the same list).
model BagItem {
  code      String      @id @db.VarChar(40)
  category  BagCategory
  nameAr    String      @map("name_ar") @db.VarChar(60)
  nameEn    String      @map("name_en") @db.VarChar(60)
  /// The app's asset for the item (e.g. `header_emerald_wings`).
  assetKey  String      @map("asset_key") @db.VarChar(60)
  sortOrder Int         @map("sort_order")
  /// Every new account receives it (and wears it, the first per category).
  free      Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  owners        UserBagItem[]
  notifications Notification[]
  /// D270 (§10.98): the store row of a store item (its art, prices, order).
  storeItem     StoreItem?

  @@unique([code, category], map: "bag_items_code_category_key")
  @@index([category, sortOrder], map: "bag_items_category_sort_idx")
  @@map("bag_items")
}

/// An item a user owns; at most one equipped per user and category.
model UserBagItem {
  userId     String        @map("user_id") @db.Uuid
  itemCode   String        @map("item_code") @db.VarChar(40)
  /// Copied from the catalogue (composite FK) so one equipped item per category is an index.
  category   BagCategory
  source     BagItemSource
  acquiredAt DateTime      @default(now()) @map("acquired_at") @db.Timestamptz(3)
  equipped   Boolean       @default(false)
  /// v1.48-social (D171): when the item leaves the bag; NULL = permanent. Past = gone (never read;
  /// the sweeper deletes the row).
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz(3)
  /// v1.48-social (D171): who sent it (source GIFT; the latest giver when time was added).
  giftedById String?       @map("gifted_by_user_id") @db.Uuid

  user     User    @relation("BagItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  item     BagItem @relation(fields: [itemCode, category], references: [code, category], onDelete: Cascade, onUpdate: Cascade)
  giftedBy User?   @relation("BagItemGiftedBy", fields: [giftedById], references: [id], onDelete: SetNull)

  @@id([userId, itemCode], map: "user_bag_items_pkey")
  @@unique([userId, category], map: "user_bag_items_equipped_key", where: raw("equipped"))
  @@index([itemCode, category], map: "user_bag_items_item_idx")
  @@index([expiresAt], map: "user_bag_items_expires_idx", where: raw("(expires_at IS NOT NULL)"))
  @@index([giftedById], map: "user_bag_items_gifted_by_idx")
  @@index([userId], map: "user_bag_items_host_active_idx", where: raw("(source = 'HOST_ACTIVE'::bag_item_source)"))
  @@map("user_bag_items")
}

/// v1.55-social (D186): the style of the active-host frame.
enum HostFrameStyle {
  BLUE
  PINK

  @@map("host_frame_style")
}

/// v1.55-social (D186, CONVENTIONS §10.49): the frame style a host without a stated gender (none, or
/// UNDISCLOSED) chose. Ignored while the gender is MALE (blue) or FEMALE (pink).
model HostFrameChoice {
  userId    String         @id @map("user_id") @db.Uuid
  style     HostFrameStyle
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("host_frame_choices")
}

/// v1.48-social (D171): the ledger of bag items sent between users (whole or part of the time). Kept
/// when an account is gone (the user columns become NULL); no foreign key to the catalogue.
model BagTransfer {
  id                 String      @id @default(uuid(7)) @db.Uuid
  senderId           String?     @map("sender_id") @db.Uuid
  recipientId        String?     @map("recipient_id") @db.Uuid
  itemCode           String      @map("item_code") @db.VarChar(40)
  category           BagCategory
  /// The whole item left the sender's bag.
  whole              Boolean
  /// The time sent; NULL = a permanent item (sent whole).
  durationMs         BigInt?     @map("duration_ms")
  /// The sender's expiry after the send (partial sends only).
  senderExpiresAt    DateTime?   @map("sender_expires_at") @db.Timestamptz(3)
  /// The recipient's expiry after the send (NULL = permanent).
  recipientExpiresAt DateTime?   @map("recipient_expires_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  sender    User? @relation("BagTransferSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User? @relation("BagTransferRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId, createdAt], map: "bag_transfers_sender_idx")
  @@index([recipientId, createdAt], map: "bag_transfers_recipient_idx")
  @@map("bag_transfers")
}

// ---- v1.23-live (CP-020, D108): live gifts (CONVENTIONS §10.23) --------------------------------

/// v1.46-live (D207, CONVENTIONS §10.66): what a gift category does besides being a tab. NORMAL: a plain tab
/// (any number, managed in the panel); LUCKY (§10.27, listed only while LUCKY_GIFTS_ENABLED) and QUIPS (§10.33) keep
/// their special behaviour — at most one category of each (`gift_categories_special_kind_key`), its code equal to
/// the kind (`gift_categories_kind_code`), never deleted.
enum GiftCategoryKind {
  NORMAL
  LUCKY
  QUIPS
  /// v1.100-social (D312, CONVENTIONS §10.118): «مُخصَّص» / Custom — gifts that name an owner user, who earns a share
  /// of every send as coins; the recipients' share is GIFT_CUSTOM_SHARE_PERCENT (60 %).
  CUSTOM

  @@map("gift_category_kind")
}

/// v1.46-live (D207): the format of a gift's hosted full-screen effect.
enum GiftAnimationFormat {
  SVGA
  MP4

  @@map("gift_animation_format")
}

/// v1.46-live (D207): how an MP4 effect carries transparency. NONE: a plain video (with its background) played
/// full screen as is; SIDE_BY_SIDE: the left half is the colour, the right half the alpha mask.
enum GiftVideoAlpha {
  NONE
  SIDE_BY_SIDE

  @@map("gift_video_alpha")
}

/// v1.46-live (D207, CONVENTIONS §10.66): the gift panel's tabs, managed in the admin panel (and `gift-admin
/// category-*`). Seeded with the five tabs that were the `gift_category` enum (POPULAR, EVENT, FUN, LUCKY, QUIPS).
/// `code` never changes; a category is deleted only while no gift is in it (FK RESTRICT) and never when special.
/// CHECKs `gift_categories_code_format`, `gift_categories_kind_code`, `gift_categories_names`,
/// `gift_categories_sort_range`, `gift_categories_icon_key_format`.
model GiftCategory {
  code          String           @id @db.VarChar(40)
  kind          GiftCategoryKind @default(NORMAL)
  nameAr        String           @map("name_ar") @db.VarChar(30)
  nameEn        String           @map("name_en") @db.VarChar(30)
  sortOrder     Int              @default(0) @map("sort_order")
  enabled       Boolean          @default(true)
  /// The tab's optional icon (PNG/WebP, content-addressed under `media/gift-categories/<code>/`), or null.
  iconObjectKey String?          @map("icon_object_key") @db.VarChar(200)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  gifts Gift[]

  // Created by 20270127090000_gift_categories; declared here (the partial one with the `partialIndexes` preview
  // feature) so `migrate diff` / `migrate dev` see no drift.
  @@unique([kind], map: "gift_categories_special_kind_key", where: raw("kind <> 'NORMAL'::gift_category_kind"))
  @@index([sortOrder, code], map: "gift_categories_sort_idx")
  @@map("gift_categories")
}

/// The corner badge of a gift in the panel. v1.79-live (D289): **deprecated** — the single value an older app reads,
/// written by the API from `badges` (NEW when «جديد» is set, else EVENT when «موسمي» is, else NONE); dropped later.
enum GiftBadge {
  NONE
  NEW
  EVENT

  @@map("gift_badge")
}

/// v1.79-live (D289, CONVENTIONS §10.102): the badges of a gift or a store item (a set; one icon each everywhere).
/// SOUND «بمؤثرات صوتية» and NO_SOUND «بدون مؤثرات صوتية» exclude each other; NEW «جديد», LIMITED «لفترة محدودة» and
/// SEASONAL «موسمي» carry an end (`badge_*_until`), after which only the badge stops showing.
enum ItemBadge {
  SOUND
  NO_SOUND
  NEW
  MOST_WANTED
  FEATURED
  LIMITED
  FULLSCREEN
  EXCLUSIVE
  SEASONAL

  @@map("item_badge")
}

/// How a send was paid: coins from the wallet, or gifts from the sender's bag.
enum LiveGiftSource {
  COINS
  BAG

  @@map("live_gift_source")
}

/// The gift catalogue, managed only with the `gift-admin` CLI (no gift is seeded). Disabled; v1.103-social (D338)
/// deleted for real only when nothing ever used it, otherwise archived (`archived_at`). CHECKs `gifts_code_format`, `gifts_price_range`, `gifts_names_present`.
model Gift {
  code               String               @id @db.VarChar(40)
  /// v1.46-live (D207): the code of its `gift_categories` row (was the `gift_category` enum).
  category           String               @db.VarChar(40)
  nameAr             String               @map("name_ar") @db.VarChar(60)
  nameEn             String               @map("name_en") @db.VarChar(60)
  priceCoins         Int                  @map("price_coins")
  /// The app's static image of the gift.
  assetKey           String               @map("asset_key") @db.VarChar(80)
  /// The app's full-screen effect (SVGA), or null for none.
  animationKey       String?              @map("animation_key") @db.VarChar(80)
  sortOrder          Int                  @default(0) @map("sort_order")
  /// Deprecated v1.79-live (D289): kept in step with `badges` for older apps and a rollback.
  badge              GiftBadge            @default(NONE)
  /// v1.79-live (D289): the badges (CHECKs `gifts_badges_sound`, `gifts_badge_new_until`, `gifts_badge_limited_until`,
  /// `gifts_badge_seasonal_until`); shown while their end is ahead (read time).
  badges             ItemBadge[]          @default([])
  badgeNewUntil      DateTime?            @map("badge_new_until") @db.Timestamptz(3)
  badgeLimitedUntil  DateTime?            @map("badge_limited_until") @db.Timestamptz(3)
  /// Null with SEASONAL only for a gift migrated from EVENT (no end until the owner sets one).
  badgeSeasonalUntil DateTime?            @map("badge_seasonal_until") @db.Timestamptz(3)
  /// v1.24.3-live (D117): the optional sub-category (the panel's chips): all three null or all set
  /// (CHECK `gifts_tag_complete`; `gifts_tag_code_format`).
  tagCode            String?              @map("tag_code") @db.VarChar(40)
  tagNameAr          String?              @map("tag_name_ar") @db.VarChar(30)
  tagNameEn          String?              @map("tag_name_en") @db.VarChar(30)
  /// v1.26.2-live (D126): the gift's art on the server, downloaded by the app on demand (object keys
  /// under `media/gifts/<code>/`, content-addressed; the API answers `MEDIA_PUBLIC_BASE_URL/<key>`).
  /// Null: the bundled `assetKey` / `animationKey` only. `animationBytes` is set exactly when
  /// `animationObjectKey` is (CHECK `gifts_animation_bytes_set`).
  imageObjectKey     String?              @map("image_object_key") @db.VarChar(200)
  animationObjectKey String?              @map("animation_object_key") @db.VarChar(200)
  animationBytes     Int?                 @map("animation_bytes")
  /// v1.46-live (D207): the hosted effect's format (set exactly with `animationObjectKey`; `.svga` / `.mp4`) and,
  /// for an MP4, its transparency (CHECK `gifts_animation_format_set`).
  animationFormat    GiftAnimationFormat? @map("animation_format")
  animationAlpha     GiftVideoAlpha?      @map("animation_alpha")
  /// v1.46-live (D207): the gift's hosted MP3 sound (≤ 1 MiB, ≤ 15 s), played with the effect (or alone); the
  /// three set together, never on a QUIPS gift (CHECK `gifts_audio_set`).
  audioObjectKey     String?              @map("audio_object_key") @db.VarChar(200)
  audioBytes         Int?                 @map("audio_bytes")
  audioMs            Int?                 @map("audio_ms")
  /// v1.43-live (D195, §10.58): a PK booster's activation gift (DOUBLE ×2 … TRIPLE_TURBO ×10), or null.
  /// Never LUCKY or QUIPS, never free (CHECK `gifts_pk_booster_kind`). PK points only, never money.
  pkBooster          PkBoosterKind?       @map("pk_booster")
  /// v1.32-live (D154, §10.33): a QUIPS gift's bundled sound (app asset key), its length and its line
  /// of text (shown as a chat bubble while it plays). Set exactly for QUIPS (CHECK `gifts_quip_fields`).
  soundKey           String?              @map("sound_key") @db.VarChar(80)
  soundMs            Int?                 @map("sound_ms")
  quipText           String?              @map("quip_text") @db.VarChar(200)
  /// v1.100-social (D312, §10.118): the owner of a CUSTOM gift «صاحب الهدية» (set exactly for CUSTOM, CHECK
  /// `gifts_custom_owner`); they earn GIFT_CUSTOM_OWNER_PERCENT of each send's coin value as coins.
  ownerUserId        String?              @map("owner_user_id") @db.Uuid
  enabled            Boolean              @default(true)
  /// v1.103-social (D338, CONVENTIONS §10.131): «حذف» of a gift that was used — archived instead of deleted: out of the
  /// app's catalogue, the bag's send choices, the panel's normal list and every picker; history keeps its name and art.
  /// Always off while set (CHECK `gifts_archived_off`). «استعادة» clears it. Null: a normal gift.
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoryRef GiftCategory    @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "gifts_category_fkey")
  owner       User?           @relation("GiftOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, map: "gifts_owner_user_id_fkey")
  stock       UserGiftStock[]
  pkBoosts    PkBoost[]
  sends       LiveGift[]
  /// v1.97-social (D303): the events this gift scores in.
  eventGifts  EventGift[]
  /// v1.101-social (D325): the event this gift belongs to (an exclusive event gift, CHECK `gifts_event_plain`): sent
  /// with coins only while that event runs, otherwise only from the bag (pieces won as prizes).
  eventId     String?         @map("event_id") @db.Uuid
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([category, sortOrder], map: "gifts_category_sort_idx")
  @@index([ownerUserId], map: "gifts_owner_idx")
  @@index([eventId], map: "gifts_event_idx", where: raw("(event_id IS NOT NULL)"))
  @@map("gifts")
}

/// The gift bag (الحقيبة): gifts a user owns. CHECK `user_gift_stock_quantity_range` (0 … 10^9);
/// rows at 0 stay and are not listed.
model UserGiftStock {
  userId    String   @map("user_id") @db.Uuid
  giftCode  String   @map("gift_code") @db.VarChar(40)
  quantity  Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftCode], references: [code], onDelete: Restrict)

  @@id([userId, giftCode], map: "user_gift_stock_pkey")
  @@index([giftCode], map: "user_gift_stock_gift_idx")
  @@map("user_gift_stock")
}

/// One send in a live: `quantity` of one gift to each recipient. `totalCoins` is the coin value
/// (unitPrice × quantity × recipients); `coinsCharged` is that for COINS and 0 for BAG. CHECKs
/// `live_gifts_quantity_positive`, `live_gifts_amounts`, `live_gifts_combo`.
model LiveGift {
  id               String         @id @default(uuid(7)) @db.Uuid
  senderId         String         @map("sender_id") @db.Uuid
  clientId         String         @map("client_id") @db.Uuid
  /// The live it was sent in (null once that room is gone, and for a gift sent in a direct
  /// conversation, D155).
  roomId           String?        @map("room_id") @db.Uuid
  /// v1.40-social (D155): the direct conversation it was sent in (null for live gifts).
  dmConversationId String?        @map("dm_conversation_id") @db.Uuid
  giftCode         String         @map("gift_code") @db.VarChar(40)
  quantity         Int
  source           LiveGiftSource
  unitPrice        Int            @map("unit_price")
  totalCoins       BigInt         @map("total_coins")
  coinsCharged     BigInt         @map("coins_charged")
  /// The recipients' user ids, sorted and joined (combo matching).
  recipientsKey    String         @map("recipients_key")
  /// The first send of the combo (its own id when it starts one).
  comboId          String         @map("combo_id") @db.Uuid
  comboCount       Int            @map("combo_count")
  comboQuantity    BigInt         @map("combo_quantity")
  /// v1.32-live (D154, §10.33): the recipients' earnings share of `total_coins` at the time of the send,
  /// in basis points (the category's GIFT_HOST_SHARE_PERCENTS; LUCKY: LUCKY_GIFT_HOST_SHARE_PERCENT).
  hostShareBps     Int            @map("host_share_bps")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  room           LiveRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  gift           Gift                @relation(fields: [giftCode], references: [code], onDelete: Restrict)
  recipients     LiveGiftRecipient[]
  /// v1.27-live (D132): the draws of a LUCKY send (none for other gifts).
  luckyDraw      LuckyGiftDraw?
  /// v1.40-social (D155).
  dmConversation DmConversation?     @relation(fields: [dmConversationId], references: [id], onDelete: SetNull)
  dmMessage      DmMessage?
  /// v1.32-live (D154): the free-quip row of a free QUIPS send.
  freeQuip       LiveFreeQuip?
  /// v1.43-live (D195): the PK points of a send made in a room during a PK battle.
  pkPoints       PkGiftPoint?

  @@unique([senderId, clientId], map: "live_gifts_client_once")
  @@index([senderId, roomId, createdAt(sort: Desc)], map: "live_gifts_sender_room_idx")
  @@index([roomId, createdAt], map: "live_gifts_room_idx")
  @@index([giftCode], map: "live_gifts_gift_idx")
  @@index([dmConversationId], map: "live_gifts_dm_conversation_idx")
  @@index([createdAt], map: "live_gifts_created_at_idx")
  @@map("live_gifts")
}

/// A recipient of a send, in the order the sender listed them; `coins` = unitPrice × quantity.
model LiveGiftRecipient {
  giftId   String @map("gift_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  position Int    @db.SmallInt
  coins    BigInt

  gift LiveGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([giftId, userId], map: "live_gift_recipients_pkey")
  @@index([userId], map: "live_gift_recipients_user_idx")
  @@map("live_gift_recipients")
}

/// v1.32-live (D154, §10.33): the one free quip a person sent in a live (owner: one per viewer per
/// live, any of the free sounds). Inserted in the send's transaction; a second free send → 409.
model LiveFreeQuip {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  giftId    String   @unique @map("gift_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift LiveGift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@id([roomId, userId], map: "live_free_quips_pkey")
  @@index([userId], map: "live_free_quips_user_idx")
  @@map("live_free_quips")
}

/// v1.36-live (D154e, CONVENTIONS §10.37): one segment of a live's program «قائمة البرامج» (≤ 10 per
/// live, ascending start). `announced_at`: when the room was told it started (null: not yet).
model LiveProgramItem {
  roomId      String    @map("room_id") @db.Uuid
  position    Int       @db.SmallInt
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  title       String    @db.VarChar(240)
  announcedAt DateTime? @map("announced_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, position], map: "live_program_items_pkey")
  @@index([startsAt], map: "live_program_items_due_idx", where: raw("announced_at IS NULL"))
  @@map("live_program_items")
}

/// v1.38-live (D154i, CONVENTIONS §10.39): the YouTube video a live watches together (sync state only).
model LiveWatch {
  roomId     String   @id(map: "live_watch_pkey") @map("room_id") @db.Uuid
  videoId    String   @map("video_id") @db.VarChar(11)
  title      String   @db.VarChar(400)
  channel    String?  @db.VarChar(200)
  playing    Boolean
  positionMs Int      @map("position_ms")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("live_watch")
}

/// v1.38-live (D154i): a viewer's suggestion for watch-together (PENDING / APPROVED / REJECTED).
model LiveWatchSuggestion {
  id        String    @id(map: "live_watch_suggestions_pkey") @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  videoId   String    @map("video_id") @db.VarChar(11)
  title     String    @db.VarChar(400)
  channel   String?   @db.VarChar(200)
  status    String    @default("PENDING") @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt], map: "live_watch_suggestions_pending_idx", where: raw("status = 'PENDING'"))
  @@index([userId], map: "live_watch_suggestions_user_idx")
  @@map("live_watch_suggestions")
}

/// v1.37-live (D154h, CONVENTIONS §10.38): sticker art the app may place on a live (the catalogue).
model LiveStickerArt {
  key       String   @id(map: "live_sticker_art_pkey") @db.VarChar(64)
  pack      String   @db.VarChar(32)
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("live_sticker_art")
}

/// v1.37-live (D154h): a sticker on a live now (≤ 3; Kabi art or a text), placed by the host.
model LiveSticker {
  roomId   String  @map("room_id") @db.Uuid
  id       String  @db.Uuid
  position Int     @db.SmallInt
  artKey   String? @map("art_key") @db.VarChar(64)
  text     String? @db.VarChar(160)
  x        Float
  y        Float
  scale    Float
  rotation Float

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, id], map: "live_stickers_pkey")
  @@unique([roomId, position], map: "live_stickers_position_key")
  @@map("live_stickers")
}

/// v1.35-live (D154d, CONVENTIONS §10.36): one ended live, summarised once for the host's data center
/// (written by the summariser after the end; never changed). `earnings_coins` = Σ over the gifts the
/// host received in it of floor(coins × the send's `host_share_bps` / 10 000) — display only (D149).
model LiveSummary {
  roomId          String   @id @map("room_id") @db.Uuid
  hostUserId      String   @map("host_user_id") @db.Uuid
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime @map("ended_at") @db.Timestamptz(3)
  durationSeconds Int      @map("duration_seconds")
  peakViewers     Int      @map("peak_viewers")
  uniqueViewers   Int      @map("unique_viewers")
  giftCount       Int      @map("gift_count")
  giftCoins       BigInt   @map("gift_coins")
  earningsCoins   BigInt   @map("earnings_coins")
  newFollowers    Int      @map("new_followers")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host User     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId, startedAt], map: "live_summaries_host_started_idx")
  @@map("live_summaries")
}

/// v1.33-live (D154b): how a traffic card was paid.
enum LiveBoostSource {
  COINS
  CARD

  @@map("live_boost_source")
}

/// v1.33-live (D154b, CONVENTIONS §10.34): a traffic card «بطاقة الزيارات» — a live shown in one of the
/// few paid slots at the top of the live list for `minutes`. Scheduled when bought (`slot`, `starts_at`,
/// `ends_at`; boosts of one room run back to back); a waiting one whose live ended is cancelled and
/// refunded (`cancelled_at`), a running one whose live ended is cut short (`ends_at` moved).
model LiveBoost {
  id           String          @id @default(uuid(7)) @db.Uuid
  roomId       String          @map("room_id") @db.Uuid
  hostUserId   String          @map("host_user_id") @db.Uuid
  buyerId      String          @map("buyer_id") @db.Uuid
  clientId     String          @map("client_id") @db.Uuid
  minutes      Int
  /// v1.51-live (D233): the rocket stage 1–4 bought (fixed at purchase; older rows backfilled by length).
  stage        Int             @db.SmallInt
  source       LiveBoostSource
  coinsCharged BigInt          @map("coins_charged")
  slot         Int             @db.SmallInt
  startsAt     DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime        @map("ends_at") @db.Timestamptz(3)
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  room  LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host  User     @relation("LiveBoostHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  buyer User     @relation("LiveBoostBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, clientId], map: "live_boosts_client_once")
  @@index([endsAt], map: "live_boosts_ends_idx", where: raw("cancelled_at IS NULL"))
  @@index([roomId, endsAt], map: "live_boosts_room_idx")
  @@index([hostUserId], map: "live_boosts_host_idx")
  @@map("live_boosts")
}

/// v1.51-live (D233, CONVENTIONS §10.81): the price of a rocket stage set in the admin panel; a stage with no row
/// costs what `LIVE_BOOST_PRICES` says. The length of a stage is always the server config.
model LiveBoostPrice {
  stage       Int      @id @db.SmallInt
  coins       BigInt
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("live_boost_prices")
}

/// v1.33-live (D154b): traffic cards a user holds (granted by an admin as rewards), by length.
model LiveBoostCard {
  userId    String   @map("user_id") @db.Uuid
  minutes   Int
  quantity  Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, minutes], map: "live_boost_cards_pkey")
  @@map("live_boost_cards")
}

/// D124 (v1.26-live, CONVENTIONS §10.26): a promo banner shown on the live hub between the live
/// cards. Managed only with the `banner-admin` CLI (migration role); read by `GET /home/banners`
/// while `enabled` and `starts_at <= now < ends_at` (no end = open). `link` is an in-app route of
/// the allowlist or an https URL (`home-banners.ts`), checked by the CLI and again on read.
model HomeBanner {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// A `HOME_BANNER` media asset (1 500 × 500 WebP; ROOM 600 × 800, HUB_CARD 720 × 805), owned by the banner from now on.
  mediaId   String    @unique @map("media_id") @db.Uuid
  /// Optional overlay text, 1–40 code points each.
  titleAr   String?   @map("title_ar") @db.VarChar(80)
  titleEn   String?   @map("title_en") @db.VarChar(80)
  /// The empty side of the picture where the overlay text goes (physical: `LEFT` or `RIGHT`).
  titleSide String    @default("RIGHT") @map("title_side") @db.VarChar(8)
  /// v1.27.4-live (D137, §10.26): `HOME` (the live hub, 3:1) or `ROOM` (the promo box in a live,
  /// 3:4, 600 × 800); v1.50-social (D176): `TASKS` (the Task Center, 3:1); v1.51-social (D177):
  /// `WALLET` (the wallet page, 3:1); v1.59-live (D248): `HUB_CARD` (the live hub's card-size banner in one
  /// grid cell, 720 × 805) — CHECK `home_banners_placement_values` (all five since migration
  /// 20270303090000_banner_hub_card).
  placement String    @default("HOME") @db.VarChar(8)
  link      String    @db.VarChar(512)
  startsAt  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(3)
  sortOrder Int       @default(0) @map("sort_order")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// v1.97-social (D303, §10.114.6): `IMAGE` (a still), `ANIMATED` (an animated WebP / GIF kept animated) or `VIDEO`
  /// (`video_media_id`, muted and looping; `media_id` is its poster) — CHECK `home_banners_kind_shape`.
  kind         String  @default("IMAGE") @db.VarChar(8)
  videoMediaId String? @unique @map("video_media_id") @db.Uuid
  /// v1.97-social (D303): the event the banner opens (`link` is then `/events/<id>`); null once the event is gone.
  eventId      String? @map("event_id") @db.Uuid

  media MediaAsset  @relation("HomeBannerMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  video MediaAsset? @relation("HomeBannerVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  event Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([sortOrder, startsAt], map: "home_banners_enabled_idx", where: raw("enabled"))
  @@index([placement, sortOrder, startsAt], map: "home_banners_placement_idx", where: raw("enabled"))
  @@map("home_banners")
}

/// v1.27-live (D132, CONVENTIONS §10.27): the daily protection of lucky gifts. One row per day (in
/// LUCKY_GIFT_DAY_TIME_ZONE): the day's lucky spend and the coins paid out. Locked by every lucky
/// send; CHECK `lucky_gift_days_amounts`: 0 ≤ paid, 0 ≤ spend.
model LuckyGiftDay {
  day        DateTime @id @db.Date
  spendCoins BigInt   @default(0) @map("spend_coins")
  paidCoins  BigInt   @default(0) @map("paid_coins")
  sends      Int      @default(0)
  draws      BigInt   @default(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("lucky_gift_days")
}

/// v1.27-live (D132): the audit row of one lucky send — every winning draw as
/// `[index, drawn multiplier, paid multiplier]` (draws not listed did not win), the table used and
/// the day's budget before and after. Written in the send's transaction; read back for a retry.
model LuckyGiftDraw {
  giftId        String   @id @map("gift_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  giftCode      String   @map("gift_code") @db.VarChar(40)
  unitPrice     Int      @map("unit_price")
  quantity      Int
  recipients    Int
  draws         Int
  /// The table used: `{rtpBps, hostShareBps, outcomes: [[multiplier, chancePerMillion], …]}`.
  odds          Json
  /// `[[index, drawnMultiplier, paidMultiplier], …]` (paid 0: withheld by the daily protection).
  wins          Json
  coinsWon      BigInt   @map("coins_won")
  topMultiplier Int?     @map("top_multiplier")
  downgraded    Int
  budgetDay     DateTime @map("budget_day") @db.Date
  budgetBefore  BigInt   @map("budget_before")
  budgetAfter   BigInt   @map("budget_after")
  spendAfter    BigInt   @map("spend_after")
  /// v1.30-live (D148): the sender's losing draws in a row before and after the send, and the draws
  /// the guarantee paid (null before D148).
  lossesBefore  Int?     @map("losses_before")
  lossesAfter   Int?     @map("losses_after")
  guaranteed    Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  gift   LiveGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "lucky_gift_draws_created_idx")
  @@index([senderId, createdAt(sort: Desc)], map: "lucky_gift_draws_sender_idx")
  @@map("lucky_gift_draws")
}

/// v1.27-live (D132): the caller's one-time "I am 18 or older" statement (accounts have no birth
/// date). Pending owner / legal review (CONVENTIONS §10.27).
/// v1.30-live (D148, CONVENTIONS §10.27): the lucky-gift guarantee — a sender's losing draws in a
/// row (any room, any session), read and written only under the sender's advisory lock in a lucky
/// send's transaction; reset by any paid draw. CHECK `lucky_gift_pity_losses`: losses ≥ 0.
model LuckyGiftPity {
  userId    String   @id @map("user_id") @db.Uuid
  losses    Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lucky_gift_pity")
}

model LuckyGiftAgeConfirmation {
  userId      String   @id @map("user_id") @db.Uuid
  confirmedAt DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lucky_gift_age_confirmations")
}

/// v1.27.1-live (D133, CONVENTIONS §10.28): a host featured on the live hub (`featured=true`).
/// Managed only by the `feature-admin` CLI. CHECK `live_featured_hosts_rank_range`: 0 … 1 000 000.
model LiveFeaturedHost {
  userId    String    @id @map("user_id") @db.Uuid
  rank      Int       @default(100)
  /// After this time the row no longer counts (null: no end).
  until     DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_featured_hosts")
}

// ---------------------------------------------------------------------------------------------
// v1.28-live (D146, owner 2026-10-27): premium usernames (يوزر مميز), CONVENTIONS §10.32.

/// D146: the tier of a premium username (decided by its shape, `premium-username-rules.ts`),
/// matching the owner's medal art: LEGEND, RUBY, GOLD, SILVER.
enum PremiumUsernameTier {
  LEGEND
  RUBY
  GOLD
  SILVER

  @@map("premium_username_tier")
}

/// D146: ACTIVE (the user's username now), GRACE (expired; held 7 days for its last renter, who
/// already went back to the regular username), ENDED (back in the pool; kept for the history).
enum PremiumUsernameLeaseStatus {
  ACTIVE
  GRACE
  ENDED

  @@map("premium_username_lease_status")
}

/// D146: RENT (paid with coins), GRANT (given by an admin with `premium-admin grant`).
enum PremiumUsernameSource {
  RENT
  GRANT

  @@map("premium_username_source")
}

/// D146: one holding of a premium username by one user, from the first rent (or grant) until it
/// ends. Renewals extend `expires_at`. `regular_username` is the username the user goes back to;
/// it stays held for them while the lease is ACTIVE (`isUsernameTaken`). CHECKs
/// `premium_username_leases_format`, `premium_username_leases_grace`.
model PremiumUsernameLease {
  id              String                     @id @default(uuid(7)) @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  username        String                     @db.VarChar(30)
  tier            PremiumUsernameTier
  source          PremiumUsernameSource
  status          PremiumUsernameLeaseStatus @default(ACTIVE)
  regularUsername String                     @map("regular_username") @db.VarChar(30)
  startedAt       DateTime                   @default(now()) @map("started_at") @db.Timestamptz(3)
  /// Null: an admin grant without an end.
  expiresAt       DateTime?                  @map("expires_at") @db.Timestamptz(3)
  /// GRACE only: when the name returns to the pool.
  graceUntil      DateTime?                  @map("grace_until") @db.Timestamptz(3)
  /// The smallest reminder (days before the end) already sent for the current period.
  remindedDays    Int?                       @map("reminded_days")
  endedAt         DateTime?                  @map("ended_at") @db.Timestamptz(3)
  /// GRACE_OVER | RELEASED | REVOKED.
  endReason       String?                    @map("end_reason") @db.VarChar(20)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(3)

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      PremiumUsernamePayment[]
  notifications Notification[]

  @@unique([username], map: "premium_username_leases_one_holder", where: raw("status = ANY (ARRAY['ACTIVE'::premium_username_lease_status, 'GRACE'::premium_username_lease_status])"))
  @@unique([userId], map: "premium_username_leases_one_active", where: raw("status = 'ACTIVE'::premium_username_lease_status"))
  @@unique([regularUsername], map: "premium_username_leases_regular_held", where: raw("status = 'ACTIVE'::premium_username_lease_status"))
  @@index([status, expiresAt], map: "premium_username_leases_due_idx")
  @@index([userId, createdAt(sort: Desc)], map: "premium_username_leases_user_idx")
  @@map("premium_username_leases")
}

/// D146: a rent or a renewal paid with coins (`wallet_ledger` reason PREMIUM_USERNAME_RENT /
/// PREMIUM_USERNAME_RENEW, reference = this id). `idempotency_key` (the request's
/// `Idempotency-Key`, kept 24 hours) makes a retry return the first result.
model PremiumUsernamePayment {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  leaseId        String   @map("lease_id") @db.Uuid
  /// RENT | RENEW.
  kind           String   @db.VarChar(10)
  username       String   @db.VarChar(30)
  priceCoins     BigInt   @map("price_coins")
  periodDays     Int      @map("period_days")
  /// The balance right after this payment (the answer of a replay).
  coinsAfter     BigInt   @map("coins_after")
  idempotencyKey String?  @map("idempotency_key") @db.Uuid
  requestHash    String?  @map("request_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease PremiumUsernameLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey], map: "premium_username_payments_idempotency")
  @@map("premium_username_payments")
}

/// D146: the owner's monthly price of a tier, in coins. No row: that tier is not on sale.
model PremiumUsernameTierPrice {
  tier         PremiumUsernameTier @id
  monthlyCoins BigInt              @map("monthly_coins")
  updatedAt    DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("premium_username_tier_prices")
}

/// D146: the owner's monthly price of one username (overrides its tier's price).
model PremiumUsernameNamePrice {
  username     String   @id @db.VarChar(30)
  monthlyCoins BigInt   @map("monthly_coins")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("premium_username_name_prices")
}

/// D146: names that are never rented (brand, offensive words), managed with `premium-admin reserve`.
model PremiumUsernameReserved {
  name      String   @id @db.VarChar(30)
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("premium_username_reserved")
}

/// v1.29-live (D147, CONVENTIONS §11.11): a normalized search term people searched. No user id is
/// ever stored with it; rows without counts are dropped by the sweeper after 14 days.
model SearchTerm {
  id          String    @id @default(uuid(7)) @db.Uuid
  term        String    @unique @db.VarChar(64)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  /// Hidden by an admin (`search-admin hide`): never listed, still counted.
  hiddenAt    DateTime? @map("hidden_at") @db.Timestamptz(3)

  counts SearchTermCount[]

  @@map("search_terms")
}

/// D147: how many different people searched a term in one hour (each person counts once per term
/// per 7 days, deduplicated by an ephemeral HMAC key in Redis).
model SearchTermCount {
  termId    String     @map("term_id") @db.Uuid
  hour      DateTime   @db.Timestamptz(3)
  searchers Int
  term      SearchTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, hour])
  @@index([hour], map: "search_term_counts_hour_idx")
  @@map("search_term_counts")
}

/// D147: words that keep a search term out of `GET /search/trending` and hashtags out of
/// `GET /search/trending-hashtags` (`search-admin block-word`); matched like live blocked words.
model SearchBlockedWord {
  word      String   @id @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("search_blocked_words")
}

// ---- v1.40-social (DRAFT, D155): direct messages (CONVENTIONS §11.13) ------------------------

/// v1.40-social (D155): who may send a user direct messages.
enum WhoCanMessage {
  EVERYONE
  FOLLOWING
  NOBODY

  @@map("who_can_message")
}

/// D155: one side of a conversation — ACCEPTED, or REQUEST (a message request waiting for them).
enum DmParticipantStatus {
  ACCEPTED
  REQUEST

  @@map("dm_participant_status")
}

enum DmMessageKind {
  TEXT
  IMAGE
  VOICE
  EMOJI
  GIFT

  @@map("dm_message_kind")
}

/// D155: one conversation per pair of accounts (`user_low_id` < `user_high_id`, CHECK
/// `dm_conversations_ordered`), created by the first message. Kept when its messages expire.
model DmConversation {
  id            String   @id @default(uuid(7)) @db.Uuid
  userLowId     String   @map("user_low_id") @db.Uuid
  userHighId    String   @map("user_high_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz(3)

  userLow      User            @relation("DmConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User            @relation("DmConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  participants DmParticipant[]
  messages     DmMessage[]
  gifts        LiveGift[]

  @@unique([userLowId, userHighId], map: "dm_conversations_pair_key")
  @@index([userHighId], map: "dm_conversations_user_high_idx")
  @@map("dm_conversations")
}

/// D155: a user's side of a conversation. `has_sent`: they wrote in it at least once (the privacy
/// exception and the end of a request); `request_sent`: messages they sent while the other side had
/// it as a REQUEST (≤ DM_REQUEST_MAX_MESSAGES; never reset). `read_at`: everything received up to
/// then is read. `cleared_at`: deleted for this user up to then.
model DmParticipant {
  conversationId String              @map("conversation_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  peerId         String              @map("peer_id") @db.Uuid
  status         DmParticipantStatus
  muted          Boolean             @default(false)
  /// v1.43.1-social (D165): the user marked it unread (cleared by reading it).
  markedUnread   Boolean             @default(false) @map("marked_unread")
  /// v1.104-social (D339): archived by this user «المؤرشفة» (null: not archived); a message from the peer clears it.
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  hasSent        Boolean             @default(false) @map("has_sent")
  requestSent    Int                 @default(0) @map("request_sent")
  readAt         DateTime?           @map("read_at") @db.Timestamptz(3)
  clearedAt      DateTime?           @map("cleared_at") @db.Timestamptz(3)
  lastMessageAt  DateTime            @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation("DmParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  peer         User           @relation("DmParticipantPeer", fields: [peerId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId], map: "dm_participants_pkey")
  @@unique([userId, peerId], map: "dm_participants_user_peer_key")
  @@index([userId, status, lastMessageAt(sort: Desc), conversationId], map: "dm_participants_list_idx")
  @@index([peerId], map: "dm_participants_peer_idx")
  @@map("dm_participants")
}

/// D155: a direct message; hard-deleted by the sweeper at `expires_at` (sent + DM_RETENTION_HOURS)
/// with its media. CHECK `dm_messages_content`: the column of its kind.
model DmMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  senderId       String        @map("sender_id") @db.Uuid
  recipientId    String        @map("recipient_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  kind           DmMessageKind
  text           String?       @db.VarChar(1000)
  token          String?       @db.VarChar(64)
  mediaId        String?       @unique(map: "dm_messages_media_id_key") @map("media_id") @db.Uuid
  giftId         String?       @unique(map: "dm_messages_gift_id_key") @map("gift_id") @db.Uuid
  asRequest      Boolean       @default(false) @map("as_request")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)

  conversation DmConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation("DmMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User            @relation("DmMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  media        MediaAsset?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  gift         LiveGift?       @relation(fields: [giftId], references: [id], onDelete: SetNull)
  hides        DmMessageHide[]

  @@unique([senderId, clientId], map: "dm_messages_client_once")
  @@index([conversationId, createdAt, id], map: "dm_messages_conversation_idx")
  @@index([recipientId, createdAt], map: "dm_messages_recipient_idx")
  @@index([expiresAt], map: "dm_messages_expires_idx")
  @@map("dm_messages")
}

/// D155: a message deleted "for me" by one participant.
model DmMessageHide {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId], map: "dm_message_hides_pkey")
  @@index([userId], map: "dm_message_hides_user_idx")
  @@map("dm_message_hides")
}

// ---------------------------------------------------------------------------------------------
// v1.104-social (DRAFT, D339, CONVENTIONS §10.133): group messages «رسائل جماعية». CHECKs in migration
// 20270411090100_dm_archive_groups.

/// D339: a member's place in a group (ADMIN: add / remove members, rename, the photo, roles).
enum DmGroupRole {
  ADMIN
  MEMBER

  @@map("dm_group_role")
}

/// D339: REMOVED by moderation (a DM_GROUP report's REMOVE_TARGET): gone for every member.
enum DmGroupStatus {
  ACTIVE
  REMOVED

  @@map("dm_group_status")
}

/// D339: a group conversation. `created_by_id` + `client_id`: the create's idempotency (null once the creator's account
/// is gone). `last_message_at`: the newest message (the list's order; the create time before the first one).
model DmGroup {
  id            String        @id @default(uuid(7)) @db.Uuid
  name          String        @db.VarChar(50)
  photoMediaId  String?       @unique(map: "dm_groups_photo_media_id_key") @map("photo_media_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  status        DmGroupStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastMessageAt DateTime      @map("last_message_at") @db.Timestamptz(3)
  removedAt     DateTime?     @map("removed_at") @db.Timestamptz(3)

  photo     MediaAsset?      @relation("DmGroupPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("DmGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   DmGroupMember[]
  messages  DmGroupMessage[]

  @@unique([createdById, clientId], map: "dm_groups_client_once")
  @@map("dm_groups")
}

/// D339: one member of a group, with their own state: role, mute, archive «المؤرشفة», the read pointer and when they
/// joined (messages before it are not theirs to read). Leaving or being removed deletes the row.
model DmGroupMember {
  groupId    String      @map("group_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  role       DmGroupRole @default(MEMBER)
  muted      Boolean     @default(false)
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(3)
  readAt     DateTime?   @map("read_at") @db.Timestamptz(3)
  joinedAt   DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)

  group DmGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation("DmGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId], map: "dm_group_members_pkey")
  @@index([userId], map: "dm_group_members_user_idx")
  @@map("dm_group_members")
}

/// D339: a group message (TEXT, IMAGE, VOICE or EMOJI — no gifts); hard-deleted by the DM sweeper at `expires_at`
/// (sent + DM_RETENTION_HOURS) with its file. CHECK `dm_group_messages_content`: the column of its kind.
model DmGroupMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  senderId  String        @map("sender_id") @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  kind      DmMessageKind
  text      String?       @db.VarChar(1000)
  token     String?       @db.VarChar(64)
  mediaId   String?       @unique(map: "dm_group_messages_media_id_key") @map("media_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)

  group  DmGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User        @relation("DmGroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  media  MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientId], map: "dm_group_messages_client_once")
  @@index([groupId, createdAt, id], map: "dm_group_messages_group_idx")
  @@index([expiresAt], map: "dm_group_messages_expires_idx")
  @@map("dm_group_messages")
}

// ---------------------------------------------------------------------------------------------
// v1.44-social (DRAFT, D166, CP-024 approved with defaults, CONVENTIONS §10.41): the Me hub's
// programs — the Task Center, the Event Center (SVIP and the recharge packages need no table).
// CHECKs in migration 20261214100000_me_programs.

/// D166: how often a task resets (a day or an ISO week in LIVE_RANKINGS_TIME_ZONE).
enum TaskPeriod {
  DAILY
  WEEKLY

  @@map("task_period")
}

/// D166: who a task or an event is for (HOSTS = holders of the hosting permission).
enum ProgramAudience {
  EVERYONE
  HOSTS
  /// v1.94-social (D297): creator-programme members only (`creator_members`); Task Center tasks only.
  CREATORS

  @@map("program_audience")
}

/// v1.101-social (D325, §10.127): who an event is for (its own type since v2; was `program_audience`). AGENCIES: agency
/// owners and the member hosts of an open agency; CP: people in a CP couple now (gift events only).
enum EventAudience {
  EVERYONE
  HOSTS
  CREATORS
  AGENCIES
  CP

  @@map("event_audience")
}

/// D166: what an event's leaderboard counts.
enum EventMetric {
  GIFT_COINS_RECEIVED
  GIFT_COINS_SENT
  LIVE_MINUTES
  TAPS_RECEIVED
  NEW_FOLLOWERS
  /// v1.97-social (D303, §10.114): the event's own gifts (`event_gifts`), scored per board (`event_boards`).
  EVENT_GIFTS

  @@map("event_metric")
}

/// D166: a task on offer (task-admin CLI). Progress is computed from stored data (`metric`), never
/// reported by the app.
model TaskDefinition {
  code           String          @id @db.VarChar(40)
  period         TaskPeriod
  metric         String          @db.VarChar(40)
  target         Int
  /// v1.53-social (D184): task rewards are cherries (was `reward_coins`, ×10 at the migration).
  rewardCherries Int             @map("reward_cherries")
  audience       ProgramAudience @default(EVERYONE)
  nameAr         String          @map("name_ar") @db.VarChar(80)
  nameEn         String          @map("name_en") @db.VarChar(80)
  enabled        Boolean         @default(true)
  sortOrder      Int             @default(0) @map("sort_order")
  /// D176: a daily pool template, offered through the per-person assignment (task_assignments).
  pool           Boolean         @default(false)
  /// D176: WATCH, LIVE, SOCIAL, GIFT, CONTENT, MESSAGE or HOST (variety; null when not pool); v1.94-social (D297):
  /// CREATOR (audience CREATORS).
  poolGroup      String?         @map("pool_group") @db.VarChar(10)
  /// D176: one target and reward per level band 1…4 (0 = not offered in that band); rewards in
  /// cherries since v1.53-social (D184).
  bandTargets    Int[]           @default([]) @map("band_targets")
  bandRewards    Int[]           @default([]) @map("band_rewards")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  claims      TaskClaim[]
  assignments TaskAssignment[]

  @@map("task_definitions")
}

/// D176: a level band of the daily pool (the higher of Support and Charm levels from `minLevel`).
model TaskPoolBand {
  band         Int      @id @db.SmallInt
  minLevel     Int      @map("min_level")
  dailyCount   Int      @map("daily_count") @db.SmallInt
  hostCount    Int      @map("host_count") @db.SmallInt
  /// v1.94-social (D297): of the daily count, how many CREATOR tasks a creator-programme member gets first.
  creatorCount Int      @default(0) @map("creator_count") @db.SmallInt
  nameAr       String   @map("name_ar") @db.VarChar(40)
  nameEn       String   @map("name_en") @db.VarChar(40)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("task_pool_bands")
}

/// D176: a person's pool task of a day, fixed at the day's first read with its band's target and reward.
model TaskAssignment {
  userId         String   @map("user_id") @db.Uuid
  day            DateTime @db.Date
  taskCode       String   @map("task_code") @db.VarChar(40)
  band           Int      @db.SmallInt
  target         Int
  /// v1.53-social (D184): cherries (was `reward_coins`, ×10 at the migration).
  rewardCherries Int      @map("reward_cherries")
  position       Int      @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// v1.86-social (D281): the generated variant (`K.<template>.<subject|*>.<amount>.<from>-<to>`; its amount is
  /// `target`), its gift or category, its window of the day (minutes; null = the whole day), its resolved names
  /// and the reasons of the smart assignment. Null on rows before D281 (the template itself, the whole day).
  variant        String?  @db.VarChar(120)
  subject        String?  @db.VarChar(40)
  windowFrom     Int?     @map("window_from") @db.SmallInt
  windowTo       Int?     @map("window_to") @db.SmallInt
  nameAr         String?  @map("name_ar") @db.VarChar(160)
  nameEn         String?  @map("name_en") @db.VarChar(160)
  reason         Json?    @db.JsonB

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task TaskDefinition @relation(fields: [taskCode], references: [code], onDelete: Cascade)

  @@id([userId, day, taskCode], map: "task_assignments_pkey")
  @@index([taskCode], map: "task_assignments_task_idx")
  @@index([day], map: "task_assignments_day_idx")
  @@index([userId, day(sort: Desc)], map: "task_assignments_user_day_idx")
  @@map("task_assignments")
}

/// v1.71-live (D281, CONVENTIONS §10.62.2): the owner's knobs of the smart targets and tasks (one row, id 1;
/// OWNER only in the panel, audited `host_targets.settings.update`). CHECK `host_target_settings_shape`.
model HostTargetSettings {
  id               Int       @id @default(1) @db.SmallInt
  easyPercentile   Int       @default(50) @map("easy_percentile") @db.SmallInt
  mediumPercentile Int       @default(75) @map("medium_percentile") @db.SmallInt
  hardPercentile   Int       @default(90) @map("hard_percentile") @db.SmallInt
  easyRewardBps    Int       @default(150) @map("easy_reward_bps")
  mediumRewardBps  Int       @default(250) @map("medium_reward_bps")
  hardRewardBps    Int       @default(400) @map("hard_reward_bps")
  noRepeatDays     Int       @default(7) @map("no_repeat_days") @db.SmallInt
  taskNoRepeatDays Int       @default(3) @map("task_no_repeat_days") @db.SmallInt
  historyDays      Int       @default(30) @map("history_days") @db.SmallInt
  completionShift  Int       @default(10) @map("completion_shift") @db.SmallInt
  /// D281b: the OWNER's new-host defaults {kind: [[easy, medium, hard] × 4 bands]}; null = the code's.
  newHostDefaults  Json?     @map("new_host_defaults") @db.JsonB
  /// The first day of the smart engine (null until the API's first read sets it to the next day).
  engineFrom       DateTime? @map("engine_from") @db.Date
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById      String?   @map("updated_by_id") @db.Uuid

  @@map("host_target_settings")
}

/// v1.71-live (D281): one of a host's three targets of a day (EASY / MEDIUM / HARD), fixed at the day's first read;
/// `reward_cherries` is the reward shown (the level's share of the nominal profit); a completion pays at most that
/// share of the actual profit counted, once (`paid_*`; cherry ledger HOST_TARGET_REWARD, reference `HT:<level>@<day>`).
/// CHECK `host_target_assignments_shape`.
model HostTargetAssignment {
  userId           String    @map("user_id") @db.Uuid
  day              DateTime  @db.Date
  /// D281b: GIFTS («الهدايا») or LUCKY («هدايا الحظ»); three levels each.
  track            String    @default("GIFTS") @db.VarChar(6)
  level            String    @db.VarChar(6)
  code             String    @db.VarChar(120)
  kind             String    @db.VarChar(20)
  subject          String?   @db.VarChar(40)
  amount           BigInt
  windowFrom       Int       @map("window_from") @db.SmallInt
  windowTo         Int       @map("window_to") @db.SmallInt
  expectedCoins    BigInt    @map("expected_coins")
  rewardBps        Int       @map("reward_bps")
  rewardCherries   BigInt    @map("reward_cherries")
  titleAr          String    @map("title_ar") @db.VarChar(160)
  titleEn          String    @map("title_en") @db.VarChar(160)
  reason           Json      @db.JsonB
  catalogueVersion String    @map("catalogue_version") @db.VarChar(16)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  progress         BigInt?
  profitMicrocents BigInt?   @map("profit_microcents")
  paidCherries     BigInt?   @map("paid_cherries")
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, track, level], map: "host_target_assignments_pkey")
  @@index([day], map: "host_target_assignments_day_idx")
  @@map("host_target_assignments")
}

/// D166: a task's reward, paid once per person, task and period (`task_claims_once`). Until v1.53-social
/// the coins paid (after the daily cap) are a `wallet_ledger` row `TASK_REWARD` with this id as reference
/// (`reward_currency` COINS); since then (D184) the cherries paid are a `cherry_ledger` row `TASK_REWARD`
/// with reference `<code>@<period start>` (`reward_currency` CHERRIES).
model TaskClaim {
  id             String             @id @default(uuid(7)) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  taskCode       String             @map("task_code") @db.VarChar(40)
  periodStart    DateTime           @map("period_start") @db.Date
  /// What the claim paid, in `rewardCurrency` (was `reward_coins`).
  rewardAmount   Int                @map("reward_amount")
  rewardCurrency TaskRewardCurrency @map("reward_currency")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task TaskDefinition @relation(fields: [taskCode], references: [code], onDelete: Restrict)

  @@unique([userId, taskCode, periodStart], map: "task_claims_once")
  @@index([userId, periodStart], map: "task_claims_user_period_idx")
  @@index([taskCode], map: "task_claims_task_idx")
  @@map("task_claims")
}

/// D166: a person checked in that day; `streak` counts consecutive days (a missed day restarts it).
model DailyCheckIn {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  day         DateTime @db.Date
  streak      Int
  rewardCoins Int      @map("reward_coins")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day], map: "daily_check_ins_once")
  @@map("daily_check_ins")
}

/// D166: an event created by the team (event-admin CLI). `permanent` events may have no end;
/// `regions` (ISO 3166-1 alpha-2) targets the event at those countries (the Regional tab).
/// `prizes` is a JSON array of `{rankFrom, rankTo, coins}`.
model Event {
  id                  String        @id @default(uuid(7)) @db.Uuid
  titleAr             String        @map("title_ar") @db.VarChar(120)
  titleEn             String        @map("title_en") @db.VarChar(120)
  bannerUrl           String?       @map("banner_url") @db.VarChar(2048)
  /// v1.101-social (D325): null only for a DRAFT (CHECK `events_shape`).
  startsAt            DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime?     @map("ends_at") @db.Timestamptz(3)
  rulesAr             String        @map("rules_ar") @db.VarChar(4000)
  rulesEn             String        @map("rules_en") @db.VarChar(4000)
  /// D176: the calendar bar's second line (a short prize line) and its tone.
  summaryAr           String?       @map("summary_ar") @db.VarChar(80)
  summaryEn           String?       @map("summary_en") @db.VarChar(80)
  tone                String?       @db.VarChar(6)
  metric              EventMetric
  audience            EventAudience @default(EVERYONE)
  permanent           Boolean       @default(false)
  regions             String[]      @default([]) @db.Char(2)
  featured            Boolean       @default(false)
  prizes              Json          @default("[]")
  /// The leaderboard was frozen into `event_results` (once, after the end).
  frozenAt            DateTime?     @map("frozen_at") @db.Timestamptz(3)
  /// The prizes are paid from this time (the review window after the freeze).
  payoutDueAt         DateTime?     @map("payout_due_at") @db.Timestamptz(3)
  /// An admin holds the payout during the review (event-admin hold / release).
  payoutHold          Boolean       @default(false) @map("payout_hold")
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// v1.97-social (D303, §10.114.1): the IANA zone the event's dates are shown in (null: LIVE_RANKINGS_TIME_ZONE).
  timeZone            String?       @map("time_zone") @db.VarChar(64)
  /// v1.97-social (D303 follow-ups, owner; CONVENTIONS §10.114.9): the event page's art, uploaded per event
  /// (`uploadAdminEventMedia` / `uploadStaffEventMedia`, the published specs): the background (`media/events/bg/…`:
  /// `.webp` still, `.anim.webp` animated, `.mp4` / `.mov` video with `backgroundPosterKey`), the transparent title art
  /// (`media/events/title/…webp`) and the animation overlay (`media/events/overlay/….svga|.json`). Null = none.
  backgroundKey       String?       @map("background_key") @db.VarChar(200)
  backgroundPosterKey String?       @map("background_poster_key") @db.VarChar(200)
  titleKey            String?       @map("title_key") @db.VarChar(200)
  overlayKey          String?       @map("overlay_key") @db.VarChar(200)
  /// v1.97-social (D303): who made it last («via» panel / app / cli) — audit has the full trail.
  createdById         String?       @map("created_by_id") @db.Uuid
  /// v1.101-social (D325, CONVENTIONS §10.127; CHECK `events_v2_shape`): DRAFT (no dates needed, never shown, scored or
  /// swept) or PUBLISHED.
  status              String        @default("PUBLISHED") @db.VarChar(10)
  /// NONE, WEEKLY or MONTHLY (a period restarts the boards; each period frozen and paid on its own).
  recurrence          String        @default("NONE") @db.VarChar(8)
  /// The current period (0-based) and its window (recurring events only; NONE: the event's own dates).
  period              Int           @default(0)
  periodStartsAt      DateTime?     @map("period_starts_at") @db.Timestamptz(3)
  periodEndsAt        DateTime?     @map("period_ends_at") @db.Timestamptz(3)
  /// COINS (points = coins) or MULTIPLIER (each event gift's `points_per_coin`, a decimal).
  scoring             String        @default("MULTIPLIER") @db.VarChar(10)
  /// EVENT_GIFTS (only the event's gifts score) or ALL_GIFTS (every gift; a gift not listed counts its coins × 1).
  countedGifts        String        @default("EVENT_GIFTS") @map("counted_gifts") @db.VarChar(12)
  /// The Live home banner (a HOME_BANNER asset; a banner opening the event is made from it at publish).
  bannerMediaId       String?       @map("banner_media_id") @db.Uuid
  /// When the start notification went to the audience (once).
  startNotifiedAt     DateTime?     @map("start_notified_at") @db.Timestamptz(3)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(3)
  /// v1.102-social (D334, §10.127.11): content creators count as hosts (HOSTS audience; the D166 HOSTS board). True for
  /// every event made after migration 20270409090200; false for the older ones (D295's rule kept).
  creatorsAsHosts     Boolean       @default(true) @map("creators_as_hosts")
  /// v1.105-social (D340, §10.134): «إعلان بملء الشاشة عند البدء» — the app shows the start full screen once per person.
  /// True for every event made after migration 20270412090000; false for the older ones.
  announceFullscreen  Boolean       @default(true) @map("announce_fullscreen")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  results       EventResult[]
  /// v1.97-social (D303): an EVENT_GIFTS event's gifts and boards.
  gifts         EventGift[]
  boards        EventBoard[]
  banners       HomeBanner[]
  notifications Notification[]
  badgeGrants   UserEventBadge[]
  /// v1.101-social (D325): the event's own gifts and prize items, its milestones and frozen periods.
  ownGifts      Gift[]
  ownItems      StoreItem[]
  milestones    EventMilestone[]
  periods       EventPeriod[]
  /// v1.105-social (D340): who has seen the full-screen start announcement.
  startsSeen    EventStartAnnouncement[]
  bannerMedia   MediaAsset?              @relation("EventBannerMedia", fields: [bannerMediaId], references: [id], onDelete: SetNull)

  @@index([startsAt], map: "events_starts_idx")
  @@index([status], map: "events_status_idx")
  @@index([periodEndsAt], map: "events_period_due_idx", where: raw("((recurrence)::text <> 'NONE'::text) AND (frozen_at IS NULL)"))
  @@index([endsAt], map: "events_due_idx", where: raw("(paid_at IS NULL)"))
  @@map("events")
}

/// D166: one row of an ended event's frozen leaderboard and its prize (`EVENT_PRIZE`, reference: this
/// id, so a prize is paid once per event and person).
model EventResult {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  /// v1.97-social (D303): `MAIN` (a D166 event's one board) or the board kind (SENDERS, RECEIVERS, AGENCIES, CP).
  board       String    @default("MAIN") @db.VarChar(10)
  /// v1.101-social (D325): the period of a recurring event (0 otherwise).
  period      Int       @default(0)
  rank        Int
  /// The person (SENDERS / RECEIVERS / MAIN), the agency's OWNER (AGENCIES) or the couple's first partner (CP).
  userId      String    @map("user_id") @db.Uuid
  /// v1.97-social (D303): what is ranked — the user id, the agency id (AGENCIES) or the couple id (CP).
  entrantKey  String    @map("entrant_key") @db.VarChar(36)
  /// v1.97-social (D303): AGENCIES — the agency; CP — the couple and its second partner (both win the bundle).
  agencyId    String?   @map("agency_id") @db.Uuid
  coupleId    String?   @map("couple_id") @db.Uuid
  partnerId   String?   @map("partner_id") @db.Uuid
  score       BigInt
  prizeCoins  Int       @default(0) @map("prize_coins")
  /// v1.97-social (D303): the prize bundle of this rank, frozen with the result (`[]` = none or not qualified).
  prize       Json      @default("[]")
  /// NONE (no prize for this rank), PENDING, PAID or FORFEITED (the account was not active).
  prizeStatus String    @default("NONE") @map("prize_status") @db.VarChar(10)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts EventPrizePayout[]

  @@unique([eventId, period, board, rank], map: "event_results_rank_once")
  @@unique([eventId, period, board, entrantKey], map: "event_results_entrant_once")
  @@index([userId], map: "event_results_user_idx")
  @@map("event_results")
}

/// v1.97-social (D303, CONVENTIONS §10.114.2): a gift that scores in an EVENT_GIFTS event — each recipient of a send
/// adds `coins × points_per_coin + quantity × points_per_gift` points (CHECK `event_gifts_points`).
model EventGift {
  eventId       String  @map("event_id") @db.Uuid
  giftCode      String  @map("gift_code") @db.VarChar(40)
  /// v1.101-social (D325): the points multiplier per coin (a decimal, 0–1000, e.g. 1.2).
  pointsPerCoin Decimal @default(1) @map("points_per_coin") @db.Decimal(7, 2)
  pointsPerGift Int     @default(0) @map("points_per_gift")
  sortOrder     Int     @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gift  Gift  @relation(fields: [giftCode], references: [code], onDelete: Restrict)

  @@id([eventId, giftCode], map: "event_gifts_pkey")
  @@index([giftCode], map: "event_gifts_gift_idx")
  @@map("event_gifts")
}

/// v1.97-social (D303, §10.114.3): one board of an EVENT_GIFTS event — SENDERS «الداعمين», RECEIVERS «المضيفين»,
/// AGENCIES «الوكالات», CP — with its qualification minimum and its prize bundles per rank range (CHECK
/// `event_boards_kind`, `event_boards_min_points`; v1.102-social `event_boards_shown`).
model EventBoard {
  id        String @id @default(uuid(7)) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  kind      String @db.VarChar(10)
  minPoints BigInt @default(0) @map("min_points")
  /// `[{rankFrom, rankTo, items: [{type: COINS|CHERRIES|BAG_ITEM|VIP, amount?, itemCode?, tierCode?, days?}]}]`.
  prizes    Json   @default("[]")
  sortOrder Int    @default(0) @map("sort_order")
  /// v1.102-social (D334): «عدد المعروضين» — how many places the board lists (1–100, default 20).
  shown     Int    @default(20)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind], map: "event_boards_kind_once")
  @@map("event_boards")
}

/// v1.97-social (D303, §10.114.4): one winner's payout of one result (CP: both partners) — once (the key); `granted`
/// lists what was given (items skipped because gone from the catalogue are listed with `skipped`).
model EventPrizePayout {
  id          String    @id @default(uuid(7)) @db.Uuid
  resultId    String    @map("result_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// PAID, or FORFEITED (the account was not ACTIVE at payout time).
  status      String    @db.VarChar(10)
  granted     Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// v1.105-social (D340, §10.134): when the winner saw the full-screen «مبروك» (null: not yet; PAID rows only).
  announcedAt DateTime? @map("announced_at") @db.Timestamptz(3)

  result EventResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resultId, userId], map: "event_prize_payouts_once")
  @@index([userId], map: "event_prize_payouts_user_idx")
  @@index([userId], map: "event_prize_payouts_unannounced_idx", where: raw("((announced_at IS NULL) AND ((status)::text = 'PAID'::text))"))
  @@map("event_prize_payouts")
}

/// v1.105-social (D340, CONVENTIONS §10.134): a person saw an event's full-screen start announcement (once).
model EventStartAnnouncement {
  eventId String   @map("event_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  seenAt  DateTime @map("seen_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId], map: "event_start_announcements_pkey")
  @@index([userId], map: "event_start_announcements_user_idx")
  @@map("event_start_announcements")
}

/// v1.101-social (D325, §10.127): one frozen period of an event (its window), written at each freeze.
model EventPeriod {
  eventId  String   @map("event_id") @db.Uuid
  period   Int
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  frozenAt DateTime @map("frozen_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, period], map: "event_periods_pkey")
  @@map("event_periods")
}

/// v1.101-social (D325, §10.127): a points threshold of an event board; every entrant reaching it gets its bundle once
/// per period (CHECK `event_milestones_shape`).
model EventMilestone {
  id        String @id @default(uuid(7)) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  board     String @db.VarChar(10)
  points    BigInt
  /// The bundle (the prize items of a prize line).
  prizes    Json   @default("[]")
  sortOrder Int    @default(0) @map("sort_order")

  event  Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grants EventMilestoneGrant[]

  @@unique([eventId, board, points], map: "event_milestones_once")
  @@map("event_milestones")
}

/// v1.101-social (D325): a milestone reached — once per milestone, person and period (the key); `granted` as payouts.
model EventMilestoneGrant {
  id          String   @id @default(uuid(7)) @db.Uuid
  milestoneId String   @map("milestone_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  period      Int      @default(0)
  score       BigInt
  status      String   @db.VarChar(10)
  granted     Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  milestone EventMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId, period], map: "event_milestone_grants_once")
  @@index([userId], map: "event_milestone_grants_user_idx")
  @@map("event_milestone_grants")
}

// ---- v1.52-social (D179, CONVENTIONS §10.46): the cherry economy, phase 1 ----------------------------

enum CherryLedgerReason {
  GIFT_RECEIVED
  AGENCY_COMMISSION
  PARENT_COMMISSION
  GIFT_REVERSAL
  AGENCY_COMMISSION_REVERSAL
  PARENT_COMMISSION_REVERSAL
  WITHDRAWAL_HOLD
  WITHDRAWAL_REFUND
  /// v1.53-social (D184): a Task Center reward (locked for withdrawal until the unlock rule passes).
  TASK_REWARD
  /// v1.54-social (D185): cherries sold to a recharge agent (reference: the request).
  RECHARGE_SALE
  /// v1.72-social (D208): a credit or debit by the team (reference: the `admin_balance_adjustments` row).
  ADMIN_ADJUSTMENT
  /// v1.74-social (D217): a referral reward credited after its hold (reference: the `referral_rewards` row).
  REFERRAL_REWARD
  /// v1.74-social (D217, owner 2026-11-01): that reward taken back when the team voided the referral (reference: the
  /// same `referral_rewards` row; the balance may go below 0 — a debt that blocks withdrawals).
  REFERRAL_REVERSAL
  /// D270 (§10.98): a store item bought with cherries (reference: the `store_purchases` row).
  STORE_PURCHASE
  /// v1.71-live (D281): a completed smart host target's profit-share reward (reference `HT:<level>@<day>`), locked
  /// for withdrawal and the store like TASK_REWARD (§10.46.1).
  HOST_TARGET_REWARD
  /// v1.75-live (D285): a recruiter's daily share of a recruit's platform profit (reference `SR:<recruitment>@<day>`),
  /// withdrawable (not locked like TASK_REWARD).
  STAFF_RECRUIT_COMMISSION
  /// v1.82-live (D295, §10.108): «حظر الوكالة» — the owner's unwithdrawn agency commission forfeited (a debit;
  /// reference: the agency).
  AGENCY_FORFEIT
  /// v1.97-social (D303, §10.114): an event prize in cherries (reference `EVP:<result>`), locked for withdrawal and the
  /// store like TASK_REWARD (§10.46.1).
  EVENT_PRIZE

  @@map("cherry_ledger_reason")
}

/// v1.53-social (D184): what a task claim paid in (claims before the migration: COINS).
enum TaskRewardCurrency {
  COINS
  CHERRIES

  @@map("task_reward_currency")
}

enum AgencyRank {
  NEW
  AGENT
  ADMIN
  LAPSED

  @@map("agency_rank")
}

/// v1.70-social (D206): an agency is OPEN or CLOSED (closed rows stay: the earnings history, the reopening).
enum AgencyStatus {
  OPEN
  CLOSED

  @@map("agency_status")
}

/// v1.70-social (D206): who made the agency — the team (D179 `agency-create`) or the person «افتح وكالة».
enum AgencyOrigin {
  ADMIN
  SELF

  @@map("agency_origin")
}

/// v1.70-social (D206): why an agency was closed.
enum AgencyCloseReason {
  PROBATION_FAILED
  ADMIN
  /// v1.82-live (D295, §10.108): «حظر الوكالة — تفعيل صانع محتوى وهمي» (OWNER); never reopened.
  BANNED

  @@map("agency_close_reason")
}

enum AgencyHostStatus {
  ACTIVE
  LEFT
  RELEASED
  MOVED

  @@map("agency_host_status")
}

enum AgencyComplaintStatus {
  OPEN
  RESOLVED
  REJECTED

  @@map("agency_complaint_status")
}

enum CherryWithdrawalStatus {
  PENDING
  PAID
  REJECTED

  @@map("cherry_withdrawal_status")
}

/// D179: a cherry balance (no row = 0); changed only with a `cherry_ledger` row. CHECK
/// `cherry_wallets_range` (may be negative only after an admin reversal).
model CherryWallet {
  userId    String   @id @map("user_id") @db.Uuid
  cherries  BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cherry_wallets")
}

/// D179: every change of a cherry balance, append-only; `(user, reason, reference)` once.
model CherryLedgerEntry {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  delta        BigInt
  balanceAfter BigInt             @map("balance_after")
  reason       CherryLedgerReason
  referenceId  String             @map("reference_id") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, referenceId], map: "cherry_ledger_reference_once")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "cherry_ledger_user_created_idx")
  @@index([referenceId], map: "cherry_ledger_reference_idx")
  @@index([userId, reason], map: "cherry_ledger_user_reason_idx")
  @@index([createdAt], map: "cherry_ledger_created_at_idx")
  @@map("cherry_ledger")
}

/// D179: a host agency (created by an admin); `rankMonth` = the month of the last month-start
/// evaluation, `evaluateFrom` = the first month start at which a NEW agency is evaluated.
model Agency {
  id                  String             @id @default(uuid(7)) @db.Uuid
  ownerUserId         String             @map("owner_user_id") @db.Uuid
  inviteCode          String             @map("invite_code") @db.VarChar(12)
  parentAgencyId      String?            @map("parent_agency_id") @db.Uuid
  rank                AgencyRank         @default(NEW)
  rankMonth           DateTime?          @map("rank_month") @db.Date
  evaluateFrom        DateTime           @map("evaluate_from") @db.Date
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// v1.58-social (D189): the host agent's code `hostNN` (their special username), given at activation.
  hostCode            String?            @map("host_code") @db.VarChar(30)
  hostCodeNumber      Int?               @map("host_code_number")
  hostCodeAt          DateTime?          @map("host_code_at") @db.Timestamptz(3)
  /// v1.58-social (D189): the team suspended the host agent (every perk removed at once).
  suspendedAt         DateTime?          @map("suspended_at") @db.Timestamptz(3)
  suspendReason       String?            @map("suspend_reason") @db.VarChar(500)
  /// v1.70-social (D206, §10.65): the agency's name (agencies made by the team before D206 have none).
  name                String?            @db.VarChar(40)
  origin              AgencyOrigin       @default(ADMIN)
  status              AgencyStatus       @default(OPEN)
  /// v1.70-social (D206): a self-opened agency's probation — it must activate AGENCY_PROBATION_MIN_HOSTS hosts
  /// before `probationEndsAt`; `probationPassedAt` once it did (NULL both: no probation, e.g. made by the team).
  probationEndsAt     DateTime?          @map("probation_ends_at") @db.Timestamptz(3)
  probationPassedAt   DateTime?          @map("probation_passed_at") @db.Timestamptz(3)
  /// The 24-hours-left reminder was sent for the current `probationEndsAt`.
  probationRemindedAt DateTime?          @map("probation_reminded_at") @db.Timestamptz(3)
  /// The activated hosts counted when the probation passed or failed.
  probationActivated  Int?               @map("probation_activated")
  closedAt            DateTime?          @map("closed_at") @db.Timestamptz(3)
  closeReason         AgencyCloseReason? @map("close_reason")
  closeNote           String?            @map("close_note") @db.VarChar(500)

  owner              User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  parent             Agency?              @relation("AgencyParent", fields: [parentAgencyId], references: [id], onDelete: SetNull)
  subAgencies        Agency[]             @relation("AgencyParent")
  hosts              AgencyHost[]
  earnings           AgencyEarning[]
  months             AgencyMonth[]
  applications       AgencyApplication[]
  notifications      Notification[]
  /// v1.82-live (D295): the creators this agency activated, and its ban (if any).
  creatorActivations CreatorApplication[] @relation("CreatorActivatingAgency")
  ban                AgencyBan?

  @@unique([ownerUserId], map: "agencies_owner_once")
  @@unique([inviteCode], map: "agencies_invite_code_key")
  @@unique([hostCode], map: "agencies_host_code_key")
  @@unique([hostCodeNumber], map: "agencies_host_code_number_key")
  @@index([parentAgencyId], map: "agencies_parent_idx")
  @@index([probationEndsAt], map: "agencies_probation_running_idx", where: raw("status = 'OPEN'::agency_status AND probation_ends_at IS NOT NULL AND probation_passed_at IS NULL"))
  @@index([status, closedAt], map: "agencies_status_closed_idx")
  @@map("agencies")
}

/// v1.70-social (D206, §10.65): an application «افتح وكالة» — kept with the agency for the team (the agency is
/// made at once; no approval). PRIVATE: the fields and the two pictures (the D185 private uploads) are read only in
/// the panel, every view audited. `(user, clientKey)` once: the `Idempotency-Key`.
model AgencyApplication {
  id              String    @id @default(uuid(7)) @db.Uuid
  agencyId        String    @map("agency_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  clientKey       String    @map("client_key") @db.Uuid
  requestHash     String    @map("request_hash") @db.Char(64)
  name            String    @db.VarChar(40)
  country         String    @db.Char(2)
  contactType     String    @map("contact_type") @db.VarChar(16)
  contactValue    String?   @map("contact_value") @db.VarChar(100)
  expectedHosts   Int       @map("expected_hosts")
  bio             String?   @db.VarChar(300)
  photoKey        String?   @map("photo_key") @db.VarChar(256)
  selfieKey       String?   @map("selfie_key") @db.VarChar(256)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  purgedAt        DateTime? @map("purged_at") @db.Timestamptz(3)
  /// v1.75-live (D285): the Kabso Team member who referred the applicant (MODERATION / BD), if named.
  recruiterUserId String?   @map("recruiter_user_id") @db.Uuid

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruiter User?  @relation("AgencyApplicationRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)

  @@unique([userId, clientKey], map: "agency_applications_client_once")
  @@index([agencyId, createdAt(sort: Desc)], map: "agency_applications_agency_idx")
  @@index([userId, createdAt(sort: Desc)], map: "agency_applications_user_idx")
  @@map("agency_applications")
}

/// D179: a host's link to an agency (one ACTIVE per host, partial unique `agency_hosts_one_active`).
model AgencyHost {
  id                 String           @id @default(uuid(7)) @db.Uuid
  agencyId           String           @map("agency_id") @db.Uuid
  hostUserId         String           @map("host_user_id") @db.Uuid
  status             AgencyHostStatus @default(ACTIVE)
  commissionEligible Boolean          @map("commission_eligible")
  activatedAt        DateTime         @default(now()) @map("activated_at") @db.Timestamptz(3)
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz(3)

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  host       User              @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  earnings   AgencyEarning[]
  complaints AgencyComplaint[]

  @@unique([hostUserId], map: "agency_hosts_one_active", where: raw("status = 'ACTIVE'::agency_host_status"))
  @@index([agencyId, status, activatedAt(sort: Desc)], map: "agency_hosts_agency_idx")
  @@index([hostUserId, activatedAt(sort: Desc)], map: "agency_hosts_host_idx")
  @@map("agency_hosts")
}

/// D179: a linked host's cherries from one send and the commissions paid on them.
model AgencyEarning {
  id               String    @id @default(uuid(7)) @db.Uuid
  giftId           String    @map("gift_id") @db.Uuid
  agencyId         String    @map("agency_id") @db.Uuid
  agencyHostId     String    @map("agency_host_id") @db.Uuid
  hostUserId       String    @map("host_user_id") @db.Uuid
  hostCherries     BigInt    @map("host_cherries")
  rateBps          Int       @map("rate_bps")
  commission       BigInt
  parentAgencyId   String?   @map("parent_agency_id") @db.Uuid
  parentRateBps    Int       @map("parent_rate_bps")
  parentCommission BigInt    @map("parent_commission")
  month            DateTime  @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz(3)

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  link   AgencyHost @relation(fields: [agencyHostId], references: [id], onDelete: Cascade)

  @@unique([giftId, hostUserId], map: "agency_earnings_once")
  @@index([agencyId, month, hostUserId], map: "agency_earnings_agency_month_idx")
  @@index([agencyHostId], map: "agency_earnings_link_idx")
  @@index([parentAgencyId, month], map: "agency_earnings_parent_idx")
  @@index([createdAt], map: "agency_earnings_created_at_idx")
  @@map("agency_earnings")
}

/// D179: an agency's month totals (hosts' cherries, commission, parent commission).
model AgencyMonth {
  agencyId         String   @map("agency_id") @db.Uuid
  month            DateTime @db.Date
  hostCherries     BigInt   @default(0) @map("host_cherries")
  commission       BigInt   @default(0)
  parentCommission BigInt   @default(0) @map("parent_commission")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([agencyId, month], map: "agency_months_pkey")
  @@map("agency_months")
}

/// D179: a host's complaint after the leave window (resolved by an admin with economy-admin).
model AgencyComplaint {
  id           String                @id @default(uuid(7)) @db.Uuid
  agencyHostId String                @map("agency_host_id") @db.Uuid
  hostUserId   String                @map("host_user_id") @db.Uuid
  agencyId     String                @map("agency_id") @db.Uuid
  text         String                @db.VarChar(1000)
  status       AgencyComplaintStatus @default(OPEN)
  resolution   String?               @db.VarChar(10)
  note         String?               @db.VarChar(500)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime?             @map("resolved_at") @db.Timestamptz(3)

  link AgencyHost @relation(fields: [agencyHostId], references: [id], onDelete: Cascade)

  @@unique([agencyHostId], map: "agency_complaints_one_open", where: raw("status = 'OPEN'::agency_complaint_status"))
  @@index([status, createdAt], map: "agency_complaints_status_idx")
  @@index([agencyId], map: "agency_complaints_agency_idx")
  @@index([hostUserId], map: "agency_complaints_host_idx")
  @@map("agency_complaints")
}

/// D179: a withdrawal request, paid by hand by an admin (no payment provider yet).
model CherryWithdrawal {
  id            String                 @id @default(uuid(7)) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  cherries      BigInt
  amountMinor   BigInt                 @map("amount_minor")
  currency      String                 @db.Char(3)
  rateCherries  BigInt                 @map("rate_cherries")
  rateMinor     Int                    @map("rate_minor")
  payoutDetails String                 @map("payout_details") @db.VarChar(500)
  status        CherryWithdrawalStatus @default(PENDING)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime?              @map("decided_at") @db.Timestamptz(3)
  decisionNote  String?                @map("decision_note") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId], map: "cherry_withdrawals_client_once")
  @@unique([userId], map: "cherry_withdrawals_one_pending", where: raw("status = 'PENDING'::cherry_withdrawal_status"))
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "cherry_withdrawals_user_created_idx")
  @@index([status, createdAt], map: "cherry_withdrawals_status_idx")
  @@index([decidedAt], map: "cherry_withdrawals_decided_at_idx", where: raw("(status = 'PAID'::cherry_withdrawal_status)"))
  @@map("cherry_withdrawals")
}

// ---- v1.54-social (D185, CONVENTIONS §10.48): recharge agents «وكلاء الشحن» ------------------------------

enum RechargeApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("recharge_application_status")
}

enum RechargeAgentStatus {
  APPROVED
  ACTIVE
  SUSPENDED

  @@map("recharge_agent_status")
}

enum RechargeStockReason {
  TOPUP
  SALE
  CHERRY_PURCHASE
  /// v1.69-social (D204): coins frozen for an order when the payment details are sent (reference: the order),
  /// and frozen coins given back to the stock (a cancellation, an expiry or a dispute refunded to the agent).
  ORDER_HOLD
  ORDER_RELEASE

  @@map("recharge_stock_reason")
}

enum RechargeCherryRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("recharge_cherry_request_status")
}

/// D185: an application «كن وكيل شحن». PRIVATE (admins only, through the recharge-admin CLI, audited); the
/// personal fields are NULL once `purgedAt` is set (retention).
model RechargeAgentApplication {
  id              String                    @id @default(uuid(7)) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  status          RechargeApplicationStatus @default(PENDING)
  fullName        String?                   @map("full_name") @db.VarChar(120)
  phone           String?                   @db.VarChar(16)
  photoKey        String?                   @map("photo_key") @db.VarChar(256)
  selfieKey       String?                   @map("selfie_key") @db.VarChar(256)
  locations       Json?
  paymentMethods  Json?                     @map("payment_methods")
  rejectReason    String?                   @map("reject_reason") @db.VarChar(500)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?                 @map("decided_at") @db.Timestamptz(3)
  purgedAt        DateTime?                 @map("purged_at") @db.Timestamptz(3)
  /// v1.75-live (D285): the Kabso Team member who referred the applicant (MODERATION / BD), if named.
  recruiterUserId String?                   @map("recruiter_user_id") @db.Uuid

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     RechargeAgent?
  recruiter User?          @relation("RechargeApplicationRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)

  @@unique([userId], map: "recharge_agent_applications_one_pending", where: raw("status = 'PENDING'::recharge_application_status"))
  @@index([userId, createdAt(sort: Desc)], map: "recharge_agent_applications_user_idx")
  @@index([status, createdAt], map: "recharge_agent_applications_status_idx")
  @@map("recharge_agent_applications")
}

/// D185: a recharge agent (from approval on). `code` is given at activation and never changes.
model RechargeAgent {
  userId               String              @id @map("user_id") @db.Uuid
  applicationId        String              @unique(map: "recharge_agents_application_key") @map("application_id") @db.Uuid
  status               RechargeAgentStatus @default(APPROVED)
  code                 String?             @unique(map: "recharge_agents_code_key") @db.VarChar(16)
  codeNumber           Int?                @unique(map: "recharge_agents_code_number_key") @map("code_number")
  stockCoins           BigInt              @default(0) @map("stock_coins")
  dailyCherryCap       BigInt?             @map("daily_cherry_cap")
  countries            String[]            @db.VarChar(2)
  locations            Json
  paymentTypes         Json                @map("payment_types")
  availability         Json                @default("[]")
  availabilityTimeZone String              @default("UTC") @map("availability_time_zone") @db.VarChar(64)
  suspendReason        String?             @map("suspend_reason") @db.VarChar(500)
  approvedAt           DateTime            @default(now()) @map("approved_at") @db.Timestamptz(3)
  activatedAt          DateTime?           @map("activated_at") @db.Timestamptz(3)
  suspendedAt          DateTime?           @map("suspended_at") @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    RechargeAgentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stockLedger    RechargeStockEntry[]
  topups         RechargeTopup[]
  sales          RechargeSale[]
  employees      RechargeEmployee[]
  cherryRequests RechargeCherryRequest[]
  orders         RechargeOrder[]

  @@index([countries], map: "recharge_agents_countries_idx", type: Gin)
  @@map("recharge_agents")
}

/// D185: the last code number given (one row, id 1).
model RechargeAgentCounter {
