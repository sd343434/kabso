  DISMISSED

  @@map("report_status")
}

/// A presigned upload slot (§11.1). Closed by `complete` (COMPLETED/FAILED) or the sweeper.
model MediaUpload {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  kind         String            @db.VarChar(32)
  contentType  String            @map("content_type") @db.VarChar(64)
  byteSize     Int               @map("byte_size")
  objectKey    String            @map("object_key") @db.VarChar(256)
  status       MediaUploadStatus @default(PENDING)
  mediaAssetId String?           @unique @map("media_asset_id") @db.Uuid
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "media_uploads_user_created_idx")
  @@index([expiresAt], map: "media_uploads_pending_expiry_idx", where: raw("status = 'PENDING'::media_upload_status"))
  @@map("media_uploads")
}

/// A processed image (WebP 1080, or 1920 for a story, and 320). Attached to at most one post or
/// story, of its `kind` (CP-008).
model MediaAsset {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  /// `POST_IMAGE`, `STORY_IMAGE`, `LIVE_COVER`, `LIVE_CHAT_IMAGE` or `LIVE_CHAT_VOICE` (the
  /// upload's kind).
  kind       String    @default("POST_IMAGE") @db.VarChar(32)
  /// 0 for a `LIVE_CHAT_VOICE` clip (CP-017).
  width      Int
  height     Int
  /// CP-017: a `LIVE_CHAT_VOICE` clip's length (≤ 30 000 ms); null for images. D162: a video's
  /// length (`POST_VIDEO` ≤ 180 000, `REEL_VIDEO` ≤ 60 000). D168: new `POST_VIDEO` rows ≤ 90 000
  /// (CHECK `media_assets_post_video_90s`, NOT VALID: older rows keep their length).
  durationMs Int?      @map("duration_ms")
  blurhash   String?   @db.VarChar(64)
  /// D162: a video's file (`media/{id}/video.mp4|.mov`); otherwise the large WebP.
  largeKey   String    @map("large_key") @db.VarChar(256)
  /// D162: a video's poster at 320 px.
  thumbKey   String    @map("thumb_key") @db.VarChar(256)
  /// D162: a video's poster at 1 080 px (the consumed `VIDEO_POSTER`); null for other kinds.
  posterKey  String?   @map("poster_key") @db.VarChar(256)
  byteSize   Int       @map("byte_size")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attachedAt DateTime? @map("attached_at") @db.Timestamptz(3)

  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  upload          MediaUpload?
  postMedia       PostMedia?
  story           Story?
  liveCover       LiveHost?
  chatMessage     LiveChatMessage?
  /// CP-018: a family's emblem.
  familyEmblem    Family?
  /// CP-022: a family's cover.
  familyCover     Family?            @relation("FamilyCover")
  /// D124: a home banner's picture (v1.97-social, D303: a video banner's poster).
  homeBanner      HomeBanner?        @relation("HomeBannerMedia")
  /// v1.97-social (D303): a video banner's `BANNER_VIDEO`.
  homeBannerVideo HomeBanner?        @relation("HomeBannerVideo")
  /// v1.101-social (D325): the event whose Live home banner this is (before publish).
  eventBanners    Event[]            @relation("EventBannerMedia")
  /// D155: a direct message's picture or voice clip.
  dmMessage       DmMessage?
  /// v1.104-social (D339): a group message's picture or voice clip, and a group's photo.
  dmGroupMessage  DmGroupMessage?
  dmGroupPhoto    DmGroup?           @relation("DmGroupPhoto")
  /// D168: a profile photo.
  profileAvatar   UserProfile?       @relation("ProfileAvatar")
  /// D218: a profile cover.
  profileCover    UserProfile?       @relation("ProfileCover")
  /// v1.89-social (D290): the video of a level-raise request.
  levelRaise      LevelRaiseRequest?
  /// v1.95-social (D301): the owner's cover video (one language).
  ownerCoverVideo OwnerCoverVideo?

  @@index([createdAt], map: "media_assets_unattached_idx", where: raw("attached_at IS NULL"))
  @@map("media_assets")
}

/// A post (§11.2). CHECKs: text or media (app), counters ≥ 0, `publish_at` for SCHEDULED.
model Post {
  id              String         @id @default(uuid(7)) @db.Uuid
  authorId        String         @map("author_id") @db.Uuid
  text            String         @default("") @db.VarChar(2200)
  /// D162: `REEL` — one `REEL_VIDEO`, listed by the reels feed only.
  format          PostFormat     @default(POST)
  /// v1.72-live (D283, §10.96.10): an official announcement «إعلان رسمي — فريق كابسو» — only the Kabso Team
  /// creates one, and a limited staff account (MODERATION / SUPPORT / FINANCE) creates nothing else. Never changes.
  announcement    Boolean        @default(false)
  /// v1.95-social (D301, §10.112.2): the app owner marked it «رسمي» (an official announcement on his profile).
  officialAt      DateTime?      @map("official_at") @db.Timestamptz(3)
  /// v1.95-social (D301 follow-up, §10.112.7): the official announcement's English caption (`text` is the Arabic one).
  textEn          String?        @map("text_en") @db.VarChar(2200)
  location        String?        @db.VarChar(80)
  status          PostStatus     @default(PUBLISHED)
  moderation      PostModeration @default(VISIBLE)
  publishAt       DateTime?      @map("publish_at") @db.Timestamptz(3)
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(3)
  editedAt        DateTime?      @map("edited_at") @db.Timestamptz(3)
  commentsEnabled Boolean        @default(true) @map("comments_enabled")
  whoCanComment   WhoCanComment  @default(EVERYONE) @map("who_can_comment")
  hideLikeCount   Boolean        @default(false) @map("hide_like_count")
  likeCount       Int            @default(0) @map("like_count")
  commentCount    Int            @default(0) @map("comment_count")
  shareCount      Int            @default(0) @map("share_count")
  repostCount     Int            @default(0) @map("repost_count")
  saveCount       Int            @default(0) @map("save_count")
  viewCount       Int            @default(0) @map("view_count")
  /// `Idempotency-Key` of createPost and the SHA-256 of its body (kept 24 h, §11.2).
  idempotencyKey  String?        @map("idempotency_key") @db.Uuid
  requestHash     String?        @map("request_hash") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  author        User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  likes         PostLike[]
  saves         PostSave[]
  reposts       PostRepost[]
  views         PostView[]
  shares        PostShareEvent[]
  pin           PostPin?
  /// D301 follow-up: the announcement's notification fan-out (official posts only).
  ownerFanout   OwnerAnnouncementFanout?
  hashtags      PostHashtag[]
  mentions      PostMention[]
  comments      Comment[]
  hides         PostHide[]
  reports       Report[]
  notifications Notification[]

  @@unique([authorId, idempotencyKey], map: "posts_author_idempotency_key")
  @@index([authorId, publishedAt(sort: Desc), id(sort: Desc)], map: "posts_author_published_idx", where: raw("status = 'PUBLISHED'::post_status AND deleted_at IS NULL"))
  @@index([publishedAt(sort: Desc), id(sort: Desc)], map: "posts_published_idx", where: raw("status = 'PUBLISHED'::post_status AND deleted_at IS NULL AND moderation = 'VISIBLE'::post_moderation"))
  @@index([publishAt], map: "posts_scheduled_due_idx", where: raw("status = 'SCHEDULED'::post_status AND deleted_at IS NULL"))
  @@index([authorId, status, createdAt(sort: Desc)], map: "posts_author_status_created_idx")
  @@index([authorId, publishedAt(sort: Desc), id(sort: Desc)], map: "posts_reels_author_published_idx", where: raw("format = 'REEL'::post_format AND status = 'PUBLISHED'::post_status AND deleted_at IS NULL"))
  /// v1.95-social (D301): the owner's official announcements, newest first.
  /// D301 follow-up: the latest official announcement (the posts feed's first item).
  @@index([officialAt(sort: Desc)], map: "posts_official_latest_idx", where: raw("official_at IS NOT NULL"))
  @@index([authorId, publishedAt(sort: Desc), id(sort: Desc)], map: "posts_official_author_published_idx", where: raw("official_at IS NOT NULL AND status = 'PUBLISHED'::post_status AND deleted_at IS NULL"))
  @@map("posts")
}

model PostMedia {
