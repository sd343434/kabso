/// One row per viewer and post; `viewed_at` moves when a new 24-hour view counts (§11.4).
model PostView {
  postId       String   @map("post_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  viewedAt     DateTime @map("viewed_at") @db.Timestamptz(3)
  /// D300 (§10.111): the §11.4 views this row has counted (1 per rolling 24 h; rows before D300 start at 1) — a
  /// creator's views from ACTIVE viewers are summed from it. CHECK ≥ 1.
  countedViews Int      @default(1) @map("counted_views")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId], map: "post_views_pkey")
  @@index([userId], map: "post_views_user_id_idx")
  @@map("post_views")
}

/// One counted outside share per user, post and UTC day.
