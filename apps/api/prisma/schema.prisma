// Kabso Live — Phase 1 schema (identity, sessions, verification tokens, audit log).
// Conventions: snake_case tables/columns via @@map/@map, UUIDv7 ids, timestamptz(3).
// Ownership: auth module owns sessions/verification_tokens; users module owns users,
// user_profiles, user_settings; audit_logs is append-only (common). Phase 2 (contract v1.3,
// docs/contracts/DB_PHASE2_DISCOVERY.md): live module owns live_categories, live_rooms; social
// module owns follows. v1.4-levels (DRAFT, CP-005): the levels module owns every `level_*` table,
// `user_level_states` and `points_ledger`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  /// v1.62-social (D193, CONVENTIONS §10.56): the person asked for the account to be deleted; hidden from everyone
  /// and signed out for the grace period (30 days), then purged (status DELETED, a tombstone without personal data).
  PENDING_DELETION

  @@map("user_status")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("verification_purpose")
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed + lowercased) before write; unique.
  email           String     @unique @db.VarChar(254)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Argon2id PHC string.
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(USER)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// v1.25-live (CP-022, D116): the last authenticated request (written at most once a minute);
  /// online = within the last 5 minutes. Shown only as CONVENTIONS §10.25 allows.
  lastActiveAt    DateTime?  @map("last_active_at") @db.Timestamptz(3)

  /// v1.72-social (D208, CONVENTIONS §10.67): set by the team (a temporary password or «فرض تغيير كلمة المرور»);
  /// the next sign-in must choose a new password (`login` with `newPassword`), which clears it.
  passwordChangeRequiredAt DateTime? @map("password_change_required_at") @db.Timestamptz(3)

  profile                UserProfile?
  settings               UserSettings?
  sessions               Session[]
  verificationTokens     VerificationToken[]
  auditLogs              AuditLog[]
  liveRooms              LiveRoom[]
  liveHost               LiveHost?                  @relation("LiveHostUser")
  liveHostsGranted       LiveHost[]                 @relation("LiveHostGrantedBy")
  liveViews              LiveRoomViewer[]
  /// v1.64-live (D260): the panel staff member's shift, the lives assigned to them, their visible watches.
  adminShift             AdminShift?
  /// v1.72-live (D283): the regions a MODERATION / SUPPORT staff member is responsible for.
  staffRegions           AdminStaffRegion[]
  /// v1.73-live (D283c): the official staff ID «Kabso01» given on the first panel role (kept, never reused).
  staffNumber            StaffId?
  liveAssignments        LiveRoomAssignment[]
  liveStaffWatches       LiveRoomStaffWatcher[]
  /// v1.27.6-live (D140): the lives this user watched (statistics only).
  liveAudience           LiveRoomAudience[]
  liveSeats              LiveRoomSeat[]
  liveSeatRequests       LiveSeatRequest[]
  liveSeatInvites        LiveSeatInvite[]           @relation("LiveSeatInvitee")
  liveSeatInvitesBy      LiveSeatInvite[]           @relation("LiveSeatInviter")
  liveModeratorOf        LiveRoomModerator[]
  liveTaps               LiveRoomTapper[]
  liveChatMessages       LiveChatMessage[]          @relation("LiveChatAuthor")
  liveChatDeletions      LiveChatMessage[]          @relation("LiveChatDeleter")
  liveChatMutes          LiveChatMute[]             @relation("LiveChatMuted")
  liveChatMutesBy        LiveChatMute[]             @relation("LiveChatMutedBy")
  liveKicks              LiveRoomKick[]             @relation("LiveKicked")
  liveKicksBy            LiveRoomKick[]             @relation("LiveKickedBy")
  following              Follow[]                   @relation("FollowFollower")
  followers              Follow[]                   @relation("FollowFollowee")
  /// v1.47-social (D175): follow requests sent to private accounts / received while private.
  followRequestsSent     FollowRequest[]            @relation("FollowRequestRequester")
  followRequestsReceived FollowRequest[]            @relation("FollowRequestTarget")
  /// v1.47-social (D175): up to 3 profile links (§10.47).
  profileLinks           UserProfileLink[]
  levelStates            UserLevelState[]
  pointsEntries          PointsLedgerEntry[]
  levelHistory           LevelHistory[]
  adminPermissions       UserAdminPermission[]
  /// v1.60-social (D191): the admin panel's second factor and sessions.
  adminCredential        AdminCredential?
  adminRecoveryCodes     AdminRecoveryCode[]
  adminSessions          AdminSession[]
  /// v1.68-live (D273): the staff tools' step-up grants in the app.
  adminAppGrants         AdminAppGrant[]
  mediaUploads           MediaUpload[]
  mediaAssets            MediaAsset[]
  posts                  Post[]
  postLikes              PostLike[]
  postSaves              PostSave[]
  postReposts            PostRepost[]
  postViews              PostView[]
  postShareEvents        PostShareEvent[]
  postPins               PostPin[]
  postMentions           PostMention[]
  comments               Comment[]
  commentLikes           CommentLike[]
  commentMentions        CommentMention[]
  blocking               UserBlock[]                @relation("BlockBlocker")
  blockedBy              UserBlock[]                @relation("BlockBlocked")
  muting                 UserMute[]                 @relation("MuteMuter")
  mutedBy                UserMute[]                 @relation("MuteMuted")
  postHides              PostHide[]
  reportsMade            Report[]                   @relation("ReportReporter")
  reportsAgainst         Report[]                   @relation("ReportTargetUser")
  reportsResolved        Report[]                   @relation("ReportResolver")
  privacySettings        PrivacySettings?
  stories                Story[]
  storyViews             StoryView[]
  storyMentions          StoryMention[]
  notifications          Notification[]
  notificationActs       NotificationActor[]
  notificationPrefs      NotificationSettings?
  livePointsHourly       LiveHostPointsHourly[]     @relation("LiveHostPointsHourly")
  /// v1.87-live (D314, §10.119): the same points per local month (the month / year boards).
  livePointsMonthly      LiveHostPointsMonthly[]    @relation("LiveHostPointsMonthly")
  liveScheduleSlots      LiveScheduleSlot[]         @relation("LiveScheduleSlots")
  wallet                 Wallet?
  walletLedger           WalletLedgerEntry[]
  liveBullets            LiveBullet[]
  // v1.21-live (CP-018, D106): families, CP couples and medals.
  familyMember           FamilyMember?
  familiesCreated        Family[]                   @relation("FamilyCreatedBy")
  familyJoinRequests     FamilyJoinRequest[]        @relation("FamilyJoinRequester")
  familyJoinHandled      FamilyJoinRequest[]        @relation("FamilyJoinHandler")
  familyPoints           FamilyPointsEntry[]
  cpRequestsSent         CpRequest[]                @relation("CpRequestSender")
  cpRequestsReceived     CpRequest[]                @relation("CpRequestReceiver")
  cpCouplesA             CpCouple[]                 @relation("CpCoupleA")
  cpCouplesB             CpCouple[]                 @relation("CpCoupleB")
  cpCouplesEnded         CpCouple[]                 @relation("CpCoupleEndedBy")
  cpPartner              CpPartner?                 @relation("CpPartnerUser")
  cpPartnerOf            CpPartner[]                @relation("CpPartnerOther")
  cpGiftsSent            CpGift[]                   @relation("CpGiftSender")
  cpGiftsReceived        CpGift[]                   @relation("CpGiftReceiver")
  cpCheckIns             CpCheckIn[]
  cpTaskClaims           CpTaskClaim[]
  cpConfessionsSent      CpConfession[]             @relation("CpConfessionAuthor")
  cpConfessionsGot       CpConfession[]             @relation("CpConfessionRecipient")
  cpConfessionsDel       CpConfession[]             @relation("CpConfessionDeleter")
  medals                 UserMedal[]
  /// D291: running medal metric totals (GIFTS_SENT_COINS).
  medalMetricTotals      MedalMetricTotal[]
  // v1.22-live (CP-019, D107): the bag (owned profile cards and later categories).
  bagItems               UserBagItem[]              @relation("BagItemOwner")
  /// v1.48-social (D171): bag items this user sent (as the latest giver) and the transfer ledger.
  bagItemsGifted         UserBagItem[]              @relation("BagItemGiftedBy")
  hostFrameChoice        HostFrameChoice?
  // v1.43-live (D195, CP-038): PK 1 v 1 battles between hosts.
  pkMatchesAsA           PkMatch[]                  @relation("PkMatchHostA")
  pkMatchesAsB           PkMatch[]                  @relation("PkMatchHostB")
  pkInvitesSent          PkInvite[]                 @relation("PkInviteFrom")
  pkInvitesReceived      PkInvite[]                 @relation("PkInviteTo")
  pkQueueEntry           PkQueueEntry?
  pkRecord               PkHostRecord?
  /// v1.50-live (D229): «PK أحكام».
  pkDareReports          PkDareReport[]
  pkDareSeen             PkDareSeen?
  pkPointEvents          PkPointEvent[]
  pkSettings             PkHostSettings?
  pkSupports             PkSupporter[]
  // v1.45-live (D201): the host's second camera and the one-time music-rights notice.
  liveSecondCameras      LiveSecondCamera[]
  liveMusicRights        LiveMusicRightsAcceptance?
  bagTransfersSent       BagTransfer[]              @relation("BagTransferSender")
  bagTransfersRecvd      BagTransfer[]              @relation("BagTransferRecipient")
  // v1.23-live (CP-020, D108): live gifts and the gift bag.
  giftStock              UserGiftStock[]
  giftsSent              LiveGift[]
  giftsReceived          LiveGiftRecipient[]
  // v1.25-live (CP-022, D116): family chat.
  familyChatMessages     FamilyChatMessage[]        @relation("FamilyChatAuthor")
  familyChatDeleted      FamilyChatMessage[]        @relation("FamilyChatDeleter")
  familyChatMutes        FamilyChatMute[]           @relation("FamilyChatMuted")
  familyChatMutesBy      FamilyChatMute[]           @relation("FamilyChatMutedBy")
  // v1.27-live (D132): lucky gifts — the audit rows of the caller's lucky sends and the 18+ statement.
  luckyDraws             LuckyGiftDraw[]
  luckyAgeConfirm        LuckyGiftAgeConfirmation?
  /// v1.30-live (D148): the caller's losing lucky draws in a row (the guarantee).
  luckyPity              LuckyGiftPity?
  /// v1.33-live (D154b): traffic cards held, bought and received.
  boostCards             LiveBoostCard[]
  boostsBought           LiveBoost[]                @relation("LiveBoostBuyer")
  boostsReceived         LiveBoost[]                @relation("LiveBoostHost")
  /// v1.35-live (D154d): the summaries of the user's ended lives (the data center).
  liveSummaries          LiveSummary[]
  /// v1.32-live (D154): the free quips the user sent (one per live).
  freeQuips              LiveFreeQuip[]
  watchSuggestions       LiveWatchSuggestion[]
  // v1.27.1-live (D133): featured on the live hub.
  liveFeatured           LiveFeaturedHost?
  // v1.28-live (D146): premium usernames.
  premiumLeases          PremiumUsernameLease[]
  premiumPayments        PremiumUsernamePayment[]
  /// v1.30-live (D152): push tokens of the user's sessions.
  deviceTokens           DeviceToken[]
  // v1.40-social (D155): direct messages.
  dmConversationsLow     DmConversation[]           @relation("DmConversationLow")
  dmConversationsHigh    DmConversation[]           @relation("DmConversationHigh")
  dmParticipants         DmParticipant[]            @relation("DmParticipantUser")
  dmPeerOf               DmParticipant[]            @relation("DmParticipantPeer")
  dmSent                 DmMessage[]                @relation("DmMessageSender")
  dmReceived             DmMessage[]                @relation("DmMessageRecipient")
  dmHides                DmMessageHide[]
  // v1.104-social (D339): group messages «رسائل جماعية».
  dmGroupsCreated        DmGroup[]                  @relation("DmGroupCreator")
  dmGroupMemberships     DmGroupMember[]            @relation("DmGroupMemberUser")
  dmGroupMessagesSent    DmGroupMessage[]           @relation("DmGroupMessageSender")
  // v1.44-social (D166): the Me hub's programs.
  taskClaims             TaskClaim[]
  taskAssignments        TaskAssignment[]
  /// v1.71-live (D281): the host's smart daily targets.
  hostTargetAssignments  HostTargetAssignment[]
  dailyCheckIns          DailyCheckIn[]
  eventResults           EventResult[]
  /// v1.97-social (D303): event prizes paid to the person (one row per result and winner).
  eventPrizePayouts      EventPrizePayout[]
  /// v1.105-social (D340): the event starts this person saw full screen.
  eventStartsSeen        EventStartAnnouncement[]
  /// v1.97-social (D303 follow-up): event badges the person holds (until `expires_at`).
  eventBadges            UserEventBadge[]
  /// v1.101-social (D325): event milestones the person reached.
  eventMilestoneGrants   EventMilestoneGrant[]
  // v1.52-social (D179): the cherry economy.
  cherryWallet           CherryWallet?
  cherryLedger           CherryLedgerEntry[]
  ownedAgency            Agency?
  /// v1.70-social (D206): the person's applications «افتح وكالة».
  agencyApplications     AgencyApplication[]
  /// v1.73-social (D209): the person's applications «كن مضيفاً مع الإدارة», and those a team member decided.
  hostApplications       HostApplication[]          @relation("HostApplicant")
  hostAppsDecided        HostApplication[]          @relation("HostApplicationDecider")
  /// v1.75-live (D285, §10.96.13): recruitment by staff — the applications naming the person as their recruiter, the
  /// recruitments they made / that attribute them, their commissions; the creator programme «صانع المحتوى».
  agencyAppsReferred     AgencyApplication[]        @relation("AgencyApplicationRecruiter")
  hostAppsReferred       HostApplication[]          @relation("HostApplicationRecruiter")
  rechargeAppsReferred   RechargeAgentApplication[] @relation("RechargeApplicationRecruiter")
  creatorAppsReferred    CreatorApplication[]       @relation("CreatorApplicationRecruiter")
  creatorApplications    CreatorApplication[]       @relation("CreatorApplicant")
  creatorAppsDecided     CreatorApplication[]       @relation("CreatorApplicationDecider")
  /// v1.82-live (D295): creator memberships this staff member ended; agencies they banned / owned when banned.
  creatorAppsRevoked     CreatorApplication[]       @relation("CreatorMembershipRevoker")
  agencyBansMade         AgencyBan[]                @relation("AgencyBanBy")
  agencyBansOwned        AgencyBan[]                @relation("AgencyBanOwner")
  creatorMember          CreatorMember?
  recruitsMade           StaffRecruitment[]         @relation("StaffRecruiter")
  /// v1.89-social (D290): level-raise requests «طلب رفع ليفيل» about this supporter, made by this staff member, decided
  /// by this OWNER.
  levelRaisesAbout       LevelRaiseRequest[]        @relation("LevelRaiseSupporter")
  levelRaisesRequested   LevelRaiseRequest[]        @relation("LevelRaiseRequester")
  levelRaisesDecided     LevelRaiseRequest[]        @relation("LevelRaiseDecider")
  /// v1.90-social (D293): the automatic verification badge «شارة التوثيق» (none = no row).
  verificationBadge      UserVerificationBadge?
  recruitedAs            StaffRecruitment[]         @relation("StaffRecruit")
  recruitCommissions     StaffRecruitCommission[]
  /// v1.108-social (D343): the supervisor whose staff ID this account was created with, and the sign-ups a supervisor
  /// brought with theirs.
  signupRecruit          StaffSignupRecruit?        @relation("StaffSignupRecruit")
  signupRecruitsMade     StaffSignupRecruit[]       @relation("StaffSignupRecruiter")
  /// v1.108-social (D343): the keyed hash of the mailbox this account was created with («not a new person» check).
  signupEmailMark        SignupEmailMark?
  /// v1.74-social (D217): the person's invite code, whom they invited, who invited them, their rewards.
  referralCode           ReferralCode?
  referralsMade          Referral[]                 @relation("ReferralInviter")
  referredBy             Referral?                  @relation("ReferralInvitee")
  /// v1.60-live (D250, §10.91): the team's actions on the person's lives and those they took; device bans.
  liveModerations        LiveModerationAction[]     @relation("LiveModerationHost")
  liveModerationsBy      LiveModerationAction[]     @relation("LiveModerationActor")
  deviceBansFrom         DeviceBan[]                @relation("DeviceBanSource")
  deviceBansBy           DeviceBan[]                @relation("DeviceBanCreatedBy")
  deviceBansLiftedBy     DeviceBan[]                @relation("DeviceBanLiftedBy")
  referralsDecided       Referral[]                 @relation("ReferralDecider")
  referralRewards        ReferralReward[]
  /// v1.78-social (D223): the device this account was created on (when the app sent one), and the device exceptions
  /// an OWNER granted.
  deviceSignup           DeviceSignup?
  deviceExceptionsGiven  DeviceSignupException[]
  /// v1.80-kyc (D227): the person's identity checks «تأكيد الهوية» (Didit).
  kycChecks              KycCheck[]
  agencyLinks            AgencyHost[]
  cherryWithdrawals      CherryWithdrawal[]
  // v1.54-social (D185): recharge agents.
  rechargeApplications   RechargeAgentApplication[]
  rechargeAgent          RechargeAgent?
  rechargeSalesMade      RechargeSale[]             @relation("RechargeSaleSeller")
  rechargePurchases      RechargeSale[]             @relation("RechargeSaleBuyer")
  rechargeEmployments    RechargeEmployee[]
  rechargeCherrySales    RechargeCherryRequest[]
  specialUsernames       SpecialUsername[]
  // v1.56-social (D187): the daily recharge badges.
  rechargeDailyTotals    RechargeDailyTotal[]
  rechargeBadge          RechargeBadge?
  // v1.69-social (D204): recharge orders a buyer asked an agent for.
  rechargeOrdersBought   RechargeOrder[]            @relation("RechargeOrderBuyer")
  // v1.59-social (D190): card top-ups on the website.
  topupTermsAcceptances  TopupTermsAcceptance[]
  topupOrders            TopupOrder[]
  /// v1.110-social (D345, §10.144): coins bought through Google Play / the App Store, and the bans their refunds made.
  iapPurchases           IapPurchase[]
  iapRefundBans          IapRefundBan[]
  topupFreeze            TopupFreeze?
  /// v1.109-social (D344): the app's one-time website sign-in codes.
  topupHandoffs          TopupHandoff[]
  topupCases             TopupCase[]
  stripeCustomer         StripeCustomer?
  // v1.62-social (D193): account deletion requests «حذف الحساب».
  deletionRequests       AccountDeletionRequest[]
  /// D193: reported content of this (purged) account under a legal hold.
  legalHolds             LegalHold[]
  // v1.66-social (D198): consent records and personal-data exports «تنزيل بياناتي».
  consents               UserConsent[]
  dataExports            DataExport[]

  // v1.72-social (D208): the team's temporary locks and restrictions, and balance adjustments.
  accountRestrictions       AccountRestriction[]     @relation("RestrictedUser")
  accountRestrictionsBy     AccountRestriction[]     @relation("RestrictionCreatedBy")
  accountRestrictionsLifted AccountRestriction[]     @relation("RestrictionLiftedBy")
  balanceAdjustments        AdminBalanceAdjustment[] @relation("AdjustedUser")
  balanceAdjustmentsBy      AdminBalanceAdjustment[] @relation("AdjustedBy")

  // v1.82-social (D252): «شراء VIP» — the person's membership and purchases.
  vipMembership           VipMembership?
  vipPurchases            VipPurchase[]
  /// D270 (§10.98).
  storePurchases          StorePurchase[]          @relation("StorePurchaseBuyer")
  storeGiftsReceived      StorePurchase[]          @relation("StorePurchaseRecipient")
  vipDailyCoinClaims      VipDailyCoinClaim[]
  /// v1.83-social (D258, §10.94.9): who visited this user's profile, and whose profiles this user visited.
  profileVisitsReceived   ProfileVisit[]           @relation("ProfileVisitOwner")
  profileVisitsMade       ProfileVisit[]           @relation("ProfileVisitVisitor")
  /// v1.95-social (D301, §10.112): the owner's cover videos, «رحلة Kabso», and «صندوق المؤسس» (sent / about).
  ownerCoverVideos        OwnerCoverVideo[]
  ownerJourney            OwnerJourneyMilestone[]
  ownerBio                OwnerBio?
  ownerFeedbackSent       OwnerFeedback[]          @relation("OwnerFeedbackSender")
  ownerFeedbackAbout      OwnerFeedback[]          @relation("OwnerFeedbackStaff")
  /// v1.100-social (D312, §10.118): the custom gifts this user owns «صاحب الهدية».
  ownedGifts              Gift[]                   @relation("GiftOwner")
  /// v1.99-social (D311, §10.117): the founder's moderation actions taken by / on this user.
  ownerActionsTaken       OwnerModerationAction[]  @relation("OwnerModerationActor")
  ownerActionsReceived    OwnerModerationAction[]  @relation("OwnerModerationTarget")
  /// v1.88-live (D315, §10.120): game tickets spent «مجنون اللعب» (the ledger and its rollups).
  gameTicketSpends        GameTicketSpend[]
  gameTicketSpendsHourly  GameTicketSpendHourly[]
  gameTicketSpendsMonthly GameTicketSpendMonthly[]
  giftCoinsSentHourly     GiftCoinsSentHourly[]
  giftCoinsSentMonthly    GiftCoinsSentMonthly[]

  @@index([createdAt], map: "users_created_at_idx")
  /// v1.95-social (D301, §10.112.4): «لوحة المؤسس» counts who is online now.
  @@index([lastActiveAt], map: "users_last_active_idx")
  @@map("users")
}

model UserProfile {
  userId              String               @id @map("user_id") @db.Uuid
  /// Lowercase; format enforced by CHECK constraint `user_profiles_username_format`.
  username            String               @unique @db.VarChar(30)
  /// ≤ 100 code points, 1–50 grapheme clusters (contract v1.2 §6).
  displayName         String               @map("display_name") @db.VarChar(100)
  bio                 String?              @db.VarChar(300)
  avatarUrl           String?              @map("avatar_url") @db.VarChar(2048)
  /// v1.72-live (D283, §10.96.10): `avatar_url` is the Kabso Team's fixed picture while the account is limited staff
  /// (MODERATION / SUPPORT / FINANCE, not OWNER); the person's own photo URL waits in `staff_saved_avatar_url`.
  staffAvatar         Boolean              @default(false) @map("staff_avatar")
  staffSavedAvatarUrl String?              @map("staff_saved_avatar_url") @db.VarChar(2048)
  /// v1.45-social (D168): the user's profile photo when it was uploaded (an `AVATAR` asset); its
  /// 640 px URL is `avatarUrl`. CHECK `user_profiles_avatar_media_has_url`.
  avatarMediaId       String?              @unique @map("avatar_media_id") @db.Uuid
  /// v1.76-social (D218, §10.73.3): the profile cover (a `PROFILE_COVER` asset) and its 1 080 px URL; both null
  /// (the app's Kabso gradient) or both set (CHECK `user_profiles_cover_media_has_url`).
  coverMediaId        String?              @unique @map("cover_media_id") @db.Uuid
  coverUrl            String?              @map("cover_url") @db.VarChar(2048)
  locale              String               @default("ar") @db.VarChar(8)
  /// v1.27.1-live (D133): the user's own country (ISO 3166-1 alpha-2, upper case), or null (none set;
  /// never inferred). CHECK `user_profiles_country_code_format`. Decides `scope=nearby` (§10.28).
  countryCode         String?              @map("country_code") @db.Char(2)
  /// v1.28-live (D146): the tier of the premium username the user has now (set and cleared with
  /// `username` by the premium-usernames module); null for a regular username.
  premiumTier         PremiumUsernameTier? @map("premium_tier")
  /// v1.47-social (D175): chosen at sign-up (null for accounts created before, and social sign-in,
  /// until set). Private unless `showGender` (owner: private by default).
  gender              Gender?
  showGender          Boolean              @default(false) @map("show_gender")
  /// v1.47-social (D175): the account category shown under the name; optional.
  category            AccountCategory?     @map("account_category")
  /// v1.85-social (D278b, §10.99): the profile tags «منشنات», in order; 0–10 (CHECK
  /// `user_profiles_tags_count`), each 1–24 code points (the app's `PATCH /me` rules).
  tags                String[]             @default([]) @db.VarChar(24)
  /// v1.91-social (D292, §10.106): the icon of each tag (a closed set, or `flag:<country>`); empty (rows before
  /// v1.91-social) or one per tag (CHECK `user_profiles_tag_icons_len`).
  tagIcons            String[]             @default([]) @map("tag_icons") @db.VarChar(24)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia MediaAsset? @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: NoAction)
  coverMedia  MediaAsset? @relation("ProfileCover", fields: [coverMediaId], references: [id], onDelete: NoAction)

  @@map("user_profiles")
}

/// v1.47-social (D175, CONVENTIONS §10.47): the user's gender; `UNDISCLOSED` = «أفضّل عدم الذكر».
enum Gender {
  MALE
  FEMALE
  UNDISCLOSED

  @@map("user_gender")
}

/// v1.47-social (D175, CONVENTIONS §10.47): the account category shown under the name.
enum AccountCategory {
  SINGER
  MUSICIAN
  POET
  PRESENTER
  GAMER
  CONTENT_CREATOR
  ATHLETE
  ARTIST
  BLOGGER
  PUBLIC_FIGURE
  OTHER

  @@map("account_category")
}

/// v1.47-social (D175, CONVENTIONS §10.47): a profile link (https only, normalised by the API).
/// At most 3 per user (`position` 0–2, CHECK `user_profile_links_position`). `PATCH /me` replaces
/// the whole set.
model UserProfileLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  position  Int      @db.SmallInt
  url       String   @db.VarChar(500)
  label     String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position], map: "user_profile_links_user_position_key")
  @@map("user_profile_links")
}

model UserSettings {
  userId    String   @id @map("user_id") @db.Uuid
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Session {
  id                        String    @id @default(uuid(7)) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the current refresh secret.
  refreshTokenHash          String    @map("refresh_token_hash") @db.Char(64)
  /// SHA-256 (hex) of the immediately preceding secret (also element 1 of the history below).
  previousRefreshTokenHash  String?   @map("previous_refresh_token_hash") @db.Char(64)
  /// SHA-256 (hex) of the last 10 rotated secrets, newest first (SEC-022). Presenting any of
  /// them is reuse and revokes the session. Bounded by the rotation SQL and a CHECK constraint.
  rotatedRefreshTokenHashes String[]  @default([]) @map("rotated_refresh_token_hashes") @db.Char(64)
  /// Incremented on every rotation (compare-and-swap guard + diagnostics).
  rotationCounter           Int       @default(0) @map("rotation_counter")
  deviceName                String?   @map("device_name") @db.VarChar(100)
  platform                  String?   @db.VarChar(16)
  appVersion                String?   @map("app_version") @db.VarChar(32)
  ip                        String?   @db.VarChar(64)
  userAgent                 String?   @map("user_agent") @db.VarChar(512)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt                DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding expiry (REFRESH_TTL_SECONDS from last rotation, capped by absoluteExpiresAt).
  expiresAt                 DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt         DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt                 DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT | USER_REVOKED | REFRESH_REUSE | PASSWORD_RESET | ADMIN | ACCOUNT_DELETION (D193) | ADMIN_REVOKED (D197)
  revokedReason             String?   @map("revoked_reason") @db.VarChar(32)
  /// v1.74-social (D217): the app's install id (`DeviceInfo.installId`), for the referral device checks.
  installId                 String?   @map("install_id") @db.VarChar(64)
  /// v1.60-live (D250, §10.91): the HMAC of the `DeviceInfo.deviceKey` the session signed in with (D223's key), so a
  /// device ban refuses going live and ends the device's sessions. NULL: none sent (website, older app).
  deviceHash                String?   @map("device_hash") @db.Char(64)
  /// v1.112-social (int21, §10.143.3): where the app was installed from — PLAY | APP_STORE | SIDELOAD (CHECK); NULL:
  /// not reported (website, an older app). «الشحن من الموقع» is offered only to TOPUP_APP_LINK_SOURCES (default SIDELOAD).
  installSource             String?   @map("install_source") @db.VarChar(16)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// v1.30-live (D152): at most one push token per session.
  deviceTokens   DeviceToken[]
  /// v1.68-live (D273): the staff tools' step-up, bound to this session.
  adminAppGrants AdminAppGrant[]
  /// v1.109-social (D344): the website sign-in codes this (app) session minted.
  topupHandoffs  TopupHandoff[]

  @@index([userId, createdAt(sort: Desc)], map: "sessions_user_id_created_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@index([installId], map: "sessions_install_id_idx", where: raw("install_id IS NOT NULL"))
  @@index([deviceHash], map: "sessions_device_hash_idx", where: raw("device_hash IS NOT NULL AND revoked_at IS NULL"))
  /// v1.108-social (D343): every session of a device, for the sign-up credit check.
  @@index([deviceHash], map: "sessions_device_hash_all_idx", where: raw("device_hash IS NOT NULL"))
  @@map("sessions")
}

model VerificationToken {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  /// SHA-256 (hex) of the raw token; the raw token is only ever sent by mail.
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "verification_tokens_user_id_purpose_idx")
  @@index([expiresAt], map: "verification_tokens_expires_at_idx")
  @@map("verification_tokens")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for anonymous actions (e.g. failed login for an unknown identifier).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  metadata    Json?    @db.JsonB
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Audit rows survive user deletion (actor becomes NULL).
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@index([action, createdAt(sort: Desc)], map: "audit_logs_action_created_at_idx")
  @@index([targetType, targetId], map: "audit_logs_target_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

/// Verify-first registration (contract v1.2 §6, KL-019). No account exists until the emailed code
/// is verified. At most one row per email; a username held by a live row counts as taken.
model PendingRegistration {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed + lowercase).
  email         String   @unique @db.VarChar(254)
  /// Lowercase; reserved while the row is live (format CHECK as for user_profiles).
  username      String   @unique @db.VarChar(30)
  displayName   String   @map("display_name") @db.VarChar(100)
  locale        String   @db.VarChar(8)
  /// Argon2id PHC string of the chosen password (computed at register time).
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  deviceName    String?  @map("device_name") @db.VarChar(100)
  platform      String?  @db.VarChar(16)
  appVersion    String?  @map("app_version") @db.VarChar(32)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  /// v1.66-social (D198): `{age18, terms, privacy, at, ip, userAgent}` accepted at `register` (null: not sent).
  legalConsent  Json?    @map("legal_consent") @db.JsonB
  /// v1.47-social (D175): required by `register` since v1.47 (null only on rows made before).
  gender        Gender?
  /// v1.74-social (D217): the app's install id and the invite code typed at sign-up (applied at verify).
  installId     String?  @map("install_id") @db.VarChar(64)
  referralCode  String?  @map("referral_code") @db.VarChar(16)
  /// v1.78-social (D223): HMAC-SHA-256 (hex, server key) of the app's `DeviceInfo.deviceKey`; null: none sent.
  deviceHash    String?  @map("device_hash") @db.Char(64)
  /// HMAC-SHA-256 (hex) of the 8-digit code, keyed by a key derived from RATE_LIMIT_KEY_SECRET.
  codeHash      String   @map("code_hash") @db.Char(64)
  /// Checks of the CURRENT code (max 5; reset when resend issues a new code).
  attempts      Int      @default(0)
  /// Checks across all codes of this pending registration (max 10, never reset; SEC-026).
  totalAttempts Int      @default(0) @map("total_attempts")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "pending_registrations_expires_at_idx")
  @@map("pending_registrations")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 slice 1 — live discovery and follow (contract v1.3, DB_PHASE2_DISCOVERY.md).
// CHECK constraints and the partial indexes (WHERE status = 'LIVE') are hand-written SQL in
// migration 20261016123000_live_discovery. The partial indexes are also declared below (preview
// feature `partialIndexes`) only so that `prisma migrate dev` knows them and never generates a
// DROP INDEX for them; the migration SQL remains the source of truth.

enum LiveRoomStatus {
  LIVE
  ENDED

  @@map("live_room_status")
}

enum LiveRoomMode {
  SOLO
  PK
  MULTI
  /// CP-011 (D94): voice only, with seats.
  AUDIO
  /// v1.47-live (D212, CONVENTIONS §10.69): an audio-only podcast episode — the host and up to 3
  /// speakers (seat count 4), listeners raise a hand to ask a question.
  PODCAST
  /// v1.56-live (D213, CONVENTIONS §10.86): the host's phone screen (a game or an app) with a small
  /// round front-camera bubble; Android hosts only (any viewer). No guest seats, no PK.
  STREAMER

  @@map("live_room_mode")
}

enum LiveRoomEndReason {
  HOST_ENDED
  HEARTBEAT_TIMEOUT
  HOST_SUSPENDED
  ADMIN
  /// v1.42-live (D170, CONVENTIONS §10.44): a video live whose host stayed away (camera off in the
  /// background) for LIVE_HOST_AWAY_TIMEOUT_SECONDS.
  HOST_AWAY_TIMEOUT

  @@map("live_room_end_reason")
}

/// Server-curated live categories. None are seeded (D37); rows are deactivated, never deleted.
model LiveCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// CHECK `live_categories_slug_format`: ^[a-z0-9-]{2,32}$
  slug      String   @unique @db.VarChar(32)
  nameAr    String   @map("name_ar") @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rooms LiveRoom[]

  @@map("live_categories")
}

/// A live room is metadata plus a host heartbeat (no media in v1.3, B1).
/// CP-010: where a hosting permission came from (owner D93: agencies and identity checks in L1b).
/// v1.73-social (D209, §10.68): `IDENTITY` is the permission given by approving an application «كن مضيفاً مع
/// الإدارة» (the person's ID card and selfie checked by the team): a host directly with Kabso, in no agency.
enum LiveHostSource {
  ADMIN
  AGENCY
  IDENTITY
  /// v1.82-live (D295, §10.108): a creator-programme membership grants the permission (with the membership; removed
  /// when it ends). Host and creator are exclusive (trigger `kabso_creator_host_exclusive`).
  CREATOR

  @@map("live_host_source")
}

/// CP-010: users who may go live (`Me.canHost`).
model LiveHost {
  userId       String         @id @map("user_id") @db.Uuid
  source       LiveHostSource
  grantedById  String?        @map("granted_by_id") @db.Uuid
  grantedAt    DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  /// CP-015 (D98): the host's live cover, reused by every live (a `LIVE_COVER` asset), and its
  /// public URL (the 640 px square variant). Both set or both null (CHECK).
  coverMediaId String?        @unique @map("cover_media_id") @db.Uuid
  coverUrl     String?        @map("cover_url") @db.VarChar(2048)
  /// CP-016 B (D99): words masked in this host's live chats (at most 100, CHECK).
  blockedWords String[]       @default([]) @map("blocked_words") @db.VarChar(30)
  /// CP-016 G (D99): the host's public room number, 9 digits, random and unique (CHECK range);
  /// given with the permission and shown in every live of this host ("ID: …").
  roomNumber   Int            @unique(map: "live_hosts_room_number_key") @default(dbgenerated("(((100000000)::double precision + floor((random() * (900000000)::double precision))))::integer")) @map("room_number")

  user       User        @relation("LiveHostUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?       @relation("LiveHostGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  coverMedia MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: NoAction)

  @@index([grantedById], map: "live_hosts_granted_by_idx")
  @@map("live_hosts")
}

/// CP-010: who is connected to a room's media session now (from the media server's webhook).
/// `identity` is the user id, or `guest:<guestId>` for a guest.
model LiveRoomViewer {
  roomId   String   @map("room_id") @db.Uuid
  identity String   @db.VarChar(80)
  userId   String?  @map("user_id") @db.Uuid
  guestId  String?  @map("guest_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, identity], map: "live_room_viewers_pkey")
  @@index([roomId, joinedAt(sort: Desc), identity(sort: Desc)], map: "live_room_viewers_room_joined_idx")
  @@index([userId], map: "live_room_viewers_user_idx")
  @@map("live_room_viewers")
}

/// v1.27.6-live (D140, CONVENTIONS §10.31): everyone who watched a live (the host excluded), kept
/// with the room for its statistics — the first join, and the watch time: `watch_ms` of the closed
/// visits plus the open one since `open_since` (NULL when not connected). Written only from the
/// media server's presence (`live_room_viewers`); no endpoint lists it (aggregates only).
model LiveRoomAudience {
  roomId        String    @map("room_id") @db.Uuid
  identity      String    @db.VarChar(80)
  userId        String?   @map("user_id") @db.Uuid
  firstJoinedAt DateTime  @map("first_joined_at") @db.Timestamptz(3)
  watchMs       BigInt    @default(0) @map("watch_ms")
  openSince     DateTime? @map("open_since") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, identity], map: "live_room_audience_pkey")
  @@index([userId], map: "live_room_audience_user_idx")
  @@map("live_room_audience")
}

model LiveRoom {
  id                    String             @id @default(uuid(7)) @db.Uuid
  hostUserId            String             @map("host_user_id") @db.Uuid
  /// 1–80 graphemes / ≤ 160 code points, validated in the application (CONVENTIONS §10.3).
  title                 String             @db.VarChar(160)
  categoryId            String?            @map("category_id") @db.Uuid
  status                LiveRoomStatus     @default(LIVE)
  mode                  LiveRoomMode       @default(SOLO)
  startedAt             DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt       DateTime           @default(now()) @map("last_heartbeat_at") @db.Timestamptz(3)
  endedAt               DateTime?          @map("ended_at") @db.Timestamptz(3)
  endReason             LiveRoomEndReason? @map("end_reason")
  /// CP-010: connected viewers other than the host, guests included (kept from `live_room_viewers`).
  viewerCount           Int                @default(0) @map("viewer_count")
  /// v1.27.6-live (D140, CONVENTIONS §10.31): the most viewers at once (kept with `viewer_count`);
  /// NULL for lives started before D140, which have no audience record.
  peakViewerCount       Int?               @default(0) @map("peak_viewer_count")
  /// CP-010: people without an account may watch (owner D93: allowed by default).
  allowGuests           Boolean            @default(true) @map("allow_guests")
  /// CP-011: tiles (host included) of a MULTI (4, 6, 9, 12) or AUDIO (5, 10, 15, 20, 25, D103) room; null for
  /// SOLO. CHECK `live_rooms_seat_count_mode` (migration 20261027090000_live_seats).
  seatCount             Int?               @map("seat_count") @db.SmallInt
  /// CP-011: a slug of LiveConfig.themes (CHECK `live_rooms_theme_format`).
  theme                 String             @default("classic") @db.VarChar(32)
  /// v1.27.3-live (D136, CONVENTIONS §10.29): the host's wish list, up to 4 distinct gift codes in
  /// display order (CHECK `live_rooms_wish_gifts_max`). A new live copies the host's last list.
  wishGifts             String[]           @default([]) @map("wish_gifts") @db.VarChar(40)
  /// CP-011: increases on every change of the room's seats, requests, invitations or moderators.
  seatsVersion          Int                @default(0) @map("seats_version")
  /// CP-012: the room's total score (tap + support points), kept equal to the room's
  /// `live_room_scores` row in the same transaction. v1.86-live (D310): points only (PK, boards, charm);
  /// `popular` no longer orders by it.
  score                 BigInt             @default(0)
  /// v1.86-live (D310, CONVENTIONS §10.116): the room's cherries — what the cherry ledger credited the host AND the
  /// seated guests for gifts received in this live (each send's stored share; taps never), added in the send's own
  /// transaction right after the ledger credit, taken back by a reversal (never below 0; CHECK
  /// `live_rooms_cherries_nonneg`). `popular` orders by it (§10.4) and the hub chip and the host pill show it.
  cherries              BigInt             @default(0)
  /// CP-013: false when the host turned the room chat off (a new live starts with it on).
  chatEnabled           Boolean            @default(true) @map("chat_enabled")
  /// CP-014: the live's topic (1–100 code points, CHECK `live_rooms_topic_length`); null = none.
  topic                 String?            @db.VarChar(100)
  /// CP-014: increases on every change of the title, category or topic (media metadata
  /// `roomInfoVersion`, CONVENTIONS §10.12).
  infoVersion           Int                @default(0) @map("info_version")
  /// Always null in v1.3 (no upload).
  coverUrl              String?            @map("cover_url") @db.VarChar(2048)
  /// v1.32-live (D154, §10.33): when the room's quip queue is free again (null: never used). Written
  /// under the room row's lock by each quip and soundboard sound.
  quipBusyUntil         DateTime?          @map("quip_busy_until") @db.Timestamptz(3)
  /// v1.42-live (D170, §10.44): since when the host of a video (SOLO / MULTI) live has been away
  /// (the app in the background, the camera off); null while present and always null for AUDIO.
  hostAwaySince         DateTime?          @map("host_away_since") @db.Timestamptz(3)
  /// v1.47-live (D212, §10.69): a PODCAST's episode number, per host (1, 2, …); null for other
  /// modes (CHECK `live_rooms_podcast_fields`).
  episodeNumber         Int?               @map("episode_number")
  /// v1.47-live (D212): a PODCAST's topic chip (a slug of PODCAST_TOPICS); null for other modes.
  podcastTopic          String?            @map("podcast_topic") @db.VarChar(32)
  /// v1.47-live (D212): listeners may raise a hand (PODCAST; true for other modes, unused).
  questionsOpen         Boolean            @default(true) @map("questions_open")
  /// v1.47-live (D212): how long an accepted hand speaks before going back to the listeners
  /// (60, 120, 180 or 300 s); null = no limit. PODCAST only.
  questionSeconds       Int?               @map("question_seconds") @db.SmallInt
  /// v1.56-live (D213, §10.86): a STREAMER's screen orientation (`PORTRAIT` / `LANDSCAPE`); null for
  /// other modes (CHECK `live_rooms_streamer_fields`).
  streamerOrientation   String?            @map("streamer_orientation") @db.VarChar(16)
  /// v1.56-live (D213): whether the host's camera bubble shows (STREAMER only; null otherwise).
  streamerCameraVisible Boolean?           @map("streamer_camera_visible")
  /// v1.56-live (D213): the camera bubble's corner of the screen picture (`TOP_LEFT`, `TOP_RIGHT`,
  /// `BOTTOM_LEFT`, `BOTTOM_RIGHT`; physical, not mirrored for RTL); STREAMER only.
  streamerCameraCorner  String?            @map("streamer_camera_corner") @db.VarChar(16)
  /// v1.57-live (D247, §10.88): the main picture — `SCREEN` (the screen track, the camera as the bubble) or
  /// `CAMERA` (the camera track alone, e.g. a browser studio's OBS Virtual Camera); STREAMER only.
  streamerMain          String?            @map("streamer_main") @db.VarChar(16)
  /// v1.56-live (D213): increases on every change of the layout (media metadata `streamerVersion`).
  streamerVersion       Int                @default(0) @map("streamer_version")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  host               User                   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  category           LiveCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  viewers            LiveRoomViewer[]
  /// v1.64-live (D260): the staff member this live is assigned to, and the staff watching it visibly.
  assignment         LiveRoomAssignment?
  staffWatchers      LiveRoomStaffWatcher[]
  audience           LiveRoomAudience[]
  reports            Report[]               @relation("ReportTargetLive")
  /// v1.68-live (D273): reports of a user made inside this live (the app sends the live as the report's context).
  contextReports     Report[]               @relation("ReportContextLive")
  /// v1.68-live (D273): the staff alerts «بلاغ جديد على بث» about this live.
  staffNotifications Notification[]
  /// v1.60-live (D250): what the team did on this live from the panel.
  moderations        LiveModerationAction[]
  seats              LiveRoomSeat[]
  seatRequests       LiveSeatRequest[]
  seatInvites        LiveSeatInvite[]
  moderators         LiveRoomModerator[]
  scoreParts         LiveRoomScore?
  tappers            LiveRoomTapper[]
  chatMessages       LiveChatMessage[]
  chatMutes          LiveChatMute[]
  kicks              LiveRoomKick[]
  bullets            LiveBullet[]
  gifts              LiveGift[]
  freeQuips          LiveFreeQuip[]
  boosts             LiveBoost[]
  summary            LiveSummary?
  program            LiveProgramItem[]
  stickers           LiveSticker[]
  watch              LiveWatch?
  watchSuggestions   LiveWatchSuggestion[]
  /// v1.43-live (D195): PK battles this room took part in.
  pkMatchesAsA       PkMatch[]              @relation("PkMatchRoomA")
  pkMatchesAsB       PkMatch[]              @relation("PkMatchRoomB")
  pkInvitesSent      PkInvite[]             @relation("PkInviteFromRoom")
  pkInvitesGot       PkInvite[]             @relation("PkInviteToRoom")
  pkQueueEntries     PkQueueEntry[]
  /// v1.45-live (D201): second-camera pairings of this live.
  secondCameras      LiveSecondCamera[]

  @@unique([hostUserId], map: "live_rooms_one_live_per_host", where: raw("status = 'LIVE'::live_room_status"))
  @@unique([hostUserId, episodeNumber], map: "live_rooms_host_episode_key")
  @@index([cherries(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_popular_cherries_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_new_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([categoryId, cherries(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_cat_popular_cherries_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([categoryId, startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_cat_new_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([lastHeartbeatAt], map: "live_rooms_live_heartbeat_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([hostAwaySince], map: "live_rooms_live_host_away_idx", where: raw("status = 'LIVE'::live_room_status AND host_away_since IS NOT NULL"))
  @@index([hostUserId, startedAt(sort: Desc)], map: "live_rooms_host_started_idx")
  @@index([categoryId], map: "live_rooms_category_id_idx")
  @@index([startedAt], map: "live_rooms_started_at_idx")
  @@map("live_rooms")
}

/// CP-011: a seat that is not EMPTY — either LOCKED (no user) or TAKEN (a user). An EMPTY seat has
/// no row. Seats are numbered 1 … seat_count-1 (the host is 0). CHECKs `live_room_seats_index`
/// and `live_room_seats_locked_or_taken` (migration 20261027090000_live_seats).
model LiveRoomSeat {
  roomId      String    @map("room_id") @db.Uuid
  seatIndex   Int       @map("seat_index") @db.SmallInt
  locked      Boolean   @default(false)
  userId      String?   @map("user_id") @db.Uuid
  mutedByHost Boolean   @default(false) @map("muted_by_host")
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// v1.47-live (D212, §10.69): a PODCAST question's end — the sweeper moves the speaker back to the
  /// listeners at this time; null = no limit (and always null outside PODCAST).
  demoteAt    DateTime? @map("demote_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, seatIndex], map: "live_room_seats_pkey")
  @@unique([roomId, userId], map: "live_room_seats_one_per_user")
  @@index([demoteAt], map: "live_room_seats_demote_idx", where: raw("demote_at IS NOT NULL"))
  @@index([userId], map: "live_room_seats_user_idx")
  @@map("live_room_seats")
}

/// CP-011: the state of a seat request or invitation.
enum LiveSeatOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  REPLACED

  @@map("live_seat_offer_status")
}

/// CP-011: a viewer asks for a seat. At most one PENDING per room and user.
model LiveSeatRequest {
  id         String              @id @default(uuid(7)) @db.Uuid
  roomId     String              @map("room_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  seatIndex  Int?                @map("seat_index") @db.SmallInt
  status     LiveSeatOfferStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  handledAt  DateTime?           @map("handled_at") @db.Timestamptz(3)
  /// v1.47-live (D212, §10.69): a PODCAST hand's short question (1–80 code points), or null.
  question   String?             @db.VarChar(320)
  /// v1.47-live (D212): the host said «لاحقاً» — still PENDING, listed after the others.
  deferredAt DateTime?           @map("deferred_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "live_seat_requests_one_pending", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([roomId, createdAt, id], map: "live_seat_requests_pending_idx", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([userId], map: "live_seat_requests_user_idx")
  @@map("live_seat_requests")
}

/// CP-011: the host or a moderator invites a viewer; expires after 60 s. At most one PENDING per
/// room and user (a new one REPLACES it).
model LiveSeatInvite {
  id          String              @id @default(uuid(7)) @db.Uuid
  roomId      String              @map("room_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  seatIndex   Int?                @map("seat_index") @db.SmallInt
  invitedById String              @map("invited_by_id") @db.Uuid
  status      LiveSeatOfferStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(3)
  handledAt   DateTime?           @map("handled_at") @db.Timestamptz(3)

  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation("LiveSeatInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("LiveSeatInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "live_seat_invites_one_pending", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([expiresAt], map: "live_seat_invites_pending_expiry_idx", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([userId], map: "live_seat_invites_user_idx")
  @@index([invitedById], map: "live_seat_invites_invited_by_idx")
  @@map("live_seat_invites")
}

/// CP-011: up to 5 moderators per room, appointed by the host for that room only.
model LiveRoomModerator {
  roomId  String   @map("room_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId], map: "live_room_moderators_pkey")
  @@index([userId], map: "live_room_moderators_user_idx")
  @@map("live_room_moderators")
}

/// CP-012 (D95): a room's score parts. `tap_points` is 1 per counted tap; `support_points` is 100
/// per support coin, written by L3 with the gift (0 until then). `live_rooms.score` holds the total
/// (CONVENTIONS §10.10). CHECK `live_room_scores_nonneg` (migration 20261028090000_live_taps).
model LiveRoomScore {
  roomId        String   @id @map("room_id") @db.Uuid
  tapPoints     BigInt   @default(0) @map("tap_points")
  supportPoints BigInt   @default(0) @map("support_points")
  /// v1.63-live (D259, §10.95): the cherries the host's balance was credited for gifts received in
  /// this live (CHECK `live_room_scores_host_cherries` >= 0). The points above are not cherries.
  hostCherries  BigInt   @default(0) @map("host_cherries")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("live_room_scores")
}

/// CP-016 A (D99): points a host's lives received in one UTC hour (counted taps; support coins
/// with L3). The popularity boards sum these over the current hour, day and week; rows older than
/// 15 days are removed by the live sweeper. CHECK `live_host_points_hourly_points` (>= 0).
model LiveHostPointsHourly {
  hostUserId String   @map("host_user_id") @db.Uuid
  hourStart  DateTime @map("hour_start") @db.Timestamptz(3)
  points     BigInt   @default(0)

  host User @relation("LiveHostPointsHourly", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@id([hostUserId, hourStart], map: "live_host_points_hourly_pkey")
  @@index([hourStart], map: "live_host_points_hourly_hour_idx")
  @@map("live_host_points_hourly")
}

/// v1.87-live (D314, CONVENTIONS §10.119): the popularity points of a host per LOCAL month (`month_start` = the instant
/// the month begins in LIVE_RANKINGS_TIME_ZONE), written in the same statement as the hourly row — the month and year
/// boards sum at most 12 rows per host instead of the hourly rows (kept 15 days). Rows older than 400 days are removed
/// by the live sweeper. CHECK `live_host_points_monthly_points` (>= 0).
model LiveHostPointsMonthly {
  hostUserId String   @map("host_user_id") @db.Uuid
  monthStart DateTime @map("month_start") @db.Timestamptz(3)
  points     BigInt   @default(0)

  host User @relation("LiveHostPointsMonthly", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@id([hostUserId, monthStart], map: "live_host_points_monthly_pkey")
  @@index([monthStart], map: "live_host_points_monthly_month_idx")
  @@map("live_host_points_monthly")
}

/// CP-016 C (D99): a live the host announced (CONVENTIONS §10.16). Followers get
/// `LIVE_SCHEDULED_SOON` 15 minutes before `startsAt`; `remindedAt` marks that the sweeper sent it
/// (once). Deleted 30 days after the start. CHECKs in migration 20261103090000_live_schedule.
model LiveScheduleSlot {
  id           String        @id @default(uuid(7)) @db.Uuid
  hostUserId   String        @map("host_user_id") @db.Uuid
  title        String        @db.VarChar(60)
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  remindedAt   DateTime?     @map("reminded_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// v1.47-live (D212, §10.69): PODCAST for an announced podcast episode (listed in the hub's
  /// «بودكاست» tab); null = a plain announcement.
  mode         LiveRoomMode?
  /// v1.47-live (D212): the episode's topic slug (PODCAST only).
  podcastTopic String?       @map("podcast_topic") @db.VarChar(32)

  host          User           @relation("LiveScheduleSlots", fields: [hostUserId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([hostUserId, startsAt], map: "live_schedule_slots_host_starts_idx")
  @@index([startsAt], map: "live_schedule_slots_due_idx", where: raw("reminded_at IS NULL"))
  @@index([mode, startsAt], map: "live_schedule_slots_mode_starts_idx", where: raw("mode IS NOT NULL"))
  @@map("live_schedule_slots")
}

/// CP-012 (D95): a caller's counted taps in one room and the time of their last counted batch; the
/// 10-a-second and 10 000-a-live limits are checked against it. Kept for admins (abuse watch, no
/// endpoint). CHECK `live_room_tappers_counted` (migration 20261028090000_live_taps).
model LiveRoomTapper {
  roomId       String    @map("room_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  counted      Int       @default(0)
  /// The last tap batch that counted (null: this person only sent gifts in the live).
  lastBatchAt  DateTime? @map("last_batch_at") @db.Timestamptz(3)
  /// v1.23-live (CP-020): the coin value of the gifts this person sent in the live.
  supportCoins BigInt    @default(0) @map("support_coins")
  /// v1.23-live (CP-020): Contribution points = counted + 100 × supportCoins (CHECK
  /// `live_room_tappers_points`), and when that total was reached (ties).
  points       BigInt    @default(0)
  pointsAt     DateTime  @map("points_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId], map: "live_room_tappers_pkey")
  @@index([userId], map: "live_room_tappers_user_idx")
  /// CP-014 / v1.23-live: the Contribution list (points desc, then who reached them first, then user id).
  @@index([roomId, points(sort: Desc), pointsAt, userId], map: "live_room_tappers_room_rank_idx")
  @@map("live_room_tappers")
}

/// CP-013 (D96): the author's role in the room when a chat message was sent.
enum LiveChatAuthorRole {
  HOST
  MODERATOR
  SPEAKER
  VIEWER

  @@map("live_chat_author_role")
}

/// CP-017 (D104): what a chat message carries. VOICE and IMAGE vanish 60 s after sending.
enum LiveChatMessageKind {
  TEXT
  VOICE
  IMAGE

  @@map("live_chat_message_kind")
}

/// CP-013 (D96): a live room chat message. `text` is 1–200 code points after the §10.11 rules
/// (CHECK `live_chat_messages_text_length`); `client_id` is chosen by the app, unique per sender
/// (an idempotent retry). Soft-deleted by its author, the host, a moderator or an admin report
/// action. Removed by the live sweeper 30 days after the room ended unless an OPEN report points
/// at it (migration 20261029090000_live_chat).
/// CP-017 (D104): a VOICE or IMAGE message has empty `text`, its `LIVE_CHAT_*` asset in
/// `media_id` and `expires_at` = sent + 60 s; the live chat sweeper deletes the asset after that
/// (`media_id` becomes NULL). CHECKs `live_chat_messages_text_length` and
/// `live_chat_messages_kind_shape` (migration 20261108100000_live_chat_media).
model LiveChatMessage {
  id          String              @id @default(uuid(7)) @db.Uuid
  roomId      String              @map("room_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  clientId    String              @map("client_id") @db.Uuid
  kind        LiveChatMessageKind @default(TEXT)
  text        String              @default("") @db.VarChar(200)
  mediaId     String?             @unique(map: "live_chat_messages_media_once") @map("media_id") @db.Uuid
  expiresAt   DateTime?           @map("expires_at") @db.Timestamptz(3)
  authorRole  LiveChatAuthorRole  @map("author_role")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById String?             @map("deleted_by_id") @db.Uuid
  /// CP-021 (D112): the author's couple had the Exclusive Chat Bubble (CP level 2+) when it was sent.
  cpBubble    Boolean             @default(false) @map("cp_bubble")

  room      LiveRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User        @relation("LiveChatAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User?       @relation("LiveChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([userId, clientId], map: "live_chat_messages_client_once")
  @@index([roomId, createdAt], map: "live_chat_messages_room_created_idx")
  @@index([deletedById], map: "live_chat_messages_deleted_by_idx")
  /// The expired-media sweep (only messages that still hold an asset).
  @@index([expiresAt], map: "live_chat_messages_media_expiry_idx", where: raw("media_id IS NOT NULL"))
  @@map("live_chat_messages")
}

/// CP-017 (D104): why a coin balance changed.
enum WalletLedgerReason {
  ADMIN_GRANT
  ADMIN_REVOKE
  BULLET_MESSAGE
  /// v1.21-live (CP-018, D106).
  FAMILY_CREATE
  CP_REQUEST
  CP_REFUND
  CP_GIFT
  /// v1.23-live (CP-020, D108): a gift sent in a live, paid with coins.
  LIVE_GIFT
  /// v1.27-live (D132): a LUCKY gift sent in a live (the charge; counts 10 % for the family).
  LUCKY_GIFT
  /// v1.27-live (D132): coins won by a lucky gift's draws (reference: the send).
  LUCKY_GIFT_WIN
  /// v1.28-live (D146): renting a premium username, and renewing it (reference: the payment).
  PREMIUM_USERNAME_RENT
  PREMIUM_USERNAME_RENEW
  /// v1.40-social (D155): a (non-lucky) gift sent in a direct conversation (reference: the send).
  DM_GIFT
  /// v1.33-live (D154b): a traffic card bought with coins, and its refund when it never ran.
  LIVE_BOOST
  LIVE_BOOST_REFUND
  /// v1.44-social (D166): a claimed task's coins (reference: the claim), a daily check-in's coins
  /// (reference: the check-in) and an event prize (reference: the event result).
  TASK_REWARD
  CHECK_IN_REWARD
  EVENT_PRIZE
  /// v1.54-social (D185): coins bought from a recharge agent (reference: the sale).
  RECHARGE_PURCHASE
  /// v1.59-social (D190): coins bought on the website (reference: the order), taken back after a refund, an
  /// early-fraud warning or a dispute (reference: the Stripe event; the balance may go below 0), and given back
  /// when a dispute is won (reference: the Stripe event).
  CARD_TOPUP
  CARD_TOPUP_REVERSAL
  CARD_TOPUP_RESTORE
  /// v1.69-social (D204): the frozen coins of a recharge order credited to the buyer (reference: the order).
  RECHARGE_ORDER
  /// v1.72-social (D208): a credit or debit by the team from the admin panel or `control-admin` (reference: the
  /// `admin_balance_adjustments` row; its reason text is there).
  ADMIN_ADJUSTMENT
  /// v1.82-social (D252): a VIP tier bought, renewed or upgraded with coins (reference: the `vip_purchases` row).
  VIP_PURCHASE
  /// v1.83-social (D258): a VIP's daily coins (reference: the `vip_daily_coin_claims` row).
  VIP_DAILY_COINS
  /// D270 (§10.98): a store item bought with coins (reference: the `store_purchases` row).
  STORE_PURCHASE
  /// v1.100-social (D312, §10.118): a custom gift's owner share of a send, as coins (GIFT_CUSTOM_OWNER_PERCENT, 3 % of
  /// the coin value; reference: the send), and its claw-back when the send is reversed (the balance may go below 0).
  GIFT_OWNER_ROYALTY
  GIFT_OWNER_ROYALTY_REVERSAL
  /// v1.110-social (D345, §10.144): coins bought in a store (reference: the `store_purchases` row) and taken back after
  /// the store refunded them (reference: the purchase; the balance may go below 0).
  STORE_IAP
  STORE_IAP_REVERSAL

  @@map("wallet_ledger_reason")
}

/// CP-017 (D104): a user's coin balance (no row = 0). CHECK `wallets_coins_range`: 0 … 2^53−1
/// (CONVENTIONS §3). Changed only together with a `wallet_ledger` row.
model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  coins     BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// CP-017 (D104): every change of a coin balance. `(reason, reference_id)` is unique (one charge
/// per bullet, one row per admin grant). CHECKs `wallet_ledger_delta_nonzero` and
/// `wallet_ledger_balance_range` (migration 20261108090000_wallet_and_bullets).
model WalletLedgerEntry {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  delta        BigInt
  balanceAfter BigInt             @map("balance_after")
  reason       WalletLedgerReason
  referenceId  String             @map("reference_id") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CP-018: the family points this spending gave (at most one row).
  familyPoints FamilyPointsEntry?

  @@unique([reason, referenceId], map: "wallet_ledger_reference_once")
  @@index([userId, createdAt(sort: Desc)], map: "wallet_ledger_user_created_idx")
  /// D301 follow-up (§10.112.10): «الربح» sums the free coins given in a period (migration 20270402090400_owner_profit).
  @@index([createdAt], map: "wallet_ledger_free_coins_idx", where: raw("reason IN ('EVENT_PRIZE'::wallet_ledger_reason, 'TASK_REWARD'::wallet_ledger_reason, 'CHECK_IN_REWARD'::wallet_ledger_reason)"))
  /// v1.100-social (D312): «الربح» reads the custom gift owners' coin shares per day.
  @@index([createdAt], map: "wallet_ledger_gift_owner_idx", where: raw("reason IN ('GIFT_OWNER_ROYALTY'::wallet_ledger_reason, 'GIFT_OWNER_ROYALTY_REVERSAL'::wallet_ledger_reason)"))
  @@map("wallet_ledger")
}

/// CP-017 (D104): a bullet message (رسالة عامة), sent from one live to every live. `client_id`
/// is unique per sender (an idempotent retry, never charged twice); `cost` is what it cost.
/// CHECKs `live_bullets_text_length`, `live_bullets_cost_non_negative`.
model LiveBullet {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// The live it was sent from (null once that room is gone).
  roomId    String?  @map("room_id") @db.Uuid
  text      String   @db.VarChar(60)
  cost      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room LiveRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId], map: "live_bullets_client_once")
  @@index([roomId], map: "live_bullets_room_idx")
  @@map("live_bullets")
}

/// CP-013 (D96): a user muted in one live's chat by the host or a moderator (not a block).
/// CHECK `live_chat_mutes_not_self` (migration 20261029090000_live_chat).
model LiveChatMute {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mutedById String?  @map("muted_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room    LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User     @relation("LiveChatMuted", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User?    @relation("LiveChatMutedBy", fields: [mutedById], references: [id], onDelete: SetNull)

  @@id([roomId, userId], map: "live_chat_mutes_pkey")
  @@index([userId], map: "live_chat_mutes_user_idx")
  @@index([mutedById], map: "live_chat_mutes_muted_by_idx")
  @@map("live_chat_mutes")
}

/// v1.20-live (owner D105, CONVENTIONS §10.20): a person kicked out of one live by the host or a
/// moderator. One row per room and user; it ends with the live (a new live is a new room). Kept 30
/// days after the room ended, like chat mutes. CHECK `live_room_kicks_not_self` (migration
/// 20261109090000_live_kicks).
model LiveRoomKick {
  roomId     String   @map("room_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kickedById String?  @map("kicked_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room     LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation("LiveKicked", fields: [userId], references: [id], onDelete: Cascade)
  kickedBy User?    @relation("LiveKickedBy", fields: [kickedById], references: [id], onDelete: SetNull)

  @@id([roomId, userId], map: "live_room_kicks_pkey")
  @@index([userId], map: "live_room_kicks_user_idx")
  @@index([kickedById], map: "live_room_kicks_kicked_by_idx")
  @@map("live_room_kicks")
}

/// Follow graph edge (social module). CHECK `follows_no_self_follow`.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId], map: "follows_pkey")
  @@index([followeeId, createdAt(sort: Desc)], map: "follows_followee_id_created_at_idx")
  /// D121: the following list (`GET /users/{username}/following`), newest follow first.
  @@index([followerId, createdAt(sort: Desc)], map: "follows_follower_id_created_at_idx")
  @@map("follows")
}

/// v1.47-social (D175, CONVENTIONS §10.47): a pending request to follow a private account. Accepted →
/// a `follows` row (this row deleted); declined or cancelled → deleted. CHECK `follow_requests_not_self`.
model FollowRequest {
  requesterId String   @map("requester_id") @db.Uuid
  targetId    String   @map("target_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  requester User @relation("FollowRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FollowRequestTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId], map: "follow_requests_pkey")
  @@index([targetId, createdAt(sort: Desc), requesterId(sort: Desc)], map: "follow_requests_target_created_idx")
  @@map("follow_requests")
}

// ---------------------------------------------------------------------------------------------
// v1.4-levels (DRAFT, CP-005, D72) — four independent level systems. Hand-written SQL in
// migration 20261020090000_levels adds the CHECK constraints, the partial unique indexes (also
// declared below with the `partialIndexes` preview feature so `migrate dev` sees no drift) and
// the append-only grants (points_ledger, level_history). Admin actor ids (createdById, …) are
// plain uuids without a foreign key: the audit trail is audit_logs.

enum LevelCategoryCode {
  ATTRACTIVENESS
  SUPPORT
  WIZARD
  GAMING

  @@map("level_category_code")
}

enum LevelVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("level_version_status")
}

enum LevelValueUnit {
  COIN

  @@map("level_value_unit")
}

enum LevelReversalPolicy {
  REVERSE_POINTS
  KEEP_LEVEL

  @@map("level_reversal_policy")
}

enum PointsEntryType {
  EARN
  REVERSAL
  ADJUSTMENT

  @@map("points_entry_type")
}

enum PointsSourceType {
  GIFT_RECEIVED
  GIFT_SENT
  LUCKY_GIFT_SENT
  GAME_SPEND
  /// CP-016 D (D101): a viewer's taps in a live, 10 counted taps = 1 point (CONVENTIONS §10.18).
  LIVE_TAPS
  ADMIN
  CONFIG

  @@map("points_source_type")
}

enum LevelTransitionReason {
  EARNED
  REVERSED
  ADJUSTED
  CONFIG_PUBLISHED
  RECALCULATED
  /// v1.46-levels (D169): an admin deduction marked as fraud — the only way a level goes down.
  FRAUD

  @@map("level_transition_reason")
}

enum LevelSourceEventType {
  GIFT_COMMITTED
  GAME_SPEND_COMMITTED
  GIFT_REVERSED
  GAME_SPEND_REVERSED

  @@map("level_source_event_type")
}

enum LevelEventStatus {
  PENDING
  PROCESSED
  SKIPPED
  FAILED

  @@map("level_event_status")
}

enum LevelReconciliationMode {
  DRY_RUN
  REPAIR

  @@map("level_reconciliation_mode")
}

enum LevelReconciliationStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("level_reconciliation_status")
}

/// The four categories; seeded disabled with no version (CP-005 §8).
model LevelCategory {
  id                 String            @id @default(uuid(7)) @db.Uuid
  code               LevelCategoryCode @unique
  nameAr             String            @map("name_ar") @db.VarChar(40)
  nameEn             String            @map("name_en") @db.VarChar(40)
  descriptionAr      String            @map("description_ar") @db.VarChar(200)
  descriptionEn      String            @map("description_en") @db.VarChar(200)
  isEnabled          Boolean           @default(false) @map("is_enabled")
  /// The PUBLISHED version, if any (kept in step with level_category_versions.status).
  publishedVersionId String?           @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  publishedVersion LevelCategoryVersion?  @relation("LevelCategoryPublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         LevelCategoryVersion[] @relation("LevelCategoryVersions")
  states           UserLevelState[]
  entries          PointsLedgerEntry[]
  history          LevelHistory[]

  @@map("level_categories")
}

/// A configuration version; DRAFT → PUBLISHED → ARCHIVED. Published rows are never edited.
model LevelCategoryVersion {
  id                       String              @id @default(uuid(7)) @db.Uuid
  categoryId               String              @map("category_id") @db.Uuid
  versionNumber            Int                 @map("version_number")
  status                   LevelVersionStatus  @default(DRAFT)
  /// CHECK > 0 when set; required to publish.
  multiplier               Decimal?            @db.Decimal(18, 6)
  valueUnit                LevelValueUnit?     @map("value_unit")
  reversalPolicy           LevelReversalPolicy @default(REVERSE_POINTS) @map("reversal_policy")
  luckyGiftsCountAsSupport Boolean             @default(false) @map("lucky_gifts_count_as_support")
  createdById              String?             @map("created_by_id") @db.Uuid
  publishedById            String?             @map("published_by_id") @db.Uuid
  publishedAt              DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     LevelCategory     @relation("LevelCategoryVersions", fields: [categoryId], references: [id], onDelete: Restrict)
  publishedFor LevelCategory?    @relation("LevelCategoryPublished")
  levels       LevelDefinition[]

  @@unique([categoryId, versionNumber], map: "level_category_versions_category_number_key")
  @@unique([categoryId], map: "level_category_versions_one_published", where: raw("status = 'PUBLISHED'::level_version_status"))
  @@map("level_category_versions")
}

/// One level of a version. Rules (1..n without gaps, level 1 at 0, strictly increasing) are
/// enforced on publish; CHECKs guard the ranges.
model LevelDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  levelNumber    Int      @map("level_number")
  nameAr         String   @map("name_ar") @db.VarChar(40)
  nameEn         String   @map("name_en") @db.VarChar(40)
  requiredPoints BigInt   @map("required_points")
  iconKey        String?  @map("icon_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version LevelCategoryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, levelNumber], map: "level_definitions_version_level_key")
  @@map("level_definitions")
}

/// Current progression per user and category (derived from points_ledger; never trusted from clients).
model UserLevelState {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  categoryId              String    @map("category_id") @db.Uuid
  /// CHECK >= 0. Σ points_ledger.points_delta for this user and category.
  totalPoints             BigInt    @default(0) @map("total_points")
  /// Σ of positive EARN deltas (refunds do not lower it).
  lifetimeEarnedPoints    BigInt    @default(0) @map("lifetime_earned_points")
  /// D194 (§10.57): level points credited at a ladder change so a kept level sits at its new
  /// threshold; CHECK >= 0. The level is measured on total + carried; not part of the ledger.
  carriedPoints           BigInt    @default(0) @map("carried_points")
  /// Level number under `versionId`; null before any published version applied.
  currentLevel            Int?      @map("current_level")
  versionId               String?   @map("version_id") @db.Uuid
  lastQualifiedActivityAt DateTime? @map("last_qualified_activity_at") @db.Timestamptz(3)
  calculatedAt            DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LevelCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId], map: "user_level_states_user_category_key")
  @@index([categoryId, currentLevel], map: "user_level_states_category_level_idx")
  @@map("user_level_states")
}

/// Immutable source of truth for points (append-only: the runtime role cannot UPDATE/DELETE).
model PointsLedgerEntry {
  id                  String           @id @default(uuid(7)) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  categoryId          String           @map("category_id") @db.Uuid
  entryType           PointsEntryType  @map("entry_type")
  sourceType          PointsSourceType @map("source_type")
  /// The producer's transaction id (activity entries); null for ADMIN/CONFIG entries.
  sourceTransactionId String?          @map("source_transaction_id") @db.VarChar(128)
  sourceValue         BigInt?          @map("source_value")
  /// CHECK <> 0.
  pointsDelta         BigInt           @map("points_delta")
  multiplierUsed      Decimal?         @map("multiplier_used") @db.Decimal(18, 6)
  versionId           String?          @map("version_id") @db.Uuid
  /// ADJUSTMENT idempotency (admin `Idempotency-Key`), unique when set.
  idempotencyKey      String?          @map("idempotency_key") @db.VarChar(128)
  /// REVERSAL → the EARN it compensates (unique: a reversal happens once).
  reversalOfEntryId   String?          @unique(map: "points_ledger_reversal_of_key") @map("reversal_of_entry_id") @db.Uuid
  reason              String?          @db.VarChar(500)
  /// v1.46-levels (D169): an admin deduction marked as fraud (CHECK: negative ADJUSTMENT only).
  fraud               Boolean          @default(false)
  createdById         String?          @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   LevelCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reversalOf PointsLedgerEntry? @relation("PointsReversal", fields: [reversalOfEntryId], references: [id], onDelete: Cascade)
  reversedBy PointsLedgerEntry? @relation("PointsReversal")

  @@unique([categoryId, sourceType, sourceTransactionId, entryType], map: "points_ledger_source_once", where: raw("entry_type = ANY (ARRAY['EARN'::points_entry_type, 'REVERSAL'::points_entry_type])"))
  @@unique([idempotencyKey], map: "points_ledger_idempotency_key", where: raw("idempotency_key IS NOT NULL"))
  @@index([userId, categoryId, createdAt(sort: Desc), id(sort: Desc)], map: "points_ledger_user_category_created_idx")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "points_ledger_user_created_idx")
  @@index([sourceTransactionId], map: "points_ledger_source_transaction_idx")
  @@index([categoryId], map: "points_ledger_category_id_idx")
  @@map("points_ledger")
}

/// Level transitions (append-only). previous/new are level numbers; null = no level.
model LevelHistory {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  categoryId    String                @map("category_id") @db.Uuid
  previousLevel Int?                  @map("previous_level")
  newLevel      Int?                  @map("new_level")
  points        BigInt
  reason        LevelTransitionReason
  ledgerEntryId String?               @map("ledger_entry_id") @db.Uuid
  versionId     String?               @map("version_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LevelCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "level_history_user_created_idx")
  @@index([categoryId, createdAt(sort: Desc)], map: "level_history_category_created_idx")
  @@map("level_history")
}

/// Inbox of producer events (CP-005 §6); one row per (type, source transaction).
model LevelSourceEvent {
  id                  String               @id @default(uuid(7)) @db.Uuid
  type                LevelSourceEventType
  sourceTransactionId String               @map("source_transaction_id") @db.VarChar(128)
  payload             Json                 @db.JsonB
  status              LevelEventStatus     @default(PENDING)
  attempts            Int                  @default(0)
  lastError           String?              @map("last_error") @db.VarChar(300)
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(3)

  @@unique([type, sourceTransactionId], map: "level_source_events_type_source_key")
  @@index([status, receivedAt(sort: Desc)], map: "level_source_events_status_received_idx")
  @@index([receivedAt(sort: Desc), id(sort: Desc)], map: "level_source_events_received_idx")
  @@map("level_source_events")
}

/// Reconciliation runs (CP-005); `errors` is a JSON array of short strings.
model LevelReconciliationRun {
  id                String                    @id @default(uuid(7)) @db.Uuid
  category          LevelCategoryCode?
  mode              LevelReconciliationMode
  status            LevelReconciliationStatus @default(RUNNING)
  startedAt         DateTime                  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(3)
  eventsInspected   Int                       @default(0) @map("events_inspected")
  statesInspected   Int                       @default(0) @map("states_inspected")
  failedEvents      Int                       @default(0) @map("failed_events")
  unprocessedEvents Int                       @default(0) @map("unprocessed_events")
  stateMismatches   Int                       @default(0) @map("state_mismatches")
  corrected         Int                       @default(0)
  errors            Json                      @default("[]") @db.JsonB
  initiatedById     String?                   @map("initiated_by_id") @db.Uuid

  @@index([startedAt(sort: Desc), id(sort: Desc)], map: "level_reconciliation_runs_started_idx")
  @@map("level_reconciliation_runs")
}

/// Granular admin permissions (CP-005 §9.8, owner 2026-10-20). An admin endpoint needs
/// `users.role = ADMIN` AND the permission it names. Granted with `pnpm levels:admin grant`.
enum AdminPermission {
  LEVELS_VIEW
  LEVELS_EDIT
  LEVELS_PUBLISH
  LEVELS_ADJUST
  LEVELS_RECONCILE
  /// v1.5-social (CP-006): the report queue.
  MODERATION
  /// v1.6-live (CP-010): grant and revoke the hosting permission.
  LIVE_HOSTS
  /// v1.60-social (D191, CONVENTIONS §10.54): the admin panel's roles. `MODERATION` above is the panel's
  /// moderator «مشرف»; OWNER holds every panel capability; SUPPORT «دعم» and FINANCE «مالية» hold theirs.
  /// Granted only with `admin-admin grant` (audited).
  OWNER
  SUPPORT
  FINANCE
  /// v1.75-live (D285, §10.96.13): «تطوير الأعمال» — recruitment only (a limited staff account, no moderation).
  BD

  @@map("admin_permission")
}

model UserAdminPermission {
  userId      String          @map("user_id") @db.Uuid
  permission  AdminPermission
  /// Null when granted from the command line.
  grantedById String?         @map("granted_by_id") @db.Uuid
  grantedAt   DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission], map: "user_admin_permissions_pkey")
  @@map("user_admin_permissions")
}

// ---------------------------------------------------------------------------------------------
// v1.5-social (DRAFT, CP-006 M1, D87) — media, posts, comments, search and safety
// (CONVENTIONS §11). Owners: `media` module (media_*), `posts` module (posts, post_*, hashtags,
// comments, comment_*), `safety` module (user_blocks, user_mutes, post_hides, reports,
// privacy_settings). Counters on posts/comments change in the same transaction as their rows.

enum MediaUploadStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("media_upload_status")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED

  @@map("post_status")
}

/// v1.41-social (D162, CP-023): a post, or a reel (one vertical video, Moments).
enum PostFormat {
  POST
  REEL

  @@map("post_format")
}

enum PostModeration {
  VISIBLE
  PENDING
  REMOVED

  @@map("post_moderation")
}

enum WhoCanComment {
  EVERYONE
  FOLLOWERS
  NOBODY

  @@map("who_can_comment")
}

enum WhoCanMention {
  EVERYONE
  FOLLOWING
  NOBODY

  @@map("who_can_mention")
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  STORY
  LIVE_ROOM
  LIVE_CHAT_MESSAGE
  /// CP-021 (D112): a confession on a CP couple's page.
  CP_CONFESSION
  /// CP-022 (D116): a message in a family's chat.
  FAMILY_CHAT_MESSAGE
  /// v1.40-social (D155): a direct message (kept as a snapshot: messages live 24 h).
  DM_MESSAGE
  /// v1.47-social (D175): a link on someone's profile (kept as a snapshot: links can be edited).
  PROFILE_LINK
  /// v1.104-social (D339): a group conversation (kept as a snapshot: its messages live 24 h).
  DM_GROUP

  @@map("report_target_type")
}

enum ReportReason {
  SPAM
