// Kabso Live — Phase 1 schema (identity, sessions, verification tokens, audit log).
// Conventions: snake_case tables/columns via @@map/@map, UUIDv7 ids, timestamptz(3).
// Ownership: auth module owns sessions/verification_tokens; users module owns users,
// user_profiles, user_settings; audit_logs is append-only (common). Phase 2 (contract v1.3,
// docs/contracts/DB_PHASE2_DISCOVERY.md): live module owns live_categories, live_rooms; social
// module owns follows. v1.4-levels (DRAFT, CP-005): the levels module owns every `level_*` table,
// `user_level_states` and `points_ledger`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("verification_purpose")
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed + lowercased) before write; unique.
  email           String     @unique @db.VarChar(254)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Argon2id PHC string.
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(USER)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// v1.25-live (CP-022, D116): the last authenticated request (written at most once a minute);
  /// online = within the last 5 minutes. Shown only as CONVENTIONS §10.25 allows.
  lastActiveAt    DateTime?  @map("last_active_at") @db.Timestamptz(3)

  profile            UserProfile?
  settings           UserSettings?
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
  liveRooms          LiveRoom[]
  liveHost           LiveHost?              @relation("LiveHostUser")
  liveHostsGranted   LiveHost[]             @relation("LiveHostGrantedBy")
  liveViews          LiveRoomViewer[]
  liveSeats          LiveRoomSeat[]
  liveSeatRequests   LiveSeatRequest[]
  liveSeatInvites    LiveSeatInvite[]       @relation("LiveSeatInvitee")
  liveSeatInvitesBy  LiveSeatInvite[]       @relation("LiveSeatInviter")
  liveModeratorOf    LiveRoomModerator[]
  liveTaps           LiveRoomTapper[]
  liveChatMessages   LiveChatMessage[]      @relation("LiveChatAuthor")
  liveChatDeletions  LiveChatMessage[]      @relation("LiveChatDeleter")
  liveChatMutes      LiveChatMute[]         @relation("LiveChatMuted")
  liveChatMutesBy    LiveChatMute[]         @relation("LiveChatMutedBy")
  liveKicks          LiveRoomKick[]         @relation("LiveKicked")
  liveKicksBy        LiveRoomKick[]         @relation("LiveKickedBy")
  following          Follow[]               @relation("FollowFollower")
  followers          Follow[]               @relation("FollowFollowee")
  levelStates        UserLevelState[]
  pointsEntries      PointsLedgerEntry[]
  levelHistory       LevelHistory[]
  adminPermissions   UserAdminPermission[]
  mediaUploads       MediaUpload[]
  mediaAssets        MediaAsset[]
  posts              Post[]
  postLikes          PostLike[]
  postSaves          PostSave[]
  postReposts        PostRepost[]
  postViews          PostView[]
  postShareEvents    PostShareEvent[]
  postPins           PostPin[]
  postMentions       PostMention[]
  comments           Comment[]
  commentLikes       CommentLike[]
  commentMentions    CommentMention[]
  blocking           UserBlock[]            @relation("BlockBlocker")
  blockedBy          UserBlock[]            @relation("BlockBlocked")
  muting             UserMute[]             @relation("MuteMuter")
  mutedBy            UserMute[]             @relation("MuteMuted")
  postHides          PostHide[]
  reportsMade        Report[]               @relation("ReportReporter")
  reportsAgainst     Report[]               @relation("ReportTargetUser")
  reportsResolved    Report[]               @relation("ReportResolver")
  privacySettings    PrivacySettings?
  stories            Story[]
  storyViews         StoryView[]
  storyMentions      StoryMention[]
  notifications      Notification[]
  notificationActs   NotificationActor[]
  notificationPrefs  NotificationSettings?
  livePointsHourly   LiveHostPointsHourly[] @relation("LiveHostPointsHourly")
  liveScheduleSlots  LiveScheduleSlot[]     @relation("LiveScheduleSlots")
  wallet             Wallet?
  walletLedger       WalletLedgerEntry[]
  liveBullets        LiveBullet[]
  // v1.21-live (CP-018, D106): families, CP couples and medals.
  familyMember       FamilyMember?
  familiesCreated    Family[]               @relation("FamilyCreatedBy")
  familyJoinRequests FamilyJoinRequest[]    @relation("FamilyJoinRequester")
  familyJoinHandled  FamilyJoinRequest[]    @relation("FamilyJoinHandler")
  familyPoints       FamilyPointsEntry[]
  cpRequestsSent     CpRequest[]            @relation("CpRequestSender")
  cpRequestsReceived CpRequest[]            @relation("CpRequestReceiver")
  cpCouplesA         CpCouple[]             @relation("CpCoupleA")
  cpCouplesB         CpCouple[]             @relation("CpCoupleB")
  cpCouplesEnded     CpCouple[]             @relation("CpCoupleEndedBy")
  cpPartner          CpPartner?             @relation("CpPartnerUser")
  cpPartnerOf        CpPartner[]            @relation("CpPartnerOther")
  cpGiftsSent        CpGift[]               @relation("CpGiftSender")
  cpGiftsReceived    CpGift[]               @relation("CpGiftReceiver")
  cpCheckIns         CpCheckIn[]
  cpTaskClaims       CpTaskClaim[]
  cpConfessionsSent  CpConfession[]         @relation("CpConfessionAuthor")
  cpConfessionsGot   CpConfession[]         @relation("CpConfessionRecipient")
  cpConfessionsDel   CpConfession[]         @relation("CpConfessionDeleter")
  medals             UserMedal[]
  // v1.22-live (CP-019, D107): the bag (owned profile cards and later categories).
  bagItems           UserBagItem[]
  // v1.23-live (CP-020, D108): live gifts and the gift bag.
  giftStock          UserGiftStock[]
  giftsSent          LiveGift[]
  giftsReceived      LiveGiftRecipient[]
  // v1.25-live (CP-022, D116): family chat.
  familyChatMessages FamilyChatMessage[]    @relation("FamilyChatAuthor")
  familyChatDeleted  FamilyChatMessage[]    @relation("FamilyChatDeleter")
  familyChatMutes    FamilyChatMute[]       @relation("FamilyChatMuted")
  familyChatMutesBy  FamilyChatMute[]       @relation("FamilyChatMutedBy")

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  /// Lowercase; format enforced by CHECK constraint `user_profiles_username_format`.
  username    String   @unique @db.VarChar(30)
  /// ≤ 100 code points, 1–50 grapheme clusters (contract v1.2 §6).
  displayName String   @map("display_name") @db.VarChar(100)
  bio         String?  @db.VarChar(300)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(2048)
  locale      String   @default("ar") @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  userId    String   @id @map("user_id") @db.Uuid
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Session {
  id                        String    @id @default(uuid(7)) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the current refresh secret.
  refreshTokenHash          String    @map("refresh_token_hash") @db.Char(64)
  /// SHA-256 (hex) of the immediately preceding secret (also element 1 of the history below).
  previousRefreshTokenHash  String?   @map("previous_refresh_token_hash") @db.Char(64)
  /// SHA-256 (hex) of the last 10 rotated secrets, newest first (SEC-022). Presenting any of
  /// them is reuse and revokes the session. Bounded by the rotation SQL and a CHECK constraint.
  rotatedRefreshTokenHashes String[]  @default([]) @map("rotated_refresh_token_hashes") @db.Char(64)
  /// Incremented on every rotation (compare-and-swap guard + diagnostics).
  rotationCounter           Int       @default(0) @map("rotation_counter")
  deviceName                String?   @map("device_name") @db.VarChar(100)
  platform                  String?   @db.VarChar(16)
  appVersion                String?   @map("app_version") @db.VarChar(32)
  ip                        String?   @db.VarChar(64)
  userAgent                 String?   @map("user_agent") @db.VarChar(512)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt                DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding expiry (REFRESH_TTL_SECONDS from last rotation, capped by absoluteExpiresAt).
  expiresAt                 DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt         DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt                 DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT | USER_REVOKED | REFRESH_REUSE | PASSWORD_RESET | ADMIN
  revokedReason             String?   @map("revoked_reason") @db.VarChar(32)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "sessions_user_id_created_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model VerificationToken {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  /// SHA-256 (hex) of the raw token; the raw token is only ever sent by mail.
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "verification_tokens_user_id_purpose_idx")
  @@index([expiresAt], map: "verification_tokens_expires_at_idx")
  @@map("verification_tokens")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for anonymous actions (e.g. failed login for an unknown identifier).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  targetType  String?  @map("target_type") @db.VarChar(32)
  targetId    String?  @map("target_id") @db.VarChar(64)
  metadata    Json?    @db.JsonB
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Audit rows survive user deletion (actor becomes NULL).
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@index([action, createdAt(sort: Desc)], map: "audit_logs_action_created_at_idx")
  @@index([targetType, targetId], map: "audit_logs_target_idx")
  @@map("audit_logs")
}

/// Verify-first registration (contract v1.2 §6, KL-019). No account exists until the emailed code
/// is verified. At most one row per email; a username held by a live row counts as taken.
model PendingRegistration {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Normalized (trimmed + lowercase).
  email         String   @unique @db.VarChar(254)
  /// Lowercase; reserved while the row is live (format CHECK as for user_profiles).
  username      String   @unique @db.VarChar(30)
  displayName   String   @map("display_name") @db.VarChar(100)
  locale        String   @db.VarChar(8)
  /// Argon2id PHC string of the chosen password (computed at register time).
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  deviceName    String?  @map("device_name") @db.VarChar(100)
  platform      String?  @db.VarChar(16)
  appVersion    String?  @map("app_version") @db.VarChar(32)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  /// HMAC-SHA-256 (hex) of the 8-digit code, keyed by a key derived from RATE_LIMIT_KEY_SECRET.
  codeHash      String   @map("code_hash") @db.Char(64)
  /// Checks of the CURRENT code (max 5; reset when resend issues a new code).
  attempts      Int      @default(0)
  /// Checks across all codes of this pending registration (max 10, never reset; SEC-026).
  totalAttempts Int      @default(0) @map("total_attempts")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "pending_registrations_expires_at_idx")
  @@map("pending_registrations")
}

// ---------------------------------------------------------------------------------------------
// Phase 2 slice 1 — live discovery and follow (contract v1.3, DB_PHASE2_DISCOVERY.md).
// CHECK constraints and the partial indexes (WHERE status = 'LIVE') are hand-written SQL in
// migration 20261016123000_live_discovery. The partial indexes are also declared below (preview
// feature `partialIndexes`) only so that `prisma migrate dev` knows them and never generates a
// DROP INDEX for them; the migration SQL remains the source of truth.

enum LiveRoomStatus {
  LIVE
  ENDED

  @@map("live_room_status")
}

enum LiveRoomMode {
  SOLO
  PK
  MULTI
  /// CP-011 (D94): voice only, with seats.
  AUDIO

  @@map("live_room_mode")
}

enum LiveRoomEndReason {
  HOST_ENDED
  HEARTBEAT_TIMEOUT
  HOST_SUSPENDED
  ADMIN

  @@map("live_room_end_reason")
}

/// Server-curated live categories. None are seeded (D37); rows are deactivated, never deleted.
model LiveCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// CHECK `live_categories_slug_format`: ^[a-z0-9-]{2,32}$
  slug      String   @unique @db.VarChar(32)
  nameAr    String   @map("name_ar") @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rooms LiveRoom[]

  @@map("live_categories")
}

/// A live room is metadata plus a host heartbeat (no media in v1.3, B1).
/// CP-010: where a hosting permission came from (owner D93: agencies and identity checks in L1b).
enum LiveHostSource {
  ADMIN
  AGENCY
  IDENTITY

  @@map("live_host_source")
}

/// CP-010: users who may go live (`Me.canHost`).
model LiveHost {
  userId       String         @id @map("user_id") @db.Uuid
  source       LiveHostSource
  grantedById  String?        @map("granted_by_id") @db.Uuid
  grantedAt    DateTime       @default(now()) @map("granted_at") @db.Timestamptz(3)
  /// CP-015 (D98): the host's live cover, reused by every live (a `LIVE_COVER` asset), and its
  /// public URL (the 640 px square variant). Both set or both null (CHECK).
  coverMediaId String?        @unique @map("cover_media_id") @db.Uuid
  coverUrl     String?        @map("cover_url") @db.VarChar(2048)
  /// CP-016 B (D99): words masked in this host's live chats (at most 100, CHECK).
  blockedWords String[]       @default([]) @map("blocked_words") @db.VarChar(30)
  /// CP-016 G (D99): the host's public room number, 9 digits, random and unique (CHECK range);
  /// given with the permission and shown in every live of this host ("ID: …").
  roomNumber   Int            @unique(map: "live_hosts_room_number_key") @default(dbgenerated("(((100000000)::double precision + floor((random() * (900000000)::double precision))))::integer")) @map("room_number")

  user       User        @relation("LiveHostUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User?       @relation("LiveHostGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  coverMedia MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: NoAction)

  @@index([grantedById], map: "live_hosts_granted_by_idx")
  @@map("live_hosts")
}

/// CP-010: who is connected to a room's media session now (from the media server's webhook).
/// `identity` is the user id, or `guest:<guestId>` for a guest.
model LiveRoomViewer {
  roomId   String   @map("room_id") @db.Uuid
  identity String   @db.VarChar(80)
  userId   String?  @map("user_id") @db.Uuid
  guestId  String?  @map("guest_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, identity], map: "live_room_viewers_pkey")
  @@index([roomId, joinedAt(sort: Desc), identity(sort: Desc)], map: "live_room_viewers_room_joined_idx")
  @@index([userId], map: "live_room_viewers_user_idx")
  @@map("live_room_viewers")
}

model LiveRoom {
  id              String             @id @default(uuid(7)) @db.Uuid
  hostUserId      String             @map("host_user_id") @db.Uuid
  /// 1–80 graphemes / ≤ 160 code points, validated in the application (CONVENTIONS §10.3).
  title           String             @db.VarChar(160)
  categoryId      String?            @map("category_id") @db.Uuid
  status          LiveRoomStatus     @default(LIVE)
  mode            LiveRoomMode       @default(SOLO)
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime           @default(now()) @map("last_heartbeat_at") @db.Timestamptz(3)
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz(3)
  endReason       LiveRoomEndReason? @map("end_reason")
  /// CP-010: connected viewers other than the host, guests included (kept from `live_room_viewers`).
  viewerCount     Int                @default(0) @map("viewer_count")
  /// CP-010: people without an account may watch (owner D93: allowed by default).
  allowGuests     Boolean            @default(true) @map("allow_guests")
  /// CP-011: tiles (host included) of a MULTI (4, 6, 9, 12) or AUDIO (5, 10, 15, 20, 25, D103) room; null for
  /// SOLO. CHECK `live_rooms_seat_count_mode` (migration 20261027090000_live_seats).
  seatCount       Int?               @map("seat_count") @db.SmallInt
  /// CP-011: a slug of LiveConfig.themes (CHECK `live_rooms_theme_format`).
  theme           String             @default("classic") @db.VarChar(32)
  /// CP-011: increases on every change of the room's seats, requests, invitations or moderators.
  seatsVersion    Int                @default(0) @map("seats_version")
  /// CP-012: the room's total score (tap + support points), kept equal to the room's
  /// `live_room_scores` row in the same transaction; `popular` orders by it (CONVENTIONS §10.4).
  score           BigInt             @default(0)
  /// CP-013: false when the host turned the room chat off (a new live starts with it on).
  chatEnabled     Boolean            @default(true) @map("chat_enabled")
  /// CP-014: the live's topic (1–100 code points, CHECK `live_rooms_topic_length`); null = none.
  topic           String?            @db.VarChar(100)
  /// CP-014: increases on every change of the title, category or topic (media metadata
  /// `roomInfoVersion`, CONVENTIONS §10.12).
  infoVersion     Int                @default(0) @map("info_version")
  /// Always null in v1.3 (no upload).
  coverUrl        String?            @map("cover_url") @db.VarChar(2048)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  host         User                @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  category     LiveCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  viewers      LiveRoomViewer[]
  reports      Report[]
  seats        LiveRoomSeat[]
  seatRequests LiveSeatRequest[]
  seatInvites  LiveSeatInvite[]
  moderators   LiveRoomModerator[]
  scoreParts   LiveRoomScore?
  tappers      LiveRoomTapper[]
  chatMessages LiveChatMessage[]
  chatMutes    LiveChatMute[]
  kicks        LiveRoomKick[]
  bullets      LiveBullet[]
  gifts        LiveGift[]

  @@unique([hostUserId], map: "live_rooms_one_live_per_host", where: raw("status = 'LIVE'::live_room_status"))
  @@index([score(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_popular_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_new_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([categoryId, score(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_cat_popular_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([categoryId, startedAt(sort: Desc), id(sort: Desc)], map: "live_rooms_live_cat_new_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([lastHeartbeatAt], map: "live_rooms_live_heartbeat_idx", where: raw("status = 'LIVE'::live_room_status"))
  @@index([hostUserId, startedAt(sort: Desc)], map: "live_rooms_host_started_idx")
  @@index([categoryId], map: "live_rooms_category_id_idx")
  @@map("live_rooms")
}

/// CP-011: a seat that is not EMPTY — either LOCKED (no user) or TAKEN (a user). An EMPTY seat has
/// no row. Seats are numbered 1 … seat_count-1 (the host is 0). CHECKs `live_room_seats_index`
/// and `live_room_seats_locked_or_taken` (migration 20261027090000_live_seats).
model LiveRoomSeat {
  roomId      String   @map("room_id") @db.Uuid
  seatIndex   Int      @map("seat_index") @db.SmallInt
  locked      Boolean  @default(false)
  userId      String?  @map("user_id") @db.Uuid
  mutedByHost Boolean  @default(false) @map("muted_by_host")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, seatIndex], map: "live_room_seats_pkey")
  @@unique([roomId, userId], map: "live_room_seats_one_per_user")
  @@index([userId], map: "live_room_seats_user_idx")
  @@map("live_room_seats")
}

/// CP-011: the state of a seat request or invitation.
enum LiveSeatOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  REPLACED

  @@map("live_seat_offer_status")
}

/// CP-011: a viewer asks for a seat. At most one PENDING per room and user.
model LiveSeatRequest {
  id        String              @id @default(uuid(7)) @db.Uuid
  roomId    String              @map("room_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  seatIndex Int?                @map("seat_index") @db.SmallInt
  status    LiveSeatOfferStatus @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  handledAt DateTime?           @map("handled_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "live_seat_requests_one_pending", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([roomId, createdAt, id], map: "live_seat_requests_pending_idx", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([userId], map: "live_seat_requests_user_idx")
  @@map("live_seat_requests")
}

/// CP-011: the host or a moderator invites a viewer; expires after 60 s. At most one PENDING per
/// room and user (a new one REPLACES it).
model LiveSeatInvite {
  id          String              @id @default(uuid(7)) @db.Uuid
  roomId      String              @map("room_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  seatIndex   Int?                @map("seat_index") @db.SmallInt
  invitedById String              @map("invited_by_id") @db.Uuid
  status      LiveSeatOfferStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(3)
  handledAt   DateTime?           @map("handled_at") @db.Timestamptz(3)

  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation("LiveSeatInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("LiveSeatInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "live_seat_invites_one_pending", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([expiresAt], map: "live_seat_invites_pending_expiry_idx", where: raw("status = 'PENDING'::live_seat_offer_status"))
  @@index([userId], map: "live_seat_invites_user_idx")
  @@index([invitedById], map: "live_seat_invites_invited_by_idx")
  @@map("live_seat_invites")
}

/// CP-011: up to 5 moderators per room, appointed by the host for that room only.
model LiveRoomModerator {
  roomId  String   @map("room_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId], map: "live_room_moderators_pkey")
  @@index([userId], map: "live_room_moderators_user_idx")
  @@map("live_room_moderators")
}

/// CP-012 (D95): a room's score parts. `tap_points` is 1 per counted tap; `support_points` is 100
/// per support coin, written by L3 with the gift (0 until then). `live_rooms.score` holds the total
/// (CONVENTIONS §10.10). CHECK `live_room_scores_nonneg` (migration 20261028090000_live_taps).
model LiveRoomScore {
  roomId        String   @id @map("room_id") @db.Uuid
  tapPoints     BigInt   @default(0) @map("tap_points")
  supportPoints BigInt   @default(0) @map("support_points")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("live_room_scores")
}

/// CP-016 A (D99): points a host's lives received in one UTC hour (counted taps; support coins
/// with L3). The popularity boards sum these over the current hour, day and week; rows older than
/// 15 days are removed by the live sweeper. CHECK `live_host_points_hourly_points` (>= 0).
model LiveHostPointsHourly {
  hostUserId String   @map("host_user_id") @db.Uuid
  hourStart  DateTime @map("hour_start") @db.Timestamptz(3)
  points     BigInt   @default(0)

  host User @relation("LiveHostPointsHourly", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@id([hostUserId, hourStart], map: "live_host_points_hourly_pkey")
  @@index([hourStart], map: "live_host_points_hourly_hour_idx")
  @@map("live_host_points_hourly")
}

/// CP-016 C (D99): a live the host announced (CONVENTIONS §10.16). Followers get
/// `LIVE_SCHEDULED_SOON` 15 minutes before `startsAt`; `remindedAt` marks that the sweeper sent it
/// (once). Deleted 30 days after the start. CHECKs in migration 20261103090000_live_schedule.
model LiveScheduleSlot {
  id         String    @id @default(uuid(7)) @db.Uuid
  hostUserId String    @map("host_user_id") @db.Uuid
  title      String    @db.VarChar(60)
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(3)
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  host          User           @relation("LiveScheduleSlots", fields: [hostUserId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([hostUserId, startsAt], map: "live_schedule_slots_host_starts_idx")
  @@index([startsAt], map: "live_schedule_slots_due_idx", where: raw("reminded_at IS NULL"))
  @@map("live_schedule_slots")
}

/// CP-012 (D95): a caller's counted taps in one room and the time of their last counted batch; the
/// 10-a-second and 10 000-a-live limits are checked against it. Kept for admins (abuse watch, no
/// endpoint). CHECK `live_room_tappers_counted` (migration 20261028090000_live_taps).
model LiveRoomTapper {
  roomId       String    @map("room_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  counted      Int       @default(0)
  /// The last tap batch that counted (null: this person only sent gifts in the live).
  lastBatchAt  DateTime? @map("last_batch_at") @db.Timestamptz(3)
  /// v1.23-live (CP-020): the coin value of the gifts this person sent in the live.
  supportCoins BigInt    @default(0) @map("support_coins")
  /// v1.23-live (CP-020): Contribution points = counted + 100 × supportCoins (CHECK
  /// `live_room_tappers_points`), and when that total was reached (ties).
  points       BigInt    @default(0)
  pointsAt     DateTime  @map("points_at") @db.Timestamptz(3)

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId], map: "live_room_tappers_pkey")
  @@index([userId], map: "live_room_tappers_user_idx")
  /// CP-014 / v1.23-live: the Contribution list (points desc, then who reached them first, then user id).
  @@index([roomId, points(sort: Desc), pointsAt, userId], map: "live_room_tappers_room_rank_idx")
  @@map("live_room_tappers")
}

/// CP-013 (D96): the author's role in the room when a chat message was sent.
enum LiveChatAuthorRole {
  HOST
  MODERATOR
  SPEAKER
  VIEWER

  @@map("live_chat_author_role")
}

/// CP-017 (D104): what a chat message carries. VOICE and IMAGE vanish 60 s after sending.
enum LiveChatMessageKind {
  TEXT
  VOICE
  IMAGE

  @@map("live_chat_message_kind")
}

/// CP-013 (D96): a live room chat message. `text` is 1–200 code points after the §10.11 rules
/// (CHECK `live_chat_messages_text_length`); `client_id` is chosen by the app, unique per sender
/// (an idempotent retry). Soft-deleted by its author, the host, a moderator or an admin report
/// action. Removed by the live sweeper 30 days after the room ended unless an OPEN report points
/// at it (migration 20261029090000_live_chat).
/// CP-017 (D104): a VOICE or IMAGE message has empty `text`, its `LIVE_CHAT_*` asset in
/// `media_id` and `expires_at` = sent + 60 s; the live chat sweeper deletes the asset after that
/// (`media_id` becomes NULL). CHECKs `live_chat_messages_text_length` and
/// `live_chat_messages_kind_shape` (migration 20261108100000_live_chat_media).
model LiveChatMessage {
  id          String              @id @default(uuid(7)) @db.Uuid
  roomId      String              @map("room_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  clientId    String              @map("client_id") @db.Uuid
  kind        LiveChatMessageKind @default(TEXT)
  text        String              @default("") @db.VarChar(200)
  mediaId     String?             @unique(map: "live_chat_messages_media_once") @map("media_id") @db.Uuid
  expiresAt   DateTime?           @map("expires_at") @db.Timestamptz(3)
  authorRole  LiveChatAuthorRole  @map("author_role")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById String?             @map("deleted_by_id") @db.Uuid
  /// CP-021 (D112): the author's couple had the Exclusive Chat Bubble (CP level 2+) when it was sent.
  cpBubble    Boolean             @default(false) @map("cp_bubble")

  room      LiveRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User        @relation("LiveChatAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User?       @relation("LiveChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([userId, clientId], map: "live_chat_messages_client_once")
  @@index([roomId, createdAt], map: "live_chat_messages_room_created_idx")
  @@index([deletedById], map: "live_chat_messages_deleted_by_idx")
  /// The expired-media sweep (only messages that still hold an asset).
  @@index([expiresAt], map: "live_chat_messages_media_expiry_idx", where: raw("media_id IS NOT NULL"))
  @@map("live_chat_messages")
}

/// CP-017 (D104): why a coin balance changed.
enum WalletLedgerReason {
  ADMIN_GRANT
  ADMIN_REVOKE
  BULLET_MESSAGE
  /// v1.21-live (CP-018, D106).
  FAMILY_CREATE
  CP_REQUEST
  CP_REFUND
  CP_GIFT
  /// v1.23-live (CP-020, D108): a gift sent in a live, paid with coins.
  LIVE_GIFT

  @@map("wallet_ledger_reason")
}

/// CP-017 (D104): a user's coin balance (no row = 0). CHECK `wallets_coins_range`: 0 … 2^53−1
/// (CONVENTIONS §3). Changed only together with a `wallet_ledger` row.
model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  coins     BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// CP-017 (D104): every change of a coin balance. `(reason, reference_id)` is unique (one charge
/// per bullet, one row per admin grant). CHECKs `wallet_ledger_delta_nonzero` and
/// `wallet_ledger_balance_range` (migration 20261108090000_wallet_and_bullets).
model WalletLedgerEntry {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  delta        BigInt
  balanceAfter BigInt             @map("balance_after")
  reason       WalletLedgerReason
  referenceId  String             @map("reference_id") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CP-018: the family points this spending gave (at most one row).
  familyPoints FamilyPointsEntry?

  @@unique([reason, referenceId], map: "wallet_ledger_reference_once")
  @@index([userId, createdAt(sort: Desc)], map: "wallet_ledger_user_created_idx")
  @@map("wallet_ledger")
}

/// CP-017 (D104): a bullet message (رسالة عامة), sent from one live to every live. `client_id`
/// is unique per sender (an idempotent retry, never charged twice); `cost` is what it cost.
/// CHECKs `live_bullets_text_length`, `live_bullets_cost_positive`.
model LiveBullet {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// The live it was sent from (null once that room is gone).
  roomId    String?  @map("room_id") @db.Uuid
  text      String   @db.VarChar(60)
  cost      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room LiveRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId], map: "live_bullets_client_once")
  @@index([roomId], map: "live_bullets_room_idx")
  @@map("live_bullets")
}

/// CP-013 (D96): a user muted in one live's chat by the host or a moderator (not a block).
/// CHECK `live_chat_mutes_not_self` (migration 20261029090000_live_chat).
model LiveChatMute {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mutedById String?  @map("muted_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room    LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User     @relation("LiveChatMuted", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User?    @relation("LiveChatMutedBy", fields: [mutedById], references: [id], onDelete: SetNull)

  @@id([roomId, userId], map: "live_chat_mutes_pkey")
  @@index([userId], map: "live_chat_mutes_user_idx")
  @@index([mutedById], map: "live_chat_mutes_muted_by_idx")
  @@map("live_chat_mutes")
}

/// v1.20-live (owner D105, CONVENTIONS §10.20): a person kicked out of one live by the host or a
/// moderator. One row per room and user; it ends with the live (a new live is a new room). Kept 30
/// days after the room ended, like chat mutes. CHECK `live_room_kicks_not_self` (migration
/// 20261109090000_live_kicks).
model LiveRoomKick {
  roomId     String   @map("room_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kickedById String?  @map("kicked_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room     LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation("LiveKicked", fields: [userId], references: [id], onDelete: Cascade)
  kickedBy User?    @relation("LiveKickedBy", fields: [kickedById], references: [id], onDelete: SetNull)

  @@id([roomId, userId], map: "live_room_kicks_pkey")
  @@index([userId], map: "live_room_kicks_user_idx")
  @@index([kickedById], map: "live_room_kicks_kicked_by_idx")
  @@map("live_room_kicks")
}

/// Follow graph edge (social module). CHECK `follows_no_self_follow`.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId], map: "follows_pkey")
  @@index([followeeId, createdAt(sort: Desc)], map: "follows_followee_id_created_at_idx")
  @@map("follows")
}

// ---------------------------------------------------------------------------------------------
// v1.4-levels (DRAFT, CP-005, D72) — four independent level systems. Hand-written SQL in
// migration 20261020090000_levels adds the CHECK constraints, the partial unique indexes (also
// declared below with the `partialIndexes` preview feature so `migrate dev` sees no drift) and
// the append-only grants (points_ledger, level_history). Admin actor ids (createdById, …) are
// plain uuids without a foreign key: the audit trail is audit_logs.

enum LevelCategoryCode {
  ATTRACTIVENESS
  SUPPORT
  WIZARD
  GAMING

  @@map("level_category_code")
}

enum LevelVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("level_version_status")
}

enum LevelValueUnit {
  COIN

  @@map("level_value_unit")
}

enum LevelReversalPolicy {
  REVERSE_POINTS
  KEEP_LEVEL

  @@map("level_reversal_policy")
}

enum PointsEntryType {
  EARN
  REVERSAL
  ADJUSTMENT

  @@map("points_entry_type")
}

enum PointsSourceType {
  GIFT_RECEIVED
  GIFT_SENT
  LUCKY_GIFT_SENT
  GAME_SPEND
  /// CP-016 D (D101): a viewer's taps in a live, 10 counted taps = 1 point (CONVENTIONS §10.18).
  LIVE_TAPS
  ADMIN
  CONFIG

  @@map("points_source_type")
}

enum LevelTransitionReason {
  EARNED
  REVERSED
  ADJUSTED
  CONFIG_PUBLISHED
  RECALCULATED

  @@map("level_transition_reason")
}

enum LevelSourceEventType {
  GIFT_COMMITTED
  GAME_SPEND_COMMITTED
  GIFT_REVERSED
  GAME_SPEND_REVERSED

  @@map("level_source_event_type")
}

enum LevelEventStatus {
  PENDING
  PROCESSED
  SKIPPED
  FAILED

  @@map("level_event_status")
}

enum LevelReconciliationMode {
  DRY_RUN
  REPAIR

  @@map("level_reconciliation_mode")
}

enum LevelReconciliationStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("level_reconciliation_status")
}

/// The four categories; seeded disabled with no version (CP-005 §8).
model LevelCategory {
  id                 String            @id @default(uuid(7)) @db.Uuid
  code               LevelCategoryCode @unique
  nameAr             String            @map("name_ar") @db.VarChar(40)
  nameEn             String            @map("name_en") @db.VarChar(40)
  descriptionAr      String            @map("description_ar") @db.VarChar(200)
  descriptionEn      String            @map("description_en") @db.VarChar(200)
  isEnabled          Boolean           @default(false) @map("is_enabled")
  /// The PUBLISHED version, if any (kept in step with level_category_versions.status).
  publishedVersionId String?           @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  publishedVersion LevelCategoryVersion?  @relation("LevelCategoryPublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         LevelCategoryVersion[] @relation("LevelCategoryVersions")
  states           UserLevelState[]
  entries          PointsLedgerEntry[]
  history          LevelHistory[]

  @@map("level_categories")
}

/// A configuration version; DRAFT → PUBLISHED → ARCHIVED. Published rows are never edited.
model LevelCategoryVersion {
  id                       String              @id @default(uuid(7)) @db.Uuid
  categoryId               String              @map("category_id") @db.Uuid
  versionNumber            Int                 @map("version_number")
  status                   LevelVersionStatus  @default(DRAFT)
  /// CHECK > 0 when set; required to publish.
  multiplier               Decimal?            @db.Decimal(18, 6)
  valueUnit                LevelValueUnit?     @map("value_unit")
  reversalPolicy           LevelReversalPolicy @default(REVERSE_POINTS) @map("reversal_policy")
  luckyGiftsCountAsSupport Boolean             @default(false) @map("lucky_gifts_count_as_support")
  createdById              String?             @map("created_by_id") @db.Uuid
  publishedById            String?             @map("published_by_id") @db.Uuid
  publishedAt              DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     LevelCategory     @relation("LevelCategoryVersions", fields: [categoryId], references: [id], onDelete: Restrict)
  publishedFor LevelCategory?    @relation("LevelCategoryPublished")
  levels       LevelDefinition[]

  @@unique([categoryId, versionNumber], map: "level_category_versions_category_number_key")
  @@unique([categoryId], map: "level_category_versions_one_published", where: raw("status = 'PUBLISHED'::level_version_status"))
  @@map("level_category_versions")
}

/// One level of a version. Rules (1..n without gaps, level 1 at 0, strictly increasing) are
/// enforced on publish; CHECKs guard the ranges.
model LevelDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  levelNumber    Int      @map("level_number")
  nameAr         String   @map("name_ar") @db.VarChar(40)
  nameEn         String   @map("name_en") @db.VarChar(40)
  requiredPoints BigInt   @map("required_points")
  iconKey        String?  @map("icon_key") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  version LevelCategoryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, levelNumber], map: "level_definitions_version_level_key")
  @@map("level_definitions")
}

/// Current progression per user and category (derived from points_ledger; never trusted from clients).
model UserLevelState {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  categoryId              String    @map("category_id") @db.Uuid
  /// CHECK >= 0. Σ points_ledger.points_delta for this user and category.
  totalPoints             BigInt    @default(0) @map("total_points")
  /// Σ of positive EARN deltas (refunds do not lower it).
  lifetimeEarnedPoints    BigInt    @default(0) @map("lifetime_earned_points")
  /// Level number under `versionId`; null before any published version applied.
  currentLevel            Int?      @map("current_level")
  versionId               String?   @map("version_id") @db.Uuid
  lastQualifiedActivityAt DateTime? @map("last_qualified_activity_at") @db.Timestamptz(3)
  calculatedAt            DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LevelCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId], map: "user_level_states_user_category_key")
  @@index([categoryId, currentLevel], map: "user_level_states_category_level_idx")
  @@map("user_level_states")
}

/// Immutable source of truth for points (append-only: the runtime role cannot UPDATE/DELETE).
model PointsLedgerEntry {
  id                  String           @id @default(uuid(7)) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  categoryId          String           @map("category_id") @db.Uuid
  entryType           PointsEntryType  @map("entry_type")
  sourceType          PointsSourceType @map("source_type")
  /// The producer's transaction id (activity entries); null for ADMIN/CONFIG entries.
  sourceTransactionId String?          @map("source_transaction_id") @db.VarChar(128)
  sourceValue         BigInt?          @map("source_value")
  /// CHECK <> 0.
  pointsDelta         BigInt           @map("points_delta")
  multiplierUsed      Decimal?         @map("multiplier_used") @db.Decimal(18, 6)
  versionId           String?          @map("version_id") @db.Uuid
  /// ADJUSTMENT idempotency (admin `Idempotency-Key`), unique when set.
  idempotencyKey      String?          @map("idempotency_key") @db.VarChar(128)
  /// REVERSAL → the EARN it compensates (unique: a reversal happens once).
  reversalOfEntryId   String?          @unique(map: "points_ledger_reversal_of_key") @map("reversal_of_entry_id") @db.Uuid
  reason              String?          @db.VarChar(500)
  createdById         String?          @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   LevelCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reversalOf PointsLedgerEntry? @relation("PointsReversal", fields: [reversalOfEntryId], references: [id], onDelete: Cascade)
  reversedBy PointsLedgerEntry? @relation("PointsReversal")

  @@unique([categoryId, sourceType, sourceTransactionId, entryType], map: "points_ledger_source_once", where: raw("entry_type = ANY (ARRAY['EARN'::points_entry_type, 'REVERSAL'::points_entry_type])"))
  @@unique([idempotencyKey], map: "points_ledger_idempotency_key", where: raw("idempotency_key IS NOT NULL"))
  @@index([userId, categoryId, createdAt(sort: Desc), id(sort: Desc)], map: "points_ledger_user_category_created_idx")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "points_ledger_user_created_idx")
  @@index([sourceTransactionId], map: "points_ledger_source_transaction_idx")
  @@index([categoryId], map: "points_ledger_category_id_idx")
  @@map("points_ledger")
}

/// Level transitions (append-only). previous/new are level numbers; null = no level.
model LevelHistory {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  categoryId    String                @map("category_id") @db.Uuid
  previousLevel Int?                  @map("previous_level")
  newLevel      Int?                  @map("new_level")
  points        BigInt
  reason        LevelTransitionReason
  ledgerEntryId String?               @map("ledger_entry_id") @db.Uuid
  versionId     String?               @map("version_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category LevelCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "level_history_user_created_idx")
  @@index([categoryId, createdAt(sort: Desc)], map: "level_history_category_created_idx")
  @@map("level_history")
}

/// Inbox of producer events (CP-005 §6); one row per (type, source transaction).
model LevelSourceEvent {
  id                  String               @id @default(uuid(7)) @db.Uuid
  type                LevelSourceEventType
  sourceTransactionId String               @map("source_transaction_id") @db.VarChar(128)
  payload             Json                 @db.JsonB
  status              LevelEventStatus     @default(PENDING)
  attempts            Int                  @default(0)
  lastError           String?              @map("last_error") @db.VarChar(300)
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(3)

  @@unique([type, sourceTransactionId], map: "level_source_events_type_source_key")
  @@index([status, receivedAt(sort: Desc)], map: "level_source_events_status_received_idx")
  @@index([receivedAt(sort: Desc), id(sort: Desc)], map: "level_source_events_received_idx")
  @@map("level_source_events")
}

/// Reconciliation runs (CP-005); `errors` is a JSON array of short strings.
model LevelReconciliationRun {
  id                String                    @id @default(uuid(7)) @db.Uuid
  category          LevelCategoryCode?
  mode              LevelReconciliationMode
  status            LevelReconciliationStatus @default(RUNNING)
  startedAt         DateTime                  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(3)
  eventsInspected   Int                       @default(0) @map("events_inspected")
  statesInspected   Int                       @default(0) @map("states_inspected")
  failedEvents      Int                       @default(0) @map("failed_events")
  unprocessedEvents Int                       @default(0) @map("unprocessed_events")
  stateMismatches   Int                       @default(0) @map("state_mismatches")
  corrected         Int                       @default(0)
  errors            Json                      @default("[]") @db.JsonB
  initiatedById     String?                   @map("initiated_by_id") @db.Uuid

  @@index([startedAt(sort: Desc), id(sort: Desc)], map: "level_reconciliation_runs_started_idx")
  @@map("level_reconciliation_runs")
}

/// Granular admin permissions (CP-005 §9.8, owner 2026-10-20). An admin endpoint needs
/// `users.role = ADMIN` AND the permission it names. Granted with `pnpm levels:admin grant`.
enum AdminPermission {
  LEVELS_VIEW
  LEVELS_EDIT
  LEVELS_PUBLISH
  LEVELS_ADJUST
  LEVELS_RECONCILE
  /// v1.5-social (CP-006): the report queue.
  MODERATION
  /// v1.6-live (CP-010): grant and revoke the hosting permission.
  LIVE_HOSTS

  @@map("admin_permission")
}

model UserAdminPermission {
  userId      String          @map("user_id") @db.Uuid
  permission  AdminPermission
  /// Null when granted from the command line.
  grantedById String?         @map("granted_by_id") @db.Uuid
  grantedAt   DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission], map: "user_admin_permissions_pkey")
  @@map("user_admin_permissions")
}

// ---------------------------------------------------------------------------------------------
// v1.5-social (DRAFT, CP-006 M1, D87) — media, posts, comments, search and safety
// (CONVENTIONS §11). Owners: `media` module (media_*), `posts` module (posts, post_*, hashtags,
// comments, comment_*), `safety` module (user_blocks, user_mutes, post_hides, reports,
// privacy_settings). Counters on posts/comments change in the same transaction as their rows.

enum MediaUploadStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("media_upload_status")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED

  @@map("post_status")
}

enum PostModeration {
  VISIBLE
  PENDING
  REMOVED

  @@map("post_moderation")
}

enum WhoCanComment {
  EVERYONE
  FOLLOWERS
  NOBODY

  @@map("who_can_comment")
}

enum WhoCanMention {
  EVERYONE
  FOLLOWING
  NOBODY

  @@map("who_can_mention")
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  STORY
  LIVE_ROOM
  LIVE_CHAT_MESSAGE
  /// CP-021 (D112): a confession on a CP couple's page.
  CP_CONFESSION
  /// CP-022 (D116): a message in a family's chat.
  FAMILY_CHAT_MESSAGE

  @@map("report_target_type")
}

enum ReportReason {
  SPAM
  NUDITY
  VIOLENCE
  HATE
  HARASSMENT
  ILLEGAL
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED

  @@map("report_status")
}

/// A presigned upload slot (§11.1). Closed by `complete` (COMPLETED/FAILED) or the sweeper.
model MediaUpload {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  kind         String            @db.VarChar(32)
  contentType  String            @map("content_type") @db.VarChar(64)
  byteSize     Int               @map("byte_size")
  objectKey    String            @map("object_key") @db.VarChar(256)
  status       MediaUploadStatus @default(PENDING)
  mediaAssetId String?           @unique @map("media_asset_id") @db.Uuid
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "media_uploads_user_created_idx")
  @@index([expiresAt], map: "media_uploads_pending_expiry_idx", where: raw("status = 'PENDING'::media_upload_status"))
  @@map("media_uploads")
}

/// A processed image (WebP 1080, or 1920 for a story, and 320). Attached to at most one post or
/// story, of its `kind` (CP-008).
model MediaAsset {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  /// `POST_IMAGE`, `STORY_IMAGE`, `LIVE_COVER`, `LIVE_CHAT_IMAGE` or `LIVE_CHAT_VOICE` (the
  /// upload's kind).
  kind       String    @default("POST_IMAGE") @db.VarChar(32)
  /// 0 for a `LIVE_CHAT_VOICE` clip (CP-017).
  width      Int
  height     Int
  /// CP-017: a `LIVE_CHAT_VOICE` clip's length (≤ 30 000 ms); null for images.
  durationMs Int?      @map("duration_ms")
  blurhash   String?   @db.VarChar(64)
  largeKey   String    @map("large_key") @db.VarChar(256)
  thumbKey   String    @map("thumb_key") @db.VarChar(256)
  byteSize   Int       @map("byte_size")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attachedAt DateTime? @map("attached_at") @db.Timestamptz(3)

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  upload       MediaUpload?
  postMedia    PostMedia?
  story        Story?
  liveCover    LiveHost?
  chatMessage  LiveChatMessage?
  /// CP-018: a family's emblem.
  familyEmblem Family?
  /// CP-022: a family's cover.
  familyCover  Family? @relation("FamilyCover")

  @@index([createdAt], map: "media_assets_unattached_idx", where: raw("attached_at IS NULL"))
  @@map("media_assets")
}

/// A post (§11.2). CHECKs: text or media (app), counters ≥ 0, `publish_at` for SCHEDULED.
model Post {
  id              String         @id @default(uuid(7)) @db.Uuid
  authorId        String         @map("author_id") @db.Uuid
  text            String         @default("") @db.VarChar(2200)
  location        String?        @db.VarChar(80)
  status          PostStatus     @default(PUBLISHED)
  moderation      PostModeration @default(VISIBLE)
  publishAt       DateTime?      @map("publish_at") @db.Timestamptz(3)
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(3)
  editedAt        DateTime?      @map("edited_at") @db.Timestamptz(3)
  commentsEnabled Boolean        @default(true) @map("comments_enabled")
  whoCanComment   WhoCanComment  @default(EVERYONE) @map("who_can_comment")
  hideLikeCount   Boolean        @default(false) @map("hide_like_count")
  likeCount       Int            @default(0) @map("like_count")
  commentCount    Int            @default(0) @map("comment_count")
  shareCount      Int            @default(0) @map("share_count")
  repostCount     Int            @default(0) @map("repost_count")
  saveCount       Int            @default(0) @map("save_count")
  viewCount       Int            @default(0) @map("view_count")
  /// `Idempotency-Key` of createPost and the SHA-256 of its body (kept 24 h, §11.2).
  idempotencyKey  String?        @map("idempotency_key") @db.Uuid
  requestHash     String?        @map("request_hash") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  likes         PostLike[]
  saves         PostSave[]
  reposts       PostRepost[]
  views         PostView[]
  shares        PostShareEvent[]
  pin           PostPin?
  hashtags      PostHashtag[]
  mentions      PostMention[]
  comments      Comment[]
  hides         PostHide[]
  reports       Report[]
  notifications Notification[]

  @@unique([authorId, idempotencyKey], map: "posts_author_idempotency_key")
  @@index([authorId, publishedAt(sort: Desc), id(sort: Desc)], map: "posts_author_published_idx", where: raw("status = 'PUBLISHED'::post_status AND deleted_at IS NULL"))
  @@index([publishedAt(sort: Desc), id(sort: Desc)], map: "posts_published_idx", where: raw("status = 'PUBLISHED'::post_status AND deleted_at IS NULL AND moderation = 'VISIBLE'::post_moderation"))
  @@index([publishAt], map: "posts_scheduled_due_idx", where: raw("status = 'SCHEDULED'::post_status AND deleted_at IS NULL"))
  @@index([authorId, status, createdAt(sort: Desc)], map: "posts_author_status_created_idx")
  @@map("posts")
}

model PostMedia {
  postId       String @map("post_id") @db.Uuid
  mediaAssetId String @unique @map("media_asset_id") @db.Uuid
  position     Int    @db.SmallInt

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([postId, position], map: "post_media_pkey")
  @@map("post_media")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId], map: "post_likes_pkey")
  @@index([postId, createdAt(sort: Desc), userId], map: "post_likes_post_created_idx")
  @@index([userId], map: "post_likes_user_id_idx")
  @@map("post_likes")
}

model PostSave {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId], map: "post_saves_pkey")
  @@index([userId, createdAt(sort: Desc), postId], map: "post_saves_user_created_idx")
  @@index([postId], map: "post_saves_post_id_idx")
  @@map("post_saves")
}

model PostRepost {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId], map: "post_reposts_pkey")
  @@index([userId, createdAt(sort: Desc), postId], map: "post_reposts_user_created_idx")
  @@index([postId], map: "post_reposts_post_id_idx")
  @@map("post_reposts")
}

/// One row per viewer and post; `viewed_at` moves when a new 24-hour view counts (§11.4).
model PostView {
  postId   String   @map("post_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  viewedAt DateTime @map("viewed_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId], map: "post_views_pkey")
  @@index([userId], map: "post_views_user_id_idx")
  @@map("post_views")
}

/// One counted outside share per user, post and UTC day.
model PostShareEvent {
  postId String   @map("post_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  day    DateTime @db.Date

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, day], map: "post_share_events_pkey")
  @@index([userId], map: "post_share_events_user_id_idx")
  @@map("post_share_events")
}

model PostPin {
  postId   String   @id @map("post_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  pinnedAt DateTime @default(now()) @map("pinned_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinnedAt(sort: Desc)], map: "post_pins_user_pinned_idx")
  @@map("post_pins")
}

/// Migration 20261022090000_social_m1 also adds B-tree `text_pattern_ops` prefix indexes on
/// `hashtags.tag` and `user_profiles.username` (search, §11.6). Prisma cannot express that operator
/// class for B-tree, so `prisma migrate diff` lists them as drift by design.
model Hashtag {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// NFC lower case, without `#`.
  tag       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  postId    String @map("post_id") @db.Uuid
  hashtagId String @map("hashtag_id") @db.Uuid

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId], map: "post_hashtags_pkey")
  @@index([hashtagId, postId], map: "post_hashtags_hashtag_post_idx")
  @@map("post_hashtags")
}

model PostMention {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId], map: "post_mentions_pkey")
  @@index([userId], map: "post_mentions_user_id_idx")
  @@map("post_mentions")
}

/// A comment or a reply (`parent_id`, one level; §11.5).
model Comment {
  id         String    @id @default(uuid(7)) @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  text       String    @db.VarChar(500)
  likeCount  Int       @default(0) @map("like_count")
  replyCount Int       @default(0) @map("reply_count")
  pinnedAt   DateTime? @map("pinned_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  post          Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]        @relation("CommentReplies")
  likes         CommentLike[]
  mentions      CommentMention[]
  reports       Report[]
  notifications Notification[]

  @@unique([postId], map: "comments_one_pin_per_post", where: raw("pinned_at IS NOT NULL AND deleted_at IS NULL"))
  @@index([postId, likeCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "comments_top_idx", where: raw("parent_id IS NULL AND deleted_at IS NULL"))
  @@index([parentId, createdAt, id], map: "comments_replies_idx", where: raw("deleted_at IS NULL"))
  @@index([authorId], map: "comments_author_id_idx")
  @@map("comments")
}

model CommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId], map: "comment_likes_pkey")
  @@index([userId], map: "comment_likes_user_id_idx")
  @@map("comment_likes")
}

model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId], map: "comment_mentions_pkey")
  @@index([userId], map: "comment_mentions_user_id_idx")
  @@map("comment_mentions")
}

/// CHECK `user_blocks_no_self`.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId], map: "user_blocks_pkey")
  @@index([blockedId], map: "user_blocks_blocked_id_idx")
  @@index([blockerId, createdAt(sort: Desc)], map: "user_blocks_blocker_created_idx")
  @@map("user_blocks")
}

/// CHECK `user_mutes_no_self`.
model UserMute {
  muterId   String   @map("muter_id") @db.Uuid
  mutedId   String   @map("muted_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  muter User @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId], map: "user_mutes_pkey")
  @@index([mutedId], map: "user_mutes_muted_id_idx")
  /// CP-007: `GET /me/mutes`, newest first.
  @@index([muterId, createdAt(sort: Desc)], map: "user_mutes_muter_created_idx")
  @@map("user_mutes")
}

model PostHide {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId], map: "post_hides_pkey")
  @@index([postId], map: "post_hides_post_id_idx")
  @@map("post_hides")
}

/// A report (§11.7). Exactly one target column is set (CHECK `reports_one_target`); one OPEN
/// report per reporter and target (partial unique indexes in the migration).
model Report {
  id                      String           @id @default(uuid(7)) @db.Uuid
  reporterId              String           @map("reporter_id") @db.Uuid
  targetType              ReportTargetType @map("target_type")
  targetPostId            String?          @map("target_post_id") @db.Uuid
  targetCommentId         String?          @map("target_comment_id") @db.Uuid
  targetUserId            String?          @map("target_user_id") @db.Uuid
  targetStoryId           String?          @map("target_story_id") @db.Uuid
  targetLiveRoomId        String?          @map("target_live_room_id") @db.Uuid
  /// CP-013: a live chat message.
  targetLiveChatMessageId String?          @map("target_live_chat_message_id") @db.Uuid
  /// CP-021: a CP confession.
  targetCpConfessionId    String?          @map("target_cp_confession_id") @db.Uuid
  /// CP-022: a family chat message.
  targetFamilyChatMessageId String?        @map("target_family_chat_message_id") @db.Uuid
  reason                  ReportReason
  note                    String?          @db.VarChar(500)
  status                  ReportStatus     @default(OPEN)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt              DateTime?        @map("resolved_at") @db.Timestamptz(3)
  resolvedById            String?          @map("resolved_by_id") @db.Uuid
  resolutionNote          String?          @map("resolution_note") @db.VarChar(500)

  reporter              User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetPost            Post?            @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  targetComment         Comment?         @relation(fields: [targetCommentId], references: [id], onDelete: Cascade)
  targetUser            User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetStory           Story?           @relation(fields: [targetStoryId], references: [id], onDelete: Cascade)
  targetLiveRoom        LiveRoom?        @relation(fields: [targetLiveRoomId], references: [id], onDelete: Cascade)
  targetLiveChatMessage LiveChatMessage? @relation(fields: [targetLiveChatMessageId], references: [id], onDelete: Cascade)
  targetCpConfession    CpConfession?    @relation(fields: [targetCpConfessionId], references: [id], onDelete: Cascade)
  targetFamilyChatMessage FamilyChatMessage? @relation(fields: [targetFamilyChatMessageId], references: [id], onDelete: Cascade)
  resolvedBy            User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetPostId], map: "reports_open_post_once", where: raw("status = 'OPEN'::report_status AND target_post_id IS NOT NULL"))
  @@unique([reporterId, targetCommentId], map: "reports_open_comment_once", where: raw("status = 'OPEN'::report_status AND target_comment_id IS NOT NULL"))
  @@unique([reporterId, targetUserId], map: "reports_open_user_once", where: raw("status = 'OPEN'::report_status AND target_user_id IS NOT NULL"))
  @@unique([reporterId, targetStoryId], map: "reports_open_story_once", where: raw("status = 'OPEN'::report_status AND target_story_id IS NOT NULL"))
  @@unique([reporterId, targetLiveRoomId], map: "reports_open_live_room_once", where: raw("status = 'OPEN'::report_status AND target_live_room_id IS NOT NULL"))
  @@unique([reporterId, targetLiveChatMessageId], map: "reports_open_live_chat_message_once", where: raw("status = 'OPEN'::report_status AND target_live_chat_message_id IS NOT NULL"))
  @@unique([reporterId, targetCpConfessionId], map: "reports_open_cp_confession_once", where: raw("status = 'OPEN'::report_status AND target_cp_confession_id IS NOT NULL"))
  @@unique([reporterId, targetFamilyChatMessageId], map: "reports_open_family_chat_message_once", where: raw("status = 'OPEN'::report_status AND target_family_chat_message_id IS NOT NULL"))
  @@index([status, createdAt, id], map: "reports_status_created_idx")
  @@index([targetPostId], map: "reports_target_post_idx")
  @@index([targetCommentId], map: "reports_target_comment_idx")
  @@index([targetUserId], map: "reports_target_user_idx")
  @@index([targetStoryId], map: "reports_target_story_idx")
  @@index([targetLiveRoomId], map: "reports_target_live_room_idx")
  @@index([targetLiveChatMessageId], map: "reports_target_live_chat_message_idx")
  @@index([targetCpConfessionId], map: "reports_target_cp_confession_idx")
  @@index([targetFamilyChatMessageId], map: "reports_target_family_chat_message_idx")
  @@map("reports")
}

model PrivacySettings {
  userId               String        @id @map("user_id") @db.Uuid
  whoCanMention        WhoCanMention @default(EVERYONE) @map("who_can_mention")
  defaultWhoCanComment WhoCanComment @default(EVERYONE) @map("default_who_can_comment")
  /// v1.25-live (CP-022, D116): others may see when this user was last active (§10.25).
  showActivityStatus   Boolean       @default(true) @map("show_activity_status")
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

/// A photo story (CP-008, CONVENTIONS §11.9): active until `expires_at` (+24 h); the author keeps
/// it in the archive until they delete it. `removed_at` is set by moderation (REMOVE_TARGET).
model Story {
  id             String    @id @default(uuid(7)) @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  mediaAssetId   String    @unique @map("media_asset_id") @db.Uuid
  text           String    @default("") @db.VarChar(200)
  viewCount      Int       @default(0) @map("view_count")
  /// `Idempotency-Key` of createStory and the SHA-256 of its body (kept 24 h, as posts).
  idempotencyKey String?   @map("idempotency_key") @db.Uuid
  requestHash    String?   @map("request_hash") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset     @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  views         StoryView[]
  mentions      StoryMention[]
  reports       Report[]
  notifications Notification[]

  @@unique([authorId, idempotencyKey], map: "stories_author_idempotency_key")
  @@index([authorId, expiresAt], map: "stories_author_active_idx", where: raw("deleted_at IS NULL AND removed_at IS NULL"))
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], map: "stories_author_created_idx")
  @@map("stories")
}

/// One row per viewer and story (never the author); `view_count` counts them.
model StoryView {
  storyId  String   @map("story_id") @db.Uuid
  viewerId String   @map("viewer_id") @db.Uuid
  seenAt   DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([storyId, viewerId], map: "story_views_pkey")
  @@index([storyId, seenAt(sort: Desc), viewerId(sort: Desc)], map: "story_views_story_seen_idx")
  @@index([viewerId], map: "story_views_viewer_id_idx")
  @@map("story_views")
}

/// A linked mention in a story's text (§11.6 rules, at most 10).
model StoryMention {
  storyId String @map("story_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId], map: "story_mentions_pkey")
  @@index([userId], map: "story_mentions_user_id_idx")
  @@map("story_mentions")
}

enum NotificationType {
  LIKE_POST
  LIKE_COMMENT
  COMMENT
  REPLY
  MENTION
  FOLLOW
  REPOST
  POST_PUBLISHED
  CONTENT_REMOVED
  LIVE_SCHEDULED_SOON
  /// v1.21-live (CP-018, D106).
  CP_REQUEST
  CP_ACCEPTED
  FAMILY_JOIN_ACCEPTED
  FAMILY_JOIN_DECLINED
  MEDAL_AWARDED

  @@map("notification_type")
}

/// An in-app notification (CP-009, CONVENTIONS §11.10). At most one of post / comment / story is
/// the target (a FOLLOW targets its actor); a COMMENT target also sets `post_id`. `group_key` is
/// set on unread likes and reposts so new actors join the same row; `updated_at` is the latest
/// activity (the list order and the 30-day retention).
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  recipientId    String           @map("recipient_id") @db.Uuid
  type           NotificationType
  postId         String?          @map("post_id") @db.Uuid
  commentId      String?          @map("comment_id") @db.Uuid
  storyId        String?          @map("story_id") @db.Uuid
  /// CP-016 C: the scheduled live a `LIVE_SCHEDULED_SOON` reminds of (deleted with it).
  liveScheduleId String?          @map("live_schedule_id") @db.Uuid
  /// CP-018: the family of FAMILY_JOIN_ACCEPTED / FAMILY_JOIN_DECLINED.
  familyId       String?          @map("family_id") @db.Uuid
  /// CP-018: the medal of MEDAL_AWARDED.
  medalCode      String?          @map("medal_code") @db.VarChar(40)
  groupKey       String?          @map("group_key") @db.VarChar(80)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  recipient    User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  post         Post?               @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  story        Story?              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  liveSchedule LiveScheduleSlot?   @relation(fields: [liveScheduleId], references: [id], onDelete: Cascade)
  family       Family?             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  medal        Medal?              @relation(fields: [medalCode], references: [code], onDelete: Cascade)
  actors       NotificationActor[]

  @@index([recipientId, updatedAt(sort: Desc), id(sort: Desc)], map: "notifications_recipient_updated_idx")
  @@index([recipientId, groupKey], map: "notifications_unread_group_idx", where: raw("read_at IS NULL AND group_key IS NOT NULL"))
  @@index([recipientId], map: "notifications_unread_idx", where: raw("read_at IS NULL"))
  @@index([updatedAt], map: "notifications_updated_idx")
  @@index([postId], map: "notifications_post_id_idx")
  @@index([commentId], map: "notifications_comment_id_idx")
  @@index([storyId], map: "notifications_story_id_idx")
  @@index([liveScheduleId], map: "notifications_live_schedule_id_idx")
  @@index([familyId], map: "notifications_family_id_idx")
  @@index([medalCode], map: "notifications_medal_code_idx")
  @@map("notifications")
}

/// Who caused a notification (one row per actor; grouped likes and reposts have several).
model NotificationActor {
  notificationId String   @map("notification_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([notificationId, actorId], map: "notification_actors_pkey")
  @@index([actorId], map: "notification_actors_actor_id_idx")
  @@map("notification_actors")
}

/// Per-type in-app notification switches (CP-009); no row = all on.
model NotificationSettings {
  userId    String   @id @map("user_id") @db.Uuid
  likes     Boolean  @default(true)
  comments  Boolean  @default(true)
  mentions  Boolean  @default(true)
  follows   Boolean  @default(true)
  reposts   Boolean  @default(true)
  /// CP-016 C: reminders of lives scheduled by hosts you follow.
  lives     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---- v1.21-live (DRAFT, CP-018, D106): families, CP couples and medals ------------------------

enum FamilyRole {
  LEADER
  DEPUTY
  MEMBER

  @@map("family_role")
}

/// A family join request or a CP request. PENDING until accepted, declined, cancelled or expired.
enum BondRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("bond_request_status")
}

/// CP-018 (D106): a family (العائلة). `number` is its public 8-digit number; `name_key` the
/// case-folded name, unique among families that are not disbanded; `points` the coins its members
/// spent while in it (`family_points_ledger`) and `level` the ladder level for them. A disbanded
/// family keeps its row (`disbanded_at`) so a create retry is never charged twice. CHECKs in
/// migration 20261110100000_families_cp_medals.
model Family {
  id             String    @id @default(uuid(7)) @db.Uuid
  number         Int       @default(dbgenerated("(10000000 + floor((random() * (90000000)::double precision)))::integer"))
  name           String    @db.VarChar(40)
  nameKey        String    @map("name_key") @db.VarChar(80)
  emblemMediaId  String?   @unique @map("emblem_media_id") @db.Uuid
  emblemUrl      String?   @map("emblem_url") @db.VarChar(512)
  /// v1.25-live (CP-022, D116): the cover picture (a `FAMILY_COVER` upload) and a short tagline.
  coverMediaId   String?   @unique @map("cover_media_id") @db.Uuid
  coverUrl       String?   @map("cover_url") @db.VarChar(512)
  tagline        String?   @db.VarChar(60)
  points         BigInt    @default(0)
  level          Int       @default(1)
  memberCount    Int       @default(0) @map("member_count")
  createdById    String?   @map("created_by_id") @db.Uuid
  createClientId String    @map("create_client_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  disbandedAt    DateTime? @map("disbanded_at") @db.Timestamptz(3)

  createdBy     User?               @relation("FamilyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  emblem        MediaAsset?         @relation(fields: [emblemMediaId], references: [id], onDelete: SetNull)
  cover         MediaAsset?         @relation("FamilyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  members       FamilyMember[]
  joinRequests  FamilyJoinRequest[]
  pointsEntries FamilyPointsEntry[]
  notifications Notification[]
  chatMessages  FamilyChatMessage[]
  chatMutes     FamilyChatMute[]

  @@unique([number], map: "families_number_key")
  @@unique([createdById, createClientId], map: "families_create_once")
  @@unique([nameKey], map: "families_name_key_active", where: raw("disbanded_at IS NULL"))
  @@index([points(sort: Desc), id(sort: Desc)], map: "families_points_idx", where: raw("disbanded_at IS NULL"))
  @@map("families")
}

/// A user's family (at most one: the primary key) and role; one LEADER per family.
model FamilyMember {
  userId   String     @id @map("user_id") @db.Uuid
  familyId String     @map("family_id") @db.Uuid
  role     FamilyRole @default(MEMBER)
  /// Family points this member gave while in the family.
  points   BigInt     @default(0)
  joinedAt DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId], map: "family_members_one_leader", where: raw("role = 'LEADER'::family_role"))
  @@index([familyId, joinedAt], map: "family_members_family_idx")
  @@map("family_members")
}

/// A request to join a family; at most one PENDING per user; expires 7 days after it was made.
model FamilyJoinRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  familyId    String            @map("family_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      BondRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  handledAt   DateTime?         @map("handled_at") @db.Timestamptz(3)
  handledById String?           @map("handled_by_id") @db.Uuid

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User   @relation("FamilyJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User?  @relation("FamilyJoinHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@unique([userId], map: "family_join_requests_one_pending", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([familyId, createdAt], map: "family_join_requests_family_idx")
  @@index([userId], map: "family_join_requests_user_idx")
  @@index([expiresAt], map: "family_join_requests_expiry_idx", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([handledById], map: "family_join_requests_handled_by_idx")
  @@map("family_join_requests")
}

/// Family points: one row per wallet debit of a member that counted for the family (unique
/// `wallet_ledger_id`, so a spend never counts twice). Append-only for the runtime role.
model FamilyPointsEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  walletLedgerId String   @unique @map("wallet_ledger_id") @db.Uuid
  points         BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletEntry WalletLedgerEntry @relation(fields: [walletLedgerId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt], map: "family_points_ledger_family_idx")
  @@index([userId], map: "family_points_ledger_user_idx")
  /// v1.25-live: the monthly family ranking sums a window across families.
  @@index([createdAt, familyId], map: "family_points_ledger_created_idx")
  @@map("family_points_ledger")
}

/// v1.25-live (CP-022, D116): a message in a family's chat (members only). `client_id` is unique
/// per author (an idempotent retry). Soft-deleted by its author, the leader, a deputy or moderation.
model FamilyChatMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  text        String    @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author    User     @relation("FamilyChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User?    @relation("FamilyChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([authorId, clientId], map: "family_chat_messages_client_once")
  @@index([familyId, createdAt, id], map: "family_chat_messages_family_idx")
  @@index([deletedById], map: "family_chat_messages_deleted_by_idx")
  @@map("family_chat_messages")
}

/// v1.25-live (CP-022, D116): a member the leader or a deputy muted in the family chat.
model FamilyChatMute {
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mutedById String?  @map("muted_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user    User   @relation("FamilyChatMuted", fields: [userId], references: [id], onDelete: Cascade)
  mutedBy User?  @relation("FamilyChatMutedBy", fields: [mutedById], references: [id], onDelete: SetNull)

  @@id([familyId, userId])
  @@index([userId], map: "family_chat_mutes_user_idx")
  @@index([mutedById], map: "family_chat_mutes_muted_by_idx")
  @@map("family_chat_mutes")
}

/// A CP request (العلاقة): `cost` coins taken at send (ledger CP_REQUEST, reference = id) and
/// given back when it is declined, cancelled or expires (CP_REFUND, same reference). One PENDING
/// outgoing request per sender; `client_id` is unique per sender (an idempotent retry).
model CpRequest {
  id         String            @id @default(uuid(7)) @db.Uuid
  senderId   String            @map("sender_id") @db.Uuid
  receiverId String            @map("receiver_id") @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  cost       Int
  status     BondRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  handledAt  DateTime?         @map("handled_at") @db.Timestamptz(3)

  sender   User      @relation("CpRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("CpRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  couple   CpCouple?

  @@unique([senderId, clientId], map: "cp_requests_client_once")
  @@unique([senderId], map: "cp_requests_one_outgoing", where: raw("status = 'PENDING'::bond_request_status"))
  @@index([receiverId, createdAt], map: "cp_requests_receiver_idx")
  @@index([expiresAt], map: "cp_requests_expiry_idx", where: raw("status = 'PENDING'::bond_request_status"))
  @@map("cp_requests")
}

/// A CP couple. `user_a_id` < `user_b_id`; `points` the CP gifts' coins; `level` the CP tier.
/// Ended couples keep their row (`ended_at`); the partners are in `cp_partners` while it lasts.
model CpCouple {
  id        String    @id @default(uuid(7)) @db.Uuid
  userAId   String    @map("user_a_id") @db.Uuid
  userBId   String    @map("user_b_id") @db.Uuid
  requestId String?   @unique @map("request_id") @db.Uuid
  since     DateTime  @default(now()) @db.Timestamptz(3)
  points    BigInt    @default(0)
  level     Int       @default(1)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById String?   @map("ended_by_id") @db.Uuid

  userA        User            @relation("CpCoupleA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User            @relation("CpCoupleB", fields: [userBId], references: [id], onDelete: Cascade)
  endedBy      User?           @relation("CpCoupleEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  request      CpRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  partners     CpPartner[]
  gifts        CpGift[]
  pointsLedger CpPointsEntry[]
  checkIns     CpCheckIn[]
  taskClaims   CpTaskClaim[]
  confessions  CpConfession[]

  @@index([userAId], map: "cp_couples_user_a_idx")
  @@index([userBId], map: "cp_couples_user_b_idx")
  @@index([endedById], map: "cp_couples_ended_by_idx")
  @@map("cp_couples")
}

/// A user's current CP partner (one row per partner while the couple lasts; the primary key keeps
/// one partner per user).
model CpPartner {
  userId    String @id @map("user_id") @db.Uuid
  coupleId  String @map("couple_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid

  user    User     @relation("CpPartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  partner User     @relation("CpPartnerOther", fields: [partnerId], references: [id], onDelete: Cascade)
  couple  CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId], map: "cp_partners_couple_idx")
  @@index([partnerId], map: "cp_partners_partner_idx")
  @@map("cp_partners")
}

/// A CP gift: coins spent on one's partner (ledger CP_GIFT, reference = id); adds `amount` CP
/// points to the couple. `client_id` is unique per sender.
model CpGift {
  id         String   @id @default(uuid(7)) @db.Uuid
  coupleId   String   @map("couple_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  amount     Int
  clientId   String   @map("client_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple   CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  sender   User     @relation("CpGiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("CpGiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId], map: "cp_gifts_client_once")
  @@index([coupleId, createdAt], map: "cp_gifts_couple_idx")
  @@index([receiverId], map: "cp_gifts_receiver_idx")
  @@map("cp_gifts")
}

/// CP-021 (D112): why a couple's CP points grew.
enum CpPointsSource {
  /// A CP gift (reference = `cp_gifts.id`).
  GIFT
  /// A claimed daily CP task (reference = `cp_task_claims.id`).
  TASK

  @@map("cp_points_source")
}

/// CP-021 (D112): every CP points gain of a couple, written in the same transaction as the gain
/// (append-only for the runtime role). The couples ranking sums it per window; `cp_couples.points`
/// stays the running total. One row per source and reference.
model CpPointsEntry {
  id          String         @id @default(uuid(7)) @db.Uuid
  coupleId    String         @map("couple_id") @db.Uuid
  source      CpPointsSource
  referenceId String         @map("reference_id") @db.Uuid
  points      Int
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  couple CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([source, referenceId], map: "cp_points_ledger_reference_once")
  @@index([createdAt, coupleId], map: "cp_points_ledger_created_idx")
  @@index([coupleId, createdAt], map: "cp_points_ledger_couple_idx")
  @@map("cp_points_ledger")
}

/// CP-021 (D112): a partner checked in on the CP space that day (the CP day, §10.24).
model CpCheckIn {
  coupleId  String   @map("couple_id") @db.Uuid
  day       DateTime @db.Date
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([coupleId, day, userId], map: "cp_check_ins_pkey")
  @@index([userId], map: "cp_check_ins_user_idx")
  @@map("cp_check_ins")
}

/// CP-021 (D112): a daily CP task's reward, claimed once per couple, day and task.
model CpTaskClaim {
  id          String   @id @default(uuid(7)) @db.Uuid
  coupleId    String   @map("couple_id") @db.Uuid
  day         DateTime @db.Date
  taskCode    String   @map("task_code") @db.VarChar(40)
  points      Int
  claimedById String   @map("claimed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  couple    CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  claimedBy User     @relation(fields: [claimedById], references: [id], onDelete: Cascade)

  @@unique([coupleId, day, taskCode], map: "cp_task_claims_once")
  @@index([claimedById], map: "cp_task_claims_claimed_by_idx")
  @@map("cp_task_claims")
}

/// CP-021 (D112): a confession one partner leaves for the other on the couple's page. `text` is
/// 1–200 code points after the chat text rules (both partners' blocked words masked);
/// `client_id` is unique per author (an idempotent retry). Soft-deleted by either partner or an
/// admin report action.
model CpConfession {
  id          String    @id @default(uuid(7)) @db.Uuid
  coupleId    String    @map("couple_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  text        String    @db.VarChar(200)
  clientId    String    @map("client_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  couple    CpCouple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  author    User     @relation("CpConfessionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User     @relation("CpConfessionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  deletedBy User?    @relation("CpConfessionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   Report[]

  @@unique([authorId, clientId], map: "cp_confessions_client_once")
  @@index([coupleId, createdAt], map: "cp_confessions_couple_idx")
  @@index([recipientId], map: "cp_confessions_recipient_idx")
  @@index([deletedById], map: "cp_confessions_deleted_by_idx")
  @@map("cp_confessions")
}

/// The medal catalogue (الميداليات), seeded by migration 20261110100000_families_cp_medals.
model Medal {
  code          String   @id @db.VarChar(40)
  nameAr        String   @map("name_ar") @db.VarChar(60)
  nameEn        String   @map("name_en") @db.VarChar(60)
  descriptionAr String   @map("description_ar") @db.VarChar(200)
  descriptionEn String   @map("description_en") @db.VarChar(200)
  iconKey       String   @map("icon_key") @db.VarChar(60)
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  awards        UserMedal[]
  notifications Notification[]

  @@map("medals")
}

/// A medal a user earned (once per user and medal).
model UserMedal {
  userId           String   @map("user_id") @db.Uuid
  medalCode        String   @map("medal_code") @db.VarChar(40)
  awardedAt        DateTime @default(now()) @map("awarded_at") @db.Timestamptz(3)
  /// Owner D106 amendment: 1 … 6 when shown on the profile (in this order), else null.
  showcasePosition Int?     @map("showcase_position") @db.SmallInt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal Medal @relation(fields: [medalCode], references: [code], onDelete: Cascade)

  @@id([userId, medalCode], map: "user_medals_pkey")
  @@unique([userId, showcasePosition], map: "user_medals_showcase_position_key", where: raw("showcase_position IS NOT NULL"))
  @@index([userId, awardedAt(sort: Desc)], map: "user_medals_user_awarded_idx")
  @@index([medalCode], map: "user_medals_medal_idx")
  @@map("user_medals")
}

// ---- v1.22-live (CP-019, D107): the bag (الحقيبة) ---------------------------------------------

/// A bag category. PROFILE_CARD: the decoration on the profile card's header. More come later.
enum BagCategory {
  PROFILE_CARD

  @@map("bag_category")
}

/// How a user got a bag item.
enum BagItemSource {
  /// Free item given when the account was created.
  FREE_SIGNUP
  /// Free item given to accounts that existed before the feature (migration 20261111090000_bag).
  BACKFILL
  /// Granted by an admin (`bag-admin grant`).
  ADMIN

  @@map("bag_item_source")
}

/// The bag catalogue, seeded by migration 20261111090000_bag (bag.catalogue.ts keeps the same list).
model BagItem {
  code      String      @id @db.VarChar(40)
  category  BagCategory
  nameAr    String      @map("name_ar") @db.VarChar(60)
  nameEn    String      @map("name_en") @db.VarChar(60)
  /// The app's asset for the item (e.g. `header_emerald_wings`).
  assetKey  String      @map("asset_key") @db.VarChar(60)
  sortOrder Int         @map("sort_order")
  /// Every new account receives it (and wears it, the first per category).
  free      Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  owners UserBagItem[]

  @@unique([code, category], map: "bag_items_code_category_key")
  @@index([category, sortOrder], map: "bag_items_category_sort_idx")
  @@map("bag_items")
}

/// An item a user owns; at most one equipped per user and category.
model UserBagItem {
  userId     String        @map("user_id") @db.Uuid
  itemCode   String        @map("item_code") @db.VarChar(40)
  /// Copied from the catalogue (composite FK) so one equipped item per category is an index.
  category   BagCategory
  source     BagItemSource
  acquiredAt DateTime      @default(now()) @map("acquired_at") @db.Timestamptz(3)
  equipped   Boolean       @default(false)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item BagItem @relation(fields: [itemCode, category], references: [code, category], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, itemCode], map: "user_bag_items_pkey")
  @@unique([userId, category], map: "user_bag_items_equipped_key", where: raw("equipped"))
  @@index([itemCode, category], map: "user_bag_items_item_idx")
  @@map("user_bag_items")
}

// ---- v1.23-live (CP-020, D108): live gifts (CONVENTIONS §10.23) --------------------------------

/// A catalogue tab of the gift panel.
enum GiftCategory {
  POPULAR
  EVENT
  FUN

  @@map("gift_category")
}

/// The corner badge of a gift in the panel.
enum GiftBadge {
  NONE
  NEW
  EVENT

  @@map("gift_badge")
}

/// How a send was paid: coins from the wallet, or gifts from the sender's bag.
enum LiveGiftSource {
  COINS
  BAG

  @@map("live_gift_source")
}

/// The gift catalogue, managed only with the `gift-admin` CLI (no gift is seeded). Disabled, never
/// deleted. CHECKs `gifts_code_format`, `gifts_price_range`, `gifts_names_present`.
model Gift {
  code         String       @id @db.VarChar(40)
  category     GiftCategory
  nameAr       String       @map("name_ar") @db.VarChar(60)
  nameEn       String       @map("name_en") @db.VarChar(60)
  priceCoins   Int          @map("price_coins")
  /// The app's static image of the gift.
  assetKey     String       @map("asset_key") @db.VarChar(80)
  /// The app's full-screen effect (SVGA), or null for none.
  animationKey String?      @map("animation_key") @db.VarChar(80)
  sortOrder    Int          @default(0) @map("sort_order")
  badge        GiftBadge    @default(NONE)
  /// v1.24.3-live (D117): the optional sub-category (the panel's chips): all three null or all set
  /// (CHECK `gifts_tag_complete`; `gifts_tag_code_format`).
  tagCode      String?      @map("tag_code") @db.VarChar(40)
  tagNameAr    String?      @map("tag_name_ar") @db.VarChar(30)
  tagNameEn    String?      @map("tag_name_en") @db.VarChar(30)
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  stock UserGiftStock[]
  sends LiveGift[]

  @@index([category, sortOrder], map: "gifts_category_sort_idx")
  @@map("gifts")
}

/// The gift bag (الحقيبة): gifts a user owns. CHECK `user_gift_stock_quantity_range` (0 … 10^9);
/// rows at 0 stay and are not listed.
model UserGiftStock {
  userId    String   @map("user_id") @db.Uuid
  giftCode  String   @map("gift_code") @db.VarChar(40)
  quantity  Int
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftCode], references: [code], onDelete: Restrict)

  @@id([userId, giftCode], map: "user_gift_stock_pkey")
  @@index([giftCode], map: "user_gift_stock_gift_idx")
  @@map("user_gift_stock")
}

/// One send in a live: `quantity` of one gift to each recipient. `totalCoins` is the coin value
/// (unitPrice × quantity × recipients); `coinsCharged` is that for COINS and 0 for BAG. CHECKs
/// `live_gifts_quantity_positive`, `live_gifts_amounts`, `live_gifts_combo`.
model LiveGift {
  id            String         @id @default(uuid(7)) @db.Uuid
  senderId      String         @map("sender_id") @db.Uuid
  clientId      String         @map("client_id") @db.Uuid
  /// The live it was sent in (null once that room is gone).
  roomId        String?        @map("room_id") @db.Uuid
  giftCode      String         @map("gift_code") @db.VarChar(40)
  quantity      Int
  source        LiveGiftSource
  unitPrice     Int            @map("unit_price")
  totalCoins    BigInt         @map("total_coins")
  coinsCharged  BigInt         @map("coins_charged")
  /// The recipients' user ids, sorted and joined (combo matching).
  recipientsKey String         @map("recipients_key")
  /// The first send of the combo (its own id when it starts one).
  comboId       String         @map("combo_id") @db.Uuid
  comboCount    Int            @map("combo_count")
  comboQuantity BigInt         @map("combo_quantity")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  sender     User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  room       LiveRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  gift       Gift                @relation(fields: [giftCode], references: [code], onDelete: Restrict)
  recipients LiveGiftRecipient[]

  @@unique([senderId, clientId], map: "live_gifts_client_once")
  @@index([senderId, roomId, createdAt(sort: Desc)], map: "live_gifts_sender_room_idx")
  @@index([roomId, createdAt], map: "live_gifts_room_idx")
  @@index([giftCode], map: "live_gifts_gift_idx")
  @@map("live_gifts")
}

/// A recipient of a send, in the order the sender listed them; `coins` = unitPrice × quantity.
model LiveGiftRecipient {
  giftId   String @map("gift_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  position Int    @db.SmallInt
  coins    BigInt

  gift LiveGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([giftId, userId], map: "live_gift_recipients_pkey")
  @@index([userId], map: "live_gift_recipients_user_idx")
  @@map("live_gift_recipients")
}
