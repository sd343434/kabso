  @@index([agentUserId, createdAt(sort: Desc)], map: "recharge_topups_agent_idx")
  @@index([createdAt], map: "recharge_topups_created_at_idx")
  @@map("recharge_topups")
}

/// D185: coins sold from an agent's stock to a buyer by the agent or an employee.
model RechargeSale {
  id           String   @id @default(uuid(7)) @db.Uuid
  agentUserId  String   @map("agent_user_id") @db.Uuid
  sellerUserId String   @map("seller_user_id") @db.Uuid
  buyerUserId  String   @map("buyer_user_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  coins        BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent         RechargeAgent  @relation(fields: [agentUserId], references: [userId], onDelete: Cascade)
  seller        User           @relation("RechargeSaleSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  buyer         User           @relation("RechargeSaleBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([sellerUserId, clientId], map: "recharge_sales_client_once")
  @@index([agentUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_sales_agent_created_idx")
  @@index([sellerUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_sales_seller_created_idx")
  @@index([buyerUserId], map: "recharge_sales_buyer_idx")
  @@index([createdAt], map: "recharge_sales_created_at_idx")
  @@map("recharge_sales")
}

/// D185: an agent's employee with weekly hours (one active employment per user).
model RechargeEmployee {
  id             String    @id @default(uuid(7)) @db.Uuid
  agentUserId    String    @map("agent_user_id") @db.Uuid
  employeeUserId String    @map("employee_user_id") @db.Uuid
  timeZone       String    @map("time_zone") @db.VarChar(64)
  schedule       Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)
  /// D287: may buy hosts' cherries for the agent («يمكنه شراء الكرز»).
  canBuyCherries Boolean   @default(true) @map("can_buy_cherries")
  /// D287: receives the agent's coin orders and cherry offers («يستقبل طلبات الشراء»).
  receivesOrders Boolean   @default(true) @map("receives_orders")

  agent    RechargeAgent @relation(fields: [agentUserId], references: [userId], onDelete: Cascade)
  employee User          @relation(fields: [employeeUserId], references: [id], onDelete: Cascade)

  @@unique([employeeUserId], map: "recharge_employees_one_active", where: raw("removed_at IS NULL"))
  @@index([agentUserId, createdAt], map: "recharge_employees_agent_idx")
  @@map("recharge_employees")
}

/// D185: a host's cherries sold to an agent (two-sided confirmation).
model RechargeCherryRequest {
  id          String                      @id @default(uuid(7)) @db.Uuid
  agentUserId String                      @map("agent_user_id") @db.Uuid
  hostUserId  String                      @map("host_user_id") @db.Uuid
  createdBy   String                      @map("created_by") @db.Uuid
  clientId    String                      @map("client_id") @db.Uuid
  cherries    BigInt
  coins       BigInt
  payoutMinor BigInt                      @map("payout_minor")
  currency    String                      @db.Char(3)
  status      RechargeCherryRequestStatus @default(PENDING)
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime                    @map("expires_at") @db.Timestamptz(3)
  decidedAt   DateTime?                   @map("decided_at") @db.Timestamptz(3)
  /// D287: the employee who last acted for the agent (created or answered it); null = the agent or the host.
  actedBy     String?                     @map("acted_by") @db.Uuid
  /// D287: who confirmed, declined or cancelled it (null while open or expired).
  decidedBy   String?                     @map("decided_by") @db.Uuid

  agent RechargeAgent @relation(fields: [agentUserId], references: [userId], onDelete: Cascade)
  host  User          @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@unique([createdBy, clientId], map: "recharge_cherry_requests_client_once")
  @@index([agentUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_cherry_requests_agent_idx")
  @@index([hostUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_cherry_requests_host_idx")
  @@index([agentUserId, hostUserId, status], map: "recharge_cherry_requests_pair_idx")
  @@index([actedBy, decidedAt], map: "recharge_cherry_requests_acted_by_idx", where: raw("acted_by IS NOT NULL"))
  @@map("recharge_cherry_requests")
}

// ---- v1.69-social (D204, CONVENTIONS §10.64): recharge orders with escrow «طلبات الشحن» ---------------------

enum RechargeOrderStatus {
  REQUESTED
  AWAITING_PAYMENT
  PAID
  DISPUTED
  COMPLETED
  COMPLETED_BY_ADMIN
  REFUNDED_TO_AGENT
  CANCELLED
  EXPIRED

  @@map("recharge_order_status")
}

enum RechargeOrderMessageKind {
  TEXT
  IMAGE
  PAYMENT_DETAILS
  TRANSFER_PROOF
  SYSTEM

  @@map("recharge_order_message_kind")
}

enum RechargeOrderRole {
  BUYER
  AGENT
  EMPLOYEE
  ADMIN
  SYSTEM

  @@map("recharge_order_role")
}

/// D204: the admin-set exchange rate of a country's currency (units of `currency` per 1 USD, × 1 000 000). No row:
/// the country is shown in USD only.
model RechargeExchangeRate {
  country   String   @id @db.Char(2)
  currency  String   @db.Char(3)
  /// Units of `currency` per 1 USD × 1 000 000 (e.g. EGP 50.5 → 50 500 000).
  rateMicro BigInt   @map("rate_micro")
  /// Decimal places of `currency` (EGP 2, KWD 3, IQD 0).
  digits    Int      @db.SmallInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("recharge_exchange_rates")
}

/// D245: the latest AUTOMATIC rate of a currency (units per 1 USD × 1 000 000) from the free feed or the OWNER's paid
/// provider. A manual `RechargeExchangeRate` of a country wins over it. A value that moved more than FX_MAX_JUMP_PERCENT
/// from `rateMicro` is held (`held*`) for the team's review; `rateMicro` stays in force meanwhile.
model FxRate {
  currency              String    @id @db.Char(3)
  rateMicro             BigInt    @map("rate_micro")
  /// OPEN_ER_API | CURRENCYAPI | EXCHANGERATE_API.
  source                String    @db.VarChar(24)
  /// The provider's own «last updated» time of this value (the free feed: once a day).
  providerUpdatedAt     DateTime? @map("provider_updated_at") @db.Timestamptz(3)
  fetchedAt             DateTime  @map("fetched_at") @db.Timestamptz(3)
  heldRateMicro         BigInt?   @map("held_rate_micro")
  heldSource            String?   @map("held_source") @db.VarChar(24)
  heldProviderUpdatedAt DateTime? @map("held_provider_updated_at") @db.Timestamptz(3)
  heldAt                DateTime? @map("held_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("fx_rates")
}

/// D245: one row — the OWNER's paid exchange-rate provider «مزوّد أسعار الصرف» (the API key sealed AES-256-GCM with a
/// key derived from ADMIN_TOTP_KEY, `fx-settings/v1`; write-only, last 4 shown) and the poller's shared state.
model FxSettings {
  id                    Int       @id @default(1) @db.SmallInt
  /// CURRENCYAPI | EXCHANGERATE_API.
  provider              String    @default("CURRENCYAPI") @db.VarChar(24)
  enabled               Boolean   @default(false)
  apiKeyEnc             String?   @map("api_key_enc")
  apiKeyLast4           String?   @map("api_key_last4") @db.VarChar(4)
  apiKeySetById         String?   @map("api_key_set_by_id") @db.Uuid
  apiKeySetAt           DateTime? @map("api_key_set_at") @db.Timestamptz(3)
  lastTestAt            DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk            Boolean?  @map("last_test_ok")
  lastTestById          String?   @map("last_test_by_id") @db.Uuid
  lastTest              Json?     @map("last_test")
  /// The poller: when the next fetch is due, and the lease of the instance fetching now.
  nextFetchAt           DateTime? @map("next_fetch_at") @db.Timestamptz(3)
  runningUntil          DateTime? @map("running_until") @db.Timestamptz(3)
  lastAttemptAt         DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt         DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastSource            String?   @map("last_source") @db.VarChar(24)
  lastProviderUpdatedAt DateTime? @map("last_provider_updated_at") @db.Timestamptz(3)
  /// The last successful fetch's counts (accepted / unchanged / held / rejected).
  lastReport            Json?     @map("last_report")
  lastErrorAt           DateTime? @map("last_error_at") @db.Timestamptz(3)
  lastErrorIssue        String?   @map("last_error_issue") @db.VarChar(32)
  lastErrorDetail       String?   @map("last_error_detail") @db.VarChar(300)
  /// Failed fetches in a row (the back-off); 0 after a success.
  failures              Int       @default(0)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById           String?   @map("updated_by_id") @db.Uuid

  @@map("fx_settings")
}

/// D204: a buyer's order to an agent. The price is fixed at creation (retail USD and the local amount at the rate in
/// force). Coins are frozen from the agent's stock (ORDER_HOLD) from the payment details until a confirmation (to
/// the buyer), a cancellation / expiry (back to the stock, ORDER_RELEASE) or a dispute decision.
model RechargeOrder {
  id             String              @id @default(uuid(7)) @db.Uuid
  buyerUserId    String              @map("buyer_user_id") @db.Uuid
  agentUserId    String              @map("agent_user_id") @db.Uuid
  clientId       String              @map("client_id") @db.Uuid
  country        String              @db.Char(2)
  coins          BigInt
  usdMinor       BigInt              @map("usd_minor")
  localCurrency  String?             @map("local_currency") @db.Char(3)
  localRateMicro BigInt?             @map("local_rate_micro")
  localMinor     BigInt?             @map("local_minor")
  localDigits    Int?                @map("local_digits") @db.SmallInt
  paymentType    String              @map("payment_type") @db.VarChar(16)
  status         RechargeOrderStatus @default(REQUESTED)
  /// The coins frozen from the agent's stock right now (0 or `coins`).
  heldCoins      BigInt              @default(0) @map("held_coins")
  detailsAt      DateTime?           @map("details_at") @db.Timestamptz(3)
  noticeAckAt    DateTime?           @map("notice_ack_at") @db.Timestamptz(3)
  paidAt         DateTime?           @map("paid_at") @db.Timestamptz(3)
  disputedAt     DateTime?           @map("disputed_at") @db.Timestamptz(3)
  disputedBy     RechargeOrderRole?  @map("disputed_by")
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(3)
  closedBy       String?             @map("closed_by") @db.Uuid
  closeReason    String?             @map("close_reason") @db.VarChar(500)
  /// D287: the agent's side person who acted first and owns the order (the agent or an employee).
  claimedBy      String?             @map("claimed_by") @db.Uuid
  claimedAt      DateTime?           @map("claimed_at") @db.Timestamptz(3)
  /// When REQUESTED or AWAITING_PAYMENT ends by itself (the sweeper; null afterwards).
  expiresAt      DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)

  buyer         User                   @relation("RechargeOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  agent         RechargeAgent          @relation(fields: [agentUserId], references: [userId], onDelete: Cascade)
  messages      RechargeOrderMessage[]
  notifications Notification[]

  @@unique([buyerUserId, clientId], map: "recharge_orders_client_once")
  @@unique([buyerUserId, agentUserId], map: "recharge_orders_one_open", where: raw("status = ANY (ARRAY['REQUESTED'::recharge_order_status, 'AWAITING_PAYMENT'::recharge_order_status, 'PAID'::recharge_order_status, 'DISPUTED'::recharge_order_status])"))
  @@index([buyerUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_orders_buyer_idx")
  @@index([agentUserId, createdAt(sort: Desc), id(sort: Desc)], map: "recharge_orders_agent_idx")
  @@index([status, updatedAt], map: "recharge_orders_status_idx")
  @@index([expiresAt], map: "recharge_orders_expiry_idx", where: raw("expires_at IS NOT NULL"))
  @@index([claimedBy, closedAt], map: "recharge_orders_claimed_by_idx", where: raw("claimed_by IS NOT NULL"))
  @@map("recharge_orders")
}

/// D204: the order's own chat «محادثة الطلب» — kept as evidence (never edited or deleted by a participant).
model RechargeOrderMessage {
  id           String                   @id @default(uuid(7)) @db.Uuid
  /// The chat's order (a sequence: several lines of one transaction share `createdAt`).
  seq          BigInt                   @unique(map: "recharge_order_messages_seq_key") @default(autoincrement())
  orderId      String                   @map("order_id") @db.Uuid
  authorUserId String?                  @map("author_user_id") @db.Uuid
  role         RechargeOrderRole
  kind         RechargeOrderMessageKind
  text         String?                  @db.VarChar(1000)
  /// PAYMENT_DETAILS: the method type.
  method       String?                  @db.VarChar(16)
  /// IMAGE / TRANSFER_PROOF: the private object (`private/recharge-orders/<order>/<message>.webp`).
  imageKey     String?                  @map("image_key") @db.VarChar(256)
  /// SYSTEM: the event (`CREATED`, `DETAILS_SENT`, `PAID`, …).
  event        String?                  @db.VarChar(24)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  order RechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, seq], map: "recharge_order_messages_order_idx")
  @@map("recharge_order_messages")
}

// ---- v1.54-social (D185, CONVENTIONS §10.48.1): the special-username layer «يوزر مميز» --------------------

enum SpecialUsernameSource {
  RECHARGE_AGENT
  ADMIN_GIFT
  PURCHASE
  /// v1.58-social (D189): a host agent's `hostNN`.
  HOST_AGENT

  @@map("special_username_source")
}

enum SpecialUsernameStatus {
  ACTIVE
  GRACE
  ENDED

  @@map("special_username_status")
}

/// D185: a special username. While ACTIVE it is `user_profiles.username` and `baseUsername` is the person's
/// own username, kept for them. GRACE: ended, the name still reserved for the person until `graceUntil`
/// (null = forever: the `coin` names).
model SpecialUsername {
  id           String                @id @default(uuid(7)) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  username     String                @db.VarChar(30)
  baseUsername String                @map("base_username") @db.VarChar(30)
  source       SpecialUsernameSource
  status       SpecialUsernameStatus @default(ACTIVE)
  locked       Boolean               @default(true)
  grantedAt    DateTime              @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt    DateTime?             @map("expires_at") @db.Timestamptz(3)
  graceUntil   DateTime?             @map("grace_until") @db.Timestamptz(3)
  endedAt      DateTime?             @map("ended_at") @db.Timestamptz(3)
  endReason    String?               @map("end_reason") @db.VarChar(20)
  reason       String?               @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId], map: "special_usernames_one_active", where: raw("status = 'ACTIVE'::special_username_status"))
  @@unique([username], map: "special_usernames_name_held", where: raw("status = ANY (ARRAY['ACTIVE'::special_username_status, 'GRACE'::special_username_status])"))
  @@unique([baseUsername], map: "special_usernames_base_held", where: raw("status = 'ACTIVE'::special_username_status"))
  @@unique([username], map: "special_usernames_coin_once", where: raw("(username)::text ~ '^coin[0-9]+$'::text"))
  @@unique([username], map: "special_usernames_host_once", where: raw("(username)::text ~ '^host[0-9]+$'::text"))
  @@index([userId, grantedAt(sort: Desc)], map: "special_usernames_user_idx")
  @@index([status, expiresAt, graceUntil], map: "special_usernames_due_idx")
  @@map("special_usernames")
}

// ---- v1.56-social (D187, CONVENTIONS §10.50): the daily recharge badges «شارات الشحن اليومي» -------------------

/// D187: the coins a person received from recharges in one calendar day (RECHARGE_BADGE_TIME_ZONE) and the tier
/// reached (0: none). Written only by `recordRechargeIn`, in the recharge's transaction.
model RechargeDailyTotal {
  userId    String   @map("user_id") @db.Uuid
  day       DateTime @db.Date
  coins     BigInt   @default(0)
  tier      Int      @default(0) @db.SmallInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("recharge_daily_totals")
}

/// D187: the badge a person shows (tier 1–5) until `until` (reached + RECHARGE_BADGE_HOURS).
model RechargeBadge {
  userId    String   @id @map("user_id") @db.Uuid
  tier      Int      @map("badge_tier") @db.SmallInt
  until     DateTime @map("badge_until") @db.Timestamptz(3)
  day       DateTime @map("badge_day") @db.Date
  reachedAt DateTime @map("reached_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recharge_badges")
}

// ---- v1.59-social (D190, CONVENTIONS §10.53): card top-ups on the website through Stripe -------------------------

enum TopupOrderStatus {
  /// The Checkout session exists; nothing paid yet.
  PENDING
  /// A bank transfer was chosen: Stripe waits for the money (funding instructions shown).
  AWAITING_FUNDS
  /// Paid and credited (once, by the webhook).
  PAID
  EXPIRED
  FAILED

  @@map("topup_order_status")
}

enum TopupCaseKind {
  REFUND
  EARLY_FRAUD_WARNING
  DISPUTE

  @@map("topup_case_kind")
}

enum TopupCaseStatus {
  OPEN
  CLOSED

  @@map("topup_case_status")
}

/// D190: «العملات رقمية وغير قابلة للاسترداد» accepted before a checkout (statement, version, time, IP, user agent).
model TopupTermsAcceptance {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  termsVersion String   @map("terms_version") @db.VarChar(32)
  termsText    String   @map("terms_text") @db.VarChar(300)
  locale       String   @db.VarChar(5)
  ip           String?  @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  acceptedAt   DateTime @map("accepted_at") @db.Timestamptz(3)

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  order TopupOrder?

  @@index([userId, acceptedAt(sort: Desc)], map: "topup_terms_acceptances_user_idx")
  @@map("topup_terms_acceptances")
}

/// D190: one website purchase (CHECKs in migration 20270104100000_card_topups).
model TopupOrder {
  id                    String           @id @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  termsAcceptanceId     String           @map("terms_acceptance_id") @db.Uuid
  packageId             String           @map("package_id") @db.VarChar(32)
  coins                 BigInt
  amountMinor           Int              @map("amount_minor")
  currency              String           @db.Char(3)
  paymentMethodTypes    String[]         @map("payment_method_types") @db.VarChar(32)
  status                TopupOrderStatus @default(PENDING)
  stripeSessionId       String?          @map("stripe_session_id") @db.VarChar(255)
  stripePaymentIntentId String?          @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId        String?          @map("stripe_charge_id") @db.VarChar(255)
  paymentMethodType     String?          @map("payment_method_type") @db.VarChar(32)
  creditedAt            DateTime?        @map("credited_at") @db.Timestamptz(3)
  refundedMinor         Int              @default(0) @map("refunded_minor")
  fraudWarningAt        DateTime?        @map("fraud_warning_at") @db.Timestamptz(3)
  autoRefundId          String?          @map("auto_refund_id") @db.VarChar(255)
  disputeId             String?          @map("dispute_id") @db.VarChar(255)
  disputeStatus         String?          @map("dispute_status") @db.VarChar(32)
  disputeAmountMinor    Int              @default(0) @map("dispute_amount_minor")
  evidenceSubmittedAt   DateTime?        @map("evidence_submitted_at") @db.Timestamptz(3)
  coinsReversed         BigInt           @default(0) @map("coins_reversed")
  /// v1.59-social (owner answer CP-033 Q2): what the team itself refunded (`payments-admin refund`, cents,
  /// recorded before the Stripe call) and why. Such a refund reverses its coins but never freezes the buyer.
  teamRefundedMinor     Int              @default(0) @map("team_refunded_minor")
  teamRefundReason      String?          @map("team_refund_reason") @db.VarChar(500)
  /// v1.109-social (D344): how `amountMinor` was made — the package's base price and Stripe's estimated fee
  /// (percent in basis points, fixed in cents; both 0 when the gross-up is off). NULL on older orders.
  basePriceMinor        Int?             @map("base_price_minor")
  feePercentBps         Int?             @map("fee_percent_bps")
  feeFixedMinor         Int?             @map("fee_fixed_minor")
  /// v1.109-social (D344): the fee Stripe really took (its balance transaction), read after the credit.
  stripeFeeMinor        Int?             @map("stripe_fee_minor")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  user    User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  terms   TopupTermsAcceptance @relation(fields: [termsAcceptanceId], references: [id], onDelete: Restrict)
  freezes TopupFreeze[]
  cases   TopupCase[]
  events  StripeEvent[]

  @@unique([termsAcceptanceId], map: "topup_orders_terms_once")
  @@unique([stripeSessionId], map: "topup_orders_session_once")
  @@unique([stripePaymentIntentId], map: "topup_orders_payment_intent_once")
  @@index([stripeChargeId], map: "topup_orders_charge_idx")
  @@index([userId, createdAt(sort: Desc)], map: "topup_orders_user_created_idx")
  @@index([creditedAt], map: "topup_orders_credited_at_idx", where: raw("(credited_at IS NOT NULL)"))
  @@index([createdAt], map: "topup_orders_created_at_idx")
  @@map("topup_orders")
}

/// D190: a buyer frozen from card purchases (one row per user).
model TopupFreeze {
  userId    String        @id @map("user_id") @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  reason    TopupCaseKind
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  order TopupOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("topup_freezes")
}

/// v1.109-social (D344, CONVENTIONS §10.143): a one-time code the app mints so the website top-up page opens signed
/// in (owner: «يدخل اليوزر والباسورد تلقائي»). Only SHA-256 of the 32 random bytes is stored; it lives 60 s, is
/// redeemed once (`consumed_at`), and is honoured only while the minting session is live and the account ACTIVE.
/// Never a password. Rows are deleted with the session or the user (CASCADE) and pruned at the next mint.
model TopupHandoff {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// The app session that minted it (revoking it voids the code).
  sessionId    String    @map("session_id") @db.Uuid
  /// SHA-256 (hex) of the code.
  codeHash     String    @unique(map: "topup_handoffs_code_hash_key") @map("code_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// The website session the code was exchanged for.
  webSessionId String?   @map("web_session_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId], map: "topup_handoffs_user_idx")
  @@index([sessionId], map: "topup_handoffs_session_idx")
  @@map("topup_handoffs")
}

/// D190: an admin case after a refund, an early-fraud warning or a dispute, with the FIFO gift attribution.
model TopupCase {
  id             String          @id @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  kind           TopupCaseKind
  stripeObjectId String          @map("stripe_object_id") @db.VarChar(255)
  status         TopupCaseStatus @default(OPEN)
  outcome        String?         @db.VarChar(32)
  coinsReversed  BigInt          @map("coins_reversed")
  attribution    Json
  note           String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt       DateTime?       @map("closed_at") @db.Timestamptz(3)

  order TopupOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([kind, stripeObjectId], map: "topup_cases_object_once")
  @@index([status, createdAt(sort: Desc)], map: "topup_cases_status_idx")
  @@map("topup_cases")
}

/// D190: every Stripe event, once.
model StripeEvent {
  id          String    @id @db.VarChar(255)
  type        String    @db.VarChar(100)
  orderId     String?   @map("order_id") @db.Uuid
  outcome     String?   @db.VarChar(32)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  order TopupOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("stripe_events")
}

/// D190: the buyer's Stripe customer (bank transfers only).
model StripeCustomer {
  userId     String   @id @map("user_id") @db.Uuid
  customerId String   @map("customer_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId], map: "stripe_customers_customer_once")
  @@map("stripe_customers")
}

// ---- v1.60-social (D191, CONVENTIONS §10.54): the admin panel «لوحة الإدارة» ---------------------------------

/// An admin's TOTP second factor (RFC 6238). The secret is AES-256-GCM encrypted with ADMIN_TOTP_KEY
/// (never stored or logged in clear); `last_totp_step` refuses a code used twice; failures count towards the
/// lockout (`locked_until`).
model AdminCredential {
  userId         String    @id @map("user_id") @db.Uuid
  totpSecretEnc  String?   @map("totp_secret_enc") @db.VarChar(255)
  totpEnrolledAt DateTime? @map("totp_enrolled_at") @db.Timestamptz(3)
  lastTotpStep   BigInt?   @map("last_totp_step")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

/// Single-use recovery codes shown once at enrolment; only their SHA-256 is kept.
model AdminRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "admin_recovery_codes_user_idx")
  @@map("admin_recovery_codes")
}

/// A panel session behind the HttpOnly cookie (only its SHA-256 is kept; the CSRF token is an HMAC of the cookie,
/// never stored). PASSWORD = the
/// password was right and the second factor (enrolment or code) is still due; ACTIVE = signed in.
model AdminSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  stage             String    @db.VarChar(16)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip                String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "admin_sessions_user_idx")
  @@index([expiresAt], map: "admin_sessions_expires_idx")
  @@map("admin_sessions")
}

/// v1.68-live (D273, CONVENTIONS §10.96.6): «أدوات فريق كابسو» in the app — the step-up with the panel authenticator
/// code, bound to one app session (sign-in) of the staff member, for STAFF_APP_GRANT_SECONDS (12 h). Every staff route
/// checks it with the roles held now; it ends with the session, a revoked role, a lockout, a reset authenticator or
/// «إنهاء» in the app.
model AdminAppGrant {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ENDED | ROLE_REVOKED | LOCKED | TOTP_RESET | REPLACED
  revokedReason String?   @map("revoked_reason") @db.VarChar(16)
  ip            String?   @db.VarChar(64)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "admin_app_grants_session_idx", where: raw("revoked_at IS NULL"))
  @@index([userId], map: "admin_app_grants_user_idx")
  @@map("admin_app_grants")
}

/// v1.60-social (D191/D192, CONVENTIONS §10.54.6): the public website's settings, one row per key
/// (`socials`, `topupEnabled`). Read by `GET /site/settings`, changed by the OWNER from the panel (audited).
/// D228: also `cameraFxEngine` (`"DEEPAR"` / `"FREE"`), served in `LiveConfig.cameraFxEngine`.
model SiteSetting {
  key         String   @id @db.VarChar(40)
  value       Json     @db.JsonB
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("site_settings")
}

// ---- v1.64-social (D196, CONVENTIONS §10.53.1): the Stripe keys from the admin panel «الدفع (Stripe)» ------------

/// D196: one row (id 1). The Stripe secret (or restricted) key and the webhook signing secret the OWNER enters in the
/// panel, AES-256-GCM sealed with a key derived from ADMIN_TOTP_KEY (HKDF `payment-settings/v1`, the column as
/// additional data); only their prefix and last 4 characters are kept in clear for the panel. Both or neither (a key
/// without its webhook secret would take payments that are never credited). They override STRIPE_SECRET_KEY /
/// STRIPE_WEBHOOK_SECRET; cleared, the env keys apply again. After a rotation the previous webhook secret verifies
/// for 10 minutes. A null option = the server's env value. Written only by `PaymentSettingsService` (audited).
model PaymentSettings {
  id                         Int       @id @default(1) @db.SmallInt
  secretKeyEnc               String?   @map("secret_key_enc")
  secretKeyPrefix            String?   @map("secret_key_prefix") @db.VarChar(7)
  secretKeyLast4             String?   @map("secret_key_last4") @db.VarChar(4)
  secretKeySetById           String?   @map("secret_key_set_by_id") @db.Uuid
  secretKeySetAt             DateTime? @map("secret_key_set_at") @db.Timestamptz(3)
  webhookSecretEnc           String?   @map("webhook_secret_enc")
  webhookSecretLast4         String?   @map("webhook_secret_last4") @db.VarChar(4)
  webhookSecretSetById       String?   @map("webhook_secret_set_by_id") @db.Uuid
  webhookSecretSetAt         DateTime? @map("webhook_secret_set_at") @db.Timestamptz(3)
  previousWebhookSecretEnc   String?   @map("previous_webhook_secret_enc")
  previousWebhookSecretUntil DateTime? @map("previous_webhook_secret_until") @db.Timestamptz(3)
  publishableKey             String?   @map("publishable_key") @db.VarChar(260)
  bankTransferEnabled        Boolean?  @map("bank_transfer_enabled")
  statementDescriptorSuffix  String?   @map("statement_descriptor_suffix") @db.VarChar(10)
  disputeAutoSubmit          Boolean?  @map("dispute_auto_submit")
  appLinkEnabled             Boolean?  @map("app_link_enabled")
  /// v1.109-social (D344): the website price includes Stripe's fee (NULL = TOPUP_STRIPE_FEE_GROSS_UP).
  stripeFeeGrossUp           Boolean?  @map("stripe_fee_gross_up")
  /// v1.109-social (D344): Stripe's percent in basis points (290 = 2.9 %; NULL = TOPUP_STRIPE_FEE_PERCENT).
  stripeFeePercentBps        Int?      @map("stripe_fee_percent_bps")
  /// v1.109-social (D344): Stripe's fixed fee in the top-up currency's minor unit (NULL = TOPUP_STRIPE_FEE_FIXED_MINOR).
  stripeFeeFixedMinor        Int?      @map("stripe_fee_fixed_minor")
  updatedAt                  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById                String?   @map("updated_by_id") @db.Uuid

  @@map("payment_settings")
}

// ---- v1.75-social (D222, CONVENTIONS §10.72): the media storage from the panel «التخزين (R2 / S3)» --------------

/// D222: the OWNER's object-storage settings (one row, id 1). The access key id and the secret are AES-256-GCM sealed
/// (HKDF `storage-settings/v1` from ADMIN_TOTP_KEY), only their last 4 in clear. `enabled` on → used over the env.
model StorageSettings {
  id                     Int       @id @default(1) @db.SmallInt
  enabled                Boolean   @default(false)
  /// `R2` | `S3`.
  provider               String    @default("R2") @db.VarChar(8)
  accountId              String?   @map("account_id") @db.VarChar(32)
  endpoint               String?   @db.VarChar(300)
  region                 String?   @db.VarChar(64)
  forcePathStyle         Boolean   @default(false) @map("force_path_style")
  accessKeyIdEnc         String?   @map("access_key_id_enc")
  accessKeyIdLast4       String?   @map("access_key_id_last4") @db.VarChar(4)
  accessKeyIdSetById     String?   @map("access_key_id_set_by_id") @db.Uuid
  accessKeyIdSetAt       DateTime? @map("access_key_id_set_at") @db.Timestamptz(3)
  secretAccessKeyEnc     String?   @map("secret_access_key_enc")
  secretAccessKeyLast4   String?   @map("secret_access_key_last4") @db.VarChar(4)
  secretAccessKeySetById String?   @map("secret_access_key_set_by_id") @db.Uuid
  secretAccessKeySetAt   DateTime? @map("secret_access_key_set_at") @db.Timestamptz(3)
  publicBucket           String?   @map("public_bucket") @db.VarChar(63)
  publicBaseUrl          String?   @map("public_base_url") @db.VarChar(300)
  privateBucket          String?   @map("private_bucket") @db.VarChar(63)
  lastTestAt             DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk             Boolean?  @map("last_test_ok")
  lastTestById           String?   @map("last_test_by_id") @db.Uuid
  lastTest               Json?     @map("last_test")
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById            String?   @map("updated_by_id") @db.Uuid

  @@map("storage_settings")
}

// ---- v1.61-social (D192, CONVENTIONS §10.55): the public website kabsolive.com ---------------------------------
// (The website's settings are `SiteSetting` above, D191/D192, §10.54.6.)

/// D192: the website's «أبلغني عند الإطلاق» waitlist. One row per normalized email; a repeated sign-up changes
/// nothing (the response never says whether the email was already there). Read only by the `waitlist-admin` CLI.
model WaitlistSignup {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Trimmed + lowercase.
  email     String   @unique(map: "waitlist_signups_email_key") @db.VarChar(254)
  /// `ar` or `en`: the language of the launch e-mail.
  locale    String   @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt], map: "waitlist_signups_created_at_idx")
  @@map("waitlist_signups")
}

// ---- v1.62-social (D193, CONVENTIONS §10.56): account deletion «حذف الحساب» --------------------------------------

/// D193: PENDING (the grace period; the account is PENDING_DELETION), CANCELLED (the person signed in and cancelled,
/// or the team cancelled it), PURGED (the account became a tombstone).
enum AccountDeletionStatus {
  PENDING
  CANCELLED
  PURGED

  @@map("account_deletion_status")
}

/// D193: one deletion request. At most one PENDING per user (partial unique). Kept after the purge (no personal data:
/// the user row is the tombstone) as the record of when and how the account was deleted, until
/// DELETED_LEDGER_RETENTION_DAYS (7 years) after the purge — then deleted with the tombstone's audit rows.
model AccountDeletionRequest {
  id           String                @id @default(uuid(7)) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  status       AccountDeletionStatus @default(PENDING)
  /// APP (the person, re-authenticated in the app) | ADMIN (`account-admin request`, e.g. an emailed request).
  requestedVia String                @map("requested_via") @db.VarChar(10)
  requestedAt  DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  /// The earliest moment the sweeper purges the account (requested_at + ACCOUNT_DELETION_GRACE_DAYS).
  purgeAfter   DateTime              @map("purge_after") @db.Timestamptz(3)
  cancelledAt  DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  /// APP (signed in again and cancelled) | ADMIN (`account-admin cancel`).
  cancelledVia String?               @map("cancelled_via") @db.VarChar(10)
  purgedAt     DateTime?             @map("purged_at") @db.Timestamptz(3)
  /// SWEEPER | ADMIN (`account-admin purge-now`).
  purgedVia    String?               @map("purged_via") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId], map: "account_deletion_requests_one_pending", where: raw("status = 'PENDING'::account_deletion_status"))
  @@index([purgeAfter], map: "account_deletion_requests_due_idx", where: raw("status = 'PENDING'::account_deletion_status"))
  @@index([userId, requestedAt(sort: Desc)], map: "account_deletion_requests_user_idx")
  @@map("account_deletion_requests")
}

/// D193 (owner 2026-10-31): content of a purged account that had an OPEN or ACTIONED report, kept as a snapshot for
/// REPORT_LEGAL_HOLD_DAYS (90) — hidden from every user, linked only to its reports and the tombstone id; admins read it
/// with `account-admin hold-show` (audited). The sweeper deletes it with its reports and files at `delete_after`.
model LegalHold {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// The tombstone (the purged account's random id; no personal data).
  userId      String           @map("user_id") @db.Uuid
  targetType  ReportTargetType @map("target_type")
  /// The deleted row's id (no foreign key: the row is gone, except a comment's, which stays soft-deleted).
  targetId    String           @map("target_id") @db.Uuid
  /// What the content was: text, dates, media metadata and keys (see `legalHoldSnapshot`).
  snapshot    Json             @db.JsonB
  /// Stored files kept for the hold and deleted with it.
  objectKeys  String[]         @default([]) @map("object_keys")
  heldAt      DateTime         @map("held_at") @db.Timestamptz(3)
  deleteAfter DateTime         @map("delete_after") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@unique([targetType, targetId], map: "legal_holds_target_key")
  @@index([deleteAfter], map: "legal_holds_delete_after_idx")
  @@index([userId], map: "legal_holds_user_idx")
  @@map("legal_holds")
}

/// D193: the regular username of a purged account, held for ACCOUNT_DELETION_USERNAME_QUARANTINE_DAYS so nobody can
/// take it over at once (impersonation). Only its SHA-256 is kept (no link to the tombstone); the sweeper deletes the
/// row when the quarantine ends. `coin`/`host` codes are never released (special_usernames).
model DeletedUsername {
  nameHash  String   @id @map("name_hash") @db.Char(64)
  until     DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([until], map: "deleted_usernames_until_idx")
  @@map("deleted_usernames")
}

// ---- v1.66-social (D198, CONVENTIONS §10.61): legal documents, consents and the personal-data export ------------

enum LegalDocumentKind {
  TERMS
  PRIVACY

  @@map("legal_document_kind")
}

/// D198: what a consent row records. AGE_18 = «عمري 18 عاماً أو أكثر» (sign-up, and the lucky gifts' statement);
/// TOPUP_TERMS = D190's «العملات رقمية وغير قابلة للاسترداد» (also kept in topup_terms_acceptances).
enum ConsentDocument {
  TERMS
  PRIVACY
  AGE_18
  TOPUP_TERMS

  @@map("consent_document")
}

enum DataExportStatus {
  PENDING
  RUNNING
  READY
  DOWNLOADED
  EXPIRED
  FAILED

  @@map("data_export_status")
}

/// D198: one published version of the terms or the privacy policy (`legal-admin publish`, migration role, audited).
/// The version in force is the latest whose `effective_at` has passed; until one exists no consent is required.
model LegalDocument {
  id          String            @id @default(uuid(7)) @db.Uuid
  kind        LegalDocumentKind
  version     String            @db.VarChar(32)
  effectiveAt DateTime          @map("effective_at") @db.Timestamptz(3)
  publishedAt DateTime          @default(now()) @map("published_at") @db.Timestamptz(3)
  /// SHA-256 (hex) of the published text (the website page).
  contentHash String            @map("content_hash") @db.Char(64)
  url         String            @db.VarChar(300)
  /// What changed, shown on the consent screen.
  summaryAr   String            @map("summary_ar") @db.VarChar(2000)
  summaryEn   String            @map("summary_en") @db.VarChar(2000)

  consents UserConsent[]

  @@unique([kind, version], map: "legal_documents_kind_version_key")
  @@index([kind, effectiveAt(sort: Desc)], map: "legal_documents_kind_effective_idx")
  @@map("legal_documents")
}

/// D198: an acceptance (user, document, version, time, truncated IP, user agent, method). ip/ua cleared at the purge.
model UserConsent {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  document        ConsentDocument
  version         String          @db.VarChar(32)
  legalDocumentId String?         @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime        @default(now()) @map("accepted_at") @db.Timestamptz(3)
  /// IPv4 /24 (`a.b.c.0`) or IPv6 /48 (`x:y:z::`), never the full address.
  ipTruncated     String?         @map("ip_truncated") @db.VarChar(64)
  userAgent       String?         @map("user_agent") @db.VarChar(512)
  /// REGISTRATION | IN_APP | TOPUP_WEBSITE | LUCKY_GIFT.
  method          String          @db.VarChar(20)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId], map: "user_consents_once_per_document", where: raw("legal_document_id IS NOT NULL"))
  @@index([userId, document, acceptedAt(sort: Desc)], map: "user_consents_user_idx")
  @@map("user_consents")
}

/// D198: one «تنزيل بياناتي» job. The ZIP is under `private/data-exports/`; only the token's SHA-256 is kept.
model DataExport {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       DataExportStatus @default(PENDING)
  /// APP (the person, re-authenticated) | ADMIN (`privacy-admin export`, a verified emailed request).
  requestedVia String           @map("requested_via") @db.VarChar(10)
  requestedAt  DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt    DateTime?        @map("started_at") @db.Timestamptz(3)
  readyAt      DateTime?        @map("ready_at") @db.Timestamptz(3)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(3)
  downloadedAt DateTime?        @map("downloaded_at") @db.Timestamptz(3)
  objectKey    String?          @map("object_key") @db.VarChar(200)
  sizeBytes    Int?             @map("size_bytes")
  sha256       String?          @db.Char(64)
  tokenHash    String?          @map("token_hash") @db.Char(64)
  attempts     Int              @default(0)
  error        String?          @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "data_exports_token_key", where: raw("token_hash IS NOT NULL"))
  @@index([userId, requestedAt(sort: Desc)], map: "data_exports_user_idx")
  @@index([status, requestedAt], map: "data_exports_status_idx")
  @@map("data_exports")
}

// ---- v1.43-live (D195, CONVENTIONS §10.58, CP-038): PK 1 v 1 ------------------------------------

/// The four PK boosters (owner D195): «دبل» ×2, «دبل تيربو» ×3, «تربل» ×5, «تربل تيربو» ×10 by default.
enum PkBoosterKind {
  DOUBLE
  DOUBLE_TURBO
  TRIPLE
  TRIPLE_TURBO

  @@map("pk_booster_kind")
}

/// A PK match: BATTLE (PK_BATTLE_SECONDS) → RESULT (PK_RESULT_SECONDS, the win / lose animation) →
/// CLOSED. Side A is the inviter (or the first in the random queue).
enum PkMatchStatus {
  /// v1.44-live (D199): connected, waiting for either host to start (auto-start off).
  CONNECTED
  BATTLE
  RESULT
  CLOSED

  @@map("pk_match_status")
}

/// How a PK came about.
enum PkMatchSource {
  INVITE
  RANDOM

  @@map("pk_match_source")
}

/// Why the battle ended: its time ran out, a host ended it early (forfeit), a host left or stayed
/// away, or a moderator ended it (void: no result, not counted).
enum PkEndReason {
  TIME
  FORFEIT
  DISCONNECT
  AWAY
  ADMIN
  /// v1.44-live (D199): a CONNECTED PK that never started (void, never counted).
  CANCELLED

  @@map("pk_end_reason")
}

/// v1.44-live (D199): one round, or the best of three rounds (the first to win two).
enum PkMode {
  SINGLE
  BEST_OF_THREE

  @@map("pk_mode")
}

/// v1.44-live (D199): whom the random queue may pair a host with (D175 gender; unknown or undisclosed
/// matches any preference).
enum PkGenderPref {
  BOTH
  MALE
  FEMALE

  @@map("pk_gender_pref")
}

/// v1.44-live (D199): the random queue's region — anyone, or hosts of the same country (D133).
enum PkRegionPref {
  GLOBAL
  SAME_COUNTRY

  @@map("pk_region_pref")
}

/// A side of a match.
enum PkSide {
  A
  B

  @@map("pk_side")
}

enum PkInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("pk_invite_status")
}

/// v1.43-live (D195): one PK between two SOLO video lives. Scores are PK points only (the coin value of
/// the gifts sent in each room during the battle × that side's booster); money, cherries, live scores,
/// rankings, charm and levels always use the gift's real value. At most one BATTLE / RESULT match per
/// room (partial unique indexes on each room column, plus the PK room advisory locks).
model PkMatch {
  id               String        @id @default(uuid(7)) @db.Uuid
  source           PkMatchSource
  status           PkMatchStatus @default(BATTLE)
  roomAId          String        @map("room_a_id") @db.Uuid
  hostAId          String        @map("host_a_id") @db.Uuid
  roomBId          String        @map("room_b_id") @db.Uuid
  hostBId          String        @map("host_b_id") @db.Uuid
  scoreA           BigInt        @default(0) @map("score_a")
  scoreB           BigInt        @default(0) @map("score_b")
  startedAt        DateTime      @map("started_at") @db.Timestamptz(3)
  battleEndsAt     DateTime      @map("battle_ends_at") @db.Timestamptz(3)
  /// When the battle actually ended (time, forfeit, disconnect, admin); null during BATTLE.
  endedAt          DateTime?     @map("ended_at") @db.Timestamptz(3)
  resultEndsAt     DateTime?     @map("result_ends_at") @db.Timestamptz(3)
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz(3)
  endReason        PkEndReason?  @map("end_reason")
  /// The winning side; null for a draw, a void (ADMIN) match or while the battle runs.
  winner           PkSide?
  /// The side that forfeited, disconnected or stayed away (FORFEIT / DISCONNECT / AWAY).
  loserCause       PkSide?       @map("loser_cause")
  /// D170 × D195: since when side A's / B's host has been out of the media session (webhook); null
  /// while connected.
  aLeftAt          DateTime?     @map("a_left_at") @db.Timestamptz(3)
  bLeftAt          DateTime?     @map("b_left_at") @db.Timestamptz(3)
  /// The host of side A / B turned the opponent's sound off in their room.
  aMutesB          Boolean       @default(false) @map("a_mutes_b")
  bMutesA          Boolean       @default(false) @map("b_mutes_a")
  /// Increases on every change (data messages carry it; apps keep the highest).
  seq              Int           @default(0)
  /// Set by `pk-admin end` (the CLI cannot reach the media server): the API's PK tick tells both rooms.
  pendingNotice    Boolean       @default(false) @map("pending_notice")
  adminReason      String?       @map("admin_reason") @db.VarChar(200)
  /// The top supporters frozen when the battle ended: `[{userId, points}]`, at most 3 per side.
  topA             Json?         @map("top_a")
  topB             Json?         @map("top_b")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// v1.44-live (D199): the settings used (one host's; `settingsFrom` names whose when they differed).
  mode             PkMode        @default(SINGLE)
  roundSeconds     Int           @default(300) @map("round_seconds")
  /// The round running (or the last one); best of three only goes past 1.
  round            Int           @default(1) @db.SmallInt
  roundsA          Int           @default(0) @map("rounds_a") @db.SmallInt
  roundsB          Int           @default(0) @map("rounds_b") @db.SmallInt
  /// PK points of the rounds already finished (`score_*` is the running round's).
  totalA           BigInt        @default(0) @map("total_a")
  totalB           BigInt        @default(0) @map("total_b")
  settingsFrom     PkSide?       @map("settings_from")
  /// When the hosts were connected (auto-start off: `startedAt` is then when the battle started).
  connectedAt      DateTime?     @map("connected_at") @db.Timestamptz(3)
  /// Whether the finished match counts in the records (combined PK points ≥ PK_EFFECTIVE_MIN_POINTS).
  effective        Boolean?
  /// v1.50-live (D229): «PK أحكام» (DARES) or the normal PK.
  type             PkType        @default(NORMAL)
  /// v1.55-live (D242) «جولة أخرى»: the battle this rematch follows, the first of its chain (the chain's PK media
  /// watchers stay valid) and how many rematches came before it (PK_REMATCH_MAX).
  rematchOf        String?       @map("rematch_of") @db.Uuid
  rematchRootId    String?       @map("rematch_root_id") @db.Uuid
  rematchCount     Int           @default(0) @map("rematch_count")
  /// v1.55-live (D242): an open offer on a RESULT match — the side that asked and when it lapses.
  rematchBy        PkSide?       @map("rematch_by")
  rematchExpiresAt DateTime?     @map("rematch_expires_at") @db.Timestamptz(3)

  previous    PkMatch?       @relation("PkRematch", fields: [rematchOf], references: [id], onDelete: SetNull)
  rematches   PkMatch[]      @relation("PkRematch")
  roomA       LiveRoom       @relation("PkMatchRoomA", fields: [roomAId], references: [id], onDelete: Cascade)
  roomB       LiveRoom       @relation("PkMatchRoomB", fields: [roomBId], references: [id], onDelete: Cascade)
  hostA       User           @relation("PkMatchHostA", fields: [hostAId], references: [id], onDelete: Cascade)
  hostB       User           @relation("PkMatchHostB", fields: [hostBId], references: [id], onDelete: Cascade)
  boosts      PkBoost[]
  points      PkGiftPoint[]
  supporters  PkSupporter[]
  invite      PkInvite?
  dare        PkMatchDare?
  pointEvents PkPointEvent[]

  @@unique([roomAId], map: "pk_matches_room_a_active", where: raw("status <> 'CLOSED'::pk_match_status"))
  @@unique([roomBId], map: "pk_matches_room_b_active", where: raw("status <> 'CLOSED'::pk_match_status"))
  @@index([status], map: "pk_matches_open_idx", where: raw("status <> 'CLOSED'::pk_match_status"))
  @@index([hostAId, startedAt(sort: Desc)], map: "pk_matches_host_a_idx")
  @@index([hostBId, startedAt(sort: Desc)], map: "pk_matches_host_b_idx")
  @@index([roomBId], map: "pk_matches_room_b_idx")
  @@index([rematchRootId], map: "pk_matches_rematch_root_idx", where: raw("rematch_root_id IS NOT NULL"))
  @@map("pk_matches")
}

/// v1.43-live (D195): a host invites another live host; PK_INVITE_TTL_SECONDS (15) to answer.
model PkInvite {
  id         String         @id @default(uuid(7)) @db.Uuid
  fromRoomId String         @map("from_room_id") @db.Uuid
  fromHostId String         @map("from_host_id") @db.Uuid
  toRoomId   String         @map("to_room_id") @db.Uuid
  toHostId   String         @map("to_host_id") @db.Uuid
  status     PkInviteStatus @default(PENDING)
  createdAt  DateTime       @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  handledAt  DateTime?      @map("handled_at") @db.Timestamptz(3)
  matchId    String?        @unique @map("match_id") @db.Uuid
  /// v1.50-live (D229): the PK type the invitation offers.
  type       PkType         @default(NORMAL)

  fromRoom LiveRoom @relation("PkInviteFromRoom", fields: [fromRoomId], references: [id], onDelete: Cascade)
  toRoom   LiveRoom @relation("PkInviteToRoom", fields: [toRoomId], references: [id], onDelete: Cascade)
  fromHost User     @relation("PkInviteFrom", fields: [fromHostId], references: [id], onDelete: Cascade)
  toHost   User     @relation("PkInviteTo", fields: [toHostId], references: [id], onDelete: Cascade)
  match    PkMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([fromRoomId], map: "pk_invites_one_out", where: raw("status = 'PENDING'::pk_invite_status"))
  @@unique([toRoomId], map: "pk_invites_one_in", where: raw("status = 'PENDING'::pk_invite_status"))
  @@index([expiresAt], map: "pk_invites_pending_expiry_idx", where: raw("status = 'PENDING'::pk_invite_status"))
  @@index([fromHostId, createdAt(sort: Desc)], map: "pk_invites_from_host_idx")
  @@index([toHostId], map: "pk_invites_to_host_idx")
  @@index([toRoomId], map: "pk_invites_to_room_idx")
  @@map("pk_invites")
}

/// v1.43-live (D195): «مطابقة عشوائية» — a host waiting to be paired (PK_RANDOM_WAIT_SECONDS).
model PkQueueEntry {
  hostId    String   @id @map("host_id") @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  joinedAt  DateTime @map("joined_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// v1.50-live (D229): only waiters of the same type are paired.
  type      PkType   @default(NORMAL)

  host User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([joinedAt], map: "pk_queue_joined_idx")
  @@index([roomId], map: "pk_queue_room_idx")
  @@map("pk_queue")
}

/// v1.43-live (D195): a booster activated by its gift on one side of a match. Active while
/// `starts_at <= now < ends_at`; a higher one replaces a lower one (the lower one's `ends_at` moves
/// to the replacement time, `replaced` true).
model PkBoost {
  id         String        @id @default(uuid(7)) @db.Uuid
  matchId    String        @map("match_id") @db.Uuid
  side       PkSide
  kind       PkBoosterKind
  multiplier Int           @db.SmallInt
  giftId     String        @unique @map("gift_id") @db.Uuid
  giftCode   String        @map("gift_code") @db.VarChar(40)
  senderId   String        @map("sender_id") @db.Uuid
  startsAt   DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime      @map("ends_at") @db.Timestamptz(3)
  replaced   Boolean       @default(false)
  /// v1.44-live (D199): the round it was used in (limits are per round).
  round      Int           @default(1) @db.SmallInt

  match PkMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gift  Gift    @relation(fields: [giftCode], references: [code], onDelete: Restrict)

  @@index([matchId, side, round, endsAt], map: "pk_boosts_match_side_idx")
  @@index([giftCode], map: "pk_boosts_gift_code_idx")
  @@map("pk_boosts")
}

/// v1.43-live (D195): the PK points of one gift send (one row per send: a retry is never counted twice).
/// `points = coins × multiplier`; `coins` is the send's real coin value.
model PkGiftPoint {
  giftId     String   @id @map("gift_id") @db.Uuid
  matchId    String   @map("match_id") @db.Uuid
  side       PkSide
  senderId   String   @map("sender_id") @db.Uuid
  coins      BigInt
  multiplier Int      @db.SmallInt
  points     BigInt
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  gift  LiveGift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  match PkMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, side], map: "pk_gift_points_match_idx")
  @@map("pk_gift_points")
}

/// v1.43-live (D195): a supporter's PK points on one side of a match (the top three per side).
model PkSupporter {
  matchId String @map("match_id") @db.Uuid
  side    PkSide
  userId  String @map("user_id") @db.Uuid
  points  BigInt @default(0)

  match PkMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, side, userId], map: "pk_supporters_pkey")
  @@index([matchId, side, points(sort: Desc)], map: "pk_supporters_rank_idx")
  @@index([userId], map: "pk_supporters_user_idx")
  @@map("pk_supporters")
}

/// v1.43-live (D195): a host's PK record (finished, non-void matches).
model PkHostRecord {
  hostId       String   @id @map("host_id") @db.Uuid
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// v1.50-live (D229): PK points (win / draw / loss / refused dare, `pk_dare_settings`; may be below 0).
  points       Int      @default(0)
  /// D300 (owner: «لاعب الأحكام» counts «PK أحكام» only): the part of `points` from DARES matches — the same
  /// once-per-match `pk_point_events`, added in the same statement (may be below 0).
  daresPoints  Int      @default(0) @map("dares_points")
  daresDone    Int      @default(0) @map("dares_done")
  daresRefused Int      @default(0) @map("dares_refused")

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("pk_host_records")
}

/// v1.50-live (D229): the PK type — the normal PK, or «PK أحكام» (the loser of a decisive result gets a dare).
enum PkType {
  NORMAL
  DARES

  @@map("pk_type")
}

enum PkDareCategory {
  FUNNY
  SINGING
  ACTING
  TALK
  TRUTH
  DANCE_LIGHT
  IMITATION
  QUIZ
  DRAWING

  @@map("pk_dare_category")
}

/// Owner (D229): three levels, about a third of the library each; a draw offers one of each.
enum PkDareLevel {
  EASY
  MEDIUM
  HARD

  @@map("pk_dare_level")
}

/// DECIDING (the draw, then the loser accepts or refuses) → ACTIVE (the timer; the winner judges) → DONE / REFUSED;
/// CANCELLED: a moderator's end (no points).
enum PkDareStatus {
  DECIDING
  ACTIVE
  DONE
  REFUSED
  CANCELLED

  @@map("pk_dare_status")
}

enum PkDareCause {
  LOSER_REFUSED
  DECIDE_TIMEOUT
  LOSER_LEFT
  WINNER_DONE
  WINNER_NOT_DONE
  TIMER
  WINNER_LEFT
  ADMIN

  @@map("pk_dare_cause")
}

/// v1.50-live (D229): one dare of the library (Kabso's own; seeded by `pk-dares-admin import`). `seqNo` numbers the
/// bit of `pk_dare_seen.bits`. `disabledReason` ADMIN | REPORTS when not active.
model PkDare {
  id               String         @id @default(uuid(7)) @db.Uuid
  seqNo            Int            @unique(map: "pk_dares_seq_no_key") @default(autoincrement()) @map("seq_no")
  code             String         @unique(map: "pk_dares_code_key") @db.VarChar(40)
  textAr           String         @map("text_ar") @db.VarChar(200)
  textEn           String         @map("text_en") @db.VarChar(300)
  category         PkDareCategory
  level            PkDareLevel
  requiresCamera   Boolean        @default(true) @map("requires_camera")
  active           Boolean        @default(true)
  disabledReason   String?        @map("disabled_reason") @db.VarChar(16)
  reportCount      Int            @default(0) @map("report_count")
  reportsClearedAt DateTime?      @map("reports_cleared_at") @db.Timestamptz(3)
  createdBy        String         @default("SEED") @map("created_by") @db.VarChar(8)
  createdById      String?        @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  matches PkMatchDare[]
  reports PkDareReport[]

  @@index([level], map: "pk_dares_draw_idx", where: raw("active"))
  @@index([reportCount(sort: Desc)], map: "pk_dares_reported_idx", where: raw("report_count > 0"))
  @@map("pk_dares")
}

/// v1.50-live (D229): the dare of one DARES match. `optionIds` EASY, MEDIUM, HARD; `drawn` the server's draw (0–2).
model PkMatchDare {
  matchId      String       @id @map("match_id") @db.Uuid
  loserSide    PkSide       @map("loser_side")
  loserHostId  String       @map("loser_host_id") @db.Uuid
  winnerHostId String       @map("winner_host_id") @db.Uuid
  optionIds    String[]     @map("option_ids") @db.Uuid
  drawn        Int          @db.SmallInt
  dareId       String       @map("dare_id") @db.Uuid
  status       PkDareStatus @default(DECIDING)
  cause        PkDareCause?
  revealAt     DateTime     @map("reveal_at") @db.Timestamptz(3)
  decideBy     DateTime     @map("decide_by") @db.Timestamptz(3)
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(3)
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz(3)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(3)
  /// The loser's PK points from the dare (the refusal's, else 0).
  points       Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  match PkMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  dare  PkDare  @relation(fields: [dareId], references: [id], onDelete: Restrict)

  @@index([status], map: "pk_match_dares_open_idx", where: raw("finished_at IS NULL"))
  @@index([loserHostId, createdAt(sort: Desc)], map: "pk_match_dares_loser_idx")
  @@map("pk_match_dares")
}

/// v1.50-live (D229): a viewer's (or host's) report of a dare; one per person per dare.
model PkDareReport {
  dareId    String   @map("dare_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  matchId   String?  @map("match_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  dare PkDare @relation(fields: [dareId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dareId, userId], map: "pk_dare_reports_pkey")
  @@index([userId], map: "pk_dare_reports_user_idx")
  @@map("pk_dare_reports")
}

/// v1.50-live (D229): the dares a host has been shown — bit n is `pk_dares.seq_no` n (2.5 KB for 20 000).
model PkDareSeen {
  hostId    String   @id @map("host_id") @db.Uuid
  bits      Bytes
  seen      Int      @default(0)
  cycles    Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("pk_dare_seen")
}

/// v1.50-live (D229): the PK points written for one match and host (kind WIN / DRAW / LOSS / DARE_REFUSED).
model PkPointEvent {
  matchId   String   @map("match_id") @db.Uuid
  hostId    String   @map("host_id") @db.Uuid
  kind      String   @db.VarChar(16)
  points    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  match PkMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  host  User    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@id([matchId, hostId, kind], map: "pk_point_events_pkey")
  @@index([hostId, createdAt(sort: Desc)], map: "pk_point_events_host_idx")
  @@map("pk_point_events")
}

/// v1.50-live (D229): one row (id 1) — the PK points and the loser's decision time («أحكام PK», audited).
model PkDareSettings {
  id               Int      @id @default(1) @db.SmallInt
  winPoints        Int      @default(3) @map("win_points")
  drawPoints       Int      @default(1) @map("draw_points")
  lossPoints       Int      @default(0) @map("loss_points")
  refusePoints     Int      @default(-3) @map("refuse_points")
  /// v1.67-live (D276): a host who withdrew from a DARES battle (FORFEIT, DISCONNECT, AWAY), instead of lossPoints.
  forfeitPoints    Int      @default(-3) @map("forfeit_points")
  decideSeconds    Int      @default(30) @map("decide_seconds")
  reportsToDisable Int      @default(5) @map("reports_to_disable")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById      String?  @map("updated_by_id") @db.Uuid

  @@map("pk_dare_settings")
}

/// v1.43-live (D195): a host's PK settings (no row: invitations on).
model PkHostSettings {
  hostId         String       @id @map("host_id") @db.Uuid
  invitesEnabled Boolean      @default(true) @map("invites_enabled")
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// v1.44-live (D199): the PK Setting page (1 v 1).
  mode           PkMode       @default(SINGLE)
  /// 3, 5 or 10; null: the server's PK_BATTLE_SECONDS.
  roundMinutes   Int?         @map("round_minutes") @db.SmallInt
  autoStart      Boolean      @default(true) @map("auto_start")
  randomGender   PkGenderPref @default(BOTH) @map("random_gender")
  randomRegion   PkRegionPref @default(GLOBAL) @map("random_region")
  autoMatch      Boolean      @default(false) @map("auto_match")
  recommendable  Boolean      @default(true)

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId], map: "pk_host_settings_auto_match_idx", where: raw("auto_match"))
  @@map("pk_host_settings")
}

/// v1.45-live (D201, CONVENTIONS §10.63): why a second camera (or its pairing code) ended.
enum LiveSecondCameraEndReason {
  /// The host (either device: the same account) ended it, or asked for a new code.
  REVOKED
  /// The code was not redeemed in time.
  EXPIRED
  /// The second device left the media session.
  LEFT
  /// The live ended.
  ROOM_ENDED
  /// A PK started (the second camera is not part of a PK).
  PK

  @@map("live_second_camera_end_reason")
}

/// v1.45-live (D201): which feed the viewers see full screen by default.
enum LiveSecondCameraMain {
  HOST
  SECOND

  @@map("live_second_camera_main")
}

/// v1.45-live (D201, CONVENTIONS §10.63): a second device of the host publishing a second camera into
/// their SOLO video live (media identity `cam2:<hostUserId>`). A row starts as a pairing code (only its
/// HMAC is stored), single use, valid `LIVE_SECOND_CAMERA_CODE_SECONDS`; redeemed by the SAME account it is
/// the live's second camera until it ends. Partial unique indexes: one open code and one second camera
/// per live. Never counted as a viewer.
model LiveSecondCamera {
  id          String                     @id @default(uuid(7)) @db.Uuid
  roomId      String                     @map("room_id") @db.Uuid
  hostUserId  String                     @map("host_user_id") @db.Uuid
  /// HMAC-SHA256 (hex) of the code; the code itself is never stored or logged.
  codeHash    String                     @map("code_hash") @db.Char(64)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime                   @map("expires_at") @db.Timestamptz(3)
  redeemedAt  DateTime?                  @map("redeemed_at") @db.Timestamptz(3)
  /// Set when the second device joined the media session (webhook or reconciliation).
  connectedAt DateTime?                  @map("connected_at") @db.Timestamptz(3)
  endedAt     DateTime?                  @map("ended_at") @db.Timestamptz(3)
  endReason   LiveSecondCameraEndReason? @map("end_reason")
  mainFeed    LiveSecondCameraMain       @default(HOST) @map("main_feed")

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host User     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([roomId, endedAt])
  @@index([hostUserId, codeHash])
  @@map("live_second_cameras")
}

/// v1.45-live (D201): the host accepted the music-rights notice once («تأكد أنك تملك حقوق تشغيل
/// الموسيقى…»); the first acceptance is kept, with the notice's version.
model LiveMusicRightsAcceptance {
  userId        String   @id @map("user_id") @db.Uuid
  noticeVersion Int      @map("notice_version") @db.SmallInt
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_music_rights_acceptances")
}

/// v1.72-social (D208, CONVENTIONS §10.67): what the team may switch off for a while.
enum AccountRestrictionKind {
  /// «قفل الحساب»: no sign-in until `ends_at` (every session ended when it starts).
  LOCK
  /// «كتم الدردشة»: no live chat, bullet, comment or direct message.
  CHAT_MUTE
  /// «منع البث»: no going live (a current live ends).
  NO_LIVE
  /// «منع إرسال الهدايا»: no gift (live, direct, bag).
  NO_GIFTS
  /// «منع النشر»: no post, reel or story.
  NO_POSTING

  @@map("account_restriction_kind")
}

/// v1.72-social (D208, §10.67): a temporary lock or restriction set by the team (panel or `control-admin`). Active
/// while `lifted_at` is null and `starts_at <= now < ends_at`; a new one of the same kind lifts the open one
/// («replaced»). The reason is shown to the person. Never deleted except with the account.
model AccountRestriction {
  id          String                 @id @default(uuid(7)) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  kind        AccountRestrictionKind
  reason      String                 @db.VarChar(500)
  startsAt    DateTime               @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime               @map("ends_at") @db.Timestamptz(3)
  createdById String?                @map("created_by_id") @db.Uuid
  via         String                 @db.VarChar(10)
  liftedAt    DateTime?              @map("lifted_at") @db.Timestamptz(3)
  liftedById  String?                @map("lifted_by_id") @db.Uuid
  liftReason  String?                @map("lift_reason") @db.VarChar(500)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User                   @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("RestrictionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy      User?                  @relation("RestrictionLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)
  notifications Notification[]
  /// v1.60-live (D250): the live moderation that set it.
  moderations   LiveModerationAction[]

  @@index([userId, kind, endsAt(sort: Desc)], map: "account_restrictions_open_idx", where: raw("lifted_at IS NULL"))
  @@index([userId, createdAt(sort: Desc)], map: "account_restrictions_user_idx")
  @@map("account_restrictions")
}

/// v1.72-social (D208, §10.67): a balance adjustment by the team (coins or cherries, credit > 0 or debit < 0), with
/// the ledger row it wrote (`ADMIN_ADJUSTMENT`, reference = this id). The per-admin daily cap sums |delta| here.
model AdminBalanceAdjustment {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  currency      String   @db.VarChar(10)
  delta         BigInt
  balanceBefore BigInt   @map("balance_before")
  balanceAfter  BigInt   @map("balance_after")
  allowNegative Boolean  @default(false) @map("allow_negative")
  reason        String   @db.VarChar(500)
  via           String   @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User           @relation("AdjustedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor         User?          @relation("AdjustedBy", fields: [actorUserId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([actorUserId, createdAt], map: "admin_balance_adjustments_actor_idx")
  @@index([userId, createdAt(sort: Desc)], map: "admin_balance_adjustments_user_idx")
  @@map("admin_balance_adjustments")
}

/// v1.73-social (D209, §10.68): the state of an application «كن مضيفاً مع الإدارة».
enum HostApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("host_application_status")
}

/// v1.73-social (D209, §10.68): an application to host directly with the Kabso team (no agency). PRIVATE: the
/// date of birth, the contact, the bio, the links and the two pictures (the D185 private uploads) are read only in
/// the panel, every view audited. At most one PENDING per user (partial unique `host_applications_one_pending`);
/// `(user, clientKey)` once: the `Idempotency-Key`. Approving gives the `live_hosts` row with source IDENTITY.
model HostApplication {
  id              String                @id @default(uuid(7)) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  status          HostApplicationStatus @default(PENDING)
  clientKey       String                @map("client_key") @db.Uuid
  requestHash     String                @map("request_hash") @db.Char(64)
  displayName     String                @map("display_name") @db.VarChar(100)
  country         String                @db.Char(2)
  dateOfBirth     DateTime?             @map("date_of_birth") @db.Date
  contactType     String                @map("contact_type") @db.VarChar(16)
  contactValue    String?               @map("contact_value") @db.VarChar(100)
  bio             String?               @db.VarChar(300)
  links           String[]              @default([]) @db.VarChar(200)
  photoKey        String?               @map("photo_key") @db.VarChar(256)
  selfieKey       String?               @map("selfie_key") @db.VarChar(256)
  rulesAcceptedAt DateTime              @map("rules_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  decidedById     String?               @map("decided_by_id") @db.Uuid
  rejectReason    String?               @map("reject_reason") @db.VarChar(500)
  /// CANCELLED only: `USER` (the person), `AGENCY` (they joined or opened an agency), `ACCOUNT` (deletion).
  cancelReason    String?               @map("cancel_reason") @db.VarChar(16)
  purgedAt        DateTime?             @map("purged_at") @db.Timestamptz(3)
  /// v1.75-live (D285): the Kabso Team member who referred the applicant (MODERATION / BD), if named.
  recruiterUserId String?               @map("recruiter_user_id") @db.Uuid

  user      User  @relation("HostApplicant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("HostApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  recruiter User? @relation("HostApplicationRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)

  @@unique([userId, clientKey], map: "host_applications_client_once")
  // Created by 20270202090100_host_applications; declared with the `partialIndexes` preview feature (no drift).
  @@unique([userId], map: "host_applications_one_pending", where: raw("status = 'PENDING'::host_application_status"))
  @@index([userId, createdAt(sort: Desc)], map: "host_applications_user_idx")
  @@index([status, createdAt(sort: Desc)], map: "host_applications_status_idx")
  @@index([decidedById], map: "host_applications_decided_by_idx")
  @@map("host_applications")
}

// ---- v1.74-social (D217, CONVENTIONS §10.71): «دعوة الأصدقاء» — invite codes, referrals and rewards ----------------

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
  VOID

  @@map("referral_status")
}

enum ReferralRewardKind {
  SIGNUP_INVITER
  SIGNUP_INVITEE
  FIRST_RECHARGE
  MILESTONE

  @@map("referral_reward_kind")
}

enum ReferralRewardStatus {
  PENDING
  CREDITED
  VOID
  /// Credited, then taken back (`REFERRAL_REVERSAL`) when the team voided the referral.
  REVERSED

  @@map("referral_reward_status")
}

/// D217: one row (id 1) — every amount and rule of the programme; edited in the panel (FINANCE / OWNER, the
/// authenticator code again) or `referral-admin settings` (audited). `milestones`: `[{friends, cherries}]`, increasing.
model ReferralSettings {
  id                    Int      @id @default(1) @db.SmallInt
  enabled               Boolean  @default(true)
  inviterSignupCherries BigInt   @default(20000) @map("inviter_signup_cherries")
  inviteeSignupCherries BigInt   @default(0) @map("invitee_signup_cherries")
  firstRechargeBps      Int      @default(500) @map("first_recharge_bps")
  milestones            Json     @default("[{\"friends\":1,\"cherries\":50000},{\"friends\":5,\"cherries\":300000},{\"friends\":15,\"cherries\":1000000}]") @db.JsonB
  dailySignupCap        Int      @default(20) @map("daily_signup_cap")
  holdHours             Int      @default(24) @map("hold_hours")
  applyWindowDays       Int      @default(7) @map("apply_window_days")
  selfIpWindowHours     Int      @default(24) @map("self_ip_window_hours")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById           String?  @map("updated_by_id") @db.Uuid

  @@map("referral_settings")
}

/// D217: a person's invite code (made on first read; never changes).
model ReferralCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique(map: "referral_codes_code_key") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/// D217: who invited whom (one inviter per person, ever). `source` SIGNUP | LATER. REJECTED = a fraud rule at the
/// start (`rejectReason`); VOID = voided later (the hold's re-check or the team, `voidReason`).
model Referral {
  id               String         @id @default(uuid(7)) @db.Uuid
  inviterUserId    String         @map("inviter_user_id") @db.Uuid
  inviteeUserId    String         @unique(map: "referrals_invitee_key") @map("invitee_user_id") @db.Uuid
  code             String         @db.VarChar(16)
  source           String         @db.VarChar(8)
  status           ReferralStatus @default(PENDING)
  rejectReason     String?        @map("reject_reason") @db.VarChar(32)
  inviteeInstallId String?        @map("invitee_install_id") @db.VarChar(64)
  inviteeIp        String?        @map("invitee_ip") @db.VarChar(64)
  /// SHA-256 (hex) of the canonical mailbox (`canonicalEmail`): the alias / duplicate check without the address.
  inviteeEmailHash String         @map("invitee_email_hash") @db.Char(64)
  holdUntil        DateTime       @map("hold_until") @db.Timestamptz(3)
  firstRechargeAt  DateTime?      @map("first_recharge_at") @db.Timestamptz(3)
  qualifiedAt      DateTime?      @map("qualified_at") @db.Timestamptz(3)
  voidedAt         DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidReason       String?        @map("void_reason") @db.VarChar(500)
  decidedById      String?        @map("decided_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  inviter   User             @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee   User             @relation("ReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  decidedBy User?            @relation("ReferralDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  rewards   ReferralReward[]

  @@index([inviterUserId, createdAt(sort: Desc)], map: "referrals_inviter_idx")
  @@index([status, createdAt(sort: Desc)], map: "referrals_status_idx")
  @@index([holdUntil], map: "referrals_due_idx", where: raw("status = 'PENDING'::referral_status"))
  @@index([inviteeInstallId], map: "referrals_install_idx", where: raw("invitee_install_id IS NOT NULL"))
  @@index([inviteeEmailHash], map: "referrals_email_idx")
  @@map("referrals")
}

/// D217: a reward — PENDING until `holdUntil`, then CREDITED (one `REFERRAL_REWARD` ledger row, reference = this id)
/// or VOID. FIRST_RECHARGE keeps the recharge (`rechargeReason` = the coin ledger reason, `rechargeReference`), its
/// coins and the rate; MILESTONE has no referral and keeps the threshold.
model ReferralReward {
  id                String               @id @default(uuid(7)) @db.Uuid
  referralId        String?              @map("referral_id") @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  kind              ReferralRewardKind
  status            ReferralRewardStatus @default(PENDING)
  cherries          BigInt
  holdUntil         DateTime             @map("hold_until") @db.Timestamptz(3)
  baseCoins         BigInt?              @map("base_coins")
  rateBps           Int?                 @map("rate_bps")
  rechargeReason    String?              @map("recharge_reason") @db.VarChar(20)
  rechargeReference String?              @map("recharge_reference") @db.VarChar(64)
  milestoneFriends  Int?                 @map("milestone_friends")
  creditedAt        DateTime?            @map("credited_at") @db.Timestamptz(3)
  voidedAt          DateTime?            @map("voided_at") @db.Timestamptz(3)
  reversedAt        DateTime?            @map("reversed_at") @db.Timestamptz(3)
  /// REVERSED: the part of the claw-back the balance did not cover (a debt).
  reversalShortfall BigInt?              @map("reversal_shortfall")
  voidReason        String?              @map("void_reason") @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([referralId, kind], map: "referral_rewards_referral_kind_key", where: raw("(referral_id IS NOT NULL) AND (status <> 'REVERSED'::referral_reward_status)"))
  @@unique([userId, milestoneFriends], map: "referral_rewards_milestone_key", where: raw("(kind = 'MILESTONE'::referral_reward_kind) AND (status <> 'REVERSED'::referral_reward_status)"))
  @@index([userId, createdAt(sort: Desc)], map: "referral_rewards_user_idx")
  @@index([holdUntil], map: "referral_rewards_due_idx", where: raw("status = 'PENDING'::referral_reward_status"))
  @@index([creditedAt(sort: Desc)], map: "referral_rewards_credited_idx", where: raw("status = 'CREDITED'::referral_reward_status"))
  @@map("referral_rewards")
}

// ---------------------------------------------------------------------------------------------
// v1.78-social (D223, CONVENTIONS §10.75): at most SIGNUP_MAX_ACCOUNTS_PER_DEVICE accounts created per device.
// ---------------------------------------------------------------------------------------------

/// D223: the device an account was created on — HMAC-SHA-256 (hex) under the server's device key of the app's
/// `DeviceInfo.deviceKey` (itself a salted SHA-256 of ANDROID_ID / the iOS Keychain id; the raw id never leaves the
/// phone). Written once by `registerVerify`; kept when the account is deleted (deleted accounts still count).
model DeviceSignup {
  userId     String   @id @map("user_id") @db.Uuid
  deviceHash String   @map("device_hash") @db.Char(64)
  platform   String?  @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceHash, createdAt], map: "device_signups_device_idx")
  @@map("device_signups")
}

/// D223: an OWNER's exception for one device — it may create `maxAccounts` accounts instead of the default.
model DeviceSignupException {
  deviceHash  String   @id @map("device_hash") @db.Char(64)
  maxAccounts Int      @map("max_accounts")
  reason      String   @db.VarChar(500)
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  grantedBy User? @relation(fields: [grantedById], references: [id], onDelete: SetNull)

  @@map("device_signup_exceptions")
}

// ---- v1.80-kyc (D227, CONVENTIONS §10.77): identity verification with Didit «تأكيد الهوية» ---------------------

/// D227: what a check was started for (the application it belongs to).
enum KycPurpose {
  HOST_APPLICATION
  AGENCY_OPEN
  RECHARGE_AGENT

  @@map("kyc_purpose")
}

/// D227: a check's state, mapped from Didit's session status (`Not Started` → NOT_STARTED, `In Progress` /
/// `Awaiting User` / `Resubmitted` → IN_PROGRESS, `In Review`, `Approved`, `Declined`, `Expired` / `Kyc Expired` →
/// EXPIRED, `Abandoned`). An Approved session whose date of birth is under 18 is stored DECLINED (`UNDER_MIN_AGE`).
enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DECLINED
  EXPIRED
  ABANDONED

  @@map("kyc_status")
}

/// D227: the OWNER's «التحقق من الهوية (Didit)» settings — one row. The API key and the webhook secret are sealed
/// (AdminSecretBox, HKDF info `kyc-settings/v1`, per-column AAD) and write-only: only their last 4 characters, who
/// and when. The workflow ids are not secrets (Didit console ids).
model KycSettings {
  id                   Int       @id @default(1) @db.SmallInt
  enabled              Boolean   @default(false)
  apiKeyEnc            String?   @map("api_key_enc")
  apiKeyLast4          String?   @map("api_key_last4") @db.VarChar(4)
  apiKeySetById        String?   @map("api_key_set_by_id") @db.Uuid
  apiKeySetAt          DateTime? @map("api_key_set_at") @db.Timestamptz(3)
  webhookSecretEnc     String?   @map("webhook_secret_enc")
  webhookSecretLast4   String?   @map("webhook_secret_last4") @db.VarChar(4)
  webhookSecretSetById String?   @map("webhook_secret_set_by_id") @db.Uuid
  webhookSecretSetAt   DateTime? @map("webhook_secret_set_at") @db.Timestamptz(3)
  /// The default workflow (every purpose without its own).
  workflowId           String?   @map("workflow_id") @db.Uuid
  workflowIdHost       String?   @map("workflow_id_host") @db.Uuid
  workflowIdAgency     String?   @map("workflow_id_agency") @db.Uuid
  workflowIdRecharge   String?   @map("workflow_id_recharge") @db.Uuid
  /// How many checks one person may start in 24 hours (1–10).
  maxSessionsPerDay    Int       @default(3) @map("max_sessions_per_day") @db.SmallInt
  lastTestAt           DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk           Boolean?  @map("last_test_ok")
  lastTestById         String?   @map("last_test_by_id") @db.Uuid
  lastTest             Json?     @map("last_test")
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById          String?   @map("updated_by_id") @db.Uuid

  @@map("kyc_settings")
}

/// D227: one Didit verification session of a person. Only the minimum is kept: Didit's session id and number, the
/// status and decision, the warning codes (reasons), the dates, and from the document the name, the date of birth
/// (18+), the issuing country and the document number as an HMAC (never the number itself). Never an image: the
/// team sees them in Didit's console, or through a short-lived fetch from the panel (audited).
model KycCheck {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  purpose           KycPurpose
  status            KycStatus  @default(NOT_STARTED)
  /// Didit's session id (unique) and the number shown in Didit's console.
  sessionId         String     @unique(map: "kyc_checks_session_key") @map("session_id") @db.Uuid
  sessionNumber     Int?       @map("session_number")
  workflowId        String     @map("workflow_id") @db.Uuid
  /// Didit's status string as last received (e.g. `In Review`).
  providerStatus    String     @map("provider_status") @db.VarChar(32)
  /// The warnings' `risk` codes of a decline or review (and `UNDER_MIN_AGE`), at most 20.
  reasons           String[]   @default([]) @db.VarChar(64)
  fullName          String?    @map("full_name") @db.VarChar(200)
  dateOfBirth       DateTime?  @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-3 of the document's issuing state.
  documentCountry   String?    @map("document_country") @db.Char(3)
  /// HMAC-SHA-256 (hex) of `<country>:<number>` under a key derived from ADMIN_TOTP_KEY (`kyc-document/v1`).
  documentHash      String?    @map("document_hash") @db.Char(64)
  /// The same document hash is on another account's check (flagged to the team; never an automatic decline).
  duplicateDocument Boolean    @default(false) @map("duplicate_document")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt         DateTime?  @map("decided_at") @db.Timestamptz(3)
  /// The newest event applied (Didit's `created_at` of the webhook, or the sync time): older ones are ignored.
  lastEventAt       DateTime?  @map("last_event_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "kyc_checks_user_idx")
  @@index([documentHash], map: "kyc_checks_document_idx")
  @@index([status, createdAt(sort: Desc)], map: "kyc_checks_status_idx")
  @@map("kyc_checks")
}

/// D227: the webhook deliveries already applied (Didit's `event_id`; a retry reuses it): idempotency. Kept 30 days.
model KycWebhookEvent {
  eventId    String   @id @map("event_id") @db.VarChar(64)
  sessionId  String?  @map("session_id") @db.Uuid
  type       String   @db.VarChar(48)
  status     String?  @db.VarChar(32)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt], map: "kyc_webhook_events_received_idx")
  @@map("kyc_webhook_events")
}

// ---- v1.60-live (D250, CONVENTIONS §10.91): live moderation from the panel «مراقبة البث» ---------------------------

/// D250: what the team did on a live from the panel. END ends it; NO_LIVE «منع من البث» and SUSPEND «تعليق الحساب»
/// also set a D208 restriction (NO_LIVE / LOCK) until `ends_at`; DEVICE_BAN «حظر جهاز» also bans the account's
/// devices; DISMISS «تمت المراجعة — لا مخالفة» closes the live's open reports and changes nothing else.
enum LiveModerationKind {
  END
  /// v1.68-live (D273): a warning with the reason; the live goes on.
  WARN
  NO_LIVE
  SUSPEND
  DEVICE_BAN
  DISMISS

  @@map("live_moderation_kind")
}

/// D250: one action of the team on a live (audited separately; this row is the host's notification target and the
/// live's moderation history). Never deleted except with the live or the host.
model LiveModerationAction {
  id            String             @id @default(uuid(7)) @db.Uuid
  roomId        String             @map("room_id") @db.Uuid
  hostUserId    String             @map("host_user_id") @db.Uuid
  actorId       String?            @map("actor_id") @db.Uuid
  kind          LiveModerationKind
  reason        String             @db.VarChar(500)
  /// NO_LIVE / SUSPEND: the restriction's end; DEVICE_BAN: the ban's end (NULL = permanent); else NULL.
  endsAt        DateTime?          @map("ends_at") @db.Timestamptz(3)
  restrictionId String?            @map("restriction_id") @db.Uuid
  /// Whether this action ended the live (it was on air).
  endedLive     Boolean            @default(false) @map("ended_live")
  reportsClosed Int                @default(0) @map("reports_closed")
  devicesBanned Int                @default(0) @map("devices_banned")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  room          LiveRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host          User                @relation("LiveModerationHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  actor         User?               @relation("LiveModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  restriction   AccountRestriction? @relation(fields: [restrictionId], references: [id], onDelete: SetNull)
  notifications Notification[]
  deviceBans    DeviceBan[]

  @@index([roomId, createdAt(sort: Desc)], map: "live_moderation_actions_room_idx")
  @@index([hostUserId, createdAt(sort: Desc)], map: "live_moderation_actions_host_idx")
  @@map("live_moderation_actions")
}

/// D250: a banned device «حظر جهاز» — the HMAC of D223's device key (never the key). While active (not lifted, and
/// `ends_at` NULL = permanent or in the future) the device cannot sign up, sign in or go live, for any account.
model DeviceBan {
  id               String    @id @default(uuid(7)) @db.Uuid
  deviceHash       String    @map("device_hash") @db.Char(64)
  reason           String    @db.VarChar(500)
  /// The account the device was found on (the panel names the device by it).
  sourceUserId     String?   @map("source_user_id") @db.Uuid
  liveModerationId String?   @map("live_moderation_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(3)
  liftedAt         DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById       String?   @map("lifted_by_id") @db.Uuid
  liftReason       String?   @map("lift_reason") @db.VarChar(500)
  /// v1.110-social (D345, §10.144.4): the refunded store purchase that banned the device (lifted by the OWNER only).
  iapPurchaseId    String?   @map("iap_purchase_id") @db.Uuid

  iapPurchase    IapPurchase?          @relation(fields: [iapPurchaseId], references: [id], onDelete: SetNull)
  sourceUser     User?                 @relation("DeviceBanSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
  liveModeration LiveModerationAction? @relation(fields: [liveModerationId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("DeviceBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy       User?                 @relation("DeviceBanLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([deviceHash], map: "device_bans_open_idx", where: raw("lifted_at IS NULL"))
  @@index([createdAt(sort: Desc)], map: "device_bans_created_idx")
  @@map("device_bans")
}

// ---- v1.82-social (DRAFT, D252, CONVENTIONS §10.93): «شراء VIP» -------------------------------------------------------

/// D252: what a VIP purchase did — a new membership, the same tier extended, or a higher tier from now.
enum VipPurchaseKind {
  NEW
  RENEW
  UPGRADE

  @@map("vip_purchase_kind")
}

/// D252: a VIP tier, managed in the admin panel (catalog.manage). `sortOrder` 1 … n is both the order the app shows and
/// the rank (higher = higher tier). CHECK `vip_tiers_shape` (code, names, colour `#RRGGBB`, https emblem, price 1 …
/// 10^12 coins, 1 … 365 days). Never deleted: switched off (`enabled`), so memberships and purchases keep their tier.
model VipTier {
  id                     String   @id @default(uuid(7)) @db.Uuid
  code                   String   @unique(map: "vip_tiers_code_key") @db.VarChar(40)
  nameAr                 String   @map("name_ar") @db.VarChar(30)
  nameEn                 String   @map("name_en") @db.VarChar(30)
  sortOrder              Int      @map("sort_order")
  /// The tier's colour, `#RRGGBB` upper case.
  color                  String   @db.Char(7)
  /// v1.83-social (D258, §10.94.10): the special text colour of the tier's members (CHAT_NAME_COLOR: their name,
  /// chat message, banner line), `#RRGGBB`, set in the panel; one solid colour in the app. Null: none.
  nameColor              String?  @map("name_color") @db.Char(7)
  /// v1.83-social (D258, §10.94.12): percent off when renewing this tier (0 – 90; 0 = none), set in the panel.
  renewalDiscountPercent Int      @default(15) @map("renewal_discount_percent")
  /// The tier BADGE (central crest): an SVGA animation and a still, each a bundled asset path
  /// (`assets/vip/...`) or a hosted https URL. Null = the app draws a token placeholder in `color`.
  badgeAnimation         String?  @map("badge_animation") @db.VarChar(2048)
  badgeStill             String?  @map("badge_still") @db.VarChar(2048)
  priceCoins             BigInt   @map("price_coins")
  durationDays           Int      @map("duration_days")
  enabled                Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById            String?  @map("updated_by_id") @db.Uuid

  perks           VipTierPerk[]
  memberships     VipMembership[]
  purchases       VipPurchase[]
  dailyCoinClaims VipDailyCoinClaim[]

  @@index([sortOrder, id], map: "vip_tiers_sort_idx")
  @@map("vip_tiers")
}

/// D252: one perk of a tier, in order. Whether the app really does it (`available`) is the server's list, never stored.
model VipTierPerk {
  id            String  @id @default(uuid(7)) @db.Uuid
  tierId        String  @map("tier_id") @db.Uuid
  code          String  @db.VarChar(40)
  titleAr       String  @map("title_ar") @db.VarChar(40)
  titleEn       String  @map("title_en") @db.VarChar(40)
  descriptionAr String? @map("description_ar") @db.VarChar(200)
  descriptionEn String? @map("description_en") @db.VarChar(200)
  sortOrder     Int     @map("sort_order")
  enabled       Boolean @default(true)
  /// The perk's own art (avatar frame, entry bar, …): an SVGA animation and a still (asset path or https URL), plus
  /// the art's intrinsic size so the client fits it (not all square: the card is 720×1280, the entrance 660×150).
  animation     String? @db.VarChar(2048)
  still         String? @db.VarChar(2048)
  artWidth      Int?    @map("art_width")
  artHeight     Int?    @map("art_height")
  /// D258 (§10.94): the perk's number for this tier — free public messages a day (DAILY_BULLET), coins a day
  /// (DAILY_COINS), the level speed-up in percent (LEVEL_SPEEDUP); null for other perks or not set yet.
  amount        Int?

  tier VipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, code], map: "vip_tier_perks_tier_code_key")
  @@map("vip_tier_perks")
}

/// D252: a person's VIP membership (at most one; active while `expiresAt` is in the future).
model VipMembership {
  userId    String   @id @map("user_id") @db.Uuid
  tierId    String   @map("tier_id") @db.Uuid
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// v1.65-live (D264, §10.97): the VIP bag items the member took off (perk codes); a new membership starts empty.
  offPerks  String[] @default([]) @map("off_perks")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier VipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId, expiresAt], map: "vip_memberships_tier_idx")
  @@map("vip_memberships")
}

/// D252: one purchase (wallet ledger `VIP_PURCHASE`, reference = this row); the answer of an Idempotency-Key replay.
model VipPurchase {
  id                String          @id @default(uuid(7)) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  tierId            String          @map("tier_id") @db.Uuid
  kind              VipPurchaseKind
  /// The coins charged (after any renewal discount).
  priceCoins        BigInt          @map("price_coins")
  /// v1.83-social (D258): the tier's list price then, and the renewal discount applied (0 = none).
  listPriceCoins    BigInt?         @map("list_price_coins")
  discountPercent   Int             @default(0) @map("discount_percent")
  durationDays      Int             @map("duration_days")
  previousTierId    String?         @map("previous_tier_id") @db.Uuid
  previousExpiresAt DateTime?       @map("previous_expires_at") @db.Timestamptz(3)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  /// The balance right after this purchase.
  coinsAfter        BigInt          @map("coins_after")
  idempotencyKey    String?         @map("idempotency_key") @db.Uuid
  requestHash       String?         @map("request_hash") @db.Char(64)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier VipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey], map: "vip_purchases_idempotency")
  @@index([userId, createdAt(sort: Desc)], map: "vip_purchases_user_idx")
  @@map("vip_purchases")
}

/// D258 (§10.94.5): a VIP's daily coins claimed (at most one a day; the day in LIVE_RANKINGS_TIME_ZONE). The wallet
/// ledger row (`VIP_DAILY_COINS`) references this row.
model VipDailyCoinClaim {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  day       DateTime @db.Date
  tierId    String   @map("tier_id") @db.Uuid
  coins     BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier VipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([userId, day], map: "vip_daily_coin_claims_user_day_key")
  @@map("vip_daily_coin_claims")
}

/// v1.83-social (D258, CONVENTIONS §10.94.9): one row per (profile owner, visitor) — someone else opened the owner's
/// profile; `visits` counts openings at least 10 minutes apart. A VIP holding PROFILE_VISITORS lists theirs
/// («من زار ملفي»). Kept 30 days after the last visit.
model ProfileVisit {
  ownerId        String   @map("owner_id") @db.Uuid
  visitorId      String   @map("visitor_id") @db.Uuid
  firstVisitedAt DateTime @map("first_visited_at") @db.Timestamptz(3)
  lastVisitedAt  DateTime @map("last_visited_at") @db.Timestamptz(3)
  visits         Int      @default(1)

  owner   User @relation("ProfileVisitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  visitor User @relation("ProfileVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([ownerId, visitorId], map: "profile_visits_pkey")
  @@index([ownerId, lastVisitedAt(sort: Desc)], map: "profile_visits_owner_last_idx")
  @@map("profile_visits")
}

/// v1.64-live (D260, CONVENTIONS §10.96): a panel staff member's shift «في المناوبة». Lives are assigned only to
/// staff on shift; going off shift hands their lives to the others.
model AdminShift {
  userId         String    @id @map("user_id") @db.Uuid
  onShift        Boolean   @default(false) @map("on_shift")
  /// When the shift last changed (on or off).
  since          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// v1.76-live (D286, §10.96.14): `panel` | `app` (switched by hand) | `auto` (staff work); CHECK
  /// admin_shifts_started_via_values.
  startedVia     String    @default("panel") @map("started_via") @db.VarChar(8)
  /// v1.76-live (D286): the last staff work seen (at most once a minute); an `auto` shift goes off after
  /// STAFF_SHIFT_IDLE_OFF_SECONDS without any.
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onShift], map: "admin_shifts_on_idx", where: raw("on_shift"))
  @@index([lastActivityAt], map: "admin_shifts_auto_idx", where: raw("on_shift AND started_via = 'auto'"))
  @@map("admin_shifts")
}

/// v1.72-live (D283, CONVENTIONS §10.96.11): a region (a fixed group of countries, `staff-regions.ts`) a MODERATION /
/// SUPPORT staff member is responsible for. Set by the OWNER in «الموظفون والصلاحيات» (audited `admin.team.regions`).
/// The live assignment and report alerts prefer a staff member whose region covers the host's country. CHECK
/// `admin_staff_regions_code` (the 13 codes).
model AdminStaffRegion {
  userId     String   @map("user_id") @db.Uuid
  region     String   @db.VarChar(24)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, region])
  @@index([region], map: "admin_staff_regions_region_idx")
  @@map("admin_staff_regions")
}

/// v1.73-live (D283c, CONVENTIONS §10.96.12): the official staff IDs «Kabso01», «Kabso02», … — one per person, given
/// in the same transaction as their first panel role by `kabso_admin_panel_role` (the only writer: the runtime role may
/// only read this table), sequential under an advisory lock (no gaps, no duplicates). Retired, never reused: a revoke
/// keeps the row (shown again on a re-grant); a purged account leaves the number with `user_id` NULL.
model StaffId {
  number     Int      @id
  userId     String?  @unique @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("staff_ids")
}

/// v1.64-live (D260): the staff member who watches a LIVE room (one per room; removed when the live ends).
model LiveRoomAssignment {
  roomId     String   @id @map("room_id") @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  room  LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admin User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "live_room_assignments_admin_idx")
  @@map("live_room_assignments")
}

/// v1.64-live (D260): a staff member watching a live VISIBLY (`team:<adminId>:<nonce>`): listed with the
/// «فريق كابسو» badge, never a viewer (not in `live_room_viewers`, not counted in `viewer_count`).
model LiveRoomStaffWatcher {
  roomId   String   @map("room_id") @db.Uuid
  identity String   @db.VarChar(80)
  adminId  String   @map("admin_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  room  LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admin User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([roomId, identity])
  @@index([adminId], map: "live_room_staff_watchers_admin_idx")
  @@map("live_room_staff_watchers")
}

// ---- D270 (CONVENTIONS §10.98): «المتجر» ------------------------------------------------------------------------------

/// D270: what a store price is in.
enum StoreCurrency {
  COINS
  CHERRIES

  @@map("store_currency")
}

/// D270: an item on the store — a bag catalogue row (`bagCode`, `store_<12 hex>`) with its hosted art, names, order,
/// «جديد» badge, on / off and prices (per duration per currency). Never deleted (purchases point at it).
model StoreItem {
  id                 String               @id @default(uuid(7)) @db.Uuid
  bagCode            String               @unique(map: "store_items_bag_code_key") @map("bag_code") @db.VarChar(40)
  kind               BagCategory
  nameAr             String               @map("name_ar") @db.VarChar(40)
  nameEn             String               @map("name_en") @db.VarChar(40)
  /// Hosted https art: a PNG / WebP still and an SVGA or MP4 animation (MP4: `animationAlpha` set).
  still              String?              @db.VarChar(2048)
  animation          String?              @db.VarChar(2048)
  animationFormat    GiftAnimationFormat? @map("animation_format")
  animationAlpha     GiftVideoAlpha?      @map("animation_alpha")
  artWidth           Int?                 @map("art_width")
  artHeight          Int?                 @map("art_height")
  sortOrder          Int                  @map("sort_order")
  /// Deprecated v1.79-live (D289): true exactly when `badges` holds NEW (kept for a rollback).
  isNew              Boolean              @default(false) @map("is_new")
  /// v1.79-live (D289): the badges, as on gifts (CHECKs `store_items_badges_sound`, `store_items_badge_*_until`).
  badges             ItemBadge[]          @default([])
  badgeNewUntil      DateTime?            @map("badge_new_until") @db.Timestamptz(3)
  badgeLimitedUntil  DateTime?            @map("badge_limited_until") @db.Timestamptz(3)
  badgeSeasonalUntil DateTime?            @map("badge_seasonal_until") @db.Timestamptz(3)
  enabled            Boolean              @default(false)
  /// v1.79-live (D289b): «حذف من المتجر» of an item someone bought or holds — gone from the store and every listing, never
  /// sold (`enabled` false), still working for its owners until their items end; null: in the store. CHECK
  /// `store_items_hidden_off`. An item nobody bought or holds is deleted for real instead.
  hiddenAt           DateTime?            @map("hidden_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// v1.101-social (D325): an event-exclusive prize item (always off and hidden, CHECK `store_items_event_exclusive`).
  eventId            String?              @map("event_id") @db.Uuid
  event              Event?               @relation(fields: [eventId], references: [id], onDelete: Restrict)

  bagItem   BagItem          @relation(fields: [bagCode, kind], references: [code, category], onDelete: Restrict)
  prices    StoreItemPrice[]
  purchases StorePurchase[]

  @@unique([bagCode, kind], map: "store_items_bag_code_kind_key")
  @@index([kind, sortOrder, id], map: "store_items_kind_sort_idx")
  @@index([eventId], map: "store_items_event_idx", where: raw("(event_id IS NOT NULL)"))
  @@map("store_items")
}

/// D270: one price of an item (7, 14 or 30 days) in one currency.
model StoreItemPrice {
  itemId   String        @map("item_id") @db.Uuid
  currency StoreCurrency
  days     Int
  amount   BigInt

  item StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, currency, days], map: "store_item_prices_pkey")
  @@map("store_item_prices")
}

/// D270: a store purchase — for oneself or a gift (`recipientId` another person). The ledger row (`STORE_PURCHASE`
/// in the coin or the cherry ledger) references it.
model StorePurchase {
  id             String        @id @default(uuid(7)) @db.Uuid
  buyerId        String        @map("buyer_id") @db.Uuid
  recipientId    String        @map("recipient_id") @db.Uuid
  itemId         String        @map("item_id") @db.Uuid
  currency       StoreCurrency
  days           Int
  price          BigInt
  balanceAfter   BigInt        @map("balance_after")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  extended       Boolean
  idempotencyKey String?       @map("idempotency_key") @db.Uuid
  requestHash    String?       @map("request_hash") @db.Char(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  buyer     User      @relation("StorePurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  recipient User      @relation("StorePurchaseRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  item      StoreItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([buyerId, idempotencyKey], map: "store_purchases_idempotency")
  @@index([buyerId, createdAt(sort: Desc)], map: "store_purchases_buyer_idx")
  @@index([createdAt(sort: Desc), id], map: "store_purchases_created_idx")
  @@index([itemId, createdAt(sort: Desc)], map: "store_purchases_item_idx")
  @@map("store_purchases")
}

// ---- v1.75-live (D285, CONVENTIONS §10.96.13): recruitment by staff «الاستقطاب» and the creator programme ----------

/// What a recruit became: a direct host, a host agency, a recharge agent or a content creator.
enum StaffRecruitType {
  HOST
  AGENCY
  RECHARGE_AGENT
  CREATOR

  @@map("staff_recruit_type")
}

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// v1.82-live (D295): the team ended the membership this application made.
  REVOKED

  @@map("creator_application_status")
}

/// v1.82-live (D295, §10.108): who made a creator application — the person («انضم كصانع محتوى») or an agency owner who
/// activated one of the agency's members as a creator (written APPROVED at once).
enum CreatorApplicationSource {
  APPLICATION
  AGENCY

  @@map("creator_application_source")
}

/// v1.75-live (D285): an application «انضم كصانع محتوى» (the creator programme). PRIVATE (the links and the bio are
/// read only in the panel). At most one PENDING per user (partial unique); approving makes a `creator_members` row.
model CreatorApplication {
  id              String                   @id @default(uuid(7)) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  status          CreatorApplicationStatus @default(PENDING)
  country         String                   @db.Char(2)
  category        String                   @db.VarChar(24)
  links           String[]                 @db.VarChar(200)
  bio             String?                  @db.VarChar(300)
  recruiterUserId String?                  @map("recruiter_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(3)
  decidedById     String?                  @map("decided_by_id") @db.Uuid
  rejectReason    String?                  @map("reject_reason") @db.VarChar(500)
  /// v1.82-live (D295): APPLICATION (the person's own) or AGENCY (an agency owner's activation; `agency_id` set).
  source          CreatorApplicationSource @default(APPLICATION)
  agencyId        String?                  @map("agency_id") @db.Uuid
  /// v1.82-live (D295): the team ended the membership (status REVOKED).
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedById     String?                  @map("revoked_by_id") @db.Uuid
  revokeReason    String?                  @map("revoke_reason") @db.VarChar(500)

  user      User           @relation("CreatorApplicant", fields: [userId], references: [id], onDelete: Cascade)
  agency    Agency?        @relation("CreatorActivatingAgency", fields: [agencyId], references: [id], onDelete: SetNull)
  revokedBy User?          @relation("CreatorMembershipRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  decidedBy User?          @relation("CreatorApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  recruiter User?          @relation("CreatorApplicationRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)
  member    CreatorMember?

  @@unique([userId], map: "creator_applications_one_pending", where: raw("status = 'PENDING'::creator_application_status"))
  @@index([userId, createdAt(sort: Desc)], map: "creator_applications_user_idx")
  @@index([status, createdAt(sort: Desc)], map: "creator_applications_status_idx")
  @@index([agencyId, createdAt(sort: Desc)], map: "creator_applications_agency_idx", where: raw("agency_id IS NOT NULL"))
  @@map("creator_applications")
}

/// v1.75-live (D285): a member of the creator programme (from the approval on).
model CreatorMember {
  userId        String   @id @map("user_id") @db.Uuid
  applicationId String   @unique(map: "creator_members_application_key") @map("application_id") @db.Uuid
  activatedAt   DateTime @map("activated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application CreatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("creator_members")
}

/// v1.75-live (D285): a recruit permanently attributed to the staff member who referred them, made when the
/// application was ACTIVATED (approved; an agency at its opening). One per (type, recruit); a person is a HOST or a
/// CREATOR recruit, not both (`staff_recruitments_one_gift_recruit`). The recruiter changes only by the OWNER in the
/// panel, with a reason (audited).
model StaffRecruitment {
  id              String           @id @default(uuid(7)) @db.Uuid
  type            StaffRecruitType
  recruiterUserId String           @map("recruiter_user_id") @db.Uuid
  recruitUserId   String           @map("recruit_user_id") @db.Uuid
  /// The application that named the recruiter (agency / recharge / host / creator application id).
  applicationId   String           @map("application_id") @db.Uuid
  /// The agency (AGENCY), else null.
  agencyId        String?          @map("agency_id") @db.Uuid
  activatedAt     DateTime         @map("activated_at") @db.Timestamptz(3)
  reassignedAt    DateTime?        @map("reassigned_at") @db.Timestamptz(3)
  reassignedById  String?          @map("reassigned_by_id") @db.Uuid
  reassignReason  String?          @map("reassign_reason") @db.VarChar(500)

  recruiter   User                     @relation("StaffRecruiter", fields: [recruiterUserId], references: [id], onDelete: Cascade)
  recruit     User                     @relation("StaffRecruit", fields: [recruitUserId], references: [id], onDelete: Cascade)
  commissions StaffRecruitCommission[]

  @@unique([type, recruitUserId], map: "staff_recruitments_type_recruit_key")
  @@unique([recruitUserId], map: "staff_recruitments_one_gift_recruit", where: raw("type IN ('HOST'::staff_recruit_type, 'CREATOR'::staff_recruit_type)"))
  @@index([recruiterUserId, type, activatedAt(sort: Desc)], map: "staff_recruitments_recruiter_idx")
  @@map("staff_recruitments")
}

/// v1.75-live (D285): the OWNER's commission shares per recruit type (one row, id 1), basis points of the profit.
model StaffRecruitSettings {
  id          Int      @id @default(1) @db.SmallInt
  hostBps     Int      @default(100) @map("host_bps")
  creatorBps  Int      @default(100) @map("creator_bps")
  agencyBps   Int      @default(100) @map("agency_bps")
  rechargeBps Int      @default(75) @map("recharge_bps")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("staff_recruit_settings")
}

/// v1.75-live (D285): one recruitment's commission of one day (the programs' day), written once by the daily job:
/// the platform profit counted (money units, D281), the share in effect, the cherries credited — never more than that
/// share of the profit (CHECK `staff_recruit_commissions_guard`). `skipped` when nothing was paid for a reason
/// (`RECRUITER_INACTIVE`).
model StaffRecruitCommission {
  recruitmentId   String           @map("recruitment_id") @db.Uuid
  day             DateTime         @db.Date
  type            StaffRecruitType
  recruiterUserId String           @map("recruiter_user_id") @db.Uuid
  recruitUserId   String           @map("recruit_user_id") @db.Uuid
  profitUnits     Decimal          @map("profit_units") @db.Decimal(40, 0)
  rateCherries    BigInt           @map("rate_cherries")
  rateMinor       Int              @map("rate_minor")
  bps             Int
  cherries        BigInt
  skipped         String?          @db.VarChar(24)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recruitment StaffRecruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  recruiter   User             @relation(fields: [recruiterUserId], references: [id], onDelete: Cascade)

  @@id([recruitmentId, day], map: "staff_recruit_commissions_pkey")
  @@index([recruiterUserId, day(sort: Desc)], map: "staff_recruit_commissions_recruiter_idx")
  @@index([day], map: "staff_recruit_commissions_day_idx")
  @@map("staff_recruit_commissions")
}

// ---- v1.108-social (D343, CONVENTIONS §10.142): the sign-up code «رمز الدعوة أو رمز المشرف» -------------------------

/// D343: whether a sign-up's attribution earns its credit (GRANTED) or was withheld with a reason (WITHHELD).
enum SignupCreditStatus {
  GRANTED
  WITHHELD

  @@map("signup_credit_status")
}

/// D343: an account created with a supervisor's staff ID (one row per account, never changed): the supervisor, the
/// staff ID as typed, and whether the recruit counts — WITHHELD (`withholdReason` DEVICE_HAD_ACCOUNT, EMAIL_HAD_ACCOUNT,
/// RECRUITER_INACTIVE) when the person is not a new person or the supervisor could not recruit any more. A GRANTED
/// row is the person's recruiter on their later host / creator / agency / recharge-agent application (D285).
model StaffSignupRecruit {
  userId          String             @id @map("user_id") @db.Uuid
  recruiterUserId String             @map("recruiter_user_id") @db.Uuid
  code            String             @db.VarChar(16)
  status          SignupCreditStatus
  withholdReason  String?            @map("withhold_reason") @db.VarChar(32)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User @relation("StaffSignupRecruit", fields: [userId], references: [id], onDelete: Cascade)
  recruiter User @relation("StaffSignupRecruiter", fields: [recruiterUserId], references: [id], onDelete: Cascade)

  @@index([recruiterUserId, createdAt(sort: Desc)], map: "staff_signup_recruits_recruiter_idx")
  @@index([status, createdAt(sort: Desc)], map: "staff_signup_recruits_status_idx")
  @@map("staff_signup_recruits")
}

/// D343: HMAC-SHA-256 (server key, HKDF info `signup-email/v1`) of the canonical mailbox an account was created with —
/// never the address. Kept while the account exists and SIGNUP_IDENTITY_RETENTION_DAYS after its purge (`purgedAt`),
/// then deleted by the referral sweeper. Read only by the sign-up credit check («ليس شخصاً جديداً»).
model SignupEmailMark {
  userId    String    @id @map("user_id") @db.Uuid
  emailHash String    @map("email_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  purgedAt  DateTime? @map("purged_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailHash], map: "signup_email_marks_hash_idx")
  @@index([purgedAt], map: "signup_email_marks_purged_idx", where: raw("purged_at IS NOT NULL"))
  @@map("signup_email_marks")
}

// ---- v1.89-social (D290, CONVENTIONS §10.103): level-raise requests «طلب رفع ليفيل» ------------------------------------

enum LevelRaiseStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("level_raise_status")
}

/// v1.89-social (D290): a source app's data for the proposal (admin-editable, OWNER). MONEY: price of 1 000 000 coins
/// (USD cents), coins per XP (× 1 000) and the known XP-table points (`xp_table`: [{level, xp, confidence}]). FACTOR:
/// a conservative `factor_milli` (500 = × 0.5). `confidence` CONFIRMED only with a source (owner or a cited page).
/// Exactly one row is the default for an app not in the list (`is_other`).
model LevelRaiseSourceApp {
  id                 String    @id @default(uuid(7)) @db.Uuid
  code               String    @unique @db.VarChar(32)
  nameAr             String    @map("name_ar") @db.VarChar(60)
  nameEn             String    @map("name_en") @db.VarChar(60)
  mode               String    @db.VarChar(8)
  usdPerMillionCents BigInt?   @map("usd_per_million_cents")
  coinsPerXpMilli    BigInt?   @map("coins_per_xp_milli")
  xpTable            Json      @default("[]") @map("xp_table")
  factorMilli        Int?      @map("factor_milli")
  confidence         String    @db.VarChar(10)
  /// v1.89-social (D290): other spellings matched by the name suggestion (Zafa / زفة / Zafa Live …).
  aliases            String[]  @default([]) @db.VarChar(60)
  sourceNote         String    @default("") @map("source_note") @db.VarChar(1000)
  sourceUrl          String?   @map("source_url") @db.VarChar(500)
  sourceDate         DateTime? @map("source_date") @db.Date
  enabled            Boolean   @default(true)
  isOther            Boolean   @default(false) @map("is_other")
  sort               Int       @default(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById        String?   @map("updated_by_id") @db.Uuid

  requests LevelRaiseRequest[]

  @@map("level_raise_source_apps")
}

/// v1.89-social (D290): the proposal's weights (one row, id 1; OWNER-editable, audited).
model LevelRaiseSettings {
  id                       Int      @id @default(1) @db.SmallInt
  minRechargeCoins         BigInt   @default(1000000) @map("min_recharge_coins")
  firstDays                Int      @default(7) @map("first_days")
  anchorCoins              BigInt   @default(1000000) @map("anchor_coins")
  firstDaysBaseLevel       Int      @default(20) @map("first_days_base_level")
  totalBaseLevel           Int      @default(15) @map("total_base_level")
  levelsPerDoublingTenths  Int      @default(40) @map("levels_per_doubling_tenths")
  supportBonusPer10        Int      @default(1) @map("support_bonus_per_10")
  supportBonusMax          Int      @default(2) @map("support_bonus_max")
  charmBonusPer10          Int      @default(1) @map("charm_bonus_per_10")
  charmBonusMax            Int      @default(2) @map("charm_bonus_max")
  belowTableExponentTenths Int      @default(30) @map("below_table_exponent_tenths")
  updatedAt                DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById              String?  @map("updated_by_id") @db.Uuid

  @@map("level_raise_settings")
}

/// v1.89-social (D290): a staff member's (MODERATION / SUPPORT, app or panel) request to raise a supporter's support
/// level, with the source app's video; the OWNER approves (≤ the proposal, ≤ 40, ≥ the current level) or rejects it.
/// One PENDING per supporter. On approval the level is raised through the levels engine (an ADJUSTMENT ledger entry,
/// `ledger_entry_id`); `proposal` keeps the proposal and its inputs as decided.
model LevelRaiseRequest {
  id                 String           @id @default(uuid(7)) @db.Uuid
  supporterUserId    String           @map("supporter_user_id") @db.Uuid
  requestedById      String           @map("requested_by_id") @db.Uuid
  via                String           @db.VarChar(8)
  sourceAppId        String?          @map("source_app_id") @db.Uuid
  sourceAppName      String           @map("source_app_name") @db.VarChar(60)
  sourceAccountId    String           @map("source_account_id") @db.VarChar(64)
  sourceLevel        Int              @map("source_level")
  /// The video's asset while it exists; NULL once deleted after the decision (owner: the video goes, the evidence stays).
  videoMediaId       String?          @unique @map("video_media_id") @db.Uuid
  /// The video's evidence, kept after its deletion: the asset id, length, size and display size.
  videoAssetId       String           @map("video_asset_id") @db.Uuid
  videoDurationMs    Int?             @map("video_duration_ms")
  videoByteSize      Int              @map("video_byte_size")
  videoWidth         Int              @map("video_width")
  videoHeight        Int              @map("video_height")
  /// Set at the decision; the media sweeper deletes the objects and the asset row (retried until it succeeds).
  videoDeletedAt     DateTime?        @map("video_deleted_at") @db.Timestamptz(3)
  /// The canonical source app (`APP:<code>`, or `NAME:<normalized name>` for an app not in the list) and the account ID
  /// trimmed and lower-cased: unique among PENDING / APPROVED requests (`level_raise_requests_source_once`).
  sourceAppKey       String           @map("source_app_key") @db.VarChar(80)
  sourceAccountKey   String           @map("source_account_key") @db.VarChar(64)
  /// The latest REJECTED request for the same source account when this one was made («سبق رفض طلب بنفس الحساب»).
  previousRejectedId String?          @map("previous_rejected_id") @db.Uuid
  note               String?          @db.VarChar(500)
  status             LevelRaiseStatus @default(PENDING)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedById        String?          @map("decided_by_id") @db.Uuid
  rejectReason       String?          @map("reject_reason") @db.VarChar(500)
  proposedLevel      Int?             @map("proposed_level")
  approvedLevel      Int?             @map("approved_level")
  levelBefore        Int?             @map("level_before")
  levelAfter         Int?             @map("level_after")
  ledgerEntryId      String?          @map("ledger_entry_id") @db.Uuid
  proposal           Json?

  supporter        User                 @relation("LevelRaiseSupporter", fields: [supporterUserId], references: [id], onDelete: Cascade)
  requestedBy      User                 @relation("LevelRaiseRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy        User?                @relation("LevelRaiseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  sourceApp        LevelRaiseSourceApp? @relation(fields: [sourceAppId], references: [id], onDelete: SetNull)
  video            MediaAsset?          @relation(fields: [videoMediaId], references: [id], onDelete: SetNull)
  previousRejected LevelRaiseRequest?   @relation("LevelRaisePreviousRejection", fields: [previousRejectedId], references: [id], onDelete: SetNull)
  laterRequests    LevelRaiseRequest[]  @relation("LevelRaisePreviousRejection")
  notifications    Notification[]

  @@unique([sourceAppKey, sourceAccountKey], map: "level_raise_requests_source_once", where: raw("status IN ('PENDING'::level_raise_status, 'APPROVED'::level_raise_status)"))
  @@index([status, createdAt(sort: Desc)], map: "level_raise_requests_status_idx")
  @@index([requestedById, createdAt(sort: Desc)], map: "level_raise_requests_requester_idx")
  @@index([supporterUserId, createdAt(sort: Desc)], map: "level_raise_requests_supporter_idx")
  @@index([sourceAppKey, sourceAccountKey], map: "level_raise_requests_source_idx")
  @@map("level_raise_requests")
}

// ---- v1.90-social (D293, CONVENTIONS §10.105): automatic verification badges «شارة التوثيق» ---------------------

/// D293: the badge a person shows beside their name — granted automatically by conditions, highest first: OWNER
/// (black and gold), STAFF (red: the Kabso Team), RECHARGE_AGENT (gold), HOST_AGENT (green), CREATOR (purple),
/// VERIFIED_HOST (blue). One per person.
enum VerificationBadge {
  OWNER
  STAFF
  RECHARGE_AGENT
  HOST_AGENT
  CREATOR
  VERIFIED_HOST

  @@map("verification_badge")
}

/// D293: a person's current badge (no row = none), written only by `verification-badges.ts` (the sweeper and the
/// immediate recomputes). `since` = when this badge was granted; `computedAt` = the last evaluation that kept it.
model UserVerificationBadge {
  userId     String            @id @map("user_id") @db.Uuid
  badge      VerificationBadge
  since      DateTime          @map("since") @db.Timestamptz(3)
  computedAt DateTime          @map("computed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([badge], map: "user_verification_badges_badge_idx")
  @@map("user_verification_badges")
}

/// D293: the OWNER's thresholds (one row, id 1; panel-editable with the code, audited). "More than": a value equal
/// to its threshold does not qualify. The window is the last 30 days (rolling, the owner's decision, not a setting).
model VerificationBadgeSettings {
  id                    Int       @id @default(1) @db.SmallInt
  /// Gold: coins the recharge agent sold (direct sales + completed orders) in the window, more than this.
  rechargeMinSalesCoins BigInt    @default(300000000) @map("recharge_min_sales_coins")
  /// Gold: cherries the recharge agent bought from hosts (confirmed cherry purchases) in the window, more than this.
  rechargeMinCherries   BigInt    @default(300000000) @map("recharge_min_cherries")
  /// Green: the host agent's agency has more than this many active hosts now.
  hostAgentMinHosts     Int       @default(30) @map("host_agent_min_hosts")
  /// Green: the cherries the agency's hosts received (agency earnings) in the window, more than this.
  hostAgentMinCherries  BigInt    @default(300000000) @map("host_agent_min_cherries")
  /// The last full recompute (the sweeper, the CLI or a settings change).
  lastRunAt             DateTime? @map("last_run_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById           String?   @map("updated_by_id") @db.Uuid

  @@map("verification_badge_settings")
}

/// v1.82-live (D295, §10.108): «حظر الوكالة — تفعيل صانع محتوى وهمي» (OWNER, the code again and a reason). One row per
/// banned agency (a second ban changes nothing): the agency closed BANNED, the owner's unwithdrawn agency commission
/// forfeited (`AGENCY_FORFEIT`, `forfeited_cherries` ≤ `commission_cherries`), the creator activations concerned revoked.
/// Append-only for the runtime group.
model AgencyBan {
  agencyId           String   @id @map("agency_id") @db.Uuid
  ownerUserId        String   @map("owner_user_id") @db.Uuid
  bannedById         String?  @map("banned_by_id") @db.Uuid
  reason             String   @db.VarChar(500)
  /// The owner's agency and parent commission from this agency (net of reversals) at the ban.
  commissionCherries BigInt   @map("commission_cherries")
  forfeitedCherries  BigInt   @map("forfeited_cherries")
  creatorUserIds     String[] @default([]) @map("creator_user_ids") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  owner    User   @relation("AgencyBanOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  bannedBy User?  @relation("AgencyBanBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@index([ownerUserId], map: "agency_bans_owner_idx")
  @@map("agency_bans")
}

// ---------------------------------------------------------------------------------------------
// v1.95-social (D301, CONVENTIONS §10.112): the app owner's profile «صفحة صاحب البرنامج». Owner: `owner-profile`.

/// One cover video per owner and language (`ar` / `en`); the asset is a `PROFILE_COVER_VIDEO`.
model OwnerCoverVideo {
  userId  String   @map("user_id") @db.Uuid
  lang    String   @db.VarChar(2)
  mediaId String   @unique(map: "owner_cover_videos_media_once") @map("media_id") @db.Uuid
  setAt   DateTime @default(now()) @map("set_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, lang], map: "owner_cover_videos_pkey")
  @@map("owner_cover_videos")
}

/// v1.98-social (D307, §10.112.11): the owner's bilingual bio (Arabic, English), each ≤ 300 code points or null; shown
/// only while the account is the owner. CHECK `owner_bios_shape` in the migration.
model OwnerBio {
  userId    String   @id(map: "owner_bios_pkey") @map("user_id") @db.Uuid
  bioAr     String?  @map("bio_ar")
  bioEn     String?  @map("bio_en")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_bios")
}

/// «رحلة Kabso»: an owner's milestone (≤ 30 per owner; at most one `latest`). CHECKs in the migration.
model OwnerJourneyMilestone {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  titleAr   String   @map("title_ar") @db.VarChar(60)
  titleEn   String   @map("title_en") @db.VarChar(60)
  lineAr    String?  @map("line_ar") @db.VarChar(120)
  lineEn    String?  @map("line_en") @db.VarChar(120)
  year      Int      @db.SmallInt
  month     Int      @db.SmallInt
  icon      String   @db.VarChar(16)
  latest    Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId], map: "owner_journey_one_latest", where: raw("latest"))
  @@index([ownerId, position], map: "owner_journey_owner_position_idx")
  @@map("owner_journey_milestones")
}

/// «اقترح ميزة / أبلغ عن موظف» → «صندوق المؤسس» (OWNER only). Pictures are private keys
/// (`private/owner-feedback/{id}/{n}.webp`). CHECKs in the migration.
model OwnerFeedback {
  id          String    @id @default(uuid(7)) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  /// `FEATURE` or `STAFF_REPORT`.
  kind        String    @db.VarChar(16)
  text        String    @db.VarChar(1000)
  /// STAFF_REPORT: the Kabso Team account reported (never notified).
  staffUserId String?   @map("staff_user_id") @db.Uuid
  category    String?   @db.VarChar(24)
  imageKeys   String[]  @default([]) @map("image_keys") @db.VarChar(160)
  /// `NEW`, `READ`, `DONE`.
  status      String    @default("NEW") @db.VarChar(8)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  doneAt      DateTime? @map("done_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  sender        User           @relation("OwnerFeedbackSender", fields: [senderId], references: [id], onDelete: Cascade)
  staff         User?          @relation("OwnerFeedbackStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "owner_feedback_created_idx")
  @@index([senderId, createdAt], map: "owner_feedback_sender_created_idx")
  @@map("owner_feedback")
}

/// v1.95-social (D301 follow-up, §10.112.7): the fan-out of an official announcement's notification to every ACTIVE
/// account, in batches after the request (`cursor_user_id`: the last account written; resumable and idempotent).
model OwnerAnnouncementFanout {
  postId       String    @id @map("post_id") @db.Uuid
  cursorUserId String?   @map("cursor_user_id") @db.Uuid
  recipients   Int       @default(0)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  doneAt       DateTime? @map("done_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([startedAt], map: "owner_announcement_fanouts_pending_idx", where: raw("done_at IS NULL"))
  @@map("owner_announcement_fanouts")
}

/// v1.95-social (D301 follow-up, §10.112.10): the owner's fixed monthly costs «تكاليف ثابتة» (USD), prorated by day in
/// «الربح». CHECK `owner_fixed_costs_shape` in the migration.
model OwnerFixedCost {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @db.VarChar(60)
  monthlyMinor BigInt    @map("monthly_minor")
  currency     String    @default("USD") @db.Char(3)
  activeFrom   DateTime  @map("active_from") @db.Date
  activeTo     DateTime? @map("active_to") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([activeFrom, activeTo], map: "owner_fixed_costs_active_idx")
  @@map("owner_fixed_costs")
}

/// v1.97-social (D303 follow-ups, owner: «ميداليات كجوائز» with levels; CONVENTIONS §10.114.8): an event medal «وسام
/// فعالية», made by the team (panel or app) and reusable across events; each level has its own uploaded art
/// (`event_badge_levels`); a prize line gives one level for N days.
model EventBadge {
  code        String   @id @db.VarChar(40)
  nameAr      String   @map("name_ar") @db.VarChar(40)
  nameEn      String   @map("name_en") @db.VarChar(40)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  levels  EventBadgeLevel[]
  holders UserEventBadge[]

  @@map("event_badges")
}

/// v1.97-social (D303 follow-up): one level of an event medal and its art (`media/events/badge/<id>.webp`, 512 × 512,
/// transparent — the published spec).
model EventBadgeLevel {
  badgeCode String @map("badge_code") @db.VarChar(40)
  level     Int    @db.SmallInt
  imageKey  String @map("image_key") @db.VarChar(200)

  badge EventBadge @relation(fields: [badgeCode], references: [code], onDelete: Cascade)

  @@id([badgeCode, level], map: "event_badge_levels_pkey")
  @@map("event_badge_levels")
}

/// v1.97-social (D303 follow-up): an event medal a person holds until `expires_at`, at `level` (a new prize of the same
/// medal adds its days and keeps the higher level); shown with the medals while it lasts; the events sweeper deletes
/// rows a day after they end.
model UserEventBadge {
  userId    String    @map("user_id") @db.Uuid
  badgeCode String    @map("badge_code") @db.VarChar(40)
  level     Int       @default(1) @db.SmallInt
  /// Null = permanent «دائم» (owner, D303 follow-up).
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  eventId   String?   @map("event_id") @db.Uuid

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge EventBadge @relation(fields: [badgeCode], references: [code], onDelete: Cascade)
  event Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@id([userId, badgeCode], map: "user_event_badges_pkey")
  @@index([expiresAt], map: "user_event_badges_expires_idx")
  @@map("user_event_badges")
}

/// v1.99-social (D311, CONVENTIONS §10.117; owner: «يمكنه حذف او حظر او تحذير اي شخص»): «إجراءات المؤسس» — one row per
/// founder action taken in the app (WARN, SUSPEND «حظر مؤقت», BAN «حظر دائم», DELETE_ACCOUNT), keyed by the request's
/// `clientId` so a retry returns the first result instead of acting twice. The audit trail (`owner.moderation.action` and
/// the reused panel actions' own rows) is in `audit_logs`. CHECKs `owner_moderation_actions_shape`.
model OwnerModerationAction {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorId    String    @map("actor_id") @db.Uuid
  targetId   String    @map("target_id") @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  /// WARN | SUSPEND | BAN | DELETE_ACCOUNT.
  action     String    @db.VarChar(20)
  reason     String    @db.VarChar(500)
  /// SUSPEND only: the length in days, and its end.
  days       Int?
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(3)
  /// DELETE_ACCOUNT only: when the grace period ends and the account is purged.
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  User @relation("OwnerModerationActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User @relation("OwnerModerationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, clientId], map: "owner_moderation_actions_client_once")
  @@index([targetId, createdAt(sort: Desc)], map: "owner_moderation_actions_target_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "owner_moderation_actions_actor_idx")
  @@map("owner_moderation_actions")
}

/// v1.88-live (D315, CONVENTIONS §10.120; owner: «مجنون اللعب»): game tickets «التذاكر» SPENT in a game — the ledger the
/// first game writes through `recordGameTicketSpendIn` (once per `(game_code, reference)`, in the game's own
/// transaction that debits the tickets). No game exists yet; the board reads the rollups below. CHECK
/// `game_ticket_spends_shape` (tickets > 0, codes and references well-formed).
model GameTicketSpend {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  gameCode  String   @map("game_code") @db.VarChar(40)
  tickets   BigInt
  reference String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameCode, reference], map: "game_ticket_spends_reference_once")
  @@index([userId, createdAt(sort: Desc)], map: "game_ticket_spends_user_idx")
  @@map("game_ticket_spends")
}

/// v1.88-live (D315): tickets spent per user and UTC hour (the hour / day / week boards; kept 15 days, like
/// `live_host_points_hourly`). CHECK `game_ticket_spends_hourly_tickets` (>= 0).
model GameTicketSpendHourly {
  userId    String   @map("user_id") @db.Uuid
  hourStart DateTime @map("hour_start") @db.Timestamptz(3)
  tickets   BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, hourStart], map: "game_ticket_spends_hourly_pkey")
  @@index([hourStart], map: "game_ticket_spends_hourly_hour_idx")
  @@map("game_ticket_spends_hourly")
}

/// v1.88-live (D315): tickets spent per user and local month (the month / year boards; kept 400 days). CHECK
/// `game_ticket_spends_monthly_tickets` (>= 0).
model GameTicketSpendMonthly {
  userId     String   @map("user_id") @db.Uuid
  monthStart DateTime @map("month_start") @db.Timestamptz(3)
  tickets    BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, monthStart], map: "game_ticket_spends_monthly_pkey")
  @@index([monthStart], map: "game_ticket_spends_monthly_month_idx")
  @@map("game_ticket_spends_monthly")
}

/// v1.90-live (D320, CONVENTIONS §10.124): the coin value of the gifts a user SENT per UTC hour — «الأغنى» (the
/// Richest board); kept 15 days. CHECK `gift_coins_sent_hourly_coins` (>= 0).
model GiftCoinsSentHourly {
  userId    String   @map("user_id") @db.Uuid
  hourStart DateTime @map("hour_start") @db.Timestamptz(3)
  coins     BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, hourStart], map: "gift_coins_sent_hourly_pkey")
  @@index([hourStart], map: "gift_coins_sent_hourly_hour_idx")
  @@map("gift_coins_sent_hourly")
}

/// v1.90-live (D320): the same per local month (the month / year boards; kept 400 days). CHECK
/// `gift_coins_sent_monthly_coins` (>= 0).
model GiftCoinsSentMonthly {
  userId     String   @map("user_id") @db.Uuid
  monthStart DateTime @map("month_start") @db.Timestamptz(3)
  coins      BigInt   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, monthStart], map: "gift_coins_sent_monthly_pkey")
  @@index([monthStart], map: "gift_coins_sent_monthly_month_idx")
  @@map("gift_coins_sent_monthly")
}

// ---- v1.110-social (D345, CONVENTIONS §10.144): coins from the stores «الشراء من المتجر» ------------------------------

/// D345: the store a purchase was made in.
enum IapPlatform {
  GOOGLE_PLAY
  APP_STORE

  @@map("iap_platform")
}

/// D345: a real purchase, or a sandbox / licence-tester one (accepted while STORE_IAP_ACCEPT_SANDBOX).
enum IapEnvironment {
  PRODUCTION
  SANDBOX

  @@map("iap_environment")
}

/// D345: CREDITED (coins given), REJECTED (verified but not credited: the once-per-account+device rule on Google),
/// REFUNDED (the store refunded it; the coins were taken back).
enum IapPurchaseStatus {
  CREDITED
  REJECTED
  REFUNDED

  @@map("iap_purchase_status")
}

/// D345: what became of an Apple CONSUMPTION_REQUEST.
enum IapConsumptionStatus {
  PENDING
  SENT
  SKIPPED_NO_CONSENT
  SKIPPED_UNKNOWN
  FAILED

  @@map("iap_consumption_status")
}

/// D345: a store product id (Play Console / App Store Connect) and the coins it gives. Managed by the OWNER; never
/// deleted (switched off).
model IapProduct {
  id                String      @id @default(uuid(7)) @db.Uuid
  platform          IapPlatform
  productId         String      @map("product_id") @db.VarChar(150)
  coins             BigInt
  /// The reference price in US cents (the panel; the lifetime amounts of a consumption request's context).
  referenceUsdCents Int?        @map("reference_usd_cents")
  sortOrder         Int         @default(0) @map("sort_order")
  enabled           Boolean     @default(true)
  createdById       String?     @map("created_by_id") @db.Uuid
  updatedById       String?     @map("updated_by_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)

  purchases IapPurchase[]

  @@unique([platform, productId], map: "iap_products_platform_product_key")
  @@map("iap_products")
}

/// D345: one verified store purchase (one row per store transaction: Google orderId or the token hash, Apple
/// transactionId). Kept with the ledger (financial / anti-fraud record).
model IapPurchase {
  id                    String            @id @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  platform              IapPlatform
  storeProductId        String            @map("store_product_id") @db.Uuid
  productId             String            @map("product_id") @db.VarChar(150)
  coins                 BigInt
  /// Google `orderId` (or `token:<sha256>` for a test purchase without one); Apple `transactionId`.
  transactionId         String            @map("transaction_id") @db.VarChar(200)
  originalTransactionId String?           @map("original_transaction_id") @db.VarChar(200)
  /// Google's purchase token (needed to consume it and to match a void) and its SHA-256.
  purchaseToken         String?           @map("purchase_token")
  purchaseTokenHash     String?           @map("purchase_token_hash") @db.Char(64)
  environment           IapEnvironment
  status                IapPurchaseStatus
  rejectReason          String?           @map("reject_reason") @db.VarChar(32)
  /// D223's device HMAC of the buyer's phone (never shown).
  deviceHash            String?           @map("device_hash") @db.Char(64)
  priceMilli            BigInt?           @map("price_milli")
  currency              String?           @db.Char(3)
  purchasedAt           DateTime          @map("purchased_at") @db.Timestamptz(3)
  creditedAt            DateTime?         @map("credited_at") @db.Timestamptz(3)
  consumedAt            DateTime?         @map("consumed_at") @db.Timestamptz(3)
  consentVersion        String            @map("consent_version") @db.VarChar(32)
  consentAt             DateTime          @map("consent_at") @db.Timestamptz(3)
  consentShareData      Boolean           @map("consent_share_data")
  consentLocale         String?           @map("consent_locale") @db.VarChar(8)
  refundedAt            DateTime?         @map("refunded_at") @db.Timestamptz(3)
  refundSource          String?           @map("refund_source") @db.VarChar(32)
  refundReason          String?           @map("refund_reason") @db.VarChar(500)
  refundDetail          Json?             @map("refund_detail")
  coinsReversed         BigInt            @default(0) @map("coins_reversed")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  product      IapProduct              @relation(fields: [storeProductId], references: [id], onDelete: Restrict)
  refundBan    IapRefundBan?
  deviceBans   DeviceBan[]
  consumptions IapConsumptionRequest[]

  @@unique([platform, transactionId], map: "iap_purchases_transaction_key")
  @@unique([platform, purchaseTokenHash], map: "iap_purchases_token_key")
  @@index([userId, createdAt(sort: Desc)], map: "iap_purchases_user_idx")
  @@index([deviceHash], map: "iap_purchases_device_idx", where: raw("device_hash IS NOT NULL"))
  @@index([createdAt(sort: Desc)], map: "iap_purchases_created_idx")
  @@index([platform, consumedAt], map: "iap_purchases_unconsumed_idx", where: raw("consumed_at IS NULL AND status = 'CREDITED'"))
  @@map("iap_purchases")
}

/// D345: a store server notification applied once (Apple notificationUUID, Google Pub/Sub messageId).
model IapNotification {
  id             String      @id @default(uuid(7)) @db.Uuid
  platform       IapPlatform
  notificationId String      @map("notification_id") @db.VarChar(200)
  type           String      @db.VarChar(64)
  subtype        String?     @db.VarChar(64)
  transactionId  String?     @map("transaction_id") @db.VarChar(200)
  outcome        String      @db.VarChar(64)
  receivedAt     DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([platform, notificationId], map: "iap_notifications_once")
  @@index([receivedAt(sort: Desc)], map: "iap_notifications_received_idx")
  @@map("iap_notifications")
}

/// D345: an Apple CONSUMPTION_REQUEST and the consumption information answered (only with the buyer's consent).
model IapConsumptionRequest {
  id             String               @id @default(uuid(7)) @db.Uuid
  notificationId String               @unique(map: "iap_consumption_requests_notification_key") @map("notification_id") @db.VarChar(200)
  purchaseId     String?              @map("purchase_id") @db.Uuid
  transactionId  String               @map("transaction_id") @db.VarChar(200)
  status         IapConsumptionStatus
  payload        Json?
  context        Json?
  attempts       Int                  @default(0)
  lastError      String?              @map("last_error") @db.VarChar(300)
  receivedAt     DateTime             @map("received_at") @db.Timestamptz(3)
  deadlineAt     DateTime             @map("deadline_at") @db.Timestamptz(3)
  sentAt         DateTime?            @map("sent_at") @db.Timestamptz(3)

  purchase IapPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([status, deadlineAt], map: "iap_consumption_requests_pending_idx", where: raw("status = 'PENDING'"))
  @@map("iap_consumption_requests")
}

/// D345: the automatic ban of a refunded store purchase — the account (SUSPENDED) and the device (`device_bans`). The
/// reason is the panel's «استرداد عبر … بتاريخ … طلب …». Lifted by the OWNER only («فك الحظر»).
model IapRefundBan {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  purchaseId        String    @unique(map: "iap_refund_bans_purchase_key") @map("purchase_id") @db.Uuid
  reason            String    @db.VarChar(500)
  accountBanned     Boolean   @map("account_banned")
  devicesBanned     Int       @default(0) @map("devices_banned")
  accountLiftedAt   DateTime? @map("account_lifted_at") @db.Timestamptz(3)
  accountLiftedBy   String?   @map("account_lifted_by") @db.Uuid
  accountLiftReason String?   @map("account_lift_reason") @db.VarChar(500)
  deviceLiftedAt    DateTime? @map("device_lifted_at") @db.Timestamptz(3)
  deviceLiftedBy    String?   @map("device_lifted_by") @db.Uuid
  deviceLiftReason  String?   @map("device_lift_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase IapPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([userId], map: "iap_refund_bans_user_idx")
  @@index([createdAt(sort: Desc)], map: "iap_refund_bans_created_idx")
  @@map("iap_refund_bans")
}

/// D345: the store settings (one row, id 1): the once-per-account+device switch and the voided-purchases poll state.
model IapSettings {
  id                   Int       @id @default(1)
  oncePerAccountDevice Boolean   @default(false) @map("once_per_account_device")
  updatedById          String?   @map("updated_by_id") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  voidedPolledUntil    DateTime? @map("voided_polled_until") @db.Timestamptz(3)
  voidedLastRunAt      DateTime? @map("voided_last_run_at") @db.Timestamptz(3)
  voidedLastError      String?   @map("voided_last_error") @db.VarChar(300)

  @@map("iap_settings")
}

// ---------------------------------------------------------------------------------------------
// v1.116-social (DRAFT, D355, CONVENTIONS §10.151): «واتساب» — the official Kabso WhatsApp number (WhatsApp Business
// Platform, Cloud API) answered by the staff from the app and the panel. Owner: `whatsapp` module. Off until the
// credentials are on the server. The staff columns (`assigned_to_id`, `author_id` …) carry no foreign key: accounts are
// never deleted, only tombstoned (§10.56), and the history keeps who acted.
// ---------------------------------------------------------------------------------------------

enum WaConversationStatus {
  OPEN
  CLOSED

  @@map("wa_conversation_status")
}

enum WaDirection {
  INBOUND
  OUTBOUND

  @@map("wa_direction")
}

enum WaMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  REACTION
  CONTACTS
  INTERACTIVE
  TEMPLATE
  UNSUPPORTED

  @@map("wa_message_type")
}

/// INBOUND rows are RECEIVED; OUTBOUND rows follow Meta's statuses (sent → delivered → read, or failed).
enum WaMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED

  @@map("wa_message_status")
}

/// Where a media message's bytes are: in the private storage, or why not.
enum WaMediaState {
  NONE
  STORED
  TOO_LARGE
  TYPE_REFUSED
  FAILED

  @@map("wa_media_state")
}

enum WaAssignmentAction {
  CLAIM
  RELEASE
  TRANSFER
  CLOSE
  REOPEN

  @@map("wa_assignment_action")
}

/// D355: one conversation per customer phone (E.164). `unread_count` counts the customer's messages since the team last
/// read it; `last_inbound_at` opens Meta's 24-hour customer-service window.
model WaConversation {
  id                 String               @id @default(uuid(7)) @db.Uuid
  phoneE164          String               @unique(map: "wa_conversations_phone_key") @map("phone_e164") @db.VarChar(16)
  waId               String               @map("wa_id") @db.VarChar(32)
  profileName        String?              @map("profile_name") @db.VarChar(200)
  status             WaConversationStatus @default(OPEN)
  assignedToId       String?              @map("assigned_to_id") @db.Uuid
  assignedAt         DateTime?            @map("assigned_at") @db.Timestamptz(3)
  unreadCount        Int                  @default(0) @map("unread_count")
  lastInboundAt      DateTime?            @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt      DateTime             @default(now()) @map("last_message_at") @db.Timestamptz(3)
  lastPreview        String?              @map("last_preview") @db.VarChar(120)
  lastDirection      WaDirection?         @map("last_direction")
  linkedUserId       String?              @map("linked_user_id") @db.Uuid
  linkedById         String?              @map("linked_by_id") @db.Uuid
  linkedAt           DateTime?            @map("linked_at") @db.Timestamptz(3)
  closedAt           DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById         String?              @map("closed_by_id") @db.Uuid
  /// Set when the linked account was purged (§10.56): the sweeper deletes the conversation and its media.
  purgeAfter         DateTime?            @map("purge_after") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)

  messages    WaMessage[]
  notes       WaNote[]
  assignments WaAssignment[]

  @@index([status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "wa_conversations_status_last_idx")
  @@index([assignedToId, lastMessageAt(sort: Desc)], map: "wa_conversations_assigned_idx")
  @@index([linkedUserId], map: "wa_conversations_linked_idx", where: raw("linked_user_id IS NOT NULL"))
  @@map("wa_conversations")
}

/// D355: one message in or out. `wa_message_id` (Meta's `wamid`) is unique: a webhook delivered twice stores one row.
model WaMessage {
  id             String          @id @default(uuid(7)) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  waMessageId    String?         @unique(map: "wa_messages_wamid_key") @map("wa_message_id") @db.VarChar(160)
  direction      WaDirection
  type           WaMessageType
  body           String?
  mediaKey       String?         @map("media_key") @db.VarChar(256)
  mediaState     WaMediaState    @default(NONE) @map("media_state")
  mediaMime      String?         @map("media_mime") @db.VarChar(100)
  mediaSize      Int?            @map("media_size")
  mediaFilename  String?         @map("media_filename") @db.VarChar(240)
  mediaVoice     Boolean         @default(false) @map("media_voice")
  latitude       Float?
  longitude      Float?
  locationName   String?         @map("location_name") @db.VarChar(240)
  reactionEmoji  String?         @map("reaction_emoji") @db.VarChar(16)
  reactionToWaId String?         @map("reaction_to_wa_id") @db.VarChar(160)
  templateName   String?         @map("template_name") @db.VarChar(512)
  templateLang   String?         @map("template_lang") @db.VarChar(16)
  status         WaMessageStatus
  errorCode      Int?            @map("error_code")
  errorTitle     String?         @map("error_title") @db.VarChar(300)
  sentById       String?         @map("sent_by_id") @db.Uuid
  waTimestamp    DateTime?       @map("wa_timestamp") @db.Timestamptz(3)
  statusAt       DateTime?       @map("status_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "wa_messages_conversation_idx")
  @@map("wa_messages")
}

/// D355: an internal note on a conversation — never sent to the customer.
model WaNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "wa_notes_conversation_idx")
  @@map("wa_notes")
}

/// D355: claim / release / transfer / close / reopen of a conversation (who, from whom, to whom).
model WaAssignment {
  id             String             @id @default(uuid(7)) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  action         WaAssignmentAction
  fromUserId     String?            @map("from_user_id") @db.Uuid
  toUserId       String?            @map("to_user_id") @db.Uuid
  actorId        String?            @map("actor_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "wa_assignments_conversation_idx")
  @@map("wa_assignments")
}

/// D355: the team's quick replies «ردود سريعة» (managed with `support.whatsapp.manage`).
model WaQuickReply {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String   @unique(map: "wa_quick_replies_title_key") @db.VarChar(60)
  body        String   @db.VarChar(1024)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("wa_quick_replies")
}

/// D355: a staff member's own WhatsApp settings (the push mute).
model WaAgentSetting {
  userId    String   @id @map("user_id") @db.Uuid
  pushMuted Boolean  @default(false) @map("push_muted")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("wa_agent_settings")
}
