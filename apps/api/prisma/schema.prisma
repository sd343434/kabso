  @@map("recharge_agent_counter")
}

/// v1.58-social (D189): the next host-agent number (one row).
model HostAgentCounter {
  id         Int @id @db.SmallInt
  lastNumber Int @default(0) @map("last_number")

  @@map("host_agent_counter")
}

/// D185: every change of an agent's coin stock.
