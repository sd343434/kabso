<?xml version="1.0" encoding="utf-8"?>
<!-- D145e: Android 12+ always shows a system splash before Flutter draws. Without an explicit icon it
     shows the launcher icon (Kabi) for a moment, then the splash animation starts, which the owner
     saw as "a picture, then the animation". A blank icon on the animation's background makes the
     system splash invisible, so the first thing seen is the animation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
