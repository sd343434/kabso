<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): android:dataExtractionRules (SEC-019).
     flutter_secure_storage 11 keeps the encrypted refresh token and its
     wrapped keys in these SharedPreferences files; they must never leave the
     device (cloud backup or device-to-device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </device-transfer>
</data-extraction-rules>
