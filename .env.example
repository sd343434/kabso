# Kabso Live — local development environment (template).
#
# Copy to `.env` (scripts/dev-setup.sh does this for you) and adjust. `.env` is git-ignored.
# Every value here is a LOCAL DEV DEFAULT or a placeholder — none of them is a real secret.
# Staging/production values come from the secret manager / GitHub Environments, never from a
# file in the repository (see docs/DEPLOYMENT.md → "Secrets management").
#
# docker compose reads this file for variable interpolation, and the API reads the same names
# from its process environment.

# --- Runtime -------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# libuv threadpool size. Argon2 hashing runs on this pool and the API caps concurrent hashes
# with ARGON2_MAX_CONCURRENCY (default: os.availableParallelism()). The pool must be at least
# ARGON2_MAX_CONCURRENCY + 4 (headroom for DNS lookups, fs and crypto work), otherwise hashes
# starve everything else. It is read once when Node starts, so it must be in the PROCESS
# environment before `node` launches (export it / container env); setting it from inside the
# app or a dotenv loader is too late (`set -a; . ./.env; set +a` before starting works).
# Default libuv size is 4. Set both explicitly: if ARGON2_MAX_CONCURRENCY is left unset it
# follows the CPU count, and the pool must then be at least $(nproc) + 4.
# Production example for 8 vCPUs: ARGON2_MAX_CONCURRENCY=8, UV_THREADPOOL_SIZE=12.
ARGON2_MAX_CONCURRENCY=4
UV_THREADPOOL_SIZE=8

# --- PostgreSQL (docker compose service `postgres`) -----------------------------------------
# POSTGRES_USER is the local ADMIN (superuser) only: it creates the databases and roles below
# on first start (infra/postgres/initdb) and is never used by the API or by migrations.
POSTGRES_DB=kabso_dev
POSTGRES_USER=kabso
POSTGRES_PASSWORD=kabso_dev_password
POSTGRES_PORT=5432
# Database for `pnpm test:e2e` (created next to POSTGRES_DB on first start; name must end in _test).
KABSO_TEST_DB=kabso_test

# Least-privilege roles (SEC-011 / KL-013, docs/DEPLOYMENT.md §5.1). Created by the init script
# on FIRST start of an empty volume only — after changing them, run `docker compose down -v` or
# infra/postgres/bootstrap-roles.sql. Staging/production values come from the secret manager.
#   migration role: owns the schema, runs `prisma migrate deploy` (MIGRATION_DATABASE_URL)
KABSO_DB_MIGRATOR_USER=kabso_migrator
KABSO_DB_MIGRATOR_PASSWORD=kabso_migrator_dev_password
#   runtime role: what the API connects as (DATABASE_URL) — DML only, no DDL/TRUNCATE
KABSO_DB_APP_USER=kabso_app
KABSO_DB_APP_PASSWORD=kabso_app_dev_password
#   runtime login of the e2e database (one runtime login per database, KL-013b)
KABSO_DB_APP_TEST_USER=kabso_app_test
KABSO_DB_APP_TEST_PASSWORD=kabso_app_test_dev_password
# Must match the values above. The API refuses to boot in production if DATABASE_URL is the
# migration/owner role or a superuser.
DATABASE_URL=postgresql://kabso_app:kabso_app_dev_password@localhost:5432/kabso_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://kabso_migrator:kabso_migrator_dev_password@localhost:5432/kabso_dev?schema=public

# --- Redis (docker compose service `redis`) -------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth (see docs/contracts/CONVENTIONS.md §6) ---------------------------------------------
# HS256 signing key for access tokens, >= 32 bytes. Generate your own:
#   openssl rand -base64 48
# Replace it even locally; never deploy any environment with a `change-me-...` value.
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
# Access token lifetime (15 min) and sliding refresh lifetime (30 days).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# --- Rate limiting (CONVENTIONS.md §7, SEC-010) ----------------------------------------------
# Server-side HMAC key for rate-limit bucket keys in Redis (no plain hashes of emails/IPs).
# REQUIRED in production, must be distinct from JWT_ACCESS_SECRET, >= 32 bytes. Generate:
#   openssl rand -base64 48
# Rotating it resets all rate-limit counters (harmless). scripts/dev-setup.sh fills it locally.
RATE_LIMIT_KEY_SECRET=change-me-generate-with-openssl-rand-base64-48

# --- Live discovery (contract v1.3, CONVENTIONS §10) ------------------------------------------
# Going live / heartbeats are refused (503 LIVE_HOSTING_UNAVAILABLE) unless this is "true".
# Keep it false wherever no media provider exists (B1); turning it on in staging/production
# needs owner approval. Lists simply stay empty while it is off.
LIVE_HOSTING_ENABLED=false
# Heartbeat cadence told to clients (5–60 s) and the stale window (>= 2 x interval).
LIVE_HEARTBEAT_INTERVAL_SECONDS=15
LIVE_HEARTBEAT_STALE_SECONDS=45
# In-process stale-room sweeper period (0 disables it; refused in production).
LIVE_SWEEP_INTERVAL_SECONDS=15
# Source of the HMAC key that signs list cursors (HKDF, distinct label). Optional: when unset it
# is derived from RATE_LIMIT_KEY_SECRET. If set: >= 32 bytes, and in production generator output
# distinct from the other secrets. scripts/dev-setup.sh replaces this placeholder locally.
LIVE_CURSOR_KEY=change-me-generate-with-openssl-rand-base64-48

# --- Client IP / reverse proxies (SEC-003; see docs/DEPLOYMENT.md "Client IP and TRUST_PROXY") --
# Decides which X-Forwarded-For entry is the client IP for per-IP rate limits. Values:
#   false            no proxy in front (local dev, direct exposure) — X-Forwarded-For ignored
#   <hop count>      e.g. 1 = exactly one proxy that APPENDS to X-Forwarded-For sits in front
#   <IPs/CIDRs>      comma-separated addresses of your own proxies, e.g. 10.0.0.0/8
#   true             trusts ANY client-supplied header: spoofable; refused when NODE_ENV=production
# Wrong values let attackers rotate X-Forwarded-For and bypass every per-IP limit.
TRUST_PROXY=false

# --- Public URLs & CORS ---------------------------------------------------------------------
# Base URL used in links inside emails (verification, password reset).
APP_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (mobile apps do not need CORS).
CORS_ORIGINS=http://localhost:3000

# --- Mail (blocker B2: no SMTP provider yet) -------------------------------------------------
# `log` prints emails (incl. verification/reset links) to the API log instead of sending.
MAIL_TRANSPORT=log
MAIL_FROM="Kabso Live <no-reply@localhost>"

# --- Object storage: MinIO locally, S3/R2 in cloud (Phase 3+) -------------------------------
# Start with: docker compose --profile storage up -d
MINIO_ROOT_USER=kabso_minio
MINIO_ROOT_PASSWORD=kabso_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kabso-media-dev
S3_ACCESS_KEY_ID=kabso_minio
S3_SECRET_ACCESS_KEY=kabso_minio_dev_password
# MinIO needs path-style addressing.
S3_FORCE_PATH_STYLE=true
# v1.5-social (CONVENTIONS §11.1): uploads stay off until storage is configured (B12).
MEDIA_UPLOADS_ENABLED=false
# Where processed images are read from (a CDN or a public-read rule on media/ only; never uploads/).
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/kabso-media-dev
MEDIA_SWEEP_INTERVAL_SECONDS=300
POSTS_PUBLISH_INTERVAL_SECONDS=30
NOTIFICATIONS_SWEEP_INTERVAL_SECONDS=3600

# --- Push notifications (D152, CONVENTIONS §11.12) -------------------------------------------
# Path of the Firebase Admin SDK service-account key (a file, never its content; never in git).
# Unset, missing or invalid → push is off (one log line) and everything else works. On the
# staging server the compose file mounts /etc/kabso/firebase-admin.json here (DEPLOYMENT §5.16).
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-admin.json
PUSH_DISPATCH_INTERVAL_MS=2000
PUSH_GENERAL_GAP_SECONDS=5
PUSH_MESSAGES_GAP_SECONDS=10

# --- Live video (CP-010, D93) -----------------------------------------------------------------
# The LiveKit media server (D3). Required when LIVE_HOSTING_ENABLED=true. The values below are
# livekit-server's public `--dev` defaults (not secrets), for local development only. Production
# uses LiveKit Cloud (wss://…) with keys from the secret manager (B1). Never commit real values.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
